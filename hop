// Start or get existing session (uses hay for terminal sharing)
function getOrCreateSession(sessionName, cwd, displayName) {
    if (!sessionName || typeof sessionName !== 'string' || !SESSION_NAME_RE.test(sessionName)) {
        throw new Error('Invalid session name');
    }
    const existingConfig = getEffectiveSessionConfig(sessionName);
    if (existingConfig && existingConfig.type === 'port') {
        throw new Error('Session is configured as a port proxy');
    }
    rememberRuntimeSessionMetadata(sessionName, {
        type: 'terminal',
        cwd: cwd || existingConfig?.cwd,
        displayName: displayName || existingConfig?.displayName || toDisplaySessionName(sessionName),
        shell: existingConfig?.shell,
        env: existingConfig?.env,
        cols: existingConfig?.cols,
        rows: existingConfig?.rows,
        startup: existingConfig?.startup,
        autoStart: existingConfig?.autoStart,
        createdBy: existingConfig?.createdBy || 'user',
        agentPermitted: typeof existingConfig?.agentPermitted === 'boolean'
            ? existingConfig.agentPermitted
            : (existingConfig?.createdBy === 'agent'),
        folderId: existingConfig?.folderId || null,
        workspaceName: resolveSessionWorkspaceName(existingConfig)
    });
    if (activeSessions[sessionName]) {
        return activeSessions[sessionName];
    }
    if (isExternalTerminalBackend()) {
        const hostState = getExternalHayHostStateOrThrow();
        activeSessions[sessionName] = {
            backend: 'external',
            hostPort: hostState.port
        };
        return activeSessions[sessionName];
    }

    const config = getEffectiveSessionConfig(sessionName);
    const workspaceName = resolveSessionWorkspaceName(config);
    const ptyRuntime = buildSessionPtyEnv(sessionName, config, workspaceName);
    const effectiveCwd = cwd || config?.cwd;
    const initialCols = Number.isInteger(config?.cols) ? config.cols : 80;
    const initialRows = Number.isInteger(config?.rows) ? config.rows : 24;
    const display = config?.displayName || getSessionDisplayName(sessionName);

    // Create hay room for this session (with optional cwd/shell/env override)
    const room = hayRooms.getRoom(sessionName, { cols: initialCols, rows: initialRows }, {
        cwd: effectiveCwd,
        shell: config?.shell,
        env: ptyRuntime.env
    });
    const auditState = getSessionAuditState(sessionName, ptyRuntime.workspaceName, display);

    appendSessionAuditEvent(sessionName, ptyRuntime.workspaceName, 'session_start', {
        displayName: display,
        workspaceName: ptyRuntime.workspaceName,
        cwd: effectiveCwd || null,
        shell: config?.shell || null,
        historyFile: ptyRuntime.historyFile,
        auditMode: auditState.mode
    });

    room.on('pty_output', (event) => {
        handleSessionAuditOutput(auditState, event);
    });

    room.on('pty_input', (event) => {
        const actor = event?.actor || resolveSessionClientActor(sessionName, event?.clientId) || 'unknown';
        appendSessionAuditEvent(sessionName, ptyRuntime.workspaceName, 'input', {
            displayName: display,
            workspaceName: ptyRuntime.workspaceName,
            clientId: event?.clientId || null,
            actor,
            source: event?.source || null,
            ...truncateAuditText(event?.data)
        });
        detectAndRecordCommandLaunch(auditState, event, actor, event?.clientId || null);
    });

    room.on('pty_state', (event) => {
        const eventTs = Number.isFinite(event?.timestamp) ? Number(event.timestamp) : Date.now();
        const nextAlternate = event?.alternateScreen === true;
        const nextCursorHidden = event?.cursorHidden === true;
        auditState.alternateScreen = nextAlternate;
        auditState.cursorHidden = nextCursorHidden;
        setSessionAuditMode(
            auditState,
            nextAlternate ? 'tui_keyframe' : 'stream',
            'pty_state',
            eventTs
        );
        appendSessionAuditEvent(sessionName, ptyRuntime.workspaceName, 'pty_state', {
            displayName: display,
            workspaceName: ptyRuntime.workspaceName,
            alternateScreen: nextAlternate,
            cursorHidden: nextCursorHidden
        });
    });

    room.on('pty_resize', (event) => {
        appendSessionAuditEvent(sessionName, ptyRuntime.workspaceName, 'resize', {
            displayName: display,
            workspaceName: ptyRuntime.workspaceName,
            clientId: event?.clientId || null,
            actor: resolveSessionClientActor(sessionName, event?.clientId) || 'unknown',
            cols: event?.cols,
            rows: event?.rows
        });
    });

    room.on('session_end', (event) => {
        flushSessionTuiKeyframe(auditState, event?.timestamp, true);
        appendSessionAuditEvent(sessionName, ptyRuntime.workspaceName, 'session_end', {
            displayName: display,
            workspaceName: ptyRuntime.workspaceName,
            exitCode: event?.exitCode ?? null,
            signal: event?.signal ?? null,
            message: event?.message || 'Session ended'
        });
    });

    applyPostStartupHistoryIsolation(room, config, ptyRuntime);

    room.on('empty', () => {
        closeSessionAuditSink(sessionName);
        clearSessionClientActors(sessionName);
        delete activeSessions[sessionName];
        clearRuntimeSessionMetadata(sessionName);
        log(`Session ${getSessionDisplayName(sessionName)} closed.`, YELLOW);
        sessionClientSummary.delete(sessionName);
    });

    activeSessions[sessionName] = { room };
    log(`  Started session "${getSessionDisplayName(sessionName)}" (hay)`, GREEN);

    return activeSessions[sessionName];
}

function createVirtualClientAdapter(onServerMessage) {
    let messageHandler = null;
    const closeHandlers = [];
    let errorHandler = null;
    let open = true;

    return {
        adapter: {
            send: (data) => {
                if (!open) return;
                onServerMessage?.(data);
            },
            onMessage: (handler) => {
                messageHandler = handler;
            },
            onClose: (handler) => {
                closeHandlers.push(handler);
            },
            onError: (handler) => {
                errorHandler = handler;
            },
            close: () => {
                if (!open) return;
                open = false;
                for (const handler of closeHandlers) {
                    handler();
                }
            },
            isOpen: () => open
        },
        emit: (payload) => {
            if (!open) return;
            if (messageHandler) {
                messageHandler(payload);
            }
        },
        error: (err) => {
            if (errorHandler) errorHandler(err);
        },
        close: () => {
            if (!open) return;
            open = false;
            for (const handler of closeHandlers) {
                handler();
            }
        }
    };
}

// Fetch a terminal API entry AND stamp it as recently used — every API touch
// (stream, write, resize, exec, delete) resets the idle clock the reaper
// below runs on.
function getTerminalApiEntryTouched(terminalId) {
    const entry = terminalApiSessions.get(terminalId);
    if (entry) entry.lastTouchedAt = Date.now();
    return entry;
}

// Idle reaper for agent attaches. A virtual client is presence like any
// other ("agent" in the roster) but has no socket that could die — an agent
// that crashed or simply never called close would sit in a session's
// presence forever. Idle = no API touch and no open SSE stream. Reaping is
// safe for well-behaved agents: the MCP core re-attaches by session name on
// the next op (recoverTerminalId), so a reaped handle costs one round-trip.
const TERMINAL_API_IDLE_TTL_MS = Number(process.env.HOP_TERMINAL_API_IDLE_TTL_MS || 15 * 60 * 1000);
const TERMINAL_API_SWEEP_MS = Number(process.env.HOP_TERMINAL_API_SWEEP_MS || 60 * 1000);
if (DAEMON_FLAG && TERMINAL_API_IDLE_TTL_MS > 0) {
    setInterval(() => {
        const nowMs = Date.now();
        for (const entry of [...terminalApiSessions.values()]) {
            if (terminalApiStreams.has(entry.id)) continue; // live stream = in use
            const idleSince = entry.lastTouchedAt || Date.parse(entry.createdAt) || nowMs;
            if (nowMs - idleSince <= TERMINAL_API_IDLE_TTL_MS) continue;
            log(`[terminal-api] detached idle '${entry.actor}' terminal from ${entry.displayName || entry.sessionName} after ${Math.round((nowMs - idleSince) / 60000)}m`, DIM);
            try { entry.adapter.close(); } catch (e) { /* already closing */ }
            // adapter.close() detaches the room client and drops the entry;
            // belt-and-braces in case a close handler threw mid-chain.
            terminalApiSessions.delete(entry.id);
        }
    }, TERMINAL_API_SWEEP_MS).unref();
}

function closeTerminalApiEntry(terminalId) {
    terminalApiSessions.delete(terminalId);
    const streams = terminalApiStreams.get(terminalId);
    if (streams) {
        for (const res of streams) {
            res.end();
        }
        terminalApiStreams.delete(terminalId);
    }
    clearTerminalEventBuffer(terminalId);
}

function handleTerminalApiServerMessage(terminalId, parsed) {
    if (!parsed || !parsed.type) return;
    if (parsed.type === 'output' || parsed.type === 'snapshot') {
        sendTerminalStreamEvent(terminalId, {
            type: parsed.type,
            data: parsed.data,
            alternateScreen: parsed.alternateScreen,
            cursorHidden: parsed.cursorHidden,
            timestamp: Date.now()
        });
        return;
    }
    if (parsed.type === 'session_ended') {
        sendTerminalStreamEvent(terminalId, {
            type: 'session_ended',
            exitCode: parsed.exitCode,
            signal: parsed.signal,
            message: parsed.message,
            timestamp: Date.now()
        });
        closeTerminalApiEntry(terminalId);
    }
}

async function attachExternalTerminalApiClient(sessionName, displayName, opts = {}) {
    await ensureExternalRuntimeSession(sessionName, opts.cwd, displayName, {
        shell: opts.shell,
        env: opts.env,
        cols: opts.cols,
        rows: opts.rows,
        startup: opts.startup,
        autoStart: opts.autoStart,
        createdBy: opts.createdBy,
        createdVia: opts.createdVia,
        agentPermitted: opts.agentPermitted,
        workspaceName: opts.workspaceName,
        folderId: opts.folderId,
        saveDefinition: opts.saveDefinition === true,
        seedOutput: opts.seedOutput,
        command: opts.command
    });

    const cols = Number.isInteger(opts.cols) ? opts.cols : 80;
    const rows = Number.isInteger(opts.rows) ? opts.rows : 24;
    const label = opts.label || 'agent';
    const terminalId = `t_${crypto.randomBytes(6).toString('hex')}`;
    const clientId = hay.generateClientId();
    const sessionCwd = opts.cwd || (getEffectiveSessionConfig(sessionName) || {}).cwd;
    const wsUrl = buildExternalHayWsUrl(sessionName, {
        name: label,
        cols,
        rows,
        source: `terminal-api-${opts.actor || 'user'}`,
        cwd: sessionCwd
    });
    const ws = new WebSocket(wsUrl);
    let open = false;
    let closed = false;
    const pendingPayloads = [];

    const adapterBundle = {
        emit: (payload) => {
            if (closed || !payload) return;
            if (open && ws.readyState === WebSocket.OPEN) {
                ws.send(payload);
                return;
            }
            pendingPayloads.push(payload);
        },
        close: () => {
            if (closed) return;
            closed = true;
            closeTerminalApiEntry(terminalId);
            try { ws.close(); } catch (e) { }
        }
    };

    ws.on('open', () => {
        if (closed) return;
        open = true;
        while (pendingPayloads.length > 0 && ws.readyState === WebSocket.OPEN) {
            const payload = pendingPayloads.shift();
            if (payload) {
                ws.send(payload);
            }
        }
    });

    ws.on('message', (payload) => {
        let parsed = null;
        try {
            parsed = hay.safeParseServerMessage ? hay.safeParseServerMessage(payload.toString()) : JSON.parse(payload.toString());
        } catch (e) {
            parsed = null;
        }
        handleTerminalApiServerMessage(terminalId, parsed);
    });

    ws.on('close', () => {
        if (closed) return;
        closed = true;
        closeTerminalApiEntry(terminalId);
    });

    ws.on('error', () => {
        if (closed) return;
        closed = true;
        closeTerminalApiEntry(terminalId);
    });

    const sessionEntry = {
        id: terminalId,
        sessionName,
        displayName: displayName || getSessionDisplayName(sessionName),
        actor: opts.actor || 'user',
        clientId,
        adapter: adapterBundle,
        createdAt: new Date().toISOString(),
        lastTouchedAt: Date.now()
    };
    terminalApiSessions.set(terminalId, sessionEntry);
    return sessionEntry;
}

async function attachTerminalApiClient(sessionName, displayName, opts = {}) {
    if (isExternalTerminalBackend()) {
        return await attachExternalTerminalApiClient(sessionName, displayName, opts);
    }
    const session = activeSessions[sessionName] || getOrCreateSession(sessionName, opts.cwd, displayName);
    const room = session.room;
    const cols = Number.isInteger(opts.cols) ? opts.cols : 80;
    const rows = Number.isInteger(opts.rows) ? opts.rows : 24;
    const label = opts.label || 'agent';
    const colorIndex = Math.floor(Math.random() * 1000);

    const terminalId = `t_${crypto.randomBytes(6).toString('hex')}`;
    const clientId = hay.generateClientId();

    const adapterBundle = createVirtualClientAdapter((payload) => {
        let parsed = null;
        try {
            parsed = hay.safeParseServerMessage ? hay.safeParseServerMessage(payload) : JSON.parse(payload);
        } catch (e) {
            parsed = null;
        }
        handleTerminalApiServerMessage(terminalId, parsed);
    });

    room.attachClient(
        { id: clientId, name: label, colorIndex, cols, rows },
        adapterBundle.adapter
    );
    registerSessionClientActor(sessionName, clientId, opts.actor || label || 'agent');

    adapterBundle.adapter.onClose(() => {
        unregisterSessionClientActor(sessionName, clientId);
        closeTerminalApiEntry(terminalId);
    });

    const sessionEntry = {
        id: terminalId,
        sessionName,
        displayName: displayName || getSessionDisplayName(sessionName),
        actor: opts.actor || 'user',
        clientId,
        adapter: adapterBundle,
        createdAt: new Date().toISOString(),
        lastTouchedAt: Date.now()
    };
    terminalApiSessions.set(terminalId, sessionEntry);
    return sessionEntry;
}

function sendTerminalInput(entry, data) {
    if (!entry || !data) return;
    entry.adapter.emit(JSON.stringify({ type: 'input', data }));
}

function sendTerminalResize(entry, cols, rows) {
    if (!entry || !Number.isFinite(cols) || !Number.isFinite(rows)) return;
    entry.adapter.emit(JSON.stringify({ type: 'resize', cols, rows }));
}

// ---- Session restore -------------------------------------------------------
// The SessionStart hook (scripts/claude-session-hook.js) records, per hop
// session, which Claude conversation is running in it. We read that here to
// rebuild each session on `hop restore` with `claude --resume <id>` so multiple
// claude sessions in one workdir each resume their OWN conversation.
const CLAUDE_SESSIONS_DIR = path.join(HOME_DIR, 'claude-sessions');
const CLAUDE_HOOK_SCRIPT = path.join(__dirname, 'scripts', 'claude-session-hook.js');

// The per-turn completion counter the agent bumps once each time it finishes a
// turn — Claude via its Stop hook (scripts/claude-session-hook.js), Codex via
// its `notify` handler (parity). {sessionId, count, at}. Turning a finished
// response into a phone notification (opt-in per session) rides this: no new
// stream, no PTY write, just a number the sessions poll already carries.
function readTurnCount(internalName) {
    try {
        const c = JSON.parse(fs.readFileSync(
            path.join(CLAUDE_SESSIONS_DIR, `${internalName}.turn`), 'utf8')).count;
        return Number.isInteger(c) && c >= 0 ? c : 0;
    } catch (e) { return 0; }
}

// How many turns have completed SINCE the human armed notify-on-finish for this
// session — added to bellSeq so each finish reads as a fresh bell the phone
// surfaces (dedupe + seen-marks already handle "one finish, one alert").
// Baselined at arm time (notifyBaseTurn) so arming a long-lived session does
// not fire a single notification for its entire back history.
function finishBump(internalName, config) {
    if (!config || config.notifyOnFinish !== true) return 0;
    const base = Number.isInteger(config.notifyBaseTurn) ? config.notifyBaseTurn : 0;
    return Math.max(0, readTurnCount(internalName) - base);
}

// The hay-host writes each room's tail buffer here on graceful shutdown; on
// restore we replay a plain-shell session's buffer as the new room's seed so it
// reopens on its last screen, then a fresh shell starts in the same dir.
const SESSION_BUFFERS_DIR = path.join(HOME_DIR, 'session-buffers');

// Printed between the replayed buffer and the fresh shell's first prompt, so the
// boundary is obvious. Dim, centered-ish marker on its own line.
const SESSION_RESTORED_SEPARATOR = '\r\n\x1b[2m──────── session restored ────────\x1b[0m\r\n';

// Strip terminal QUERY sequences from a seed buffer before replay. The buffer
// is raw output from the previous life of the session; replaying queries (DA
// "who are you", DSR cursor probes, kitty keyboard probes, XTVERSION, DECRQM,
// OSC color queries) makes the user's real terminal ANSWER them — and those
// answers arrive as junk keystrokes at the fresh prompt (e.g. "1;2c").
function sanitizeSeedBuffer(buf) {
    return String(buf)
        .replace(/\x1b\[[>=]?\d*c/g, '')                          // DA1/DA2/DA3
        .replace(/\x1b\[\??\d*n/g, '')                             // DSR / cursor position report requests
        .replace(/\x1b\[\?u/g, '')                                 // kitty keyboard protocol query
        .replace(/\x1b\[>0?q/g, '')                                // XTVERSION
        .replace(/\x1b\[\?\d+(?:;\d+)*\$p/g, '')                   // DECRQM mode queries
        .replace(/\x1bP\$q[^\x1b]*\x1b\\/g, '')                    // DECRQSS
        .replace(/\x1b\](?:1[0-2]|4;\d+);\?(?:\x07|\x1b\\)/g, ''); // OSC color queries
}

function shellSessionBufferPath(internalName) {
    if (!internalName || !/^[A-Za-z0-9_.-]+$/.test(internalName)) return null;
    return path.join(SESSION_BUFFERS_DIR, `${internalName}.raw`);
}

// Non-consuming check used for `hop restore` planning/dry-run.
function shellSessionBufferExists(internalName) {
    const file = shellSessionBufferPath(internalName);
    if (!file) return false;
    try { return fs.statSync(file).size > 0; } catch (e) { return false; }
}

// Read (and consume) a persisted plain-shell buffer for a session. One-shot: the
// file is deleted after reading so a later normal recreate of the same name does
// not replay a stale screen. Returns "" when there is nothing to replay.
function readShellSessionBuffer(internalName) {
    const file = shellSessionBufferPath(internalName);
    if (!file) return '';
    let data = '';
    try {
        data = fs.readFileSync(file, 'utf8');
    } catch (e) {
        return '';
    }
    try { fs.unlinkSync(file); } catch (e) { /* best effort */ }
    return data;
}

function readClaudeSessionRecord(internalName) {
    if (!internalName || !SESSION_NAME_RE.test(internalName)) return null;
    try {
        const raw = fs.readFileSync(path.join(CLAUDE_SESSIONS_DIR, `${internalName}.json`), 'utf8');
        const rec = JSON.parse(raw);
        return rec && typeof rec.sessionId === 'string' && rec.sessionId ? rec : null;
    } catch (e) {
        return null;
    }
}
// The conversation id from the Stop-hook's turn counter. The SessionStart
// record (.json) and the turn counter (.turn) are written by the SAME hook
// but on different events, so a session can lose one and keep the other —
// mybot came back a bare shell with a .turn naming its conversation but no
// .json for restore to key on. This is the second, independent witness.
function readTurnSessionId(internalName) {
    if (!internalName || !SESSION_NAME_RE.test(internalName)) return null;
    try {
        const t = JSON.parse(fs.readFileSync(path.join(CLAUDE_SESSIONS_DIR, `${internalName}.turn`), 'utf8'));
        return typeof t.sessionId === 'string' && t.sessionId ? t.sessionId : null;
    } catch (e) { return null; }
}
// Find a transcript for a bare session id across every claude config root,
// returning which root (= the CLAUDE_CONFIG_DIR to resume under) holds it.
function findClaudeTranscriptById(sessionId) {
    if (!sessionId) return null;
    for (const root of claudeConfigRootsForRestore(null)) {
        const projects = path.join(root, 'projects');
        let slugs = [];
        try { slugs = fs.readdirSync(projects); } catch (e) { continue; }
        for (const slug of slugs) {
            const hit = findClaudeTranscriptIn(path.join(projects, slug), sessionId);
            if (hit) return { file: hit, configDir: root === path.join(os.homedir(), '.claude') ? null : root };
        }
    }
    return null;
}
// When a session has NO SessionStart record but its .turn still names a
// conversation whose transcript exists, rebuild a record from it so restore
// resumes the real conversation instead of dropping to a bare shell. The
// rebuilt record is persisted (best effort) so the next restore, fork, and
// search all agree. cwd comes from the caller (the room's real directory).
function recoverRecordFromTurn(internalName, cwd) {
    const sessionId = readTurnSessionId(internalName);
    if (!sessionId) return null;
    const found = findClaudeTranscriptById(sessionId);
    if (!found) return null;
    const configPrefix = found.configDir
        ? `CLAUDE_CONFIG_DIR='${found.configDir.replace(/'/g, `'\\''`)}' ` : '';
    const rec = {
        sessionId,
        cwd: cwd || undefined,
        source: 'resume',
        configDir: found.configDir,
        launchCmd: `${configPrefix}claude --dangerously-skip-permissions --resume ${sessionId}`,
        updatedAt: new Date().toISOString(),
        recoveredFrom: 'turn-counter'
    };
    writeClaudeSessionRecord(internalName, rec); // best effort; plan below does not depend on it
    return rec;
}

// The rival record the hook parks when a differently-rooted claude tries to
// take over a session (see scripts/claude-session-hook.js).
function readClaudeSessionRecordOther(internalName) {
    if (!internalName || !SESSION_NAME_RE.test(internalName)) return null;
    try {
        const rec = JSON.parse(fs.readFileSync(path.join(CLAUDE_SESSIONS_DIR, `${internalName}.other.json`), 'utf8'));
        return rec && typeof rec.sessionId === 'string' && rec.sessionId ? rec : null;
    } catch (e) {
        return null;
    }
}

function writeClaudeSessionRecord(internalName, rec) {
    if (!internalName || !SESSION_NAME_RE.test(internalName)) return;
    try { fs.mkdirSync(CLAUDE_SESSIONS_DIR, { recursive: true }); } catch (e) { /* best effort */ }
    try {
        // Same crash-safety as the metas: records are what lets a claude
        // conversation resume at all.
        writePrivateFile(path.join(CLAUDE_SESSIONS_DIR, `${internalName}.json`), JSON.stringify(rec), 0o600);
    } catch (e) { /* best effort */ }
}

function removeClaudeSessionRecordOther(internalName) {
    if (!internalName || !SESSION_NAME_RE.test(internalName)) return;
    try { fs.unlinkSync(path.join(CLAUDE_SESSIONS_DIR, `${internalName}.other.json`)); } catch (e) { /* absent */ }
}

// The SessionStart hook writes one record per hop session, so the set of these
// files is itself a durable, crash-surviving list of what to restore — it does
// not depend on the workspace-scoped session store (which is dormant unless a
// workspace is active). Each is `{ internalName, sessionId, cwd }`.
function listClaudeSessionRecords() {
    let files = [];
    try { files = fs.readdirSync(CLAUDE_SESSIONS_DIR).filter((f) => f.endsWith('.json')); }
    catch (e) { return []; }
    const out = [];
    for (const f of files) {
        const internalName = f.slice(0, -'.json'.length);
        const rec = readClaudeSessionRecord(internalName);
        if (rec) out.push({ internalName, ...rec });
    }
    return out;
}

// Drop a session's hook record (+ turn counter + origin marker) so a deleted
// session is not resurrected by `hop restore`.
function removeClaudeSessionRecord(internalName) {
    if (!internalName || !SESSION_NAME_RE.test(internalName)) return;
    for (const ext of ['.json', '.turn', '.meta']) {
        try { fs.unlinkSync(path.join(CLAUDE_SESSIONS_DIR, `${internalName}${ext}`)); } catch (e) { /* best effort */ }
    }
}

// Durable origin marker written by the daemon at creation time. The
// SessionStart hook runs inside the session and can't know who created it, so
// restore reads this to keep agent-created workers out of the default set.
function writeClaudeSessionMeta(internalName, meta) {
    if (!internalName || !SESSION_NAME_RE.test(internalName)) return;
    try { fs.mkdirSync(CLAUDE_SESSIONS_DIR, { recursive: true }); } catch (e) { /* best effort */ }
    try {
        // ATOMIC + FSYNCED, not writeFileSync. The thermal-sleep crash proved
        // the difference with a natural experiment: folders.json (written via
        // writePrivateFile the same night) SURVIVED, while every meta
        // rewritten in the prior three days — every rename, every folder
        // filing — vanished with the un-fsynced page cache. These files are
        // the restore inventory; they are exactly the data that must outlive
        // a power cut.
        writePrivateFile(path.join(CLAUDE_SESSIONS_DIR, `${internalName}.meta`), JSON.stringify(meta), 0o600);
    } catch (e) { /* best effort */ }
}

function readClaudeSessionMeta(internalName) {
    if (!internalName || !SESSION_NAME_RE.test(internalName)) return null;
    try {
        return JSON.parse(fs.readFileSync(path.join(CLAUDE_SESSIONS_DIR, `${internalName}.meta`), 'utf8'));
    } catch (e) {
        return null;
    }
}

// Every persisted session meta ({ internalName, cwd, createdBy }). Together
// with the hook records these form the crash-surviving restore inventory:
// records resume claude conversations, metas reopen plain shells in place.
function listClaudeSessionMetas() {
    let files = [];
    try { files = fs.readdirSync(CLAUDE_SESSIONS_DIR).filter((f) => f.endsWith('.meta')); }
    catch (e) { return []; }
    const out = [];
    for (const f of files) {
        const internalName = f.slice(0, -'.meta'.length);
        const meta = readClaudeSessionMeta(internalName);
        if (meta) out.push({ internalName, ...meta });
    }
    return out;
}

// Claude Code slugifies a project cwd for <config-root>/projects/<slug>/.
// The rule has changed across versions (older: every non-alphanumeric -> '-';
// newer builds preserve spaces: "nebula-notebook 2" keeps its space), so
// resolution must try every plausible slug.
function claudeProjectDirCandidates(cwd) {
    const raw = String(cwd || '');
    const slugs = [
        raw.replace(/[^A-Za-z0-9]/g, '-'),
        raw.replace(/[^A-Za-z0-9 ]/g, '-')
    ];
    return [...new Set(slugs)];
}

// Config roots that can hold a conversation's transcript: the recorded
// configDir first, then ~/.claude, then alternate installs (~/.claude_fable
// etc. — wrapper launchers point CLAUDE_CONFIG_DIR at these).
function claudeConfigRootsForRestore(recConfigDir) {
    const roots = [];
    const push = (p) => { if (p && typeof p === 'string' && !roots.includes(p)) roots.push(p); };
    push(recConfigDir);
    push(path.join(os.homedir(), '.claude'));
    try {
        for (const dirEntry of fs.readdirSync(os.homedir())) {
            if (/^\.claude[_-][A-Za-z0-9_-]+$/.test(dirEntry)) push(path.join(os.homedir(), dirEntry));
        }
    } catch (e) { /* home unreadable — stick with the defaults */ }
    return roots;
}

// Does the recorded conversation actually have a transcript on this host? A
// hook record can point at an ephemeral conversation (e.g. a headless
// `claude -p` that inherited HOP_SESSION) — resuming that would fail with
// "No conversation found" in the restored terminal. Verify before planning a
// resume; the caller falls back to a plain shell with a visible warning.
// A transcript for one session id under one project directory, in either
// store layout: <base>/<id>.jsonl, or the newer per-session DIRECTORY -
// which only counts when it holds a real transcript jsonl (a dir with only
// subagents/ metadata is a conversation that never persisted; resume would
// fail on it).
function findClaudeTranscriptIn(base, sessionId) {
    const file = path.join(base, `${sessionId}.jsonl`);
    try { fs.accessSync(file); return file; } catch (e) { /* next */ }
    try {
        const dir = path.join(base, sessionId);
        if (fs.statSync(dir).isDirectory()) {
            const jsonl = fs.readdirSync(dir).find((f) => f.endsWith('.jsonl'));
            if (jsonl) return path.join(dir, jsonl);
        }
    } catch (e) { /* next */ }
    return null;
}
// Was this conversation LAUNCHED in `cwd`? Claude files a transcript under
// the slug of the directory it started in, and never moves it - so the
// store, not the record's cwd field, is the authority on a conversation's
// home. The record's cwd can drift (the hook re-recorded claude's current
// directory on compaction, which follows the conversation's own shell).
function claudeTranscriptLivesUnder(rec, cwd) {
    if (!rec || !rec.sessionId || !cwd) return false;
    for (const root of claudeConfigRootsForRestore(rec.configDir)) {
        for (const slug of claudeProjectDirCandidates(cwd)) {
            if (findClaudeTranscriptIn(path.join(root, 'projects', slug), rec.sessionId)) return true;
        }
    }
    return false;
}
function resolveClaudeTranscriptPath(rec) {
    if (!rec || !rec.sessionId || !rec.cwd) return null;
    const findIn = (base) => findClaudeTranscriptIn(base, rec.sessionId);
    for (const root of claudeConfigRootsForRestore(rec.configDir)) {
        for (const slug of claudeProjectDirCandidates(rec.cwd)) {
            const hit = findIn(path.join(root, 'projects', slug));
            if (hit) return hit;
        }
    }
    // The cwd-derived slug is a HINT, not the identity: the session id is
    // unique across the whole store, and claude itself resumes by id. A
    // record whose cwd was healed (Accessibility-fork: conversation written
    // from inside the transcript dir, so its file lives under a doubly-
    // encoded slug) would otherwise read as "no transcript on this host"
    // and restore to a bare shell, when the transcript is right there.
    for (const root of claudeConfigRootsForRestore(rec.configDir)) {
        const projects = path.join(root, 'projects');
        let slugs = [];
        try { slugs = fs.readdirSync(projects); } catch (e) { continue; }
        for (const slug of slugs) {
            const hit = findIn(path.join(projects, slug));
            if (hit) return hit;
        }
    }
    return null;
}

function claudeTranscriptExists(rec) {
    return resolveClaudeTranscriptPath(rec) !== null;
}

// ---- codex transcript discovery -------------------------------------------
// Codex has no SessionStart hook, so unlike claude there is no per-session
// record pointing at its transcript. What each rollout file DOES carry is a
// first-line session_meta with the cwd it ran in — so a codex session's
// transcript is found by matching cwd among recent rollouts, newest first.
// Wrong attribution (two codex sessions in one cwd) is possible and accepted:
// the snippet shown makes a mismatch visible, and the alternative is no codex
// search at all.
const codexRolloutCwdCache = new Map(); // rollout path -> cwd (immutable per file)
let codexRolloutListCache = { at: 0, files: [] };
function listCodexRolloutFiles() {
    const now = Date.now();
    if (now - codexRolloutListCache.at < 60_000) return codexRolloutListCache.files;
    const files = [];
    for (const root of getCodexConfigRoots()) {
        const walk = (dir, depth) => {
            let names = [];
            try { names = fs.readdirSync(dir); } catch (e) { return; }
            for (const n of names) {
                const p = path.join(dir, n);
                if (n.endsWith('.jsonl')) {
                    try { files.push({ path: p, mtimeMs: fs.statSync(p).mtimeMs }); } catch (e) { /* gone */ }
                } else if (depth < 3) {
                    walk(p, depth + 1); // sessions/YYYY/MM/DD nesting
                }
            }
        };
        walk(path.join(root, 'sessions'), 0);
    }
    files.sort((a, b) => b.mtimeMs - a.mtimeMs);
    codexRolloutListCache = { at: now, files: files.slice(0, 200) };
    return codexRolloutListCache.files;
}

function codexRolloutCwd(rolloutPath) {
    if (codexRolloutCwdCache.has(rolloutPath)) return codexRolloutCwdCache.get(rolloutPath);
    let cwd = null;
    try {
        const fd = fs.openSync(rolloutPath, 'r');
        const buf = Buffer.alloc(4096);
        const n = fs.readSync(fd, buf, 0, 4096, 0);
        fs.closeSync(fd);
        const meta = JSON.parse(buf.toString('utf8', 0, n).split('\n', 1)[0]);
        cwd = meta?.payload && typeof meta.payload.cwd === 'string' ? meta.payload.cwd : null;
    } catch (e) { /* unreadable or meta line > 4KB — treat as unmatched */ }
    codexRolloutCwdCache.set(rolloutPath, cwd);
    if (codexRolloutCwdCache.size > 2000) {
        for (const key of [...codexRolloutCwdCache.keys()].slice(0, 500)) codexRolloutCwdCache.delete(key);
    }
    return cwd;
}

function resolveCodexTranscriptByCwd(cwd) {
    if (!cwd) return null;
    for (const f of listCodexRolloutFiles()) {
        if (codexRolloutCwd(f.path) === cwd) return f.path;
    }
    return null;
}

// ripgrep for deep search: a system rg when installed, else the copy every
// claude install bundles — the claude binary IS ripgrep when ARGV0=rg, the
// same dispatch its own shell integration uses. Probed once, remembered.
let rgRunnerCache = null; // { bin, env } | 'none'
function resolveRgRunner() {
    if (rgRunnerCache) return Promise.resolve(rgRunnerCache === 'none' ? null : rgRunnerCache);
    const tryOne = (bin, env) => new Promise((resolve) => {
        execFile(bin, ['--version'], { env, timeout: 5000 }, (err, stdout) => {
            resolve(!err && /ripgrep/i.test(String(stdout)) ? { bin, env } : null);
        });
    });
    return tryOne('rg', process.env)
        .then((r) => r || tryOne('claude', { ...process.env, ARGV0: 'rg' }))
        .then((r) => {
            rgRunnerCache = r || 'none';
            return r;
        });
}

// A session's transcript for SEARCH: the claude record when there is one,
// else — for sessions identifiably running codex — its newest rollout by cwd.
function resolveSessionTranscriptPathForSearch(internalName, sessionEntry) {
    const claudePath = resolveClaudeTranscriptPath(readClaudeSessionRecord(internalName));
    if (claudePath) return claudePath;
    if (/codex/i.test(String(sessionEntry?.foregroundProcess || ''))) {
        return resolveCodexTranscriptByCwd(sessionEntry?.cwd || null);
    }
    return null;
}

// Restore patience must scale with the conversation being resumed. The
// machinery gave every session the same 90s: right for a 50MB transcript,
// hopeless for a 1GB one — claude spends minutes just LOADING it, the
// verifier declares 'never started', the answer window closes, and the
// session lands on a shell (or parks at an unanswered resume menu). Both
// were observed on the 2026-08-05 cycle. Budget: a base plus ~1s per 10MB,
// capped — a 1GB transcript gets ~8 minutes to come up.
function restorePatienceMs(entry) {
    let bytes = 0;
    try {
        const tPath = resolveClaudeTranscriptPath(readClaudeSessionRecord(entry.internalName));
        if (tPath) bytes = fs.statSync(tPath).size;
    } catch (e) { /* no transcript — base patience */ }
    const scaled = 90_000 + Math.floor(bytes / 10_000_000) * 1000;
    return Math.min(8 * 60_000, scaled);
}

// Rebuild a restorable claude command from a recorded argv string (the hook's
// launchCmd): strip --resume/--continue and POSITIONAL arguments (an initial
// prompt must not be re-sent into the resumed conversation); keep flags and
// the values of known value-taking flags. Returns null if it isn't a claude
// invocation or was a headless (-p) run.
const CLAUDE_VALUE_FLAGS = new Set([
    '--model', '--permission-mode', '--allowedtools', '--allowed-tools',
    '--disallowedtools', '--disallowed-tools', '--add-dir',
    '--append-system-prompt', '--settings', '--mcp-config', '--agents',
    '--effort', '--betas', '--session-id'
]);
// The conversation a `--fork-session` launch forked FROM.
//
// Only meaningful together with --fork-session: in a plain `--resume <id>` the
// id names the conversation itself, which is not a parent to fall back to.
function forkParentSessionId(launchCmd) {
    const raw = typeof launchCmd === 'string' ? launchCmd : '';
    if (!/(?:^|\s)--fork-session(?:\s|=|$)/.test(raw)) return null;
    const m = raw.match(/(?:^|\s)(?:--resume(?:=|\s+)|-r\s+)([A-Za-z0-9-]{8,})/);
    return m ? m[1] : null;
}

/**
 * Drop `--fork-session` from a rebuilt launch command.
 *
 * Forking is a one-time act, not a standing property of the session: the
 * recorded id IS the forked conversation. Resuming it with the flag still
 * attached forks AGAIN and mints yet another id, so every restore orphans the
 * previous fork and any fork killed before its first turn loses its whole tail
 * (2026-09-01: Accessibility-fork's id churned on each restore, and a host
 * restart left the newest id with no transcript at all).
 */
function stripForkSessionFlag(command) {
    return String(command || '')
        .replace(/(?:^|\s)--fork-session(?=\s|$)/g, ' ')
        .replace(/\s{2,}/g, ' ')
        .trim();
}

function rebuildClaudeLaunch(launchCmd) {
    const raw = typeof launchCmd === 'string' ? launchCmd.trim() : '';
    if (!raw) return null;
    const tokens = raw.split(/\s+/);
    const name = (w) => ((w || '').split('/').pop() || '');
    const out = [];
    let i = 0;
    if (/^claude[\w.-]*$/.test(name(tokens[0]))) { out.push(tokens[0]); i = 1; }
    else if (name(tokens[0]) === 'node' && /claude/i.test(tokens[1] || '')) { out.push(tokens[0], tokens[1]); i = 2; }
    else return null;
    for (; i < tokens.length; i++) {
        const t = tokens[i];
        if (t === '--resume' || t === '-r' || t === '--continue' || t === '-c') {
            if ((t === '--resume' || t === '-r') && tokens[i + 1] && !tokens[i + 1].startsWith('-')) i++;
            continue;
        }
        if (t === '-p' || t === '--print') return null; // headless run — not restorable
        if (t.startsWith('-')) {
            // Dedupe valueless flags. The hook records the argv claude ACTUALLY
            // ran with, which already includes the flags the previous restore
            // added — so each restore appended another copy and commands grew
            // `--dangerously-skip-permissions` five times over a few cycles.
            const valued = !t.includes('=') && CLAUDE_VALUE_FLAGS.has(t.toLowerCase())
                && tokens[i + 1] !== undefined && !tokens[i + 1].startsWith('-');
            if (!valued && out.includes(t)) continue;
            out.push(t);
            if (valued) out.push(tokens[++i]);
        }
        // bare positional (initial prompt) — dropped
    }
    return out.join(' ');
}

// Compute how to relaunch a session: the command to run (if any) and the cwd to
// start the shell in. For a claude session we use the cwd recorded by the hook
// (where claude started), since `claude --resume` resolves the conversation from
// that project directory.
function restorePlanForSession(entry) {
    let rec = readClaudeSessionRecord(entry.internalName);
    // No SessionStart record, but the turn counter may still name this room's
    // conversation (the two are written independently). Recover a record from
    // it when the transcript is real — otherwise this room would drop to a
    // bare shell over a live conversation (the mybot case). The recovered
    // record's cwd is the room's own directory, never a transcript-store path.
    if (!rec) {
        const storePath = (c) => /[\\/]\.claude[^\\/]*[\\/]projects([\\/]|$)/.test(String(c || ''));
        const metaCwd = readClaudeSessionMeta(entry.internalName)?.cwd;
        const safeCwd = (metaCwd && !storePath(metaCwd) ? metaCwd : null)
            || (entry.cwd && !storePath(entry.cwd) ? entry.cwd : null) || metaCwd || entry.cwd;
        const recovered = recoverRecordFromTurn(entry.internalName, safeCwd);
        if (recovered) rec = recovered;
    }
    // Wrong-conversation guard. The SessionStart hook records whichever claude
    // starts inside a room, and its nested-claude check keys on
    // CLAUDE_CODE_SESSION_ID — which hop deliberately SCRUBS when it spawns
    // shells. So a side claude launched inside a session (an MCP/agent
    // workspace, a tool-run headless claude) records itself as that room's
    // conversation, in ITS directory. Restoring then resurrects the wrong
    // conversation in the wrong tree, and the room appears to have "become"
    // a different session (observed: a ~/Code/nebula-slides room came back in
    // the slides tool's agent-home workspace).
    //
    // The room's own last-known live directory (persisted to the durable meta
    // from the host, which cannot be fooled by a nested process) is the
    // arbiter: when the record disagrees with it, the record is not this
    // room's primary conversation. Reopen a plain shell in the RIGHT place
    // rather than resume the wrong history.
    // The transcript store is never a workspace (same rule as the hook and
    // fork): a meta cwd inside ~/.claude*/projects/* means the room's shell
    // was left standing in the transcript dir at some point (the
    // Accessibility-fork incident): a poisoned arbiter. Trusting it made
    // this guard fire against a CORRECT record and drop the room to a plain
    // shell in the transcript dir, which is how the fork came back as 'zsh
    // in ~/.claude/projects/-Users-jianzhou' with its conversation gone.
    const storePath = (c) => /[\\/]\.claude[^\\/]*[\\/]projects([\\/]|$)/.test(String(c || ''));
    const metaCwd = readClaudeSessionMeta(entry.internalName)?.cwd;
    const liveCwd = (metaCwd && !storePath(metaCwd) ? metaCwd : null)
        || (entry.cwd && !storePath(entry.cwd) ? entry.cwd : null)
        || (rec?.cwd && !storePath(rec.cwd) ? rec.cwd : null)
        || metaCwd || entry.cwd;
    if (rec && rec.sessionId && liveCwd && rec.cwd && rec.cwd !== liveCwd) {
        // Disagreement is not proof. The record's cwd is whatever claude
        // reported at its LAST SessionStart, and a compaction reports the
        // conversation's current shell directory - so a claude launched in
        // ~ whose Bash tool cd'd into ~/Code/x records ~/Code/x, while the
        // room (correctly) still lives in ~. Calling that "another claude"
        // discarded a 975-turn conversation (angler, 2026-08-21). The store
        // settles it: if this id's transcript is filed under the ROOM's
        // directory, the conversation was launched here and is this room's.
        // Heal the record so nothing downstream (fork, search, the next
        // restore) re-litigates it, and resume from where it truly lives.
        if (claudeTranscriptLivesUnder(rec, liveCwd)) {
            rec = { ...rec, cwd: liveCwd, healedFrom: rec.cwd };
            writeClaudeSessionRecord(entry.internalName, rec); // best effort; the plan below no longer depends on it
        }
    }
    if (rec && rec.sessionId && liveCwd && rec.cwd && rec.cwd !== liveCwd) {
        // The incumbent record disagrees with the room's real directory. The
        // hook parks a rival record at <session>.other.json when it refuses
        // to clobber; if THAT one matches the room, it is the session's true
        // conversation and the incumbent was the intruder (a helper claude
        // that got there first). Promote it rather than dropping to a shell.
        const rival = readClaudeSessionRecordOther(entry.internalName);
        if (rival && rival.sessionId && rival.cwd === liveCwd) {
            writeClaudeSessionRecord(entry.internalName, rival);
            removeClaudeSessionRecordOther(entry.internalName);
            return restorePlanForSession(entry);
        }
        return {
            command: null,
            cwd: liveCwd,
            warning: `recorded conversation started in ${rec.cwd} but this session's last directory was ${liveCwd} — that record belongs to another claude; opening a plain shell here instead`
        };
    }
    // Set only when the fork recovery below fires, so the rebuilt command keeps
    // its --fork-session: we are resuming the PARENT and must not write into
    // the parent's conversation.
    let reforkFromParent = false;
    if (rec && rec.sessionId && !claudeTranscriptExists(rec)) {
        // A fork whose own transcript never landed is not a lost session.
        // `--fork-session` mints a new conversation id at launch and claude
        // only writes that transcript once a turn completes, so a fork killed
        // before its first turn — a host restart, a crash — always leaves a
        // recorded id with nothing behind it. The conversation it forked from
        // is still on disk, and re-forking reproduces exactly what the
        // recorded command produced the first time. Dropping to a plain shell
        // here threw away the parent history too, which is the part that
        // mattered (2026-09-01: Accessibility-fork came back as a bare shell,
        // stranding a 2.3MB parent conversation).
        const parentId = forkParentSessionId(rec.launchCmd);
        if (parentId && parentId !== rec.sessionId
            && claudeTranscriptExists({ ...rec, sessionId: parentId })) {
            rec = { ...rec, sessionId: parentId, reforkedFrom: rec.sessionId };
            reforkFromParent = true;
        } else {
            return {
                command: null,
                cwd: rec.cwd || entry.cwd,
                warning: `recorded claude conversation ${String(rec.sessionId).slice(0, 8)}… has no transcript on this host — opening a plain shell instead`
            };
        }
    }
    if (rec && rec.sessionId) {
        // Preserve the original launch command's FLAGS (--dangerously-skip-
        // permissions etc.) and wrapper (claude-fable): rebuild from the
        // recorded startup when it's a claude invocation, swapping in the
        // current conversation id. A bare `claude --resume` would silently
        // restore every session with permission prompts re-enabled.
        const startup = typeof entry.startup === 'string' ? entry.startup.trim() : '';
        const firstWord = startup.split(/\s+/)[0] || '';
        let isClaudeLaunch = /(^|\/)claude[\w-]*$/.test(firstWord);
        let base = 'claude';
        if (isClaudeLaunch) {
            base = startup
                .replace(/\s--resume(=|\s+)[A-Za-z0-9-]+/g, '')
                .replace(/\s--continue\b/g, '')
                .trim();
        }
        // Highest fidelity: the argv the previous claude ACTUALLY ran with,
        // recorded by the hook. Alias expansion already happened there, so
        // flags a user bakes into a shell alias survive — a rebuilt command
        // never re-expands aliases (and any env prefix would defeat them).
        const fromArgv = rebuildClaudeLaunch(rec.launchCmd);
        if (fromArgv) {
            base = fromArgv;
            isClaudeLaunch = true;
        }
        // The fork already happened; this id is its result. Only a deliberate
        // re-fork of a parent (above) still needs the flag.
        if (!reforkFromParent) base = stripForkSessionFlag(base);
        // Config-dir prefix: needed for a bare `claude` against a wrapper
        // config; a wrapper command (claude-fable) sets it itself. A null
        // configDir means the DEFAULT root — pin that explicitly too
        // (env -u), because the room shell may have inherited a different
        // CLAUDE_CONFIG_DIR from whatever session (re)started hop, which
        // sent resumes to the wrong root ("No conversation found").
        const configDir = typeof rec.configDir === 'string' && rec.configDir.trim() ? rec.configDir.trim() : null;
        // Pin the config root for plain claude (any path/argv form); named
        // wrappers (claude-fable) set their own root themselves.
        const baseName = ((base.split(/\s+/)[0] || 'claude').split('/').pop() || 'claude');
        const bareClaude = baseName === 'claude' || baseName === 'node';
        const prefix = !bareClaude ? ''
            : configDir ? `CLAUDE_CONFIG_DIR='${configDir.replace(/'/g, `'\\''`)}' `
            : 'env -u CLAUDE_CONFIG_DIR ';
        return { command: `${prefix}${base} --resume ${rec.sessionId}`, cwd: rec.cwd || entry.cwd };
    }
    if (entry.startup && entry.autoStart !== false) {
        return { command: String(entry.startup), cwd: entry.cwd };
    }
    return { command: null, cwd: entry.cwd }; // plain shell — just reopen in its cwd
}

async function restoreSavedSessions(opts = {}) {
    // A dry run only reads; everything else rebuilds the fleet and must not
    // overlap a daemon/host restart (that race cost 17 live sessions).
    if (opts.dryRun) return restoreSavedSessionsUnlocked(opts);
    return withLifecycleLock('restore', () => restoreSavedSessionsUnlocked(opts), {
        onWait: (op) => log(`Waiting for ${op} to finish before restoring…`, YELLOW)
    });
}

// ---- restore reconciler ---------------------------------------------------
// A single restore fires once and reports success the moment it sees claude
// paint a frame. That is not the same as "correctly restored": a resumed
// claude can exit seconds later (a loop that completes), a trust/resume
// dialog can go unanswered, or a session can land on a bare shell in a race
// - and nothing re-drives it. This reconciler closes that gap. After a
// restore, it records what each session SHOULD become, then a bounded,
// windowed sweep keeps checking until every session is verified running its
// expected claude - re-driving the unambiguous failures and escalating the
// rest to a human, rather than depending on someone re-running restore.
const RESTORE_RECONCILE_FILE = path.join(HOME_DIR, '.restore-reconcile.json');
// Active only for a window after a restore, so it converges a freshly
// restarted fleet without ever fighting normal use later.
const RECONCILE_WINDOW_MS = 15 * 60 * 1000;
// Re-drives per session before we stop and ask a human. A session that
// needs more than this is not failing to LAUNCH - it is exiting on its own
// (a self-completing loop), which resurrection cannot fix.
const RECONCILE_MAX_REDRIVES = 3;
// Leave a just-driven session alone long enough to boot claude and paint.
const RECONCILE_SETTLE_MS = 45 * 1000;

function readRestoreReconcile() {
    try {
        const parsed = JSON.parse(fs.readFileSync(RESTORE_RECONCILE_FILE, 'utf8'));
        return parsed && typeof parsed === 'object' && parsed.sessions ? parsed : { sessions: {} };
    } catch (e) { return { sessions: {} }; }
}
function writeRestoreReconcile(state) {
    try { writePrivateFile(RESTORE_RECONCILE_FILE, JSON.stringify(state), 0o600); } catch (e) { /* best effort */ }
}
// Record post-restore expectations for the sessions that were planned to run
// a claude conversation. Plain-shell restores are excluded: a shell IS its
// converged state, so there is nothing to verify or re-drive.
function recordRestoreExpectations(planned) {
    const now = Date.now();
    const state = readRestoreReconcile();
    for (const p of planned || []) {
        if (!p || !p.internalName || !p.command) continue; // no claude command → nothing to converge
        state.sessions[p.internalName] = {
            internalName: p.internalName,
            displayName: p.displayName || p.internalName,
            sessionId: (/--resume\s+([A-Za-z0-9-]+)/.exec(p.command) || [])[1] || null,
            command: p.command,
            cwd: p.cwd,
            expectClaude: true,
            recordedAt: now,
            deadline: now + RECONCILE_WINDOW_MS,
            redrives: 0,
            lastDriveAt: 0,
            status: 'pending'
        };
    }
    writeRestoreReconcile(state);
}
// One reconcile pass. Shares the resume-sweep cadence. For each pending
// expectation: converged (claude up) → drop; a dialog → let the resume
// sweep / a re-drive handle it; a bare shell → re-drive (bounded); a busy
// non-shell → the user is doing something, leave it; past deadline or out
// of re-drives → escalate ('needs-attention') and stop.
// The screen and the pty foreground process are BOTH unreliable signals for
// "is this session's claude alive": an argv-launched claude runs in a
// non-job-control subshell, so node-pty reports the WRAPPER shell (zsh), and
// the grid preview can read empty for a settled, idle claude. The process
// table is the ground truth. A claude resumed a specific conversation runs
// with `--resume <sessionId>` in its argv; if such a process is alive, the
// session is up — no matter what the screen or foreground name say. This is
// what stops the reconciler from nagging (or, guarded elsewhere, re-driving)
// a claude that has been running fine for an hour (angler, lightscope).
let claudeProcListCache = { at: 0, text: '' };
function claudeProcessRunning(sessionId) {
    if (!sessionId) return false;
    const now = Date.now();
    if (now - claudeProcListCache.at > 3000) {
        try {
            // One cheap snapshot of every claude argv, cached for a few
            // seconds so a whole sweep costs one ps, not one per session.
            claudeProcListCache = { at: now, text: execFileSync('ps', ['-axo', 'command'], { encoding: 'utf8', timeout: 4000 }) };
        } catch (e) { claudeProcListCache = { at: now, text: '' }; }
    }
    const lines = claudeProcListCache.text.split('\n');
    const idInResume = new RegExp(`--resume(=|\\s+)${sessionId.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`);
    for (const line of lines) {
        if (!/(^|\/|\s)claude[\w.-]*(\s|$)/.test(line)) continue; // an actual claude process
        if (/\bps\b.*-axo|grep\b/.test(line)) continue;           // not our own probe
        if (idInResume.test(line)) return true;
    }
    return false;
}

let restoreReconcileBusy = false;
async function sweepRestoreReconcile() {
    if (shuttingDown || restoreReconcileBusy) return;
    const state = readRestoreReconcile();
    const names = Object.keys(state.sessions || {});
    if (!names.length) return;
    restoreReconcileBusy = true;
    try {
        const now = Date.now();
        let snapshot;
        try { snapshot = await listAllSessionEntriesRuntimeFirst(); }
        catch (e) { return; }
        const byName = new Map((snapshot.entries || []).map((e) => [e.internalName, e]));
        let changed = false;
        for (const name of names) {
            const exp = state.sessions[name];
            if (!exp || exp.status === 'needs-attention' || exp.status === 'converged') continue;
            const entry = byName.get(name);
            // Gone from the fleet entirely (deleted/killed): stop tracking.
            if (!entry) { delete state.sessions[name]; changed = true; continue; }
            let text = '';
            try {
                const grid = await getRoomGridPreviewShared(name);
                text = String(grid?.text || '');
            } catch (e) { continue; } // host busy — retry next tick
            // Ground truth first: is THIS conversation's claude process alive?
            // The screen and foreground name lie for argv-launched sessions.
            const procUp = claudeProcessRunning(exp.sessionId);
            const running = !isShellProcName(entry.foregroundProcess);
            const claudeUp = procUp || running || CLAUDE_UI_RE.test(text);
            if (claudeUp) {
                exp.status = 'converged';
                exp.convergedAt = now;
                changed = true;
                log(`[reconcile] ${exp.displayName}: verified running`, DIM);
                continue;
            }
            // A dialog: the resume sweep answers resume prompts already; the
            // trust dialog we answer here (only for this session's own cwd).
            if (TRUST_PROMPT_RE.test(text)) {
                const asked = trustDialogWorkspace(text);
                if (asked && samePath(asked, exp.cwd)) {
                    try {
                        const e2 = await attachTerminalApiClient(name, exp.displayName, { actor: 'system', label: 'reconcile' });
                        try { sendTerminalInput(e2, '1\r'); } finally { try { closeTerminalApiEntry(e2.id); } catch (e) {} }
                        log(`[reconcile] ${exp.displayName}: accepted workspace trust`, DIM);
                    } catch (e) { /* try again next tick */ }
                    continue;
                }
                // Trust dialog for some OTHER directory — not ours to answer.
                exp.status = 'needs-attention';
                exp.reason = `claude is asking to trust ${asked || 'a directory'}, not ${exp.cwd}`;
                changed = true;
                continue;
            }
            if (RESUME_PROMPT_RE.test(text)) continue; // resume sweep owns this
            // A busy non-shell foreground we did not recognise as claude: the
            // user is running something. Consider it converged-enough and stop.
            if (running) { exp.status = 'converged'; changed = true; continue; }
            // Bare shell: the failure we exist to fix. Re-drive, bounded.
            if (now - exp.lastDriveAt < RECONCILE_SETTLE_MS) continue; // give the last drive time
            if (now >= exp.deadline || exp.redrives >= RECONCILE_MAX_REDRIVES) {
                exp.status = 'needs-attention';
                exp.reason = exp.redrives >= RECONCILE_MAX_REDRIVES
                    ? `came up then exited ${exp.redrives}x — likely a self-completing session, resume it yourself if you want it running`
                    : 'never came up as claude within the restore window';
                changed = true;
                log(`[reconcile] ${exp.displayName}: needs attention — ${exp.reason}`, YELLOW);
                continue;
            }
            // Only re-drive an IDLE shell prompt (never type over a booting
            // screen): reuse the same positive-prompt check restore uses.
            const cleaned = stripTerminalNoise(text);
            const lines = cleaned.split('\n').map((l) => l.trimEnd()).filter((l) => l.trim() !== '');
            const last = lines.length ? lines[lines.length - 1] : '';
            if (!/[%$#\u276f>]\s*$/.test(last)) continue; // not an idle prompt yet
            try {
                const e2 = await attachTerminalApiClient(name, exp.displayName, { actor: 'system', label: 'reconcile' });
                const cmd = exp.command.endsWith('\n') ? exp.command : `${exp.command}\n`;
                try { sendTerminalInput(e2, cmd); } finally { try { closeTerminalApiEntry(e2.id); } catch (e) {} }
                exp.redrives += 1;
                exp.lastDriveAt = now;
                changed = true;
                log(`[reconcile] ${exp.displayName}: re-driving restore (attempt ${exp.redrives}/${RECONCILE_MAX_REDRIVES})`, CYAN);
            } catch (e) { /* next tick */ }
        }
        // Retire the whole file once nothing is pending and the window has
        // passed, so the sweep goes quiet during normal use.
        const stillPending = Object.values(state.sessions).some((e) => e.status === 'pending');
        const anyRecent = Object.values(state.sessions).some((e) => now - e.recordedAt < RECONCILE_WINDOW_MS);
        if (!stillPending && !anyRecent) {
            // Keep only needs-attention entries (for reporting); drop the rest.
            for (const [k, v] of Object.entries(state.sessions)) {
