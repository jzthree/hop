// First run only: offer to add a password on top of TOTP. `hop client` forces
// this during setup; the default self-host path should at least offer it once.
// Never prompts in daemon mode or non-interactive (agent) runs.
async function maybeOfferFirstRunPassword() {
    if (isPasswordEnabled()) return;
    if (!process.stdin.isTTY || !process.stdout.isTTY) return;

    const config = getHopConfig();
    if (config.password_offer_shown) return;
    // Record the offer up front so a declined (or interrupted) prompt is
    // never repeated on later startups.
    config.password_offer_shown = true;
    saveHopConfig(config);

    log(`\nYour tunnel URL will be protected by an authenticator (TOTP) code only.`, YELLOW);
    log(`A password adds a second factor for remote access.`, RESET);

    const readline = require('readline');
    const stream = require('stream');

    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    const answer = await new Promise((resolve) => {
        rl.question(`Set a password for remote access? [y/N] `, resolve);
    });
    rl.close();

    if (!/^y(es)?$/i.test(String(answer || '').trim())) {
        log(`Skipped. You can add one anytime with ${CYAN}hop password set${RESET}.`, RESET);
        return;
    }

    // Muted readline for password input (same flow as `hop password set`)
    const askPassword = (prompt) => new Promise((resolve) => {
        const mutedRl = readline.createInterface({
            input: process.stdin,
            output: new stream.Writable({
                write: (chunk, encoding, callback) => callback()
            }),
            terminal: true
        });
        process.stdout.write(prompt);
        mutedRl.question('', (value) => {
            mutedRl.close();
            process.stdout.write('\n');
            resolve(value);
        });
    });

    const password = await askPassword('Set a password: ');
    if (password.length < 4) {
        log(`Password too short (min 4 characters). Run ${CYAN}hop password set${RESET} to set one later.`, RED);
        return;
    }
    const confirm = await askPassword('Confirm password: ');
    if (password !== confirm) {
        log(`Passwords do not match. Run ${CYAN}hop password set${RESET} to set one later.`, RED);
        return;
    }
    setPassword(password);
    log(`${GREEN}✓ Password set.${RESET}`, GREEN);
}

function startDaemon() {
    const node = process.execPath;
    const script = __filename;
    // Capture the daemon's stdout/stderr to a log file instead of discarding it,
    // so tunnel restarts, health failures, and crashes leave a forensic trail.
    const logFd = rotateAndOpenLogFd(path.join(LOG_DIR, 'hop-daemon.log'));
    const child = spawn(node, [script, '--daemon'], {
        detached: true,
        stdio: ['ignore', logFd, logFd],
        env: process.env
    });
    child.unref();
    try { fs.closeSync(logFd); } catch (e) { } // child keeps its own dup
}

function waitForDaemonReady(timeoutMs = 20000) {
    return new Promise((resolve) => {
        const start = Date.now();
        // The daemon logs its startup steps ([2/4], [3/4]) into hop-daemon.log,
        // which the user can't see. Surface each step here as it happens so the
        // foreground wait isn't a long silent gap after [1/4]. The log is
        // append-only, so only scan lines written after this wait began (old
        // runs left the same markers behind).
        const daemonLogPath = path.join(LOG_DIR, 'hop-daemon.log');
        let logScanOffset = 0;
        try { logScanOffset = fs.statSync(daemonLogPath).size; } catch (e) { }
        const stepMarkers = [
            { marker: '[2/4]', message: `[2/4] Starting session manager...` },
            { marker: '[3/4]', message: `[3/4] Opening Cloudflare tunnel...` }
        ];
        const seenSteps = new Set();
        const reportDaemonProgress = () => {
            if (seenSteps.size === stepMarkers.length) return;
            let logText;
            try {
                logText = fs.readFileSync(daemonLogPath).slice(logScanOffset).toString('utf8');
            } catch (e) {
                return;
            }
            for (const step of stepMarkers) {
                if (!seenSteps.has(step.marker) && logText.includes(step.marker)) {
                    seenSteps.add(step.marker);
                    log(step.message, BOLD);
                }
            }
        };
        const check = () => {
            reportDaemonProgress();
            const state = isServerRunning();
            // State file now written early, so also check that URL is populated
            if (state && state.url) return resolve(state);
            if (Date.now() - start > timeoutMs) {
                log(`Timed out waiting for the hop daemon to start.`, RED);
                const daemonLogPath = path.join(LOG_DIR, 'hop-daemon.log');
                try {
                    const tail = fs.readFileSync(daemonLogPath, 'utf8').trimEnd().split('\n').slice(-10);
                    if (tail.length && tail[0] !== '') {
                        log(`Last ${tail.length} line(s) of ${daemonLogPath}:`, YELLOW);
                        tail.forEach((line) => log(`  ${line}`, RESET));
                    }
                } catch (e) { }
                log(`See ${CYAN}hop logs${RESET} for the full daemon log.`, RESET);
                process.exit(1);
            }
            setTimeout(check, 250);
        };
        check();
    });
}

async function startLocalSession(proxyServer, tunnelProc, publicUrl) {
    log(`[4/4] Attaching to session...`, BOLD);

    // Reuse an actively attached user-facing session (typically remote login),
    // otherwise create a fresh local session for this CLI invocation.
    const existingSessions = listActiveSessions();
    const preferredExistingSession = existingSessions.find((session) => {
        if (!session?.attached) return false;
        const config = getEffectiveSessionConfig(session.name);
        if (config?.type === 'port') return false;
        return config?.createdBy !== 'agent';
    });
    let displayName;
    let defaultSessionName;

    let sessionCwd;
    if (preferredExistingSession) {
        defaultSessionName = preferredExistingSession.name;
        displayName = getSessionDisplayName(defaultSessionName);
        log(`Connecting to existing session: ${displayName}`, RESET);
    } else {
        // Create new session - find next available name
        const cwdName = path.basename(process.cwd()).replace(/[^a-zA-Z0-9_-]/g, '-');
        const existingInternalNames = new Set(Object.keys(sessionStore.sessions));
        const existingDisplayNames = new Set(
            Object.entries(sessionStore.sessions).map(([name, config]) => config?.displayName || toDisplaySessionName(name))
        );
        existingSessions.forEach((s) => {
            existingInternalNames.add(s.name);
            existingDisplayNames.add(getSessionDisplayName(s.name));
        });
        let counter = 1;
        displayName = `${cwdName}-${counter}`;
        defaultSessionName = toInternalSessionName(displayName);
        while (
            !defaultSessionName ||
            existingInternalNames.has(defaultSessionName) ||
            existingDisplayNames.has(displayName)
        ) {
            counter++;
            displayName = `${cwdName}-${counter}`;
            defaultSessionName = toInternalSessionName(displayName);
        }
        log(`Starting session: ${displayName}`, RESET);
        sessionCwd = process.cwd();
        getOrCreateSession(defaultSessionName, sessionCwd);
    }

    const cleanup = () => {
        if (shuttingDown) return;
        shuttingDown = true;  // Prevent tunnel auto-restart
        log(`Cleaning up...`, YELLOW);

        // Remove the state file only if it is OURS: a stale daemon exiting
        // after a newer one registered must not wipe the live registration
        // (that orphans the new daemon — "Hop is not running" while it runs).
        if (fs.existsSync(STATE_FILE)) {
            try {
                const st = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));
                if (!st || !Number.isInteger(st.pid) || st.pid === process.pid) fs.unlinkSync(STATE_FILE);
            } catch (e) {
                try { fs.unlinkSync(STATE_FILE); } catch (e2) { }
            }
        }

        // Remove session config for this local session in embedded mode.
        // External backend keeps terminal definitions persistent across hop restarts.
        if (!isExternalTerminalBackend()) {
            try {
                const config = getSessionConfig(defaultSessionName);
                if (config && config.type !== 'port') {
                    deleteSessionConfig(defaultSessionName);
                }
            } catch (e) { }
        }

        // Close all in-process rooms (external backend persists independently)
        if (!isExternalTerminalBackend()) {
            hayRooms.closeAll();
        }
        closeAllSessionAuditSinks();

        // Kill cloudflared tunnel (use currentTunnelProc in case it was restarted)
        try { (currentTunnelProc || tunnelProc).kill('SIGTERM'); } catch (e) { }

        // Close proxy server
        try { proxyServer.close(); } catch (e) { }

        log(`Goodbye!`, GREEN);
        process.exit(0);
    };

    const runLocalSessionLoop = () => {
        return new Promise((resolve) => {
            // Ensure session exists on server
            getOrCreateSession(defaultSessionName, sessionCwd);
            runHayCliAttach({
                internalName: defaultSessionName,
                displayName,
                cwd: sessionCwd
            }, publicUrl || '').then(resolve).catch((err) => {
                log(`Failed to start hay CLI: ${err.message}`, RED);
                resolve(1);
            });
        });
    };

    printDetachHint();
    runLocalSessionLoop().then((code) => {
        // Ctrl+G (detach) exits hay CLI with code 10; keep tunnel alive.
        if (code === 10) {
            log(`\nDetached from local session. Tunnel is still running.`, YELLOW);
            log(`Press Ctrl+C to shut down.`, RESET);
            return;
        }
        log(`\nLocal session ended. Shutting down tunnel...`, YELLOW);
        cleanup();
    });

    process.on('SIGINT', cleanup);
    process.on('SIGTERM', cleanup);
    process.on('exit', cleanup);
}

async function attachToExistingTunnel(existingTunnel, opts = {}) {
    const forceNew = opts.forceNew === true;
    log(`Hop tunnel is already running!`, GREEN);
    log(`URL: ${existingTunnel.url}`, BOLD);

    await ensureExternalHayHostReady();
    await ensureNamingTheme();
    const cwdName = getCwdSessionBaseName();
    const cwdPath = process.cwd();

    let selection = null;
    // The daemon hands out a session for this terminal atomically (so two
    // terminals opened at once don't grab the same one). `hop new` skips that and
    // always creates a fresh session.
    if (!forceNew) {
        try {
            selection = await claimLocalCliSession(existingTunnel, cwdPath, cwdName);
        } catch (e) {
            if (e?.status && e.status !== 404) {
                // Non-fatal: we just pick a session ourselves below. A bare
                // "status 200" (no error body) usually means the running daemon
                // is an older build than this CLI and lacks this endpoint.
                log(`Note: the daemon didn't reserve a session for this terminal (${e.message}); choosing one locally instead.`, YELLOW);
                log(`If this keeps happening, the daemon may be older than this CLI — restart it with ${CYAN}hop stop && hop start${RESET} (your sessions keep running).`, DIM);
            }
        }
    }

    if (!selection) {
        let sessionsRes = { sessions: [] };
        try {
            sessionsRes = await fetchSessionList(existingTunnel);
        } catch (e) {
            log(`Note: Could not query daemon sessions (${e.message}). Defaulting to create-new.`, YELLOW);
        }
        const sessions = Array.isArray(sessionsRes.sessions) ? sessionsRes.sessions : [];
        selection = await chooseUnnamedSessionTarget(sessions, { cwdPath, cwdName, forceNew });
    }
    const target = selection.target;

    if (selection.createdNew) {
        log(`Creating new session: ${target.displayName}...`, RESET);
        if (!target.localCliClaimId) {
            try {
                const created = await callLocalApi(existingTunnel, '/api/sessions', 'POST', {
                    name: target.displayName,
                    cwd: cwdPath
                });
                if (created.status < 200 || created.status >= 300 || !(created.data?.ok || created.data?.success)) {
                    const errText = typeof created.data === 'string'
                        ? created.data
                        : (created.data?.error || `status ${created.status}`);
                    throw new Error(errText);
                }
            } catch (e) {
                log(`Note: Could not register session with daemon metadata: ${e.message}`, YELLOW);
                log(`Continuing with local attach.`, RESET);
            }
        }
    } else {
        log(`Attaching to existing session: ${target.displayName}`, RESET);
        log(`(Run ${CYAN}hop new${RESET} to start a fresh session here instead.)`, DIM);
    }

    printDetachHint();
    const code = await runHayCliAttach(target, existingTunnel.url || '');
    if (code === 10) {
        log(`\nDetached from local session.`, YELLOW);
        process.exit(0);
    }
    log(`\nSession disconnected.`, YELLOW);
    process.exit(code || 0);
}

async function fetchSessionList(existingTunnel) {
    const sessionsRes = await new Promise((resolve, reject) => {
        const opts = {
            hostname: '127.0.0.1',
            port: existingTunnel.port,
            path: '/api/sessions',
            method: 'GET',
            headers: { 'Authorization': `Bearer ${existingTunnel.sessionSecret}` }
        };
        http.get(opts, res => {
            let data = '';
            res.on('data', c => data += c);
            res.on('end', () => {
                try {
                    resolve(JSON.parse(data));
                } catch (e) {
                    reject(new Error('Failed to parse sessions response'));
                }
            });
        }).on('error', reject);
    });
    return sessionsRes || {};
}

async function claimLocalCliSession(existingTunnel, cwdPath, cwdName) {
    const claimed = await callLocalApi(existingTunnel, '/api/sessions/claim-local-cli', 'POST', {
        cwd: cwdPath,
        cwdName
    });
    if (claimed.status < 200 || claimed.status >= 300 || claimed.data?.ok !== true || !claimed.data?.target) {
        const err = new Error(claimed.data?.error || `status ${claimed.status}`);
        err.status = claimed.status;
        throw err;
    }
    return {
        target: claimed.data.target,
        createdNew: claimed.data.createdNew === true
    };
}

async function callLocalApi(existingTunnel, apiPath, method = 'GET', body = null) {
    return await new Promise((resolve, reject) => {
        const headers = { 'Authorization': `Bearer ${existingTunnel.sessionSecret}` };
        // The hop CLI run from inside a claude session (its Bash tool sets
        // CLAUDECODE) is acting as an agent: sessions it creates must land in
        // the agent bucket, not impersonate the human (Mybot/Stella confusion).
        if (process.env.CLAUDECODE === '1' || process.env.CLAUDE_CODE_SESSION_ID) {
            headers['X-Hop-Actor'] = 'agent';
        }
        let payload = null;
        if (body) {
            payload = JSON.stringify(body);
            headers['Content-Type'] = 'application/json';
        }
        const opts = {
            hostname: '127.0.0.1',
            port: existingTunnel.port,
            path: apiPath,
            method,
            headers,
            // No socket pooling: CLI flows can idle for tens of seconds
            // between calls (e.g. `hop ai tagline` waits on a model per
            // session), and the daemon closes keep-alive sockets after 5s.
            // Reusing one from the pool then fails with ECONNRESET/socket
            // hang up on a request that was never actually sent.
            agent: false
        };
        const req = http.request(opts, res => {
            let data = '';
            res.on('data', c => data += c);
            res.on('end', () => {
                try {
                    resolve({ status: res.statusCode, data: JSON.parse(data) });
                } catch (e) {
                    resolve({ status: res.statusCode, data });
                }
            });
        });
        req.on('error', reject);
        if (payload) {
            req.write(payload);
        }
        req.end();
    });
}

async function fetchExternalHayRuntimeRooms() {
    if (!isExternalTerminalBackend()) return null;
    const preferredHost = hayHostState || readHayHostStateFile();
    const inspectedHosts = (await inspectExternalHayHosts())
        .filter((entry) => hostBelongsToCurrentHome(entry, preferredHost));
    if (inspectedHosts.length === 0) {
        return null;
    }

    const canonicalHost = choosePreferredHayHost(inspectedHosts, preferredHost);
    if (canonicalHost) {
        writeHayHostStateFile(canonicalHost);
    }

    const roomsById = new Map();
    for (const entry of inspectedHosts) {
        const rooms = Array.isArray(entry.rooms) ? entry.rooms : [];
        for (const room of rooms) {
            const existing = roomsById.get(room.id);
            if (!existing) {
                roomsById.set(room.id, room);
                continue;
            }
            const existingClients = Number(existing.clientCount) || 0;
            const nextClients = Number(room.clientCount) || 0;
            const existingPreferred = canonicalHost && existing.hostPort === canonicalHost.port;
            const nextPreferred = canonicalHost && room.hostPort === canonicalHost.port;
            if (nextClients > existingClients || (!existingPreferred && nextPreferred)) {
                roomsById.set(room.id, room);
            }
        }
    }

    return Array.from(roomsById.values());
}

async function listLocalTerminalSelectionCandidates() {
    const metadataSessions = listAllSessionEntries()
        .filter((session) => session && session.type !== 'port' && typeof session.displayName === 'string');
    const runtimeRooms = await fetchExternalHayRuntimeRooms();
    if (!Array.isArray(runtimeRooms)) {
        return {
            sessions: [],
            runtimeSessionNames: new Set(),
            source: 'runtime-unavailable'
        };
    }

    const metadataByInternalName = new Map();
    for (const session of metadataSessions) {
        const internalName = String(
            session.internalName ||
            toInternalSessionName(session.displayName || '')
        ).trim();
        if (!internalName) continue;
        metadataByInternalName.set(internalName, session);
    }

    const runtimeSessions = runtimeRooms
        .map((room) => {
            const internalName = room.id;
            const metadata = metadataByInternalName.get(internalName);
            const config = getEffectiveSessionConfig(internalName);
            const displayName = metadata?.displayName || config?.displayName || internalName;
            const localCliCount = Math.max(Number(room.localCliCount) || 0, Number(metadata?.localCliCount) || 0);
            return {
                type: 'terminal',
                internalName,
                displayName,
                cwd: room.cwd || metadata?.cwd || config?.cwd,
                hostPort: room.hostPort,
                createdAt: metadata?.createdAt || config?.createdAt,
                hasLocalCli: room.hasLocalCli === true || metadata?.hasLocalCli === true || localCliCount > 0,
                localCliCount
            };
        })
        .filter((session) => !!session && typeof session.displayName === 'string' && session.displayName);

    for (const session of metadataSessions) {
        if (!session || session.type === 'port' || !session.internalName) continue;
        if (runtimeSessions.some((entry) => entry.internalName === session.internalName)) continue;
        runtimeSessions.push({
            type: 'terminal',
            internalName: session.internalName,
            displayName: session.displayName,
            cwd: session.cwd,
            hostPort: null,
            createdAt: session.createdAt,
            hasLocalCli: session.hasLocalCli === true,
            localCliCount: Number(session.localCliCount) || 0
        });
    }

    return {
        sessions: runtimeSessions,
        runtimeSessionNames: new Set(runtimeSessions.map((session) => session.internalName)),
        source: 'runtime'
    };
}

function pickSessionForDir(sessions, cwdName, opts = {}) {
    const prefix = `${cwdName}-`;
    const matches = sessions
        .filter(s => s.type !== 'port')
        .filter(s => s.displayName === cwdName || s.displayName.startsWith(prefix));
    if (matches.length === 0) return { target: null, totalMatches: 0 };
    const filtered = opts.requireNoLocalCli ? matches.filter(s => !s.hasLocalCli) : matches;
    if (filtered.length === 0) return { target: null, totalMatches: matches.length };
    const scored = filtered.map(s => {
        let score = Number.MAX_SAFE_INTEGER;
        if (s.displayName === cwdName) {
            score = 0;
        } else if (s.displayName.startsWith(prefix)) {
            const suffix = s.displayName.slice(prefix.length);
            const num = parseInt(suffix, 10);
            if (Number.isFinite(num)) score = num;
        }
        const createdAtMs = Date.parse(s.createdAt || '');
        return {
            session: s,
            score,
            createdAtMs: Number.isFinite(createdAtMs) ? createdAtMs : Number.MAX_SAFE_INTEGER
        };
    });
    scored.sort((a, b) => (
        a.score - b.score ||
        a.createdAtMs - b.createdAtMs ||
        a.session.displayName.localeCompare(b.session.displayName)
    ));
    return { target: scored[0].session, totalMatches: matches.length };
}

function pickBestExactCwdSession(sessions, cwdName, opts = {}) {
    const exactMatches = (Array.isArray(sessions) ? sessions : [])
        .filter((session) => session && session.type !== 'port' && typeof session.displayName === 'string');
    if (exactMatches.length === 0) return null;
    const filtered = opts.requireNoLocalCli ? exactMatches.filter((session) => !session.hasLocalCli) : exactMatches;
    if (filtered.length === 0) return null;
    const prefix = `${cwdName}-`;
    const scored = filtered.map((session) => {
        let score = 2;
        if (session.displayName === cwdName) {
            score = 0;
        } else if (session.displayName.startsWith(prefix)) {
            score = 1;
        }
        const createdAtMs = Date.parse(session.createdAt || '');
        return {
            session,
            score,
            createdAtMs: Number.isFinite(createdAtMs) ? createdAtMs : Number.MAX_SAFE_INTEGER
        };
    });
    scored.sort((a, b) => (
        a.createdAtMs - b.createdAtMs ||
        a.score - b.score ||
        a.session.displayName.localeCompare(b.session.displayName)
    ));
    return scored[0].session;
}

function getCwdSessionBaseName() {
    return path.basename(process.cwd()).replace(/[^a-zA-Z0-9_-]/g, '-');
}

function buildNextSessionIdentity(existingSessions, cwdName, opts = {}) {
    const sessionList = Array.isArray(existingSessions) ? existingSessions : [];
    const includeStoredSessions = opts.includeStoredSessions !== false;
    const existingInternalNames = new Set();
    const existingDisplayNames = new Set();

    if (includeStoredSessions) {
        for (const [name, config] of Object.entries(sessionStore.sessions)) {
            existingInternalNames.add(name);
            existingDisplayNames.add(config?.displayName || toDisplaySessionName(name));
        }
    }

    for (const session of sessionList) {
        if (!session || session.type === 'port') continue;
        if (typeof session.internalName === 'string' && session.internalName) {
            existingInternalNames.add(session.internalName);
        }
        const displayName = typeof session.displayName === 'string'
            ? session.displayName
            : (typeof session.name === 'string' ? session.name : '');
        if (displayName) {
            existingDisplayNames.add(displayName);
            const internalName = toInternalSessionName(displayName);
            if (internalName) existingInternalNames.add(internalName);
        }
    }

    // Use naming theme if configured, otherwise fall back to cwdName-counter
    const theme = getNamingTheme();
    if (theme) {
        const allUsed = new Set([...existingInternalNames, ...existingDisplayNames]);
        const displayName = generateSessionName(theme, allUsed);
        const internalName = toInternalSessionName(displayName) || displayName;
        return { internalName, displayName };
    }

    // Legacy fallback: cwdName-counter
    let counter = 1;
    let displayName = `${cwdName}-${counter}`;
    let internalName = toInternalSessionName(displayName);
    while (
        !internalName ||
        existingInternalNames.has(internalName) ||
        existingDisplayNames.has(displayName)
    ) {
        counter += 1;
        displayName = `${cwdName}-${counter}`;
        internalName = toInternalSessionName(displayName);
    }
    return { internalName, displayName };
}

function pickSessionForCwd(sessions, cwdPath, cwdName, opts = {}) {
    const terminalSessions = (Array.isArray(sessions) ? sessions : [])
        .filter((session) => session && session.type !== 'port' && typeof session.displayName === 'string');
    const exactCwdMatches = terminalSessions.filter((session) => (
        typeof session.cwd === 'string' && session.cwd === cwdPath
    ));
    if (exactCwdMatches.length > 0) {
        return pickBestExactCwdSession(exactCwdMatches, cwdName, opts);
    }
    return pickSessionForDir(terminalSessions, cwdName, opts).target;
}

function buildAttachTargetFromSession(session) {
    if (!session || typeof session !== 'object') return null;
    const fallbackDisplay = typeof session.displayName === 'string' ? session.displayName : '';
    const internalName = session.internalName || toInternalSessionName(fallbackDisplay);
    if (!internalName || !SESSION_NAME_RE.test(internalName)) return null;
    const displayName = fallbackDisplay || internalName;
    return {
        internalName,
        displayName,
        cwd: session.cwd,
        hostPort: session.hostPort
    };
}

async function chooseUnnamedSessionTarget(existingSessions, opts = {}) {
    const cwdPath = typeof opts.cwdPath === 'string' && opts.cwdPath.trim()
        ? opts.cwdPath
        : process.cwd();
    const cwdName = typeof opts.cwdName === 'string' && opts.cwdName.trim()
        ? opts.cwdName
        : path.basename(cwdPath).replace(/[^a-zA-Z0-9_-]/g, '-');
    // `hop new` (forceNew) skips reuse and always builds a fresh identity below.
    if (!opts.forceNew) {
        const matched = pickSessionForCwd(existingSessions, cwdPath, cwdName, {
            requireNoLocalCli: opts.requireNoLocalCli !== false
        });
        if (matched) {
            const attachTarget = buildAttachTargetFromSession(matched);
            if (attachTarget) {
                return { target: attachTarget, createdNew: false };
            }
        }
    }

    const next = buildNextSessionIdentity(existingSessions, cwdName, {
        includeStoredSessions: opts.includeStoredSessions !== false
    });
    return {
        target: {
            internalName: next.internalName,
            displayName: next.displayName,
            cwd: cwdPath
        },
        createdNew: true
    };
}

async function claimUnnamedLocalCliSession(opts = {}) {
    const cwdPath = typeof opts.cwdPath === 'string' && opts.cwdPath.trim()
        ? opts.cwdPath
        : process.cwd();
    const cwdName = typeof opts.cwdName === 'string' && opts.cwdName.trim()
        ? opts.cwdName
        : path.basename(cwdPath).replace(/[^a-zA-Z0-9_-]/g, '-');
    const snapshot = await listAllSessionEntriesRuntimeFirst();
    const selection = await chooseUnnamedSessionTarget(snapshot.entries, {
        cwdPath,
        cwdName,
        includeStoredSessions: opts.includeStoredSessions !== false
    });
    const target = selection.target;
    if (!target || !target.internalName) {
        const err = new Error('Failed to choose session target');
        err.status = 500;
        throw err;
    }

    if (selection.createdNew) {
        const claimCreatedBy = opts.createdBy === 'agent' ? 'agent' : 'user';
        rememberRuntimeSessionMetadata(target.internalName, {
            type: 'terminal',
            cwd: cwdPath,
            displayName: target.displayName,
            createdBy: claimCreatedBy,
            agentPermitted: claimCreatedBy === 'agent',
            workspaceName: null
        });
    }

    const localCliClaimId = claimPendingLocalCliSession(target.internalName);
    return {
        target: {
            ...target,
            cwd: target.cwd || cwdPath,
            localCliClaimId
        },
        createdNew: selection.createdNew
    };
}

function resolveSessionTargetByDisplay(sessionsRes, displayName) {
    const sessions = Array.isArray(sessionsRes?.sessions) ? sessionsRes.sessions : [];
    let target = sessions.find((session) => (
        session && session.type !== 'port' && session.displayName === displayName
    ));
    if (!target && sessionsRes?.aliases && sessionsRes.aliases[displayName]) {
        const resolvedName = sessionsRes.aliases[displayName];
        target = sessions.find((session) => (
            session && session.type !== 'port' && session.displayName === resolvedName
        ));
    }
    return target || null;
}

async function runHayCliConnect(wsUrl, roomName, shareUrl) {
    const hayCli = resolveHayCliPath();
    return new Promise((resolve) => {
        const cliProc = spawn('node', [hayCli, '-s', wsUrl, '-r', roomName, '-n', 'Local'], {
            stdio: 'inherit',
            // Brand context: the hay CLI is hop's terminal client — its
            // user-facing messages must speak hop ("hop attach <name>"),
            // never leak the internal hay layer.
            env: {
                ...process.env,
                FORCE_COLOR: '1',
                HAY_SHARE_URL: shareUrl || '',
                HAY_BRAND: 'hop',
                HAY_REATTACH_CMD: 'hop attach'
            }
        });

        cliProc.on('close', (code) => {
            resolve(code || 0);
        });

        cliProc.on('error', (err) => {
            log(`\nConnection error: ${err.message}`, RED);
            resolve(1);
        });
    });
}

async function runHayCliAttach(target, shareUrl = '') {
    if (!target || typeof target !== 'object') {
        throw new Error('Missing session target');
    }
    const internalName = String(target.internalName || '').trim();
    if (!internalName || !SESSION_NAME_RE.test(internalName)) {
        throw new Error('Invalid session target');
    }
    const displayName = String(target.displayName || getSessionDisplayName(internalName) || internalName).trim();
    const savedConfig = getSessionConfig(internalName);
    const sessionCwd = target.cwd || (getEffectiveSessionConfig(internalName) || {}).cwd || process.cwd();

    rememberRuntimeSessionMetadata(internalName, {
        type: 'terminal',
        cwd: sessionCwd,
        displayName,
        createdBy: target.createdBy || savedConfig?.createdBy || 'user',
        agentPermitted: typeof target.agentPermitted === 'boolean'
            ? target.agentPermitted
            : (typeof savedConfig?.agentPermitted === 'boolean' ? savedConfig.agentPermitted : false),
        workspaceName: target.workspaceName || savedConfig?.workspaceName || null
    });
    await ensureExternalHayHostReady();
    await ensureExternalRuntimeSession(internalName, sessionCwd, displayName, {
        shell: target.shell,
        env: target.env,
        cols: target.cols,
        rows: target.rows,
        startup: target.startup,
        autoStart: target.autoStart,
        createdBy: target.createdBy || savedConfig?.createdBy || 'user',
        agentPermitted: typeof target.agentPermitted === 'boolean'
            ? target.agentPermitted
            : savedConfig?.agentPermitted,
        workspaceName: target.workspaceName || savedConfig?.workspaceName,
        folderId: target.folderId,
        saveDefinition: !!savedConfig
    });
    await reconcileExternalRuntimeSessions();
    const wsUrl = buildExternalHayWsUrl(internalName, {
        name: 'Local',
        source: 'local-cli',
        claim: target.localCliClaimId,
        cwd: sessionCwd,
        hostPort: target.hostPort
    });
    return runHayCliConnect(wsUrl, internalName, shareUrl);
}

function resolveOrCreateLocalTerminalSession(nameArg, opts = {}) {
    const existingSessions = Array.isArray(opts.existingSessions) ? opts.existingSessions : [];
    const runtimeSessionNames = opts.runtimeSessionNames instanceof Set ? opts.runtimeSessionNames : null;
    const requested = String(nameArg || '').trim();

    if (requested) {
        const requestedDisplay = resolveDisplayNameAlias(requested);
        const existingInternal = hasSavedSessionConfig(requested)
            ? requested
            : findInternalSessionName(requestedDisplay);

        if (existingInternal && (!runtimeSessionNames || runtimeSessionNames.has(existingInternal))) {
            const existingConfig = getEffectiveSessionConfig(existingInternal);
            if (existingConfig?.type === 'port') {
                throw new Error('Session is configured as a port proxy');
            }
            const runtimeMatch = existingSessions.find((session) => session && session.internalName === existingInternal);
            return {
                internalName: existingInternal,
                displayName: getSessionDisplayName(existingInternal),
                cwd: runtimeMatch?.cwd || existingConfig?.cwd,
                hostPort: runtimeMatch?.hostPort,
                shell: existingConfig?.shell,
                env: existingConfig?.env,
                cols: existingConfig?.cols,
                rows: existingConfig?.rows,
                startup: existingConfig?.startup,
                autoStart: existingConfig?.autoStart,
                createdBy: existingConfig?.createdBy,
                agentPermitted: existingConfig?.agentPermitted,
                folderId: existingConfig?.folderId,
                workspaceName: existingConfig?.workspaceName
            };
        }

        const existingByList = existingSessions.find((session) => {
            if (!session || session.type === 'port') return false;
            if (session.displayName === requestedDisplay) return true;
            if (session.internalName === requestedDisplay || session.internalName === requested) return true;
            return false;
        });
        if (existingByList && existingByList.internalName) {
            return {
                internalName: existingByList.internalName,
                displayName: existingByList.displayName || requestedDisplay,
                cwd: existingByList.cwd,
                hostPort: existingByList.hostPort
            };
        }

        const displayName = isLegacyInternalSessionName(requested)
            ? toDisplaySessionName(requested)
            : requestedDisplay;
        const internalName = toInternalSessionName(displayName);
        if (!internalName) {
            throw new Error('Invalid session name');
        }
        rememberRuntimeSessionMetadata(internalName, {
            type: 'terminal',
            cwd: process.cwd(),
            displayName,
            createdBy: 'user',
            agentPermitted: false,
            workspaceName: null
        });
        return { internalName, displayName, cwd: process.cwd(), createdBy: 'user', agentPermitted: false, workspaceName: null };
    }

    const cwdName = getCwdSessionBaseName();
    const cwdPath = process.cwd();
    const { internalName, displayName } = buildNextSessionIdentity(existingSessions, cwdName);

    rememberRuntimeSessionMetadata(internalName, {
        type: 'terminal',
        cwd: cwdPath,
        displayName,
        createdBy: 'user',
        agentPermitted: false,
        workspaceName: null
    });
    return { internalName, displayName, cwd: cwdPath, createdBy: 'user', agentPermitted: false, workspaceName: null };
}

async function runLocalOnlyTerminal(nameArg) {
    await ensureHayLoaded();
    await ensureExternalHayHostReady();

    const {
        sessions: existingSessions,
        runtimeSessionNames,
        source: selectionSource
    } = await listLocalTerminalSelectionCandidates();

    let target = null;
    const requested = String(nameArg || '').trim();
    if (requested) {
        target = resolveOrCreateLocalTerminalSession(requested, {
            existingSessions,
            runtimeSessionNames
        });
    } else {
        await ensureNamingTheme();
        const cwdName = getCwdSessionBaseName();
        const cwdPath = process.cwd();
        const selection = await chooseUnnamedSessionTarget(existingSessions, {
            cwdPath,
            cwdName,
            includeStoredSessions: true
        });
        target = selection.target;

        if (selection.createdNew) {
            rememberRuntimeSessionMetadata(target.internalName, {
                type: 'terminal',
                cwd: cwdPath,
                displayName: target.displayName,
                createdBy: 'user',
                agentPermitted: false,
                workspaceName: null
            });
        } else {
            log(`Attaching to existing session: ${target.displayName}`, RESET);
        }
    }

    log(`Launching local terminal: ${target.displayName}`, RESET);
    if (!isServerRunning()) {
        log(`This session is local only — no daemon or tunnel, so it is not reachable remotely (run ${CYAN}hop${RESET} for that).`, DIM);
    }
    printDetachHint();

    const code = await runHayCliAttach(target, '');
    if (code === 10) {
        log(`\nDetached from local session.`, YELLOW);
        process.exit(0);
    }
    log(`\nLocal session ended.`, YELLOW);
    process.exit(code || 0);
}

function listAttachableSessionNames(sessionsRes) {
    return (sessionsRes.sessions || [])
        .filter((s) => s && s.type !== 'port' && typeof s.displayName === 'string' && s.displayName)
        .map((s) => s.displayName)
        .sort();
}

function printAvailableSessionNames(sessionsRes) {
    const names = listAttachableSessionNames(sessionsRes);
    if (names.length) {
        log(`Available sessions:`, RESET);
        names.forEach((name) => log(`  ${name}`, RESET));
        log(`Attach with ${CYAN}hop attach <name>${RESET} (see ${CYAN}hop session list${RESET}).`, RESET);
    } else {
        log(`No terminal sessions are running. Run ${CYAN}hop${RESET} to start one.`, RESET);
    }
}

async function attachToNamedSession(existingTunnel, displayName) {
    const sessionsRes = await fetchSessionList(existingTunnel);
    const target = resolveSessionTargetByDisplay(sessionsRes, displayName);
    if (!target) {
        log(`Session not found: ${displayName}`, RED);
        printAvailableSessionNames(sessionsRes);
        process.exit(1);
    }
    const targetDisplayName = target.displayName || displayName;
    log(`Attaching to ${targetDisplayName}...`, RESET);
    printDetachHint();
    const code = await runHayCliAttach({
        internalName: target.internalName || toInternalSessionName(targetDisplayName),
        displayName: targetDisplayName,
        cwd: target.cwd,
        hostPort: target.hostPort
    }, existingTunnel.url || '');
    if (code === 10) {
        log(`\nDetached from local session.`, YELLOW);
        process.exit(0);
    }
    log(`\nSession disconnected.`, YELLOW);
    process.exit(code || 0);
}

// `hop attach` with no name: attach to a session that has no client connected.
// Prefer one matching the current directory, else the most recently active. If
// every session is already attached, say so and list them (attach by name to
// co-view, or start a new one with `hop`).
async function attachToUnattachedSession(existingTunnel) {
    const sessionsRes = await fetchSessionList(existingTunnel);
    const live = (sessionsRes.sessions || []).filter(
        (s) => s && s.type !== 'port' && s.live && typeof s.displayName === 'string'
    );
    const unattached = live.filter((s) => !s.attached);
    if (unattached.length === 0) {
        log(`No unattached session.`, YELLOW);
        printAvailableSessionNames(sessionsRes);
        log(`Or start a new session with ${CYAN}hop${RESET}.`, RESET);
        process.exit(0);
    }
    const cwdName = getCwdSessionBaseName();
    const matched = pickSessionForCwd(unattached, process.cwd(), cwdName, { requireNoLocalCli: false });
    const target = matched
        || unattached.slice().sort((a, b) => (Number(b.lastActivityAt) || 0) - (Number(a.lastActivityAt) || 0))[0];
    return attachToNamedSession(existingTunnel, target.displayName);
}

async function attachToAllSessions(existingTunnel) {
    const sessionsRes = await fetchSessionList(existingTunnel);
    const sessions = (sessionsRes.sessions || [])
        .filter((s) => s && s.type !== 'port' && typeof s.displayName === 'string' && s.displayName);

    if (sessions.length === 0) {
        log(`No terminal sessions to attach. Run ${CYAN}hop${RESET} to start one.`, YELLOW);
        process.exit(1);
    }

    sessions.sort((a, b) => a.displayName.localeCompare(b.displayName));
    log(`Attaching sequentially to ${sessions.length} session(s).`, CYAN);
    log(`Detach from a session (Ctrl+G) to continue to the next one.`, RESET);

    let sawNonZero = false;
    for (let i = 0; i < sessions.length; i++) {
        const s = sessions[i];
        log(`\n[${i + 1}/${sessions.length}] Attaching to ${s.displayName}...`, BOLD);
        const code = await runHayCliAttach({
            internalName: s.internalName || toInternalSessionName(s.displayName),
            displayName: s.displayName,
            cwd: s.cwd,
            hostPort: s.hostPort
        }, existingTunnel.url || '');
        if (code === 10) {
            log(`Detached from ${s.displayName}.`, YELLOW);
            continue;
        }
        if (code !== 0) {
            sawNonZero = true;
            log(`Session ${s.displayName} exited with code ${code}.`, YELLOW);
        }
    }

    if (sawNonZero) {
        process.exit(1);
    }
    log(`Finished attaching all sessions.`, GREEN);
    process.exit(0);
}

const KNOWN_COMMANDS = [
    'client', 'start', 'attach', 'local', 'stop', 'status', 'doctor', 'logs',
    'help', 'config', 'url', 'qr', 'health', 'domain', 'domain-clear',
    'password', 'user', 'workspace', 'session', 'wipe', 'restore', 'update', 'resume-waiting', 'claude-hook', 'claude-skill', 'agent-skill', 'math', 'new'
];

// Suggest the closest known command for typos (small edit distances only).
function suggestNearestCommand(input) {
    const editDistance = (a, b) => {
        const dp = Array.from({ length: a.length + 1 }, (_, i) => {
            const row = new Array(b.length + 1).fill(0);
            row[0] = i;
            return row;
        });
        for (let j = 0; j <= b.length; j++) dp[0][j] = j;
        for (let i = 1; i <= a.length; i++) {
            for (let j = 1; j <= b.length; j++) {
                dp[i][j] = Math.min(
                    dp[i - 1][j] + 1,
                    dp[i][j - 1] + 1,
                    dp[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1)
                );
            }
        }
        return dp[a.length][b.length];
    };
    let best = null;
    let bestDistance = 3; // only suggest near misses
    for (const cmd of KNOWN_COMMANDS) {
        const d = editDistance(String(input).toLowerCase(), cmd);
        if (d < bestDistance) {
            bestDistance = d;
            best = cmd;
        }
    }
    return best;
}

async function main() {
    // Handle `hop client` - run as a user with exported credentials
    if (process.argv[2] === 'client') {
        // Separate flags from positionals so flag order doesn't matter.
        const clientArgs = process.argv.slice(3);
        let credentialsArg = null;
        let hostnameOverride = null;
        let wantClientHelp = false;
        let clientUsageError = null;
        for (let i = 0; i < clientArgs.length; i++) {
            const arg = clientArgs[i];
            if (arg === '--help' || arg === '-h') { wantClientHelp = true; continue; }
            if (arg === '--hostname') {
                const value = clientArgs[i + 1];
                if (!value || value.startsWith('-')) {
                    clientUsageError = 'Missing value after --hostname.';
                    break;
                }
                hostnameOverride = value;
                i++;
                continue;
            }
            if (arg.startsWith('-')) {
                clientUsageError = `Unknown option: ${arg}`;
                break;
            }
            if (credentialsArg === null) {
                credentialsArg = arg;
                continue;
            }
            clientUsageError = `Unexpected argument: ${arg}`;
            break;
        }
        if (clientUsageError) {
            log(clientUsageError, RED);
            log(`Usage: hop client <credentials.json|folder> [--hostname <name>]`, RESET);
            process.exit(1);
        }

        if (!credentialsArg || wantClientHelp) {
            log(`\n${BOLD}Hop Client Mode${RESET}\n`, CYAN);
            log(`Run hop with credentials from your admin.\n`, RESET);
            log(`${BOLD}Usage:${RESET}`, RESET);
            log(`  hop client <credentials.json>              Start tunnel with credentials`, RESET);
            log(`  hop client <folder>                        Start tunnel (folder contains credentials.json)`, RESET);
            log('');
            log(`${BOLD}Options:${RESET}`, RESET);
            log(`  --hostname <name>  Override hostname if config.yml is missing`, RESET);
            log('');
            log(`${BOLD}First run:${RESET}`, RESET);
            log(`  You'll be prompted to set a password and scan a QR code`, RESET);
            log(`  for your authenticator app.`, RESET);
            log('');
            log(`${BOLD}Example:${RESET}`, RESET);
            log(`  hop client ./my-credentials.json`, RESET);
            log('');
            process.exit(0);
        }

        // Find credentials file
        let credentialsPath = credentialsArg;
        if (fs.existsSync(credentialsArg) && fs.statSync(credentialsArg).isDirectory()) {
            credentialsPath = path.join(credentialsArg, 'credentials.json');
        }

        if (!fs.existsSync(credentialsPath)) {
            log(`Credentials file not found: ${credentialsPath}`, RED);
            process.exit(1);
        }

        // Load credentials
        let credentials;
        try {
            credentials = JSON.parse(fs.readFileSync(credentialsPath, 'utf8'));
        } catch (e) {
            log(`Invalid credentials file: ${e.message}`, RED);
            process.exit(1);
        }

        // Client config is stored per-tunnel (based on tunnel ID)
        const tunnelId = credentials.TunnelID || credentials.tunnelId || path.basename(credentialsPath, '.json');
        const clientConfigDir = path.join(HOME_DIR, 'clients', tunnelId);
        ensurePrivateDir(clientConfigDir);

        PASSWORD_FILE_PATH = path.join(clientConfigDir, '.password_hash');
        SECRET_FILE_PATH = path.join(clientConfigDir, '.auth_secret');
        const clientConfigFile = path.join(clientConfigDir, '.config.json');

        // Load or create client config
        let clientConfig = {};
        if (fs.existsSync(clientConfigFile)) {
            try {
                clientConfig = JSON.parse(fs.readFileSync(clientConfigFile, 'utf8'));
            } catch (e) { }
        }

        let hostname = clientConfig.hostname || null;
        if (hostnameOverride) {
            hostname = hostnameOverride;
        }

        // Try to find hostname in config.yml in the export folder
        const configYmlPath = path.join(path.dirname(credentialsPath), 'config.yml');
        if (!hostname && fs.existsSync(configYmlPath)) {
            const configYml = fs.readFileSync(configYmlPath, 'utf8');
            const hostnameMatch = configYml.match(/hostname:\s*(\S+)/);
            if (hostnameMatch) hostname = hostnameMatch[1];
        }

        if (!hostname) {
            log(`Hostname not found.`, RED);
            log(`Ask your admin to export a fresh bundle or pass --hostname.`, YELLOW);
            process.exit(1);
        }

        if (clientConfig.hostname !== hostname) {
            clientConfig.hostname = hostname;
            writePrivateFile(clientConfigFile, JSON.stringify(clientConfig, null, 2));
        }

        // First time setup - require password and TOTP
        const clientPasswordExists = isPasswordEnabled();
        const clientSecretExists = fs.existsSync(SECRET_FILE_PATH);

        if (!clientPasswordExists || !clientSecretExists) {
            log(`\n${BOLD}${YELLOW}⚠ First time setup required${RESET}\n`, YELLOW);
            log(`Your tunnel URL will be publicly accessible.`, RESET);
            log(`Password + authenticator code protects your hop login.\n`, RESET);

            const readline = require('readline');
            const stream = require('stream');

            const askPassword = (prompt) => new Promise((resolve) => {
                const rl = readline.createInterface({
                    input: process.stdin,
                    output: new stream.Writable({
                        write: (chunk, encoding, callback) => callback()
                    }),
                    terminal: true
                });
                process.stdout.write(prompt);
                rl.question('', (answer) => {
                    rl.close();
                    process.stdout.write('\n');
                    resolve(answer);
                });
            });

            // Set password
            if (!clientPasswordExists) {
                const password = await askPassword('Set a password: ');
                if (password.length < 4) {
                    log(`Password too short (min 4 characters).`, RED);
                    process.exit(1);
                }
                const confirm = await askPassword('Confirm password: ');
                if (password !== confirm) {
                    log(`Passwords do not match.`, RED);
                    process.exit(1);
                }
                setPassword(password);
                log(`${GREEN}✓ Password set.${RESET}`, GREEN);
            }

            // Set up TOTP
            if (!clientSecretExists) {
                loadAuthSecret();
                log(`\n${BOLD}Scan this QR code with your authenticator app:${RESET}\n`, CYAN);
                const label = hostname ? `Hop-${hostname}` : `Hop-${tunnelId.slice(0, 8)}`;
                showAuthQrCode(label);
                markAuthQrShown();
            }

            log(`\n${GREEN}✓ Setup complete!${RESET}\n`, GREEN);
        }

        loadAuthSecret();

        await checkAndInstallDependencies();
        await ensureHayLoaded();
        await ensureExternalHayHostReady();
        await reconcileExternalRuntimeSessions();
        const authEmitter = new EventEmitter();

        const proxyServer = startAuthProxy(authEmitter);
        CLIENT_TUNNEL_CONFIG = {
            tunnelId,
            credentialsPath,
            hostname,
            configDir: clientConfigDir
        };
        const { tunnel: tunnelProc, publicUrl } = await startClientTunnel();

        // Save state for other terminals to find
        writePrivateFile(STATE_FILE, JSON.stringify({
            pid: process.pid,
            port: BASE_PORT,
            url: publicUrl,
            sessionSecret: SESSION_SECRET,
            startTime: Date.now()
        }));

        // Start tunnel health monitoring (detects stale connections after VPN changes)
        startTunnelHealthMonitor();

        await waitForStart(authEmitter, publicUrl, `Hop-${hostname}`);

        await startLocalSession(proxyServer, tunnelProc, publicUrl);
        return;
    }

    // Handle `hop start` command - start daemon and print QR codes
    if (process.argv[2] === 'start') {
        const releaseStart = await withLifecycleLock('start', async () => acquireLifecycleLock('start'), {
            onWait: (op) => log(`Waiting for ${op} to finish…`, YELLOW)
        }).catch((e) => { log(e.message, RED); process.exit(1); });
        process.on('exit', () => { try { releaseStart && releaseStart(); } catch (e) { /* ignore */ } });
        const existing = isServerRunning();
        if (!existing) {
            loadAuthSecret();
            await checkAndInstallDependencies();
            startDaemon();
        }
        const state = existing || await waitForDaemonReady();
        const domainConfig = getDomainConfig();
        const label = domainConfig?.hostname ? `Hop-${domainConfig.hostname}` : 'Hop';
        loadAuthSecret();
        printStartupInfo(state.url, label);
        process.exit(0);
    }

    // Handle `hop attach` command - attach to existing session
    if (process.argv[2] === 'attach') {
        const existing = isServerRunning();
        if (!existing) {
            printNotRunningError();
            process.exit(1);
        }
        const nameArg = process.argv[3];
        const attachAll = nameArg === 'all' || nameArg === '--all';
        if (attachAll) {
            await attachToAllSessions(existing);
            return;
        }
        const displayName = nameArg && isLegacyInternalSessionName(nameArg)
            ? getSessionDisplayName(nameArg)
            : nameArg;
        if (displayName) {
            await attachToNamedSession(existing, displayName);
        } else {
            await attachToUnattachedSession(existing);
        }
        return;
    }

    // Handle `hop local` command - daemonless local terminal
    if (process.argv[2] === 'local') {
        const nameArg = process.argv[3];
        await runLocalOnlyTerminal(nameArg);
        return;
    }

    // Handle `hop stop [--all]` command - stop daemon (and hay-host + sessions with --all)
    if (process.argv[2] === 'stop') {
        // Serialize against restore/start: stopping mid-restore is exactly
        // how a fleet gets cut in half.
        const releaseStop = await withLifecycleLock('stop', async () => acquireLifecycleLock('stop'), {
            onWait: (op) => log(`Waiting for ${op} to finish…`, YELLOW)
        }).catch((e) => { log(e.message, RED); process.exit(1); });
        process.on('exit', () => { try { releaseStop && releaseStop(); } catch (e) { /* ignore */ } });
        const stopAll = process.argv.includes('--all');
        const state = isServerRunning();
        const hayHost = readHayHostStateFile();
        const hayHostAlive = !!(hayHost && isProcessAlive(hayHost.pid));

        if (!state && !(stopAll && hayHostAlive)) {
            log(`Hop is not running.`, RED);
            process.exit(1);
        }

        if (stopAll) {
            // Order matters: session deletion needs the daemon, so close sessions
            // first, then stop the daemon, then kill the hay-host process.
            if (state) {
                try {
                    const sessionsRes = await fetchSessionList(state);
                    const sessions = Array.isArray(sessionsRes?.sessions) ? sessionsRes.sessions : [];
                    for (const s of sessions) {
                        try {
                            await callLocalApi(state, '/api/sessions/delete', 'POST', { name: s.name || s.internalName });
                        } catch (e) { }
                    }
                    if (sessions.length > 0) {
                        log(`Closed ${sessions.length} session(s).`, GREEN);
                    }
                } catch (e) {
                    log(`Warning: could not close sessions via daemon: ${e.message}`, YELLOW);
                }
                try {
                    process.kill(state.pid, 'SIGTERM');
                    log(`Hop daemon stopped.`, GREEN);
                } catch (e) {
                    log(`Failed to stop hop daemon: ${e.message}`, RED);
                    process.exit(1);
                }
            }
            if (hayHostAlive) {
                const stopped = await stopExternalHayHostProcess(hayHost);
                if (!stopped) {
                    log(`Failed to stop hay-host (pid ${hayHost.pid}).`, RED);
                    process.exit(1);
                }
                clearHayHostStateFile();
                log(`Hay-host stopped. All terminal sessions ended.`, GREEN);
            } else if (hayHost) {
                clearHayHostStateFile();
            }
            process.exit(0);
        }

        // Count live sessions before killing the daemon so we can report them.
        let liveCount = 0;
        try {
            const sessionsRes = await fetchSessionList(state);
            liveCount = (sessionsRes.sessions || [])
                .filter((s) => s && s.type === 'terminal' && s.live === true).length;
        } catch (e) { }
        try {
            process.kill(state.pid, 'SIGTERM');
            log(`Hop stopped.`, GREEN);
        } catch (e) {
            log(`Failed to stop hop: ${e.message}`, RED);
            process.exit(1);
        }
        if (liveCount > 0) {
            log(`${liveCount} terminal session(s) keep running in the background (hop status).`, YELLOW);
            log(`Use ${CYAN}hop stop --all${RESET} to end them.`, RESET);
        } else if (hayHostAlive) {
            log(`The hay-host process keeps running in the background (hop status).`, YELLOW);
            log(`Use ${CYAN}hop stop --all${RESET} to end it.`, RESET);
        }
        process.exit(0);
    }

    // ── `hop ai …` — the AI-dependent command family ──────────────────────
    // Core hop is provider-agnostic and never calls a model: tunnels,
    // sessions, restore, previews all work with nothing installed. THESE
    // commands need a local agent CLI (Claude Code or Codex) that's already
    // installed and logged in — hop shells out to it, so whatever account
    // that CLI uses is the account that pays.
    if (process.argv[2] === 'ai') {
        const sub = process.argv[3];
        const flags = process.argv.slice(3);
        const has = (f) => flags.includes(f);
        const flagValue = (f) => {
            const i = flags.indexOf(f);
            return i !== -1 ? flags[i + 1] : null;
        };

        // A provider is usable only if the binary exists AND is authenticated.
        // We never parse credential files — we ask the CLI to answer a
        // trivial prompt and see if it does.
        const detectProviders = () => {
            const out = [];
            for (const [id, bin] of [['claude', 'claude'], ['codex', 'codex']]) {
                let installed = false;
                let version = '';
                try {
                    version = execSync(`command -v ${bin} >/dev/null 2>&1 && ${bin} --version 2>/dev/null | head -1`, {
                        encoding: 'utf8', shell: '/bin/sh', timeout: 15000
                    }).trim();
                    installed = !!version;
                } catch (e) { /* not installed */ }
                out.push({ id, bin, installed, version });
            }
            return out;
        };

        // Provider invocation, prompt building, and output cleaning are the
        // SHARED engine the daemon's automatic sweep uses (askAiProvider /
        // buildTaglinePrompt / cleanTaglineText) — this command is the manual
        // door onto the same machinery, never a second implementation.
        const askProvider = (providerId, prompt) => askAiProvider(providerId, prompt);

        if (!sub || sub === 'status' || sub === '--help' || sub === '-h' || sub === 'help') {
            const providers = detectProviders();
            log(`${BOLD}hop ai${RESET} — commands that use a local agent CLI`, CYAN);
            log('');
            for (const p of providers) {
                log(`  ${p.installed ? `${GREEN}✓${RESET}` : `${RED}✗${RESET}`} ${p.id.padEnd(7)} ${p.installed ? p.version : 'not installed'}`, RESET);
            }
            const any = providers.some((p) => p.installed);
            log('');
            if (!any) {
                log(`No agent CLI found. Install Claude Code or Codex and log in, then rerun.`, YELLOW);
            } else {
                log(`Commands:`, RESET);
                log(`  hop ai tagline [session…]   Generate display taglines for sessions`, RESET);
                log(`      --all      every session (default when none named)`, RESET);
                log(`      --force    re-tag even when the tagline is newer than the session's last activity`, RESET);
                log(`      --dry-run  print what would be written, change nothing`, RESET);
                log(`      --provider claude|codex`, RESET);
                log('');
                log(`Core hop never calls a model; only ${CYAN}hop ai${RESET} does.`, RESET);
            }
            process.exit(0);
        }

        // `hop ai tagline` (also accepts the phrasing `hop ai update tagline`).
        const isTagline = sub === 'tagline' || (sub === 'update' && process.argv[4] === 'tagline');
        if (!isTagline) {
            log(`Unknown command: hop ai ${sub}`, RED);
            log(`Run ${CYAN}hop ai${RESET} for available commands.`, RESET);
            process.exit(1);
        }

        const state = isServerRunning();
        if (!state) {
            printNotRunningError();
            process.exit(1);
        }
        const providers = detectProviders();
        const requested = flagValue('--provider');
        const provider = requested
            ? providers.find((p) => p.id === requested && p.installed)
            : providers.find((p) => p.installed);
        if (!provider) {
            log(requested ? `Provider "${requested}" is not installed.` : 'No agent CLI found (Claude Code or Codex).', RED);
            log(`Run ${CYAN}hop ai${RESET} to see what hop detects.`, RESET);
            process.exit(1);
        }
        const dryRun = has('--dry-run');
        const force = has('--force');
        const named = flags.filter((a, i) => i > 0 && !a.startsWith('--') && flags[i - 1] !== '--provider' && a !== 'tagline');

        const sessionsRes = await fetchSessionList(state);
        const allSessions = (sessionsRes?.sessions || []).filter((s) => s.type !== 'port');
        let targets = named.length
            ? allSessions.filter((s) => named.includes(s.displayName) || named.includes(s.internalName))
            : allSessions;
        if (named.length) {
            const missing = named.filter((n) => !allSessions.some((s) => s.displayName === n || s.internalName === n));
            for (const m of missing) log(`No such session: ${m}`, YELLOW);
        }
        // Freshness: a tagline names the session's DURABLE goal, so it should
        // not churn. Re-tag only when there isn't one, or when it's older
        // than a work-session's worth of time AND the session has actually
        // done something since. Otherwise this command is a cheap no-op you
        // can run as often as you like.
        if (!force) {
            const nowMs = Date.now();
            targets = targets.filter((s) => taglineNeedsRefresh(s, s.lastActivityAt, nowMs));
        }
        if (targets.length === 0) {
            log('Every tagline is already current. Use --force to regenerate.', GREEN);
            process.exit(0);
        }
        log(`Generating ${targets.length} tagline(s) via ${provider.id}…`, CYAN);

        const cleanTagline = cleanTaglineText;
        const gitBranch = taglineGitBranch;
        const userPrompts = taglineUserPrompts;
        const buildPrompt = buildTaglinePrompt;

        let written = 0;
        let skipped = 0;
        for (const s of targets) {
            const key = s.internalName || s.name;
            let screen = '';
            // The FIRST preview of a room can come back empty while the
            // daemon is still building that room's screen grid — one retry
            // turns a transient miss into a tagline.
            for (let attempt = 0; attempt < 2 && !screen.trim(); attempt++) {
                if (attempt) await new Promise((r) => setTimeout(r, 600));
                try {
                    const prev = await callLocalApi(state, `/api/sessions/preview?name=${encodeURIComponent(key)}`, 'GET');
                    screen = String(prev?.data?.text || '').split('\n').filter((l) => l.trim()).slice(-40).join('\n').slice(-3500);
                } catch (e) { /* retry, then give up */ }
            }
            if (!screen.trim()) {
                log(`  ${s.displayName}: no screen content — skipped`, YELLOW);
                skipped++;
                continue;
            }
            let tagline = '';
            try {
                tagline = cleanTagline(await askProvider(provider.id, buildPrompt(s, screen, userPrompts(key), gitBranch(s.cwd))));
            } catch (e) {
                const msg = String(e.stderr || e.message || '').split('\n').find((l) => l.trim()) || 'provider failed';
                log(`  ${s.displayName}: ${msg.slice(0, 120)}`, RED);
                skipped++;
                continue;
            }
            if (!tagline) {
                log(`  ${s.displayName}: unusable response — skipped`, YELLOW);
                skipped++;
                continue;
            }
            if (dryRun) {
                log(`  ${s.displayName} → ${BOLD}${tagline}${RESET}  ${YELLOW}(dry run)${RESET}`, RESET);
                continue;
            }
            try {
                const saved = await callLocalApi(state, '/api/sessions/tagline', 'POST', { internalName: key, tagline });
                if (saved?.status !== 200) throw new Error(saved?.data?.error || `HTTP ${saved?.status}`);
                log(`  ${s.displayName} → ${BOLD}${tagline}${RESET}`, GREEN);
                written++;
            } catch (e) {
                log(`  ${s.displayName}: failed to save (${e.message})`, RED);
                skipped++;
            }
        }
        log('');
        log(dryRun ? 'Dry run complete — nothing written.' : `${written} tagline(s) written${skipped ? `, ${skipped} skipped` : ''}.`, GREEN);
        process.exit(0);
    }

    // Handle `hop resume-waiting` — answer claude's resume question for any
    // session currently parked on it (sessions restored before this existed,
    // or restored with resume_mode=ask and since reconsidered).
    if (process.argv[2] === 'resume-waiting') {
        const state = isServerRunning();
        if (!state) { printNotRunningError(); process.exit(1); }
        const modeArg = String(process.argv[3] || '').toLowerCase();
        const mode = ['full', 'summary'].includes(modeArg) ? modeArg : getResumeMode();
        const key = resumeChoiceKey(mode);
        if (!key) {
            log(`Resume mode is "ask" — pass a mode: ${CYAN}hop resume-waiting full${RESET}`, YELLOW);
            process.exit(1);
        }
        const sessionsRes = await fetchSessionList(state);
        const all = (sessionsRes?.sessions || []).filter((x) => x.type !== 'port' && x.live);
        let answered = 0;
        for (const sess of all) {
            const name = sess.internalName || sess.name;
            let screen = '';
            try {
                const prev = await callLocalApi(state, `/api/sessions/preview?name=${encodeURIComponent(name)}`, 'GET');
                screen = String(prev?.data?.text || '');
            } catch (e) { continue; }
            if (!RESUME_PROMPT_RE.test(screen)) continue;
            try {
                const at = await callLocalApi(state, '/api/terminals/attach', 'POST', { name: sess.displayName || name });
                if (at?.status !== 200 || !at.data?.id) continue;
                await callLocalApi(state, `/api/terminals/${at.data.id}/write`, 'POST', { data: `${key}\r` });
                await callLocalApi(state, `/api/terminals/${at.data.id}`, 'DELETE');
                log(`  ${sess.displayName || name}: resumed ${mode === 'full' ? 'full conversation' : 'from summary'}`, GREEN);
                answered++;
            } catch (e) { /* next session */ }
        }
        log(answered ? `Answered ${answered} session(s).` : 'No sessions were waiting.', answered ? GREEN : RESET);
        process.exit(0);
    }

    // Handle `hop update` — self-update from the git checkout's origin.
    // Sessions SURVIVE: only the daemon restarts (the hay-host, which owns
    // every PTY, is untouched); the committed hay-web bundle means no build
    // step. --host additionally chains the detached graceful salvage-restart
    // so host-side changes activate too (that one DOES cycle sessions
    // through restore). --check reports without touching anything.
    if (process.argv[2] === 'update') {
        const checkOnly = process.argv.includes('--check');
        const withHost = process.argv.includes('--host');
        const runGit = (cmd, timeout = 60000) =>
            execSync(cmd, { cwd: __dirname, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout }).trim();
        try { runGit('git rev-parse --git-dir'); } catch (e) {
            log('Not a git checkout — cannot self-update.', RED);
            process.exit(1);
        }
        log('Checking for updates…', CYAN);
        try { runGit('git fetch --quiet origin', 120000); } catch (e) {
            log(`Fetch failed: ${e.message}`, RED);
            process.exit(1);
        }
        const local = runGit('git rev-parse HEAD');
        let upstream;
        try { upstream = runGit('git rev-parse @{u}'); } catch (e) {
            try { upstream = runGit('git rev-parse origin/main'); } catch (e2) {
                log('No upstream to compare against.', RED);
                process.exit(1);
            }
        }
        if (local === upstream) {
            log(`Already up to date (${local.slice(0, 7)}).`, GREEN);
            process.exit(0);
        }
        const behind = runGit(`git rev-list --count HEAD..${upstream}`);
        const ahead = runGit(`git rev-list --count ${upstream}..HEAD`);
        log(`Update available: ${behind} new commit(s)${ahead !== '0' ? ` — but local is ${ahead} ahead; resolve manually` : ''}`, YELLOW);
        try { log(runGit(`git log --oneline --no-decorate HEAD..${upstream} -15`), RESET); } catch (e) { }
        if (checkOnly) process.exit(0);
        if (ahead !== '0') process.exit(1);
        let dirty = '';
        try { dirty = runGit('git status --porcelain'); } catch (e) { }
        if (dirty) {
            log('Working tree has local changes — commit or stash them first.', RED);
            process.exit(1);
        }
        // Dependency fingerprint across the pull: reinstall only when a
        // lockfile actually changed.
        const lockRev = (ref, file) => { try { return runGit(`git rev-parse ${ref}:${file}`); } catch (e) { return ''; } };
        const locks = ['package-lock.json', 'hay/package-lock.json'];
        const before = locks.map((f) => lockRev('HEAD', f));
        try { runGit(`git merge --ff-only ${upstream}`); } catch (e) {
            log(`Fast-forward failed: ${e.message}`, RED);
            process.exit(1);
        }
        const after = locks.map((f) => lockRev('HEAD', f));
        for (let i = 0; i < locks.length; i++) {
            if (before[i] !== after[i]) {
                const dir = locks[i].startsWith('hay/') ? path.join(__dirname, 'hay') : __dirname;
                log(`Dependencies changed (${locks[i]}) — installing…`, CYAN);
                try {
                    execSync('npm install --no-audit --no-fund', { cwd: dir, stdio: 'inherit', timeout: 600000 });
                } catch (e) {
                    log(`npm install failed in ${dir}: ${e.message}`, RED);
                    process.exit(1);
                }
            }
        }
        // Restart the daemon onto the new code. The host keeps every session
        // alive through this.
        const state = isServerRunning();
        if (state) {
            log('Restarting daemon…', CYAN);
            try { process.kill(state.pid, 'SIGTERM'); } catch (e) { }
            for (let i = 0; i < 40 && isProcessAlive(state.pid); i++) {
                await new Promise((r) => setTimeout(r, 250));
            }
            startDaemon();
            await waitForDaemonReady();
        }
        log(`✓ Updated to ${runGit('git rev-parse --short HEAD')} — daemon restarted; sessions untouched.`, GREEN);
        if (withHost) {
            const script = path.join(__dirname, 'scripts', 'salvage-and-restart-host.js');
            const child = spawn(process.execPath, [script], { detached: true, stdio: 'ignore' });
            child.unref();
            log('Host salvage-restart launched (detached) — progress: ~/.hop2/transcript-salvage/restart.log', YELLOW);
            log('It waits for the fleet to go idle, then cycles the host through salvage → restore.', YELLOW);
        } else {
            log(`Host still runs the previous code; ${CYAN}hop update --host${RESET} (or the salvage script) cycles it when convenient.`, RESET);
        }
        process.exit(0);
    }

    // Handle `hop restore` - recreate saved sessions, resuming claude conversations
    if (process.argv[2] === 'restore') {
        const dryRun = process.argv.includes('--dry-run') || process.argv.includes('-n');
        const includeAgents = process.argv.includes('--agents');
        let state = isServerRunning();
        if (!state) {
            // Start the daemon on demand so `hop restore` is a one-command recovery
            // after a reboot (no need to run `hop` first).
            if (dryRun) {
                log(`Hop is not running. Start it with ${CYAN}hop${RESET} first (or run without --dry-run to start it).`, RED);
                process.exit(1);
            }
            log(`Hop is not running — starting it…`, DIM);
            startDaemon();
            state = await waitForDaemonReady();
        }
        let res;
        try {
            res = await callLocalApi(state, '/api/sessions/restore', 'POST', { dryRun, includeAgents });
        } catch (e) {
            log(`Restore request failed: ${e.message}`, RED);
            process.exit(1);
        }
        if (!res || res.status < 200 || res.status >= 300) {
            log(`Restore failed${res?.data?.error ? `: ${res.data.error}` : ''}.`, RED);
            process.exit(1);
        }
        const items = Array.isArray(res.data?.restored) ? res.data.restored : [];
        const skippedAgents = Array.isArray(res.data?.skippedAgents) ? res.data.skippedAgents : [];
        if (items.length === 0) {
            log(`No saved sessions to restore.`, YELLOW);
            if (skippedAgents.length > 0) {
                log(`(${skippedAgents.length} agent-created session(s) skipped — ${CYAN}hop restore --agents${RESET} to include)`, DIM);
            }
            process.exit(0);
        }
        log(`${dryRun ? 'Would restore' : 'Restoring'} ${items.length} session(s):`, BOLD);
        for (const it of items) {
            const how = it.command
                ? `${DIM}${it.command}${RESET}`
                : (it.replay ? `${DIM}shell in last dir (replay last screen)${RESET}` : `${DIM}shell in last dir${RESET}`);
            log(`  ${GREEN}•${RESET} ${it.name}  ${how}`, RESET);
            if (it.warning) {
                log(`      ${YELLOW}⚠ ${it.warning}${RESET}`, RESET);
            }
        }
        if (skippedAgents.length > 0) {
            log(`  ${DIM}(+${skippedAgents.length} agent-created session(s) skipped — ${CYAN}hop restore --agents${RESET}${DIM} to include)${RESET}`, RESET);
        }
        if (!dryRun) {
            log(`\nDone. Attach with ${CYAN}hop attach <name>${RESET} or open the web session manager.`, RESET);
        } else {
            log(`\n(dry run — re-run without --dry-run to apply)`, DIM);
        }
        process.exit(0);
    }

    // Handle `hop claude-hook [install|remove|status]` - manage the Claude
    // SessionStart hook that lets `hop restore` resume the right conversation.
    if (process.argv[2] === 'claude-hook') {
        const sub = process.argv[3] || 'status';
        if (sub === 'install') {
            const r = installClaudeHook();
            if (!r.ok) { log(`Failed to install hook: ${r.error}`, RED); process.exit(1); }
            log(r.already ? `Claude SessionStart hook already installed (${r.path}).` : `${GREEN}Installed${RESET} Claude SessionStart hook → ${r.path}`, RESET);
            if (!r.already) log(`New claude sessions started in hop terminals will now be restorable. Backup: ${r.path}.hop-backup`, DIM);
            process.exit(0);
        }
        if (sub === 'remove') {
            const r = removeClaudeHook();
            if (!r.ok) { log(`Failed to remove hook: ${r.error}`, RED); process.exit(1); }
            log(r.already ? `Claude SessionStart hook was not installed.` : `${GREEN}Removed${RESET} Claude SessionStart hook from ${r.path}`, RESET);
            process.exit(0);
        }
        // status
        const { path: p, data } = readClaudeSettings();
        log(claudeHookIsInstalled(data)
            ? `${GREEN}✓${RESET} Claude SessionStart hook installed (${p})`
            : `${YELLOW}!${RESET} Claude SessionStart hook not installed. Run ${CYAN}hop claude-hook install${RESET} to enable full session restore.`, RESET);
        process.exit(0);
    }

    // `agent-skill` installs Hop's bundled instructions for Claude and Codex.
    // Keep `claude-skill` as the narrower backward-compatible command.
    if (process.argv[2] === 'agent-skill' || process.argv[2] === 'claude-skill') {
        const agentWide = process.argv[2] === 'agent-skill';
        const roots = agentWide ? getAgentSkillRoots() : getClaudeConfigRoots();
        const commandName = agentWide ? 'agent-skill' : 'claude-skill';
        const sub = process.argv[3] || 'status';
        if (sub === 'install') {
            const r = installAgentSkills(roots);
            if (!r.ok) { log(`Failed to install skill: ${r.error}`, RED); process.exit(1); }
            for (const p of r.installed) log(`${GREEN}Installed${RESET} Hop skill → ${p}`, RESET);
            for (const p of r.already) log(`Hop skill already current (${p}).`, DIM);
            if (r.installed.length) log(`New agent sessions in hop terminals will pick it up automatically.`, DIM);
            process.exit(0);
        }
        if (sub === 'remove') {
            const r = removeAgentSkills(roots);
            for (const p of r.removed) log(`${GREEN}Removed${RESET} ${p}`, RESET);
            if (!r.removed.length) log(`Hop skills were not installed.`, RESET);
            process.exit(0);
        }
        // status
        let any = false;
        let skillNames = [];
        try { skillNames = fs.readdirSync(HOP_SKILLS_DIR); } catch (e) { skillNames = []; }
        for (const root of roots) for (const name of skillNames) {
            const dest = path.join(root, 'skills', name, 'SKILL.md');
            if (fs.existsSync(dest)) { any = true; log(`${GREEN}✓${RESET} ${dest}`, RESET); }
        }
        if (!any) log(`${YELLOW}!${RESET} Hop skills are not installed. Run ${CYAN}hop ${commandName} install${RESET}.`, RESET);
        process.exit(0);
    }

    // Handle `hop status` command - concise daemon/tunnel/session overview
    if (process.argv[2] === 'status') {
        const state = isServerRunning();
        log(`\n${BOLD}Hop Status${RESET}`, CYAN);
        if (!state) {
            log(`  Daemon:    ${RED}not running${RESET}`, RESET);
            log(`  Logs:      ${LOG_DIR}`, RESET);
            log('');
            printNotRunningError();
            log('');
            process.exit(0);
        }
        const fmtUptime = (ms) => {
            if (!Number.isFinite(ms) || ms < 0) return 'unknown';
            const s = Math.floor(ms / 1000), h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
            return h > 0 ? `${h}h ${m}m` : `${m}m`;
        };
        const uptime = state.startTime ? fmtUptime(Date.now() - state.startTime) : 'unknown';
        log(`  Daemon:    ${GREEN}running${RESET}  pid ${state.pid}  up ${uptime}  port ${state.port}`, RESET);

        let tunnel = null;
        try {
            const r = await callLocalApi(state, '/api/tunnel/status', 'GET');
            if (r && r.status === 200) tunnel = r.data;
        } catch (e) { }
        if (tunnel) {
            const conn = tunnel.connected ? `${GREEN}connected${RESET}` : `${RED}disconnected${RESET}`;
            log(`  Tunnel:    ${conn}  ${tunnel.url || state.url || ''}`, RESET);
            const failNote = tunnel.consecutiveFailures ? `, failures: ${tunnel.consecutiveFailures}` : '';
            if (tunnel.lastEvent) log(`             event: ${tunnel.lastEvent}${failNote}`, RESET);
            if (tunnel.lastError) log(`             ${YELLOW}last error: ${tunnel.lastError}${RESET}`, RESET);
        } else {
            log(`  Tunnel:    ${state.url || '(unknown)'}  ${YELLOW}(status unavailable)${RESET}`, RESET);
        }

        const hh = readHayHostStateFile();
        if (hh && hh.pid) {
            let alive = false;
            try { process.kill(hh.pid, 0); alive = true; } catch (e) { }
            log(`  Hay-host:  ${alive ? GREEN + 'running' + RESET : RED + 'dead' + RESET}  pid ${hh.pid}  port ${hh.port}`, RESET);
        } else {
            log(`  Hay-host:  ${YELLOW}none${RESET}`, RESET);
        }

        try {
            const sessionsRes = await fetchSessionList(state);
            const count = Array.isArray(sessionsRes?.sessions) ? sessionsRes.sessions.length : 0;
            const active = Array.isArray(sessionsRes?.active) ? sessionsRes.active.length : 0;
            log(`  Sessions:  ${count} (${active} active)`, RESET);
        } catch (e) {
            log(`  Sessions:  ${YELLOW}unavailable${RESET}`, RESET);
        }

        try {
            const r = await callLocalApi(state, '/api/sessions/restore', 'POST', { dryRun: true });
            const n = r && r.status === 200 ? (r.data?.count || 0) : 0;
            if (n > 0) log(`  Restore:   ${n} saved session(s) can be restored (${CYAN}hop restore${RESET})`, RESET);
        } catch (e) { }

        log(`  Logs:      ${LOG_DIR}  (hop logs -f)`, RESET);
        log('');
        process.exit(0);
    }

    // Handle `hop doctor` command - read-only environment/health checks
    if (process.argv[2] === 'doctor') {
        log(`\n${BOLD}Hop Doctor${RESET}\n`, CYAN);

        {
            const v = evaluateAutostartCommandShell();
            const inHop = process.env.HOP_SESSION ? ` · inside hop session '${process.env.HOP_SESSION}'` : '';
            const tty = process.stdin.isTTY && process.stdout.isTTY ? 'tty' : 'no-tty';
            log(`  Autostart: bare \`hop\` from this shell would ${v.skip || process.env.HOP_SESSION || tty === 'no-tty' ? YELLOW + 'SKIP' + RESET : GREEN + 'launch' + RESET} (${tty}${inHop} · ${v.reason})`, RESET);
        }
        let problems = 0;
        const ok = (m) => log(`  ${GREEN}✓${RESET} ${m}`, RESET);
        const warn = (m) => log(`  ${YELLOW}!${RESET} ${m}`, RESET);
        const bad = (m) => { problems++; log(`  ${RED}✗${RESET} ${m}`, RESET); };

        let cfInstalled = false;
        try { execSync('command -v cloudflared', { stdio: 'ignore' }); cfInstalled = true; } catch (e) { }
        cfInstalled ? ok('cloudflared installed') : bad('cloudflared not found (brew install cloudflared)');

        const domain = getDomainConfig();
        if (domain && domain.hostname) {
            isCloudflaredLoggedIn()
                ? ok(`custom domain ${domain.hostname} (cloudflared logged in)`)
                : bad(`custom domain ${domain.hostname} but cloudflared is not logged in (cloudflared tunnel login)`);
            isPasswordEnabled()
                ? ok('password set (required for custom domain)')
                : bad('custom domain requires a password (hop password set)');
        } else {
            ok('quick tunnel mode (random URLs)');
        }

        fs.existsSync(SECRET_FILE_PATH)
            ? ok('2FA secret configured')
            : warn('2FA secret not yet created (created on first start)');

        const webOk = fs.existsSync(path.join(HAY_ROOT, 'apps/web/dist/index.html'));
        const serverOk = fs.existsSync(path.join(HAY_ROOT, 'apps/server/dist/lib.js'));
        const cliOk = fs.existsSync(path.join(HAY_ROOT, 'apps/cli/dist/index.js'));
        if (webOk && serverOk && cliOk) {
            ok('hay client/server/cli built');
        } else {
            const missing = [!webOk && 'web', !serverOk && 'server', !cliOk && 'cli'].filter(Boolean).join(', ');
            bad(`hay build missing (${missing}) — run hop once to build`);
        }

        if (fs.existsSync(STATE_FILE)) {
            try { JSON.parse(fs.readFileSync(STATE_FILE, 'utf8')); ok('state file is valid JSON'); }
            catch (e) { bad(`state file is corrupt: ${STATE_FILE}`); }
        }

        const running = isServerRunning();
        if (running) {
            const result = await probeTunnelHealth(running.url, TUNNEL_HEALTH_TIMEOUT);
            result.ok
                ? ok(`daemon running and tunnel healthy (${result.time}ms)`)
                : bad(`daemon running but tunnel unhealthy: ${result.error || ('HTTP ' + result.status)} (hop health --restart)`);
        } else {
            warn('daemon not running (start with hop)');
        }

        log('');
        if (problems === 0) {
            log(`  ${GREEN}All checks passed.${RESET}\n`, RESET);
            process.exit(0);
        }
        log(`  ${RED}${problems} problem(s) found.${RESET}\n`, RESET);
        process.exit(1);
    }

    // Handle `hop logs [-f] [hay-host]` command - view daemon/host logs
    if (process.argv[2] === 'logs') {
        const follow = process.argv.includes('-f') || process.argv.includes('--follow');
        const wantHayHost = process.argv.includes('hay-host') || process.argv.includes('hayhost');
        const logPath = path.join(LOG_DIR, wantHayHost ? 'hay-host.log' : 'hop-daemon.log');
        if (!fs.existsSync(logPath)) {
            log(`No log yet at ${logPath}`, YELLOW);
            log(`(start hop to create it)`, RESET);
            process.exit(0);
        }
        // -F follows across rotation; falls back to a one-shot dump if tail is absent.
        const tailArgs = follow ? ['-n', '100', '-F', logPath] : ['-n', '200', logPath];
        const tailProc = spawn('tail', tailArgs, { stdio: 'inherit' });
        tailProc.on('error', () => {
            try { process.stdout.write(fs.readFileSync(logPath, 'utf8')); } catch (e) { }
            process.exit(0);
        });
        tailProc.on('close', (code) => process.exit(code || 0));
        return;
    }

    // Handle `hop --help` or `hop help`
    // Handle `hop math '<latex>'` - render a LaTeX formula in the terminal.
    // Pure local render; needs no daemon. Image in graphics-capable terminals,
    // 2D Unicode otherwise (and always inside a hop session).
    if (process.argv[2] === 'math') {
        const { runMathCli } = require('./scripts/hop-math.js');
        process.exit(runMathCli(process.argv.slice(3)));
    }

    if (process.argv[2] === '--help' || process.argv[2] === '-h' || process.argv[2] === 'help') {
        log(`\n${BOLD}Hop - Remote Terminal Access${RESET}\n`, CYAN);
        log(`${BOLD}Usage:${RESET}`, RESET);
        log(`  hop                       Launch the daemon+tunnel if needed and open a NEW terminal session`, RESET);
        log(`  hop new                   Same as hop (always opens a new session)`, RESET);
        log(`  hop attach                Reattach to an existing session (picks an unattached one; lists them if none are free)`, RESET);
        log(`  hop attach <name>         Reattach to an existing session by name`, RESET);
        log(`  hop attach all            Reattach to every existing session in turn`, RESET);
        log(`  hop start                 Start the daemon and tunnel only, then print QR codes (no terminal session)`, RESET);
        log(`  hop local [session]       Open a terminal with no daemon or tunnel — local only, not reachable remotely`, RESET);
        log(`  hop stop                  Stop hop daemon (terminal sessions keep running)`, RESET);
        log(`  hop stop --all            Stop daemon, hay-host, and all terminal sessions`, RESET);
        log(`  hop status                Show daemon, tunnel, and session status`, RESET);
        log(`  hop doctor                Run environment/health checks`, RESET);
        log(`  hop logs [-f] [hay-host]  Show daemon logs (-f to follow)`, RESET);
        log(`  hop --help                Show this help message`, RESET);
        log('');
        log(`${BOLD}URL & QR:${RESET}`, RESET);
        log(`  hop url                   Print current tunnel URL`, RESET);
        log(`  hop qr                    Show tunnel URL as QR code`, RESET);
        log(`  hop qr auth               Show authenticator setup QR code`, RESET);
        log('');
        log(`${BOLD}Config:${RESET}`, RESET);
        log(`  hop config                Show hop config`, RESET);
        log(`  hop config theme [name]   Show or set the session naming theme`, RESET);
        log('');
        log(`${BOLD}Custom Domain:${RESET}`, RESET);
        log(`  hop domain                Show current domain config`, RESET);
        log(`  hop domain <hostname>     Setup custom domain (e.g., hop.example.com)`, RESET);
        log(`  hop domain-clear          Remove custom domain, use random URLs`, RESET);
        log('');
        log(`${BOLD}Security:${RESET}`, RESET);
        log(`  hop password              Show password status`, RESET);
        log(`  hop password set          Set or change password`, RESET);
        log(`  hop password clear        Remove password protection`, RESET);
        log('');
        log(`${BOLD}Multi-user (admin):${RESET}`, RESET);
        log(`  hop user list             List all users`, RESET);
        log(`  hop user add <name>       Add a user (creates tunnel + DNS)`, RESET);
        log(`  hop user remove <name>    Remove a user`, RESET);
        log(`  hop user export <name>    Export credentials for a user`, RESET);
        log('');
        log(`${BOLD}Sessions:${RESET}`, RESET);
        log(`  hop session list [--all|-a]      List live sessions (--all/-a adds workspace defs across all workspaces)`, RESET);
        log(`  hop session add <name> [--cwd P] --workspace W  Save a terminal definition to a workspace`, RESET);
        log(`  hop session add <name> --port N --workspace W   Save a port definition to a workspace`, RESET);
        log(`  hop session rename <old> <new>   Rename a session`, RESET);
        log(`  hop session remove <name>        Remove a session`, RESET);
        log(`  hop session permit <name>        Allow agent access`, RESET);
        log(`  hop session origin <name> <user|agent>  Move a session between user/agent sides (switcher filter + restore policy)`, RESET);
        log(`  hop session block <name>         Block agent access`, RESET);
        log('');
        log(`${BOLD}Workspaces:${RESET}`, RESET);
        log(`  hop workspace list            List workspaces`, RESET);
        log(`  hop workspace create <name>   Create an empty workspace`, RESET);
        log(`  hop workspace show <name>     Show saved definitions in a workspace`, RESET);
        log(`  hop workspace save <name>     Save selected live sessions into a workspace`, RESET);
        log(`  hop workspace load <name>     Start sessions defined in a workspace`, RESET);
        log(`  hop workspace delete <name> [--yes]  Delete a workspace (asks before deleting a non-empty one)`, RESET);
        log('');
        log(`${BOLD}Restore:${RESET}`, RESET);
        log(`  hop restore [--dry-run]   Recreate your saved sessions, resuming claude conversations`, RESET);
        log(`  hop update [--check|--host] Self-update from GitHub (daemon restart; sessions survive; --host cycles the host too)`, RESET);
        log(`  hop claude-hook install   Enable full restore (adds a Claude SessionStart hook)`, RESET);
        log(`  hop claude-hook status|remove   Check or remove the hook`, RESET);
        log(`  hop agent-skill install   Install Hop orchestration instructions for Claude and Codex`, RESET);
        log(`  hop agent-skill status|remove   Check or remove the skills`, RESET);
        log(`  hop claude-skill ...      Backward-compatible Claude-only alias`, RESET);
        log('');
        log(`${BOLD}Client mode (for users):${RESET}`, RESET);
        log(`  hop client <credentials>  Run tunnel with exported credentials`, RESET);
        log('');
        log(`${BOLD}Math:${RESET}`, RESET);
        log(`  hop math '<latex>'        Render a LaTeX formula (inline image where supported, else Unicode)`, RESET);
        log('');
        log(`${BOLD}Maintenance:${RESET}`, RESET);
        log(`  hop health [--restart]    Check tunnel health (--restart forces a tunnel restart)`, RESET);
        log(`  hop wipe [--all] [--yes]  Remove workspace-defined sessions (--all kills live; --yes skips confirmation)`, RESET);
        log(`  hop wipe --agent          Close all agent-created terminal API sessions`, RESET);
        log(`  hop config resume <mode>  How restores answer claude's resume question (full|summary|ask)`, RESET);
        log('');
        process.exit(0);
    }

    // Handle `hop url` command - prints current tunnel URL (easy to copy)
    // Handle `hop config` command
    if (process.argv[2] === 'config') {
        const subCmd = process.argv[3];
        // How restored sessions answer claude's resume question.
        if (subCmd === 'resume' || subCmd === 'resume-mode') {
            const modeArg = String(process.argv[4] || '').toLowerCase();
            if (modeArg) {
                if (!['full', 'summary', 'ask'].includes(modeArg)) {
                    log(`Unknown resume mode "${modeArg}". Use: full | summary | ask`, RED);
                    process.exit(1);
                }
                const cfg = getHopConfig();
                cfg.resume_mode = modeArg;
                saveHopConfig(cfg);
                log(`Restored sessions will ${modeArg === 'ask' ? 'leave claude\'s resume question for you' : `resume ${modeArg === 'full' ? 'the FULL conversation' : 'from a summary'}`}.`, GREEN);
            } else {
                const mode = getResumeMode();
                log(`Resume mode: ${BOLD}${mode}${RESET}`, RESET);
                log(`  full     restore the whole conversation as-is (default)`, DIM);
                log(`  summary  let claude resume from its summary (cheaper)`, DIM);
                log(`  ask      leave the question on screen for you`, DIM);
                log(`Change with: ${CYAN}hop config resume <mode>${RESET}`, RESET);
            }
            process.exit(0);
        }
        if (subCmd === 'theme' || subCmd === 'naming-theme') {
            const themeArg = process.argv[4];
            if (themeArg) {
                if (!isValidTheme(themeArg)) {
                    log(`Unknown theme "${themeArg}". Available: ${getThemeChoices().map(c => c.id).join(', ')}`, RED);
                    process.exit(1);
                }
                setNamingTheme(themeArg);
                log(`Naming theme set to "${themeArg}".`, GREEN);
            } else {
                const current = getNamingTheme();
                if (current) {
                    log(`Current naming theme: ${current}`, RESET);
                    log(`Change with: hop config theme <name>`, DIM);
                } else {
                    log(`No naming theme configured. Run \`hop config theme <name>\` to set one.`, YELLOW);
                }
                log(`\nAvailable themes:`, RESET);
                for (const c of getThemeChoices()) {
                    const marker = c.id === current ? ` ${GREEN}(active)${RESET}` : '';
                    log(`  ${c.id.padEnd(10)} ${DIM}${c.example}${RESET}${marker}`);
                }
            }
            process.exit(0);
        }
        // Show all config
        const config = getHopConfig();
        log(`Hop config (${HOP_CONFIG_FILE}):`, BOLD);
        log(JSON.stringify(config, null, 2));
        process.exit(0);
    }

    if (process.argv[2] === 'url') {
        const state = isServerRunning();
        if (!state) {
            printNotRunningError();
            process.exit(1);
        }
        // Print just the URL for easy copying/piping
        console.log(state.url);
        process.exit(0);
    }

    // Handle `hop qr` command - shows either the tunnel URL QR or authenticator QR
    if (process.argv[2] === 'qr') {
        const qrTarget = process.argv[3];

        if (qrTarget === 'auth') {
            if (!fs.existsSync(SECRET_FILE_PATH)) {
                log(`No authenticator secret is configured yet.`, RED);
                log(`Start hop once to complete setup, or reset by deleting ${SECRET_FILE_PATH}.`, RESET);
                process.exit(1);
            }
            loadAuthSecret();
            log(`\nAuthenticator setup QR:`, BOLD);
            log(`Scan this with Duo/Authy/1Password, not with your camera app.\n`, CYAN);
            showAuthQrCode(getAuthQrLabel());
            process.exit(0);
        }

        if (qrTarget && qrTarget !== 'url') {
            log(`Unknown qr target: ${qrTarget}`, RED);
            log(`Use ${CYAN}hop qr${RESET} for the tunnel URL or ${CYAN}hop qr auth${RESET} for the authenticator QR.`, RESET);
            process.exit(1);
        }

        const state = isServerRunning();
        if (!state) {
            printNotRunningError();
            process.exit(1);
        }
        log(`\nCurrent tunnel URL:`, BOLD);
        log(`${state.url}\n`, GREEN);
        log(`This QR opens your Hop URL. It is not the authenticator setup QR.`, YELLOW);
        log(`Use ${CYAN}hop qr auth${RESET} for Duo/Authy/1Password.\n`, RESET);
        qrcode.generate(state.url, { small: true });
        process.exit(0);
    }

    // Handle `hop health` command - check tunnel health and optionally restart
    if (process.argv[2] === 'health') {
        const state = isServerRunning();
        if (!state) {
            printNotRunningError();
            process.exit(1);
        }

        log(`\nChecking tunnel health...`, BOLD);
        log(`  URL: ${state.url}`, RESET);
        const result = await probeTunnelHealth(state.url, TUNNEL_HEALTH_TIMEOUT);
        let localStatus = null;
        try {
            const localRes = await callLocalApi(state, '/api/tunnel/status', 'GET');
            if (localRes && localRes.status === 200) {
                localStatus = localRes.data;
            }
        } catch (e) { }

        if (result.ok) {
            log(`  Status: ${GREEN}OK${RESET} (${result.status}) - ${result.time}ms`, GREEN);
        } else {
            const reason = result.error || (result.status ? `HTTP ${result.status}` : 'Unknown error');
            log(`  Status: ${RED}FAILED${RESET} - ${reason} (${result.time}ms)`, RED);
            if (localStatus) {
                const tunnelState = localStatus.connected ? `${GREEN}connected${RESET}` : `${RED}disconnected${RESET}`;
                log(`  Local tunnel: ${tunnelState}`, RESET);
                if (localStatus.lastEvent) {
                    log(`  Last event: ${localStatus.lastEvent}`, RESET);
                }
                if (localStatus.lastError) {
                    log(`  Last error: ${localStatus.lastError}`, YELLOW);
                }
            }

            if (process.argv[3] === '--restart' || process.argv[3] === '-r') {
                log(`\nRestarting tunnel...`, YELLOW);
                let restarted = false;
                try {
                    const res = await callLocalApi(state, '/api/tunnel/restart', 'POST');
                    if (res && res.status >= 200 && res.status < 300) {
                        restarted = true;
                        log(`Restart request sent. Waiting for tunnel to become healthy...`, GREEN);
                    }
                } catch (e) { }
                if (!restarted) {
                    try {
                        process.kill(state.pid, 'SIGUSR1');  // Fallback to signal daemon to restart tunnel
                        restarted = true;
                        log(`Restart signal sent. Waiting for tunnel to become healthy...`, GREEN);
                    } catch (e) {
                        log(`Failed to signal daemon: ${e.message}`, RED);
                    }
                }
                if (restarted) {
                    const waitStartedAt = Date.now();
                    const waitTimeoutMs = TUNNEL_RESTART_VERIFY_TIMEOUT + 5000;
                    let recovered = null;
                    let activeUrl = state.url;

                    while ((Date.now() - waitStartedAt) < waitTimeoutMs) {
                        try {
                            const freshLocal = await callLocalApi(state, '/api/tunnel/status', 'GET');
                            if (freshLocal && freshLocal.status === 200 && freshLocal.data && freshLocal.data.url) {
                                activeUrl = freshLocal.data.url;
                            }
                        } catch (e) { }

                        recovered = await probeTunnelHealth(activeUrl, TUNNEL_HEALTH_TIMEOUT);
                        if (recovered.ok) {
                            log(`Tunnel healthy again: ${GREEN}${recovered.status}${RESET} after ${Date.now() - waitStartedAt}ms`, GREEN);
                            process.exit(0);
                        }
                        await new Promise((resolve) => setTimeout(resolve, TUNNEL_RESTART_VERIFY_INTERVAL));
                    }
                    const reason = (recovered && (recovered.error || (recovered.status ? `HTTP ${recovered.status}` : null))) || 'Unknown error';
                    log(`Tunnel restart did not recover within ${Math.ceil((Date.now() - waitStartedAt) / 1000)}s: ${reason}`, RED);
                }
            } else {
                log(`\nRun ${CYAN}hop health --restart${RESET} to force tunnel restart.`, RESET);
            }
        }
        process.exit(result.ok ? 0 : 1);
    }

    // Handle `hop domain <hostname>` command - setup custom domain
    if (process.argv[2] === 'domain') {
        const hostname = process.argv[3];
        if (!hostname) {
            // Show current domain config
            const config = getDomainConfig();
            if (config) {
                log(`\nCurrent custom domain configuration:`, BOLD);
                log(`  Hostname: ${config.hostname}`, GREEN);
                log(`  Tunnel:   ${config.tunnelName}`, RESET);
                log(`\nTo change: hop domain <new-hostname>`, RESET);
                log(`To remove: hop domain-clear`, RESET);
            } else {
                log(`\nNo custom domain configured.`, YELLOW);
                log(`\nUsage: hop domain <hostname>`, RESET);
                log(`Example: hop domain hop.yourdomain.com`, RESET);
            }
            process.exit(0);
        }
        // Validate hostname format
        if (!/^[a-zA-Z0-9]([a-zA-Z0-9-]*\.)+[a-zA-Z]{2,}$/.test(hostname)) {
            log(`Invalid hostname format: ${hostname}`, RED);
            log(`Example: hop.yourdomain.com`, RESET);
            process.exit(1);
        }
        await setupDomain(hostname);
        process.exit(0);
    }

    // Handle `hop domain-clear` command - remove custom domain config
    if (process.argv[2] === 'domain-clear') {
        if (fs.existsSync(DOMAIN_CONFIG_FILE)) {
            fs.unlinkSync(DOMAIN_CONFIG_FILE);
            log(`Custom domain configuration removed.`, GREEN);
            log(`Hop will use random Cloudflare URLs again.`, RESET);
        } else {
            log(`No custom domain configured.`, YELLOW);
        }
        process.exit(0);
    }

    // Handle `hop password` commands
    if (process.argv[2] === 'password') {
        const subcommand = process.argv[3];
        const readline = require('readline');

        if (!subcommand || subcommand === 'status') {
            if (isPasswordEnabled()) {
                log(`Password protection: ${GREEN}ENABLED${RESET}`, BOLD);
                log(`\nTo change: hop password set`, RESET);
                log(`To remove: hop password clear`, RESET);
            } else {
                log(`Password protection: ${YELLOW}DISABLED${RESET}`, BOLD);
                log(`\nTo enable: hop password set`, RESET);
            }
            process.exit(0);
        }

        if (subcommand === 'set') {
            // Use muted readline for password input
            const askPassword = (prompt) => new Promise((resolve) => {
                const rl = readline.createInterface({
                    input: process.stdin,
                    output: new (require('stream').Writable)({
                        write: (chunk, encoding, callback) => callback()
                    }),
                    terminal: true
                });

                process.stdout.write(prompt);
                rl.question('', (answer) => {
                    rl.close();
                    process.stdout.write('\n');
                    resolve(answer);
                });
            });

            const password = await askPassword('Enter new password: ');
            if (password.length < 4) {
                log(`Password too short (min 4 characters).`, RED);
                process.exit(1);
            }

            const confirm = await askPassword('Confirm password: ');
            if (password !== confirm) {
                log(`Passwords do not match.`, RED);
                process.exit(1);
            }

            setPassword(password);
            log(`\n${GREEN}✓ Password set successfully.${RESET}`, GREEN);
            log(`\nLogin will now require password + TOTP code.`, RESET);
            process.exit(0);
        }

        if (subcommand === 'clear') {
            if (!isPasswordEnabled()) {
                log(`Password is not set.`, YELLOW);
                process.exit(0);
            }
            clearPassword();
            log(`${GREEN}✓ Password protection removed.${RESET}`, GREEN);
            log(`\nLogin will only require TOTP code.`, RESET);
            process.exit(0);
        }

        const unknownPasswordSub = subcommand && subcommand !== 'help' && subcommand !== '--help';
        if (unknownPasswordSub) {
            log(`Unknown subcommand: ${subcommand}`, RED);
        }
        log(`\n${BOLD}Password commands:${RESET}\n`, CYAN);
        log(`  hop password           Show password status`, RESET);
        log(`  hop password set       Set or change password`, RESET);
        log(`  hop password clear     Remove password protection`, RESET);
        process.exit(unknownPasswordSub ? 1 : 0);
    }

    // Handle `hop user` commands - multi-user management
    if (process.argv[2] === 'user') {
        const subcommand = process.argv[3];
        const username = process.argv[4];

        if (!subcommand || subcommand === 'list') {
            listUsersCommand();
            process.exit(0);
        }

        if (subcommand === 'add') {
            if (!username) {
                log(`Usage: hop user add <username>`, RED);
                process.exit(1);
            }
            await addUser(username);
            process.exit(0);
        }

        if (subcommand === 'remove' || subcommand === 'rm' || subcommand === 'delete') {
            if (!username) {
                log(`Usage: hop user remove <username>`, RED);
                process.exit(1);
            }
            await removeUser(username);
            process.exit(0);
        }

        if (subcommand === 'export') {
            if (!username) {
                log(`Usage: hop user export <username>`, RED);
                process.exit(1);
            }
            await exportUserCredentials(username);
            process.exit(0);
        }

        const unknownUserSub = subcommand && subcommand !== 'help' && subcommand !== '--help';
        if (unknownUserSub) {
            log(`Unknown subcommand: ${subcommand}`, RED);
        }
        log(`\n${BOLD}User management commands:${RESET}\n`, CYAN);
        log(`  hop user list              List all users`, RESET);
        log(`  hop user add <username>    Add a new user`, RESET);
        log(`  hop user remove <username> Remove a user`, RESET);
        log(`  hop user export <username> Export credentials for a user`, RESET);
        process.exit(unknownUserSub ? 1 : 0);
    }

    // Handle `hop workspace` commands
    if (process.argv[2] === 'workspace') {
        const subcommand = process.argv[3];
        const nameArg = process.argv[4];
        const existing = isServerRunning();

        if (!subcommand || subcommand === 'list') {
            if (existing) {
                const res = await callLocalApi(existing, '/api/workspaces', 'GET');
                if (res.status !== 200) {
                    log(`Failed to list workspaces.`, RED);
                    process.exit(1);
                }
                const names = res.data.workspaces || [];
                if (names.length === 0) {
                    log(`No workspaces found.`, YELLOW);
                } else {
                    log(`\n${BOLD}Workspaces:${RESET}\n`, CYAN);
                    names.forEach((name) => {
                        log(`  ${name}`, RESET);
                    });
                }
            } else {
                const names = listWorkspaceNames();
                if (names.length === 0) {
                    log(`No workspaces found.`, YELLOW);
                } else {
                    log(`\n${BOLD}Workspaces:${RESET}\n`, CYAN);
                    names.forEach((name) => {
                        log(`  ${name}`, RESET);
                    });
                }
            }
            process.exit(0);
        }

        if (subcommand === 'create') {
            if (!nameArg) {
                log(`Usage: hop workspace create <name>`, RED);
                process.exit(1);
            }
            if (existing) {
                const res = await callLocalApi(existing, '/api/workspaces/create', 'POST', { name: nameArg });
                if (res.status !== 200) {
                    log(res.data?.error || `Failed to create workspace.`, RED);
                    process.exit(1);
                }
            } else {
                const created = createWorkspaceFile(nameArg);
                if (created === null) {
                    log(`Invalid workspace name.`, RED);
                    process.exit(1);
                }
                if (created === false) {
                    log(`Workspace already exists.`, RED);
                    process.exit(1);
                }
            }
            log(`Workspace "${nameArg}" created.`, GREEN);
            process.exit(0);
        }

        if (subcommand === 'show') {
            if (!nameArg) {
                log(`Usage: hop workspace show <name>`, RED);
                process.exit(1);
            }
            let workspace = null;
            if (existing) {
                const res = await callLocalApi(existing, `/api/workspaces/show?name=${encodeURIComponent(nameArg)}`, 'GET');
                if (res.status !== 200) {
                    log(res.data?.error || `Workspace not found: ${nameArg}`, RED);
                    process.exit(1);
                }
                workspace = res.data?.workspace || null;
            } else {
                workspace = loadWorkspaceFile(nameArg);
                if (!workspace) {
                    log(`Workspace not found: ${nameArg}`, RED);
                    process.exit(1);
                }
            }
            printWorkspaceDetails(workspace);
            process.exit(0);
        }

        if (subcommand === 'save') {
            if (!nameArg) {
                log(`Usage: hop workspace save <name>`, RED);
                process.exit(1);
            }
            if (existing) {
                const sessionsRes = await callLocalApi(existing, '/api/sessions', 'GET');
                if (sessionsRes.status !== 200) {
                    log(`Failed to list live sessions.`, RED);
                    process.exit(1);
                }
                const liveEntries = (sessionsRes.data.sessions || [])
                    .filter((entry) => entry && entry.type === 'terminal' && entry.live === true)
                    .map((entry) => ({
                        internalName: entry.internalName,
                        displayName: entry.displayName || entry.name,
                        cwd: entry.cwd
                    }));
                const selection = await promptForWorkspaceSnapshotSelection(liveEntries);
                if (selection.cancelled) {
                    log(`Workspace save cancelled.`, YELLOW);
                    process.exit(0);
                }
                const res = await callLocalApi(existing, '/api/workspaces/save', 'POST', {
                    name: nameArg,
                    sessionNames: selection.selectedInternalNames
                });
                if (res.status !== 200) {
                    log(res.data?.error || `Failed to save workspace.`, RED);
                    process.exit(1);
                }
                const selected = Array.isArray(res.data?.selected) ? res.data.selected : [];
                log(`Workspace "${nameArg}" saved with ${selected.length} session(s).`, GREEN);
            } else {
                const snapshot = await listAllSessionEntriesRuntimeFirst();
                const liveEntries = snapshot.entries.filter((entry) => entry && entry.type === 'terminal' && entry.live === true);
                const selection = await promptForWorkspaceSnapshotSelection(liveEntries);
                if (selection.cancelled) {
                    log(`Workspace save cancelled.`, YELLOW);
                    process.exit(0);
                }
                const result = await snapshotWorkspaceFile(nameArg, selection.selectedInternalNames);
                if (!result || result.error === 'invalid-workspace') {
                    log(`Invalid workspace name.`, RED);
                    process.exit(1);
                }
                if (result.error === 'no-live-sessions') {
                    log(`No live terminal sessions to save.`, RED);
                    process.exit(1);
                }
                log(`Workspace "${nameArg}" saved with ${result.selected.length} session(s).`, GREEN);
            }
            process.exit(0);
        }

        if (subcommand === 'load') {
            if (!nameArg) {
                log(`Usage: hop workspace load <name>`, RED);
                process.exit(1);
            }
            if (existing) {
                const res = await callLocalApi(existing, '/api/workspaces/load', 'POST', { name: nameArg });
                if (res.status !== 200) {
                    log(`Failed to load workspace.`, RED);
                    process.exit(1);
                }
                const result = res.data.result || {};
                if (result.created?.length) {
                    log(`Created sessions: ${result.created.join(', ')}`, GREEN);
                }
                if (result.skipped?.length) {
                    log(`Skipped sessions: ${result.skipped.map(s => s.name).join(', ')}`, YELLOW);
                }
            } else {
                const workspace = loadWorkspaceFile(nameArg);
                if (!workspace) {
                    log(`Workspace not found: ${nameArg}`, RED);
                    process.exit(1);
                }
                await applyWorkspace(workspace, { startSessions: false, workspaceName: nameArg });
            }
            log(`Workspace "${nameArg}" loaded.`, GREEN);
            process.exit(0);
        }

        if (subcommand === 'delete' || subcommand === 'remove' || subcommand === 'rm') {
            if (!nameArg) {
                log(`Usage: hop workspace delete <name> [--yes]`, RED);
                process.exit(1);
            }
            // Confirm before deleting a workspace that still has saved definitions.
            const skipDeleteConfirm = process.argv.includes('--yes') || process.argv.includes('-y');
            if (!skipDeleteConfirm) {
                let savedCount = 0;
                if (existing) {
                    try {
                        const showRes = await callLocalApi(existing, `/api/workspaces/show?name=${encodeURIComponent(nameArg)}`, 'GET');
                        if (showRes.status === 200) {
                            savedCount = Object.keys(showRes.data?.workspace?.sessions || {}).length;
                        }
                    } catch (e) { }
                } else {
                    const workspace = loadWorkspaceFile(nameArg);
                    savedCount = Object.keys(workspace?.sessions || {}).length;
                }
                if (savedCount > 0) {
                    log(`Workspace "${nameArg}" contains ${savedCount} saved session definition(s).`, YELLOW);
                    if (!process.stdin.isTTY) {
                        log(`Refusing to delete a non-empty workspace without confirmation. Re-run with --yes.`, RED);
                        process.exit(1);
                    }
                    const confirmed = await promptYesNo(`Delete workspace "${nameArg}" and its saved definitions? [y/N] `);
                    if (!confirmed) {
                        log(`Aborted. Workspace was not deleted.`, YELLOW);
                        process.exit(1);
                    }
                }
            }
            if (existing) {
                const res = await callLocalApi(existing, '/api/workspaces/delete', 'POST', { name: nameArg });
                if (res.status !== 200) {
                    log(res.data?.error || `Failed to delete workspace.`, RED);
                    process.exit(1);
                }
            } else {
                const deleted = deleteWorkspaceFile(nameArg);
                if (deleted === null) {
                    log(`Invalid workspace name.`, RED);
                    process.exit(1);
                }
                if (deleted === false) {
                    log(`Workspace not found: ${nameArg}`, RED);
                    process.exit(1);
                }
            }
            log(`Workspace "${nameArg}" deleted.`, GREEN);
            process.exit(0);
        }

        const unknownWorkspaceSub = subcommand && subcommand !== 'help' && subcommand !== '--help';
        if (unknownWorkspaceSub) {
            log(`Unknown subcommand: ${subcommand}`, RED);
        }
        log(`\n${BOLD}Workspace commands:${RESET}\n`, CYAN);
        log(`  hop workspace list           List workspaces`, RESET);
        log(`  hop workspace create <name>  Create an empty workspace`, RESET);
        log(`  hop workspace show <name>    Show saved definitions in a workspace`, RESET);
        log(`  hop workspace save <name>    Save selected live sessions into a workspace`, RESET);
        log(`  hop workspace load <name>    Start sessions defined in a workspace`, RESET);
        log(`  hop workspace delete <name> [--yes]  Delete a workspace`, RESET);
        process.exit(unknownWorkspaceSub ? 1 : 0);
    }

    // Handle `hop session` commands
    if (process.argv[2] === 'session') {
        await ensureHayLoaded();
        const subcommand = process.argv[3];
        const nameArg = process.argv[4];

        if (!subcommand || subcommand === 'list') {
            const includeAll = process.argv.includes('--all') || process.argv.includes('-a');
            const snapshot = await listAllSessionEntriesRuntimeFirst();
            // Home-shortened working directory (live cwd when known, else the
            // configured one) so the list shows WHERE each session is working.
            const sessionCwdLabel = (s) => {
                const p = (typeof s.liveCwd === 'string' && s.liveCwd) ? s.liveCwd : (typeof s.cwd === 'string' ? s.cwd : '');
                if (!p) return '';
                const home = os.homedir();
                const shown = p === home ? '~' : (p.startsWith(`${home}/`) ? `~${p.slice(home.length)}` : p);
                return `  ${DIM}${shown}${RESET}`;
            };
            // Foreground program (what the session is running right now), as the
            // mobile session view shows. Skip a bare shell — it's the idle default.
            const sessionProcLabel = (s) => {
                const proc = (typeof s.foregroundProcess === 'string' ? s.foregroundProcess : '').replace(/^-/, '').trim();
                if (!proc) return '';
                // Claude Code titles its process with a bare version ("2.1.211");
                // label it for what it is instead of a cryptic number.
                if (/^\d+\.\d+\.\d+$/.test(proc)) return `  ${MAGENTA}claude${RESET} ${DIM}${proc}${RESET}`;
                return `  ${MAGENTA}${proc}${RESET}`;
            };
            const printSessionRow = (s) => {
                if (s.type === 'port') {
                    const workspaceSuffix = Array.isArray(s.workspaceNames) && s.workspaceNames.length
                        ? `, WORKSPACE ${s.workspaceNames.join(',')}`
                        : '';
                    log(`  ${BOLD}${s.displayName}${RESET}  ${YELLOW}[PORT ${s.port}${workspaceSuffix}]${RESET}`, RESET);
                } else {
                    const workspaceSuffix = Array.isArray(s.workspaceNames) && s.workspaceNames.length
                        ? `, WORKSPACE ${s.workspaceNames.join(',')}`
                        : '';
                    const clients = Number(s.clientCount) || 0;
                    const clientChip = `${DIM} · ${clients} ${clients === 1 ? 'client' : 'clients'}${RESET}`;
                    const stateLabel = s.live
                        ? `${GREEN}[TERMINAL, LIVE${workspaceSuffix}]${RESET}${clientChip}`
                        : `${YELLOW}[TERMINAL${workspaceSuffix}]${RESET}`;
                    log(`  ${BOLD}${s.displayName}${RESET}${sessionCwdLabel(s)}${sessionProcLabel(s)}  ${stateLabel}`, RESET);
                }
            };
            if (includeAll) {
                const liveSessions = snapshot.entries.filter((session) => session && session.live === true);
                const workspaceDefs = listWorkspaceSessionDefinitions();
                const liveByName = new Map(liveSessions.map((session) => [
                    session.internalName,
                    { ...session, workspaceNames: [] }
                ]));
                const savedOnly = new Map();

                for (const def of workspaceDefs) {
                    if (liveByName.has(def.internalName)) {
                        const entry = liveByName.get(def.internalName);
                        entry.workspaceNames.push(def.workspaceName);
                        liveByName.set(def.internalName, entry);
                        continue;
                    }
                    const existing = savedOnly.get(def.internalName);
                    if (existing) {
                        existing.workspaceNames.push(def.workspaceName);
                        savedOnly.set(def.internalName, existing);
                    } else {
                        savedOnly.set(def.internalName, {
                            ...def,
                            live: false,
                            workspaceNames: [def.workspaceName]
                        });
                    }
                }

                const liveEntries = Array.from(liveByName.values());
                const savedEntries = Array.from(savedOnly.values());
                if (liveEntries.length === 0 && savedEntries.length === 0) {
                    log(`No sessions configured.`, YELLOW);
                    process.exit(0);
                }

                log(`\n${BOLD}Live sessions:${RESET}\n`, CYAN);
                if (liveEntries.length) {
                    liveEntries.forEach(printSessionRow);
                } else {
                    log(`  (none)`, DIM);
                }

                log(`\n${BOLD}Saved definitions:${RESET}\n`, CYAN);
                if (savedEntries.length) {
                    // Group saved definitions by workspace (a definition saved in
                    // several workspaces is listed under each one).
                    const byWorkspace = new Map();
                    for (const def of savedEntries) {
                        const names = Array.isArray(def.workspaceNames) && def.workspaceNames.length
                            ? def.workspaceNames
                            : ['(no workspace)'];
                        for (const workspaceName of names) {
                            if (!byWorkspace.has(workspaceName)) byWorkspace.set(workspaceName, []);
                            byWorkspace.get(workspaceName).push(def);
                        }
                    }
                    for (const workspaceName of Array.from(byWorkspace.keys()).sort((a, b) => a.localeCompare(b))) {
                        log(`  ${BOLD}Workspace: ${workspaceName}${RESET}`, RESET);
                        byWorkspace.get(workspaceName).forEach(printSessionRow);
                    }
                } else {
                    log(`  (none)`, DIM);
                }
                process.exit(0);
            }

            const sessions = snapshot.entries.filter((session) => session && session.type === 'terminal' && session.live === true);
            if (sessions.length === 0) {
                log(`No live sessions.`, YELLOW);
                process.exit(0);
            }
            log(`\n${BOLD}Sessions:${RESET}\n`, CYAN);
            sessions.forEach(printSessionRow);
            process.exit(0);
        }

        if (subcommand === 'add') {
            if (!nameArg) {
                log(`Usage: hop session add <name> [--port <number>] [--cwd <path>] --workspace <name>`, RED);
                process.exit(1);
            }
            const existingTunnel = isServerRunning();
            const displayName = nameArg;
            const name = toInternalSessionName(displayName);
            const workspaceArgIndex = process.argv.indexOf('--workspace');
            const explicitWorkspaceName = workspaceArgIndex !== -1
                ? normalizeWorkspaceName(process.argv[workspaceArgIndex + 1])
                : null;
            if (!explicitWorkspaceName) {
                log(`session add requires --workspace <name> to choose where the definition is saved.`, RED);
                log(`Example: ${CYAN}hop session add ${displayName} --port 3000 --workspace dev${RESET}`, RESET);
                log(`Tip: ${CYAN}hop workspace save <name>${RESET} snapshots live sessions instead.`, RESET);
                process.exit(1);
            }
            if (!name) {
                log(`Invalid session name.`, RED);
                process.exit(1);
            }
            if (isDisplayNameInUse(displayName)) {
                log(`Session name already in use.`, RED);
                process.exit(1);
            }
            if (hasSavedSessionConfig(name)) {
                log(`Session internal name already exists.`, RED);
                process.exit(1);
            }
            const cwdArgIndex = process.argv.indexOf('--cwd');
            let cwdPath = process.cwd();
            if (cwdArgIndex !== -1) {
                const cwdArg = process.argv[cwdArgIndex + 1];
                if (!cwdArg || cwdArg.startsWith('--')) {
                    log(`Missing path after --cwd.`, RED);
                    process.exit(1);
                }
                cwdPath = path.resolve(cwdArg);
                try {
                    if (!fs.existsSync(cwdPath) || !fs.statSync(cwdPath).isDirectory()) {
                        log(`Invalid directory for --cwd: ${cwdPath}`, RED);
                        process.exit(1);
                    }
                } catch (e) {
                    log(`Invalid directory for --cwd: ${cwdPath}`, RED);
                    process.exit(1);
                }
            }
            const portArgIndex = process.argv.indexOf('--port');
            if (portArgIndex !== -1) {
                const portArg = parseInt(process.argv[portArgIndex + 1], 10);
                if (!Number.isInteger(portArg) || portArg < 1 || portArg > 65535) {
                    log(`Invalid port. Use 1-65535.`, RED);
                    process.exit(1);
                }
                if (existingTunnel) {
                    let res = null;
                    try {
                        res = await callLocalApi(existingTunnel, '/api/sessions', 'POST', {
                            name: displayName,
                            type: 'port',
                            port: portArg,
                            startRuntime: false,
                            workspace: explicitWorkspaceName
                        });
                    } catch (e) {
                        res = null; // daemon unreachable; fall back to direct file edit
                    }
                    if (res) {
                        if (res.status >= 200 && res.status < 300) {
                            log(`Saved port session "${displayName}" → localhost:${portArg} to workspace "${explicitWorkspaceName}".`, GREEN);
                            process.exit(0);
                        }
                        log(res.data?.error || `Request failed (status ${res.status})`, RED);
                        process.exit(1);
                    }
                }
                if (await runtimeTerminalSessionExists(name)) {
                    log(`Terminal session already exists with this name.`, RED);
                    process.exit(1);
                }
                const saved = upsertWorkspaceSessionDefinition(explicitWorkspaceName, name, {
                    type: 'port',
                    port: portArg,
                    displayName,
                    createdAt: new Date().toISOString(),
                    updatedAt: new Date().toISOString(),
                    createdBy: 'user',
                    agentPermitted: false,
                    workspaceName: explicitWorkspaceName
                });
                if (!saved) {
                    log(`Failed to save port session definition.`, RED);
                    process.exit(1);
                }
                log(`Saved port session "${displayName}" → localhost:${portArg} to workspace "${explicitWorkspaceName}".`, GREEN);
                process.exit(0);
            }

            const existingConfig = getEffectiveSessionConfig(name);
            if (existingConfig && existingConfig.type === 'port') {
                log(`Port session already exists with this name.`, RED);
                process.exit(1);
            }
            if (existingTunnel) {
                let res = null;
                try {
                    res = await callLocalApi(existingTunnel, '/api/sessions', 'POST', {
                        name: displayName,
                        type: 'terminal',
                        cwd: cwdPath,
                        startRuntime: false,
                        workspace: explicitWorkspaceName
                    });
                } catch (e) {
                    res = null; // daemon unreachable; fall back to direct file edit
                }
                if (res) {
                    if (res.status >= 200 && res.status < 300) {
                        log(`Saved terminal session "${displayName}" to workspace "${explicitWorkspaceName}".`, GREEN);
                        process.exit(0);
                    }
                    log(res.data?.error || `Request failed (status ${res.status})`, RED);
                    process.exit(1);
                }
            }
            const saved = upsertWorkspaceSessionDefinition(explicitWorkspaceName, name, {
                type: 'terminal',
                cwd: cwdPath,
                displayName,
                createdAt: new Date().toISOString(),
                updatedAt: new Date().toISOString(),
                createdBy: 'user',
                agentPermitted: false,
                workspaceName: explicitWorkspaceName
            });
            if (!saved) {
                log(`Failed to save terminal session definition.`, RED);
                process.exit(1);
            }
            log(`Saved terminal session "${displayName}" to workspace "${explicitWorkspaceName}".`, GREEN);
            process.exit(0);
        }

        if (subcommand === 'origin') {
            const target = process.argv[5];
            if (!nameArg || (target !== 'user' && target !== 'agent')) {
                log(`Usage: hop session origin <name> <user|agent>`, RED);
                process.exit(1);
            }
            const resolvedDisplay = resolveDisplayNameAlias(nameArg);
            const internalName = findInternalSessionName(resolvedDisplay) || toInternalSessionName(resolvedDisplay);
            const existingTunnel = isServerRunning();
            if (!existingTunnel) {
                printNotRunningError();
                process.exit(1);
            }
            let res = null;
            try {
                res = await callLocalApi(existingTunnel, '/api/sessions/origin', 'POST', { internalName, createdBy: target });
            } catch (e) { res = null; }
            if (res && res.status >= 200 && res.status < 300 && res.data && res.data.ok === true) {
                log(`"${nameArg}" is now a ${target} session.`, GREEN);
                process.exit(0);
            }
            if (res && !(res.data && typeof res.data === 'object')) {
                log(`Daemon did not recognize this endpoint — restart it with hop stop && hop start (sessions keep running).`, YELLOW);
                process.exit(1);
            }
            log(res?.data?.error || 'Request failed.', RED);
            process.exit(1);
        }

        if (subcommand === 'permit' || subcommand === 'block') {
            if (!nameArg) {
                log(`Usage: hop session ${subcommand} <name>`, RED);
                process.exit(1);
            }
            const displayName = nameArg;
            const resolvedDisplayName = resolveDisplayNameAlias(displayName);
            const internalName = findInternalSessionName(resolvedDisplayName) || toInternalSessionName(resolvedDisplayName);
            const allowed = subcommand === 'permit';

            const existingTunnel = isServerRunning();
            if (existingTunnel) {
                let res = null;
                try {
                    res = await callLocalApi(existingTunnel, '/api/sessions/agent-permission', 'POST', {
                        internalName,
                        allowed
                    });
                } catch (e) {
                    res = null; // daemon unreachable; fall back to direct file edit
                }
                if (res) {
                    if (res.status >= 200 && res.status < 300) {
                        log(`${allowed ? 'Allowed' : 'Blocked'} agent access for "${displayName}".`, GREEN);
                        process.exit(0);
                    }
                    log(res.data?.error || `Request failed (status ${res.status})`, RED);
                    process.exit(1);
                }
            }

            const savedConfig = getSessionConfig(internalName);
            const config = getEffectiveSessionConfig(internalName);
            if (!config || config.type === 'port') {
                log(`Session not found or not a terminal.`, RED);
                process.exit(1);
            }
            config.agentPermitted = allowed;
            if (!config.createdBy) config.createdBy = 'user';
            config.updatedAt = new Date().toISOString();
            if (savedConfig) {
                setSessionConfig(internalName, config);
            } else {
                rememberRuntimeSessionMetadata(internalName, config);
            }
            log(`${allowed ? 'Allowed' : 'Blocked'} agent access for "${displayName}".`, GREEN);
            process.exit(0);
        }

        if (subcommand === 'rename' || subcommand === 'mv') {
            const newNameArg = process.argv[5];
            if (!nameArg || !newNameArg) {
                log(`Usage: hop session rename <old-name> <new-name>`, RED);
                process.exit(1);
            }
            const oldDisplayName = nameArg;
            const newDisplayName = newNameArg;

            const existingTunnel = isServerRunning();
            if (existingTunnel) {
                let res = null;
                try {
                    res = await callLocalApi(existingTunnel, '/api/sessions/rename', 'POST', {
                        oldName: oldDisplayName,
                        newName: newDisplayName
                    });
                } catch (e) {
                    res = null; // daemon unreachable; fall back to direct file edit
                }
                if (res) {
                    if (res.status >= 200 && res.status < 300) {
                        log(`Renamed session "${oldDisplayName}" to "${newDisplayName}".`, GREEN);
                        process.exit(0);
                    }
                    log(res.data?.error || `Request failed (status ${res.status})`, RED);
                    process.exit(1);
                }
            }

            try {
                renameSessionDisplayName(oldDisplayName, newDisplayName);
                log(`Renamed session "${oldDisplayName}" to "${newDisplayName}".`, GREEN);
                process.exit(0);
            } catch (e) {
                log(e?.message || 'Rename failed.', RED);
                process.exit(1);
            }
        }

        if (subcommand === 'remove' || subcommand === 'rm' || subcommand === 'delete') {
            if (!nameArg) {
                log(`Usage: hop session remove <name>`, RED);
                process.exit(1);
            }
            const displayName = nameArg;
            const resolvedDisplayName = resolveDisplayNameAlias(displayName);
            const name = hasSavedSessionConfig(displayName)
                ? displayName
                : (findInternalSessionName(resolvedDisplayName) || toInternalSessionName(resolvedDisplayName));
            if (!name) {
                log(`Session not found.`, RED);
                process.exit(1);
            }
            const existingTunnel = isServerRunning();
            if (existingTunnel) {
                let res = null;
                try {
                    res = await callLocalApi(existingTunnel, '/api/sessions/delete', 'POST', {
                        internalName: name
                    });
                } catch (e) {
                    res = null; // daemon unreachable; fall back to direct file edit
                }
                if (res) {
                    if (res.status >= 200 && res.status < 300) {
                        if (res.data?.type === 'port') {
                            log(`Removed port session "${displayName}".`, GREEN);
                        } else {
                            log(`Removed terminal session "${displayName}".`, GREEN);
                        }
                        process.exit(0);
                    }
                    log(res.data?.error || `Request failed (status ${res.status})`, RED);
                    process.exit(1);
                }
            }
            const savedConfig = getSessionConfig(name);
            const config = getEffectiveSessionConfig(name);
            if (config && config.type === 'port') {
                deleteSessionConfig(name);
                clearRuntimeSessionMetadata(name);
                log(`Removed port session "${displayName}".`, GREEN);
                process.exit(0);
            }
            // Close hay room if it exists
            if (isExternalTerminalBackend()) {
                await terminateExternalHaySession(name);
            } else if (hayRooms.hasRoom(name)) {
                hayRooms.closeRoom(name);
            }
            if (activeSessions[name]) {
                delete activeSessions[name];
            }
            clearRuntimeSessionMetadata(name);
            if (savedConfig) {
                deleteSessionConfig(name);
            }
            log(`Removed terminal session "${displayName}".`, GREEN);
            process.exit(0);
        }

        const unknownSessionSub = subcommand && subcommand !== 'help' && subcommand !== '--help';
        if (unknownSessionSub) {
            log(`Unknown subcommand: ${subcommand}`, RED);
        }
        log(`\n${BOLD}Session commands:${RESET}\n`, CYAN);
        log(`  hop session list [--all|-a]      List live sessions (--all/-a adds workspace defs across all workspaces)`, RESET);
        log(`  hop session add <name> [--cwd P] --workspace W  Save a terminal definition to a workspace`, RESET);
        log(`  hop session add <name> --port N --workspace W   Save a port definition to a workspace`, RESET);
        log(`  hop session rename <old> <new>   Rename a session`, RESET);
        log(`  hop session remove <name>        Remove a session`, RESET);
        log(`  hop session permit <name>        Allow agent access`, RESET);
        log(`  hop session origin <name> <user|agent>  Move a session between user/agent sides (switcher filter + restore policy)`, RESET);
        log(`  hop session block <name>         Block agent access`, RESET);
        process.exit(unknownSessionSub ? 1 : 0);
    }

    // Handle `hop wipe` command - removes workspace-defined sessions by default
    if (process.argv[2] === 'wipe') {
        const wipeAll = process.argv.includes('--all');
        const wipeAgent = process.argv.includes('--agent');
        const existingTunnel = isServerRunning();

        // hop wipe --agent: close all agent-created terminal API sessions
        if (wipeAgent) {
            if (!existingTunnel) {
                printNotRunningError();
                process.exit(1);
            }
            const http = require('http');
            const terminalsRes = await new Promise((resolve, reject) => {
                const opts = {
                    hostname: '127.0.0.1',
                    port: existingTunnel.port,
                    path: '/api/terminals',
                    method: 'GET',
                    headers: { 'Authorization': `Bearer ${existingTunnel.sessionSecret}` }
                };
                const req = http.request(opts, res => {
                    let data = '';
                    res.on('data', chunk => data += chunk);
                    res.on('end', () => resolve({ status: res.statusCode, data }));
                });
                req.on('error', reject);
                req.end();
            });
            const terminalsData = JSON.parse(terminalsRes.data);
            const agentTerminals = (terminalsData.terminals || []).filter(t => t && t.actor === 'agent');
            if (agentTerminals.length === 0) {
                log(`No agent terminal sessions to clean up.`, GREEN);
                process.exit(0);
            }
            log(`Closing ${agentTerminals.length} agent terminal session(s)...`, YELLOW);
            for (const t of agentTerminals) {
                try {
                    await new Promise((resolve, reject) => {
                        const opts = {
                            hostname: '127.0.0.1',
                            port: existingTunnel.port,
                            path: `/api/terminals/${encodeURIComponent(t.id)}`,
                            method: 'DELETE',
                            headers: { 'Authorization': `Bearer ${existingTunnel.sessionSecret}` }
                        };
                        const req = http.request(opts, res => {
                            let data = '';
                            res.on('data', chunk => data += chunk);
                            res.on('end', () => resolve({ status: res.statusCode, data }));
                        });
                        req.on('error', reject);
                        req.end();
                    });
                    log(`  - ${t.displayName || t.sessionName || t.id}`, RESET);
                } catch (e) {
                    log(`  - ${t.displayName || t.sessionName || t.id} (failed)`, YELLOW);
                }
            }
            log(`Done.`, GREEN);
            process.exit(0);
        }

        if (existingTunnel) {
            // Server is running - call API to delete sessions
            const http = require('http');

            // First get list of sessions
            const sessionsRes = await new Promise((resolve, reject) => {
                const opts = {
                    hostname: '127.0.0.1',
                    port: existingTunnel.port,
                    path: '/api/sessions',
                    method: 'GET',
                    headers: { 'Authorization': `Bearer ${existingTunnel.sessionSecret}` }
                };
                const req = http.request(opts, res => {
                    let data = '';
                    res.on('data', chunk => data += chunk);
                    res.on('end', () => resolve({ status: res.statusCode, data }));
                });
                req.on('error', reject);
                req.end();
            });

            const sessionsData = JSON.parse(sessionsRes.data);
            const sessions = Array.isArray(sessionsData.sessions) ? sessionsData.sessions : [];
            const liveSessions = sessions.filter((s) => s.type === 'terminal' && s.live === true);
            const unknownTerminalSessions = sessions.filter((s) => s.type === 'terminal' && typeof s.live !== 'boolean');
            const targets = wipeAll
                ? sessions
                : sessions.filter((s) => s.type === 'port' || s.live === false);

            if (targets.length === 0) {
                if (wipeAll) {
                    log(`No hop sessions to clean up.`, GREEN);
                } else {
                    if (liveSessions.length > 0 || unknownTerminalSessions.length > 0) {
                        log(`No workspace-defined sessions to clean up.`, GREEN);
                        if (liveSessions.length > 0) {
                            log(`Use ${CYAN}hop wipe --all${RESET} to also kill ${liveSessions.length} live session(s).`, RESET);
                        }
                        if (unknownTerminalSessions.length > 0) {
                            log(`Keeping ${unknownTerminalSessions.length} terminal session(s) with unknown live state. Restart Hop to classify them, or use ${CYAN}hop wipe --all${RESET}.`, RESET);
                        }
                    } else {
                        log(`No hop sessions to clean up.`, GREEN);
                    }
                }
                process.exit(0);
            }

            if (wipeAll) {
                // Killing live sessions is destructive; confirm unless --yes was passed.
                const skipWipeConfirm = process.argv.includes('--yes') || process.argv.includes('-y');
                if (!skipWipeConfirm) {
                    log(`About to kill ${targets.length} session(s):`, YELLOW);
                    targets.forEach((s) => log(`  - ${s.displayName || s.name}`, RESET));
                    if (!process.stdin.isTTY) {
                        log(`Refusing to kill sessions without confirmation (non-interactive). Re-run with --yes.`, RED);
                        process.exit(1);
                    }
                    const confirmed = await promptYesNo(`Kill these ${targets.length} session(s)? [y/N] `);
                    if (!confirmed) {
                        log(`Aborted. No sessions were killed.`, YELLOW);
                        process.exit(1);
                    }
                }
                log(`Killing ${targets.length} hop session(s)...`, YELLOW);
            } else {
                const skippedLive = liveSessions.length;
                log(`Removing ${targets.length} workspace-defined session(s)...`, YELLOW);
                if (skippedLive > 0) {
                    log(`Keeping ${skippedLive} live session(s). Use ${CYAN}hop wipe --all${RESET} to kill them.`, RESET);
                }
                if (unknownTerminalSessions.length > 0) {
                    log(`Keeping ${unknownTerminalSessions.length} terminal session(s) with unknown live state. Restart Hop to classify them, or use ${CYAN}hop wipe --all${RESET}.`, RESET);
                }
            }

            for (const s of targets) {
                try {
                    await new Promise((resolve, reject) => {
                        const opts = {
                            hostname: '127.0.0.1',
                            port: existingTunnel.port,
                            path: '/api/sessions/delete',
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${existingTunnel.sessionSecret}`
                            }
                        };
                        const req = http.request(opts, res => {
                            let data = '';
                            res.on('data', chunk => data += chunk);
                            res.on('end', () => resolve({ status: res.statusCode, data }));
                        });
                        req.on('error', reject);
                        req.write(JSON.stringify({ name: s.name }));
                        req.end();
                    });
                    log(`  - ${s.displayName || s.name}`, RESET);
                } catch (e) {
                    log(`  - ${s.displayName || s.name} (failed)`, YELLOW);
                }
            }
            log(`Done.`, GREEN);
        } else {
            // Server not running - just clean up config files
            const sessions = Object.keys(sessionStore.sessions);
            if (sessions.length === 0) {
                log(`No hop sessions to clean up.`, GREEN);
                process.exit(0);
            }
            log(`Cleaning up ${sessions.length} session config(s)...`, YELLOW);
            for (const name of sessions) {
                deleteSessionConfig(name);
                log(`  - ${getSessionDisplayName(name)}`, RESET);
            }
            log(`Done.`, GREEN);
        }
        process.exit(0);
    }

    // The default flow always starts a NEW session: bare `hop`, `hop new`, and
    // `hop --new` are equivalent. To reuse a running session, use `hop attach`.
    // (`new`/`--new` pass the typo gate below as explicit aliases.)
    if (process.argv[2] && process.argv[2] !== '--daemon' && process.argv[2] !== 'new' && process.argv[2] !== '--new') {
        const badCommand = process.argv[2];
        log(`Unknown command: ${badCommand}`, RED);
        const suggestion = suggestNearestCommand(badCommand);
        if (suggestion) {
            log(`Did you mean ${CYAN}hop ${suggestion}${RESET}?`, RESET);
        }
        log(`Run ${CYAN}hop --help${RESET} for usage.`, RESET);
        process.exit(2);
    }

    // Autostart safety: bare `hop` belongs at the end of a shell rc, so it must
    // refuse to hijack contexts that aren't an interactive terminal. Without
    // these guards, `ssh host <command>`, scp/rsync/git-over-ssh (any stray
    // stdout corrupts their protocol), scripts, and cron would all launch the
    // interactive attach flow — and inside a hop terminal it would nest a
    // session in a session.
    if (!DAEMON_FLAG) {
        if (process.env.HOP_SESSION) {
            if (process.stdout.isTTY) {
                log(`Already inside hop session '${process.env.HOP_SESSION}'. Use ${CYAN}hop attach <name>${RESET} to switch or ${CYAN}hop session list${RESET} to browse.`, DIM);
            }
            process.exit(0);
        }
        if (!process.stdin.isTTY || !process.stdout.isTTY) {
            // Non-interactive invocation (ssh command, pipe, script): do nothing,
            // print nothing, succeed — the surrounding command must be unaffected.
            process.exit(0);
        }
        if (process.env.HOP_AUTOSTART === '0') process.exit(0);
        if (process.env.HOP_AUTOSTART !== '1') {
            const verdict = evaluateAutostartCommandShell();
            if (verdict.skip) {
                if (process.env.HOP_DEBUG === '1') {
                    console.error(`[hop] autostart skipped: parent shell was started with -c (${verdict.parent}). HOP_AUTOSTART=1 overrides.`);
                }
                process.exit(0);
            }
        }
    }

    if (process.stdout.isTTY) console.clear(); // Clear screen without wiping scrollback

    // Only one instance allowed
    if (!DAEMON_FLAG) {
        const existingTunnel = isServerRunning();
        if (existingTunnel) {
            await attachToExistingTunnel(existingTunnel, { forceNew: true });
            return;
        }

        // No server yet: start daemon and wait for it to come up
        loadAuthSecret();
        await maybeOfferFirstRunPassword();
        await checkAndInstallDependencies();
        startDaemon();
        const state = await waitForDaemonReady();
        const domainConfig = getDomainConfig();
        const label = domainConfig?.hostname ? `Hop-${domainConfig.hostname}` : 'Hop';
        loadAuthSecret();
        await waitForStartPolling(state, label);
        log(`[4/4] Attaching to session...`, BOLD);
        await attachToExistingTunnel(state, { forceNew: true });
        return;
    }

    // SERVER MODE: Start new tunnel

    // Require password for custom domains
    const domainConfig = getDomainConfig();
    if (domainConfig && domainConfig.hostname && !isPasswordEnabled()) {
        log(`\n${RED}ERROR: Password required for custom domain.${RESET}`, RED);
        log(`\nYour fixed URL (${domainConfig.hostname}) is publicly known.`, YELLOW);
        log(`Password protection is required for security.\n`, RESET);
        log(`Run: ${CYAN}hop password set${RESET}`, RESET);
        process.exit(1);
    }

    loadAuthSecret();

    // Write state file early to prevent race condition where multiple daemons spawn
    // Other hop processes will see this and wait instead of spawning another daemon
    if (DAEMON_FLAG) {
        writePrivateFile(STATE_FILE, JSON.stringify({
            pid: process.pid,
            port: BASE_PORT,
            url: null,  // Not yet known, will be updated after tunnel starts
            sessionSecret: SESSION_SECRET,
            startTime: Date.now()
        }));
    }

    await checkAndInstallDependencies();
    await ensureHayLoaded();
    await ensureExternalHayHostReady();
    await reconcileExternalRuntimeSessions();
    const authEmitter = new EventEmitter();

    const proxyServer = startAuthProxy(authEmitter);
    const { tunnel: tunnelProc, publicUrl } = await startTunnel();

    // Save state for other terminals to find
    writePrivateFile(STATE_FILE, JSON.stringify({
        pid: process.pid,
        port: BASE_PORT,
        url: publicUrl,
        sessionSecret: SESSION_SECRET,
        startTime: Date.now()
    }));

    // Start tunnel health monitoring (detects stale connections after VPN changes)
    startTunnelHealthMonitor();

    if (DAEMON_FLAG) {
        // Taglines maintain themselves: one session per tick, only when it
        // needs one. First pass a minute after boot so startup stays quiet.
        // Errors are logged rather than swallowed — a silent no-op feature is
        // indistinguishable from a broken one.
        const runSweep = () => {
            Promise.resolve()
                .then(() => sweepTaglines())
                .catch((e) => log(`[tagline] sweep error: ${e && e.message}`, YELLOW));
        };
        log(`[tagline] auto-sweep ${TAGLINE_DISABLED ? 'disabled by HOP_AI_TAGLINES' : 'enabled'}`, CYAN);
        setTimeout(runSweep, 60000).unref?.();
        setInterval(runSweep, 180000).unref?.();
    }

    if (DAEMON_FLAG) {
        const cleanup = () => {
            if (shuttingDown) return;
            shuttingDown = true;
            log(`Cleaning up...`, YELLOW);

            stopTunnelHealthMonitor();

            // Only remove our own registration (see the daemon cleanup note).
            if (fs.existsSync(STATE_FILE)) {
                try {
                    const st = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));
                    if (!st || !Number.isInteger(st.pid) || st.pid === process.pid) fs.unlinkSync(STATE_FILE);
                } catch (e) {
                    try { fs.unlinkSync(STATE_FILE); } catch (e2) { }
                }
            }

            if (!isExternalTerminalBackend()) {
                hayRooms.closeAll();
            }
            closeAllSessionAuditSinks();

            try { (currentTunnelProc || tunnelProc).kill('SIGTERM'); } catch (e) { }
            try { proxyServer.close(); } catch (e) { }

            process.exit(0);
        };

        process.on('SIGINT', cleanup);
        process.on('SIGTERM', cleanup);
        process.on('exit', cleanup);

        // SIGUSR1 = restart tunnel (used by `hop health --restart`)
        process.on('SIGUSR1', () => {
            log(`[Tunnel] Received restart signal. Restarting tunnel...`, YELLOW);
            if (currentTunnelProc && !currentTunnelProc.killed) {
                try { currentTunnelProc.kill('SIGTERM'); } catch (e) { }
                // The 'close' handler will trigger startTunnelWithRestart
            } else {
                // Cloudflared already dead, restart directly
                startTunnelWithRestart();
            }
        });

        await new Promise(() => {});
    }

    await waitForStart(authEmitter, publicUrl);

    await startLocalSession(proxyServer, tunnelProc, publicUrl);
}

main().catch(err => {
    log(`Fatal: ${err.message}`, RED);
    process.exit(1);
});
