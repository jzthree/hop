const REGISTRATION_STATUS_LABEL = {
    pending_email: 'unconfirmed email',
    pending_approval: 'awaiting your decision',
    approved: 'approved — credentials not yet collected',
    claimed: 'set up',
    rejected: 'rejected'
};

function listPendingRegistrations() {
    const store = getRegistrationStore();
    const all = store.list();
    const waiting = all.filter((r) => r.status === 'pending_approval');

    if (waiting.length === 0) {
        log(`\nNothing waiting for approval.`, YELLOW);
    } else {
        log(`\n${BOLD}Waiting for you:${RESET}\n`, CYAN);
        for (const r of waiting) {
            const when = r.verifiedAt ? new Date(r.verifiedAt).toLocaleString() : 'unknown';
            log(`  ${BOLD}${r.subdomain}${RESET}`, GREEN);
            log(`    Email:     ${r.email}${r.fullName ? `  (${r.fullName})` : ''}`, RESET);
            if (r.department) log(`    Dept:      ${r.department}`, RESET);
            if (r.areaOfExpertise) log(`    Expertise: ${r.areaOfExpertise}`, RESET);
            log(`    ${r.verifiedVia === 'cloudflare-access' ? 'Requested:' : 'Confirmed:'} ${when}`, RESET);
            log(`    Approve:   ${CYAN}hop user approve ${r.subdomain}${RESET}`, RESET);
            log('');
        }
    }

    const others = all.filter((r) => r.status !== 'pending_approval');
    if (others.length > 0) {
        log(`${BOLD}Everything else:${RESET}`, RESET);
        for (const r of others) {
            log(`  ${r.subdomain} — ${REGISTRATION_STATUS_LABEL[r.status] || r.status}${r.reason ? ` (${r.reason})` : ''}`, DIM);
        }
        log('');
    }
}

async function approveRegistration(subdomain) {
    const name = String(subdomain || '').toLowerCase();
    const store = getRegistrationStore();
    const entry = store.get(name);

    if (!entry) {
        log(`No registration for "${name}". See: hop user pending`, RED);
        process.exit(1);
    }
    if (entry.status !== 'pending_approval') {
        log(`"${name}" is ${REGISTRATION_STATUS_LABEL[entry.status] || entry.status} — nothing to approve.`, YELLOW);
        process.exit(1);
    }
    if (!registrationUsesAccessGate() && !getMailConfig()) {
        log(`Mail is not configured, so they could never be told. Run: hop mail setup`, RED);
        process.exit(1);
    }

    log(`\n${BOLD}Approving ${name} for ${entry.email}${RESET}\n`, CYAN);

    // Provision FIRST. addUser exits non-zero if the tunnel or DNS fails, and
    // by leaving the registration untouched until it succeeds, a failed run
    // is simply retryable — no half-approved state, no dead claim link.
    await addUser(name);
    await exportUserCredentials(name);

    const users = getUsers();
    const provisioned = users[name] || {};
    store.markProvisioned(name, {
        hostname: provisioned.hostname,
        tunnelId: provisioned.tunnelId,
        tunnelName: provisioned.tunnelName
    });

    const approval = store.approve(name, { by: 'admin' });
    if (!approval.ok) {
        log(`\nProvisioned, but could not mark approved: ${approval.error}`, RED);
        process.exit(1);
    }

    const landingHost = getLandingHostname();
    if (registrationUsesAccessGate()) {
        // No link to send: the credential page is behind Cloudflare Access,
