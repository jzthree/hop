// ── Lifecycle lock ────────────────────────────────────────────────────────
// Restarting the daemon while a restore is mid-flight cost a live fleet 17
// sessions: the host was cycled underneath sessions that were still being
// relaunched. Any operation that starts, stops, or rebuilds the fleet takes
// this lock first, so those operations serialize instead of racing. The lock
// is a file holding {pid, op, at}; a holder whose pid is gone (or that has
// held it absurdly long) is considered stale and taken over, so a crash can
// never wedge hop permanently.
const LIFECYCLE_LOCK_FILE = path.join(HOME_DIR, '.lifecycle.lock');
const LIFECYCLE_LOCK_STALE_MS = 10 * 60_000;

function readLifecycleLock() {
    try {
        const raw = JSON.parse(fs.readFileSync(LIFECYCLE_LOCK_FILE, 'utf8'));
        if (!raw || !Number.isInteger(raw.pid)) return null;
        if (!isProcessAlive(raw.pid)) return null;
        if (Date.now() - Number(raw.at || 0) > LIFECYCLE_LOCK_STALE_MS) return null;
        return raw;
    } catch (e) {
        return null;
    }
}

// Returns a release function, or null when someone else holds it.
function acquireLifecycleLock(op) {
    const held = readLifecycleLock();
    if (held && held.pid !== process.pid) return null;
    try {
        fs.mkdirSync(HOME_DIR, { recursive: true });
        fs.writeFileSync(LIFECYCLE_LOCK_FILE, JSON.stringify({ pid: process.pid, op, at: Date.now() }), { mode: 0o600 });
    } catch (e) {
        return () => {}; // unwritable home — never block the operation itself
    }
    let released = false;
    return () => {
        if (released) return;
        released = true;
        try {
            const cur = JSON.parse(fs.readFileSync(LIFECYCLE_LOCK_FILE, 'utf8'));
            if (cur && cur.pid === process.pid) fs.unlinkSync(LIFECYCLE_LOCK_FILE);
        } catch (e) { /* already gone */ }
    };
}

