async function withLifecycleLock(op, fn, { waitMs = 120_000, onWait } = {}) {
    const startedAt = Date.now();
    let notified = false;
    for (;;) {
        const release = acquireLifecycleLock(op);
        if (release) {
            try { return await fn(); }
            finally { release(); }
        }
        const held = readLifecycleLock();
        if (Date.now() - startedAt > waitMs) {
            throw new Error(`another hop operation (${held?.op || 'unknown'}) is still running; try again shortly`);
        }
