    let names = [];
    try { names = fs.readdirSync(HOP_SKILLS_DIR); } catch (e) { names = ['hop-session', 'hop-manager']; }
    for (const root of roots) for (const name of names) {
        const dir = path.join(root, 'skills', name);
        try {
            if (fs.existsSync(dir)) {
                fs.rmSync(dir, { recursive: true });
                removed.push(dir);
            }
        } catch (e) { /* keep removing the rest */ }
    }
    return { ok: true, removed };
}

function readClaudeSettings() {
    const p = getClaudeSettingsPath();
    try {
        return { path: p, data: JSON.parse(fs.readFileSync(p, 'utf8')) };
    } catch (e) {
        return { path: p, data: {} };
    }
}

function hookGroupsHaveScript(groups) {
    return Array.isArray(groups) && groups.some((g) => Array.isArray(g?.hooks) && g.hooks.some(
        (h) => h && typeof h.command === 'string' && h.command.includes('claude-session-hook.js')
    ));
}

// Installed only when every event we manage carries the hook (so an upgrade from
// the SessionStart-only version reports "not installed" and re-install adds Stop).
function claudeHookIsInstalled(settings) {
    return CLAUDE_HOOK_EVENTS.every((ev) => hookGroupsHaveScript(settings?.hooks?.[ev]));
}

function installClaudeHook() {
    const { path: p, data } = readClaudeSettings();
    if (claudeHookIsInstalled(data)) return { ok: true, already: true, path: p };
    if (!fs.existsSync(CLAUDE_HOOK_SCRIPT)) {
        return { ok: false, error: `hook script missing: ${CLAUDE_HOOK_SCRIPT}` };
    }
    data.hooks = data.hooks || {};
    const command = `${process.execPath} ${CLAUDE_HOOK_SCRIPT}`;
    for (const ev of CLAUDE_HOOK_EVENTS) {
        if (!Array.isArray(data.hooks[ev])) data.hooks[ev] = [];
        if (!hookGroupsHaveScript(data.hooks[ev])) {
            data.hooks[ev].push({ matcher: '', hooks: [{ type: 'command', command }] });
        }
    }
    try {
        fs.mkdirSync(path.dirname(p), { recursive: true });
        if (fs.existsSync(p)) fs.copyFileSync(p, `${p}.hop-backup`);
        fs.writeFileSync(p, JSON.stringify(data, null, 2));
        return { ok: true, already: false, path: p };
    } catch (e) {
        return { ok: false, error: e.message };
    }
}

function removeClaudeHook() {
    const { path: p, data } = readClaudeSettings();
    const present = CLAUDE_HOOK_EVENTS.some((ev) => hookGroupsHaveScript(data?.hooks?.[ev]));
    if (!present) return { ok: true, already: true, path: p };
    for (const ev of CLAUDE_HOOK_EVENTS) {
        const groups = data?.hooks?.[ev];
        if (!Array.isArray(groups)) continue;
        for (const g of groups) {
            if (Array.isArray(g.hooks)) {
                g.hooks = g.hooks.filter((h) => !(h && typeof h.command === 'string' && h.command.includes('claude-session-hook.js')));
            }
        }
        data.hooks[ev] = groups.filter((g) => Array.isArray(g.hooks) && g.hooks.length > 0);
        if (data.hooks[ev].length === 0) delete data.hooks[ev];
    }
    try {
        if (fs.existsSync(p)) fs.copyFileSync(p, `${p}.hop-backup`);
        fs.writeFileSync(p, JSON.stringify(data, null, 2));
        return { ok: true, already: false, path: p };
    } catch (e) {
        return { ok: false, error: e.message };
    }
}

// ---- Codex notify install/remove (~/.codex/config.toml) --------------------
// Codex's turn-completion twin of the Claude Stop hook. Codex allows exactly
// ONE `notify` program, so we install a WRAPPER (scripts/codex-notify-hook.js)
// that bumps the same .turn counter AND forwards to whatever notify was already
// there (e.g. Codex Computer Use) via "--chain <orig...>". TOML is edited
// line-by-line — `notify` is a top-level key, and we touch only that one line —
// so the rest of the user's config is never reserialized (and mangled).
const CODEX_NOTIFY_SCRIPT = path.join(__dirname, 'scripts', 'codex-notify-hook.js');
function getCodexConfigPath() {
    return path.join(process.env.CODEX_HOME || path.join(os.homedir(), '.codex'), 'config.toml');
}
function tomlStr(s) { return JSON.stringify(String(s)); } // basic TOML string ≈ JSON string for our paths
function parseNotifyElements(line) {
    const m = line.match(/^notify\s*=\s*(\[.*\])\s*$/);
    if (!m) return null;
    const els = [];
    const re = /"((?:\\.|[^"\\])*)"/g;
    let mm;
    while ((mm = re.exec(m[1])) !== null) {
        try { els.push(JSON.parse('"' + mm[1] + '"')); } catch (e) { els.push(mm[1]); }
    }
    return els;
}
// The top-level notify line (before the first [table]); -1 if none up there.
function findTopLevelNotifyIndex(lines) {
    for (let i = 0; i < lines.length; i++) {
        if (/^\s*\[/.test(lines[i])) return -1;
        if (/^notify\s*=/.test(lines[i])) return i;
    }
    return -1;
}
function codexNotifyIsOurs(els) {
    return Array.isArray(els) && els.some((e) => typeof e === 'string' && e.includes('codex-notify-hook.js'));
}
function codexNotifyStatus() {
    const p = getCodexConfigPath();
    let text;
    try { text = fs.readFileSync(p, 'utf8'); } catch (e) { return { path: p, exists: false, installed: false }; }
    const lines = text.split('\n');
    const idx = findTopLevelNotifyIndex(lines);
    const els = idx >= 0 ? parseNotifyElements(lines[idx]) : null;
    return { path: p, exists: true, installed: codexNotifyIsOurs(els), notify: els };
}
function installCodexNotify() {
    const p = getCodexConfigPath();
    if (!fs.existsSync(CODEX_NOTIFY_SCRIPT)) return { ok: false, error: `notify script missing: ${CODEX_NOTIFY_SCRIPT}` };
    let text = '';
    try { text = fs.readFileSync(p, 'utf8'); } catch (e) { text = ''; }
    const lines = text.length ? text.split('\n') : [];
    const idx = findTopLevelNotifyIndex(lines);
    const existing = idx >= 0 ? parseNotifyElements(lines[idx]) : null;
    if (codexNotifyIsOurs(existing)) return { ok: true, already: true, path: p };
    const wrapper = [process.execPath, CODEX_NOTIFY_SCRIPT];
    const chain = (existing && existing.length) ? ['--chain', ...existing] : [];
    const newLine = `notify = [${[...wrapper, ...chain].map(tomlStr).join(', ')}]`;
    if (idx >= 0) {
        lines[idx] = newLine;
    } else {
        let insertAt = lines.findIndex((l) => /^\s*\[/.test(l));
        if (insertAt < 0) insertAt = lines.length;
        lines.splice(insertAt, 0, newLine);
    }
    try {
        fs.mkdirSync(path.dirname(p), { recursive: true });
        if (fs.existsSync(p)) fs.copyFileSync(p, `${p}.hop-backup`);
        fs.writeFileSync(p, lines.join('\n'));
        return { ok: true, already: false, path: p, chained: (existing && existing.length) ? existing : null };
    } catch (e) { return { ok: false, error: e.message }; }
}
function removeCodexNotify() {
    const p = getCodexConfigPath();
    let text;
    try { text = fs.readFileSync(p, 'utf8'); } catch (e) { return { ok: true, already: true, path: p }; }
    const lines = text.split('\n');
    const idx = findTopLevelNotifyIndex(lines);
    const els = idx >= 0 ? parseNotifyElements(lines[idx]) : null;
    if (!codexNotifyIsOurs(els)) return { ok: true, already: true, path: p };
    const ci = els.indexOf('--chain');
    const restored = ci >= 0 ? els.slice(ci + 1) : [];
    if (restored.length) lines[idx] = `notify = [${restored.map(tomlStr).join(', ')}]`;
    else lines.splice(idx, 1);
    try {
        if (fs.existsSync(p)) fs.copyFileSync(p, `${p}.hop-backup`);
        fs.writeFileSync(p, lines.join('\n'));
        return { ok: true, already: false, path: p, restored: restored.length ? restored : null };
    } catch (e) { return { ok: false, error: e.message }; }
}

// Resolve display name aliases (follows rename chain)
// Alias keys resolve case-insensitively too (unique match only), so a
// remembered old name keeps working however the caller cases it.
function lookupSessionAliasKey(name) {
    if (sessionAliases[name] !== undefined) return name;
    let match = null;
    for (const key of Object.keys(sessionAliases)) {
        if (sameNameFold(key, name)) {
            if (match !== null) return null; // ambiguous — exact only
            match = key;
        }
    }
    return match;
}

function resolveDisplayNameAlias(name) {
    if (!name || typeof name !== 'string') return name;
    let current = name;
    const seen = new Set();
    while (!seen.has(current)) {
        const key = lookupSessionAliasKey(current);
        if (key === null || sessionAliases[key] === undefined) break;
        seen.add(current);
        current = sessionAliases[key];
    }
    return current;
}

// Drop in-memory rename aliases tied to a deleted/killed session so that
// navigating an old name can't resolve a stale alias and auto-create a brand
// new session. Walks the rename chain from every known name for the session
// and removes any entry whose source or target refers to it (display or
// internal name). Safe to call from any process/path (no-op if no aliases).
function pruneSessionAliasesForSession(internalName, displayName) {
    const names = new Set();
    for (const seed of [internalName, toDisplaySessionName(internalName), displayName]) {
        if (!seed || typeof seed !== 'string') continue;
        let current = seed;
        while (!names.has(current)) {
            names.add(current);
            const nextName = sessionAliases[current];
            if (!nextName) break;
            current = nextName;
        }
    }
    for (const from of Object.keys(sessionAliases)) {
        if (names.has(from) || names.has(sessionAliases[from])) {
            delete sessionAliases[from];
        }
    }
}

// A dev server proxied under /s/<name>/ usually emits ROOT-ABSOLUTE URLs —
// /@vite/client, /src/main.tsx, /api/... — which the browser resolves against
// the tunnel origin, so they arrive with the /s/<name>/ prefix gone, fall
// through to the hub shell (or the unknown-API 404), and the port page renders
// blank. The Referer still names the session the page came from, so a request
// that matched no hop route is sent back to the referring PORT session's
// server. Top-level navigations are excluded — following a link out of a port
// page must still land on hop, not be swallowed by the proxy. WebSocket
// upgrades never carry a path-bearing Referer, so a dev server's HMR socket
// stays unrescued: the page renders, and vite quietly retries its socket.
function rescuePortReferral(req, res) {
    const referer = req.headers.referer || req.headers.referrer || '';
    const match = /\/s\/([^/?#]+)\//.exec(String(referer));
    if (!match) return false;
    let name;
    try { name = decodeURIComponent(match[1]); } catch { return false; }
    const config = getEffectiveSessionConfig(name);
    if (!config || config.type !== 'port' || !config.port) return false;
    const secFetchMode = String(req.headers['sec-fetch-mode'] || '');
    const isNavigation = secFetchMode === 'navigate' ||
        (!secFetchMode && String(req.headers.accept || '').includes('text/html'));
    if (isNavigation) {
        // A link INSIDE a proxied app is also root-absolute (/admin/growth),
        // so following it would land on the hub shell. Rescue navigations too
        // — but never off hop's own surfaces, so leaving a port page for the
        // hub keeps working: the landing page and hop-owned prefixes stay
        // hop's, everything else follows the referring app.
        const p = url.parse(req.url).pathname || '/';
        const hubOwned = p === '/' || p === '/sessions' ||
            ['/assets/', '/view/', '/api/', '/s/', '/ws', '/health', '/oauth', '/media/'].some((prefix) => p.startsWith(prefix));
        if (hubOwned) return false;
    }
    waitForPort(config.port).then((ready) => {
        if (!ready) {
            res.writeHead(502, { 'Content-Type': 'text/plain' });
            res.end(`Port session "${name}" is not answering on 127.0.0.1:${config.port}.`);
            return;
        }
        const proxy = httpProxy.createProxyServer({ target: `http://127.0.0.1:${config.port}`, ws: false });
        proxy.web(req, res, {}, () => {
            res.writeHead(502, { 'Content-Type': 'text/plain' });
            res.end(`Port session "${name}" dropped the connection.`);
        });
    });
    return true;
}

