  var stored = null;
  try { stored = JSON.parse(localStorage.getItem('hop-fab-pos') || 'null'); } catch (e) { stored = null; }
  function setPos(x, y) {
    fab.style.left = x + 'px';
    fab.style.top = y + 'px';
  }
  function initPos() {
    var pad = 12;
    var x = (stored && typeof stored.x === 'number') ? stored.x : (window.innerWidth - 56);
    var y = (stored && typeof stored.y === 'number') ? stored.y : (window.innerHeight - 120);
    x = clamp(x, pad, window.innerWidth - 56);
