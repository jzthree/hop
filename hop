const activeSessions = {}; // { sessionName: { room: HayRoom } }
const startingSessions = new Set(); // session names being initialized
const sessionAliases = {};  // { oldDisplayName: newDisplayName } - in-memory redirects
const sessionClientSummary = new Map(); // internalName -> { localCliCount: number, total: number }
