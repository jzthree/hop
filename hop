  var menu = document.getElementById('hop-session-fab-menu');
  var list = document.getElementById('hop-session-fab-list');
  var origin = document.getElementById('hop-session-fab-origin');
  if (!fab || !btn || !menu || !list || !origin) return;
  var originScope = 'user';
  var latestSessionData = null;

  function clamp(v, min, max) { return Math.min(Math.max(v, min), max); }
  function getCurrentSession() {
    var path = window.location.pathname || '';
    if (path.indexOf('/s/') === 0) {
      var rest = path.slice(3);
