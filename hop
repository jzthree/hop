// Check if tunnel is already running
function isServerRunning() {
    if (!fs.existsSync(STATE_FILE)) return null;
    ensurePrivateFile(STATE_FILE);
    try {
        const state = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));
        // Check if the process is still alive
        try {
            process.kill(state.pid, 0);
            return state;
        } catch (e) {
            // Process is dead, clean up
            fs.unlinkSync(STATE_FILE);
            return null;
        }
    } catch (e) {
        return null;
    }
}

// --- Daemon singleton ------------------------------------------------------
//
// One HOP_HOME must have exactly one daemon. Two daemons both probe the same
// detached hay host and both run its watchdog, so the older one can decide the
// host is hung and restart it — killing every PTY, and every claude inside
// them, that the other daemon is happily serving. Not theoretical: on
// 2026-08-31 and again on 2026-09-01 a daemon started Aug 21 (orphaned by a
// double-start race, then invisible to `hop stop`, which only ever kills the
// one pid the state file names) restarted a live host twice, taking ~36 claude
// sessions with it each time — while the current daemon was correctly holding
// off under the load guard.

/**
 * Other `hop --daemon` processes serving THIS HOP_HOME.
 *
 * Matched on the resolved script path plus the HOP_HOME each process actually
 * runs with — read from its own environment, since two daemons for two homes
 * share a command line — so a daemon for a different home is never touched.
 */
function listRivalHopDaemons() {
    let out;
    try {
        // -E appends each process's environment to its command, which is the
        // only way to recover HOP_HOME. Own-user processes only, which is all
        // we could signal anyway.
        out = execFileSync('ps', ['-axEo', 'pid=,command='], {
            encoding: 'utf8',
            maxBuffer: 64 * 1024 * 1024
        });
    } catch (e) {
        return [];
    }
    const defaultHome = path.join(os.homedir(), '.hop2');
    const rivals = [];
    for (const line of out.split('\n')) {
        const match = line.match(/^\s*(\d+)\s+(.*)$/);
        if (!match) continue;
        const pid = Number(match[1]);
        const command = match[2];
        if (pid === process.pid) continue;
        if (!command.includes(__filename)) continue;
        // Only the flag as its own word, and only before the environment dump
        // starts, so a stray `--daemon` inside some env value can't match.
        const commandOnly = command.split(/\s+[A-Za-z_][A-Za-z0-9_]*=/)[0];
        if (!/(?:^|\s)--daemon(?:\s|$)/.test(commandOnly)) continue;
        const homeMatch = command.match(/(?:^|\s)HOP_HOME=(\S*)/);
        const home = homeMatch ? homeMatch[1] : defaultHome;
        if (path.resolve(home) !== path.resolve(HOME_DIR)) continue;
        rivals.push(pid);
    }
    return rivals;
}

/**
 * The daemon that owns this HOP_HOME, when that is someone other than us.
 *
 * A daemon whose pid the state file no longer names has been superseded. It
 * may keep serving what it already holds, but it must not make decisions that
 * reach across process boundaries — above all, restarting the shared hay host.
 */
function getSupersedingDaemon() {
    if (!DAEMON_FLAG) return null;
    let state;
    try {
        state = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));
    } catch (e) {
        return null; // No readable record: nobody outranks us.
    }
    if (!state || !Number.isInteger(state.pid)) return null;
    if (state.pid === process.pid) return null;
    if (!isProcessAlive(state.pid)) return null;
    return state;
}

/**
 * Make this process the only daemon for HOME_DIR.
 *
 * Runs before the daemon publishes itself in the state file. Whoever is there
 * first is either the pid of record (a `hop start` over a running daemon) or an
 * orphan from an older race; either way it must not outlive this startup.
 * SIGTERM first so it runs its own cleanup — which deliberately leaves the
 * detached hay host and its sessions alone — and SIGKILL only for one that
 * ignores it.
 */
async function evictRivalHopDaemons() {
    const rivals = new Set(listRivalHopDaemons());
    try {
        const recorded = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));
        if (recorded && Number.isInteger(recorded.pid) && recorded.pid !== process.pid
            && isProcessAlive(recorded.pid)) {
            rivals.add(recorded.pid);
        }
    } catch (e) { /* no readable record: the process sweep is the whole answer */ }
    if (!rivals.size) return;

    const pids = [...rivals];
    log(`[Daemon] ${pids.length} other daemon(s) already serving ${HOME_DIR} (pid ${pids.join(', ')}). Retiring them — two daemons fight over the hay host and one eventually restarts it out from under the other.`, YELLOW);
    for (const pid of pids) {
        try { process.kill(pid, 'SIGTERM'); } catch (e) { }
    }
    const deadline = Date.now() + 5000;
    while (Date.now() < deadline && pids.some((pid) => isProcessAlive(pid))) {
        await new Promise((resolve) => setTimeout(resolve, 200));
    }
    for (const pid of pids) {
        if (!isProcessAlive(pid)) continue;
        log(`[Daemon] Daemon ${pid} ignored SIGTERM; forcing it down.`, YELLOW);
        try { process.kill(pid, 'SIGKILL'); } catch (e) { }
    }
}

function isValidSessionSecret(secret) {
    if (typeof secret !== 'string') return false;
    const trimmed = secret.trim();
    return /^[0-9a-f]{64}$/i.test(trimmed);
}

function loadSessionSecret(existingState) {
    if (existingState && isValidSessionSecret(existingState.sessionSecret)) {
        return existingState.sessionSecret;
    }

    if (!ENABLE_PERSIST_SESSION_SECRET) {
        return crypto.randomBytes(32).toString('hex');
    }

    if (fs.existsSync(SESSION_SECRET_FILE)) {
        try {
            const raw = fs.readFileSync(SESSION_SECRET_FILE, 'utf8');
            const trimmed = raw.trim();
            if (isValidSessionSecret(trimmed)) {
                ensurePrivateFile(SESSION_SECRET_FILE);
                return trimmed;
            }
        } catch (e) {
            // Fall through to regeneration below.
        }
    }

    const generated = crypto.randomBytes(32).toString('hex');
    writePrivateFile(SESSION_SECRET_FILE, generated);
    return generated;
}

