function shouldInjectSessionSwitcher(req) {
    if (!req || req.method !== 'GET') return false;
    const accept = String(req.headers?.accept || '').toLowerCase();
    if (!accept.includes('text/html')) return false;
    const dest = String(req.headers?.['sec-fetch-dest'] || '');
    if (dest && dest !== 'document') return false;
    return true;
}

function buildSessionPath(displayName) {
    return `/s/${encodeURIComponent(displayName)}/`;
}

// Resolve a display name to the session it names. `internalName` is null
// when NOTHING by that name exists — callers must refuse rather than invent.
// The old fallback returned the requested name either way (both ternary
// branches were identical), so an unresolvable name silently became a BRAND
// NEW empty session: rename a session, connect by its new name before the
// rename was visible, and you got a phantom shell wearing the new name while
// the real session kept running unreachable behind the old one.
function resolveSessionDisplayName(displayName) {
    const resolvedDisplayName = resolveDisplayNameAlias(displayName);
    const internalFromConfig = findInternalSessionName(resolvedDisplayName);
    const fallbackInternalName = toInternalSessionName(resolvedDisplayName);
    const fallbackExists = !!fallbackInternalName
        && (hopSessionExists(fallbackInternalName) || !!getEffectiveSessionConfig(fallbackInternalName));
    return {
        displayName: resolvedDisplayName,
        internalName: internalFromConfig || (fallbackExists ? fallbackInternalName : null),
        aliasRedirect: resolvedDisplayName !== displayName
    };
}

function stripSessionParam(search) {
    if (!search) return '';
    const params = new URLSearchParams(search);
    params.delete('session');
    const qs = params.toString();
    return qs ? `?${qs}` : '';
}

function parseSessionFromRequest(req, parsedUrl) {
    const pathname = parsedUrl.pathname || '';
    if (pathname.startsWith('/s/')) {
        const rest = pathname.slice(3);
        const parts = rest.split('/');
        const rawName = parts.shift() || '';
        let displayName = '';
        try {
            displayName = decodeURIComponent(rawName);
        } catch (e) {
            return null;
        }
        if (!SESSION_NAME_RE.test(displayName)) return null;
        const resolved = resolveSessionDisplayName(displayName);
        if (!resolved.internalName) return null;
        const needsSlash = pathname === `/s/${rawName}`;
        const strippedPathname = '/' + parts.join('/');
        const normalizedPathname = strippedPathname === '/' ? '/' : strippedPathname;
        const strippedUrl = normalizedPathname + (parsedUrl.search || '');
        return {
            displayName: resolved.displayName,
            internalName: resolved.internalName,
            requestedDisplayName: displayName,
            aliasRedirect: resolved.aliasRedirect,
            strippedPathname: normalizedPathname,
            strippedUrl,
            source: 'path',
            needsSlash
        };
    }

    const sessionParam = parsedUrl.query.session;
    if (sessionParam && SESSION_NAME_RE.test(sessionParam)) {
        const displayName = sessionParam;
        const resolved = resolveSessionDisplayName(displayName);
        if (!resolved.internalName) return null;
        const strippedPathname = parsedUrl.pathname || '/';
        const strippedUrl = strippedPathname + stripSessionParam(parsedUrl.search || '');
        return {
            displayName: resolved.displayName,
            internalName: resolved.internalName,
            requestedDisplayName: displayName,
            aliasRedirect: resolved.aliasRedirect,
            strippedPathname,
            strippedUrl,
            source: 'query'
        };
    }

    return null;
}

function shouldRedirectToSessionPath(req) {
    if (!req || req.method !== 'GET') return false;
    const accept = String(req.headers?.accept || '').toLowerCase();
    return accept.includes('text/html');
}

// Helper to get client IP (handles proxies)
function getClientIp(req) {
    return req.headers['cf-connecting-ip'] ||
        req.headers['x-forwarded-for'] ||
        req.socket.remoteAddress ||
        'unknown';
}

const ACTOR_HEADER = 'x-hop-actor';

function resolveActor(req) {
    return resolveActorFromHeaders(req?.headers || {}, ACTOR_HEADER);
}

function resolveSessionInternalName(name, internalName) {
    if (internalName && (getEffectiveSessionConfig(internalName) || hopSessionExists(internalName))) return internalName;
    if (!name) return null;
    const displayName = resolveDisplayNameAlias(name);
    return findInternalSessionName(displayName) || toInternalSessionName(displayName);
}

function waitForPort(port, host = '127.0.0.1', timeoutMs = 4000, intervalMs = 120) {
    const start = Date.now();
    return new Promise((resolve) => {
        const tryConnect = () => {
            const socket = net.connect({ port, host });
            socket.once('connect', () => {
                socket.end();
                resolve(true);
            });
            socket.once('error', () => {
                socket.destroy();
                if (Date.now() - start >= timeoutMs) {
                    resolve(false);
                    return;
                }
                setTimeout(tryConnect, intervalMs);
            });
        };
        tryConnect();
    });
}

function allocateLocalPort(host = '127.0.0.1') {
    return new Promise((resolve, reject) => {
        const server = net.createServer();
        server.unref();
        server.once('error', reject);
        server.listen(0, host, () => {
            const address = server.address();
            const port = address && typeof address === 'object' ? Number(address.port) : 0;
            server.close((err) => {
                if (err) {
                    reject(err);
                    return;
                }
                if (!Number.isInteger(port) || port <= 0 || port > 65535) {
                    reject(new Error('Failed to allocate local port'));
                    return;
                }
                resolve(port);
            });
        });
    });
}

function isExternalTerminalBackend() {
    return TERMINAL_BACKEND === 'external';
}

function isProcessAlive(pid) {
    if (!Number.isInteger(pid) || pid <= 0) return false;
    try {
        process.kill(pid, 0);
        return true;
    } catch (e) {
        return false;
    }
}

function readHayHostStateFile() {
    if (!fs.existsSync(HAY_HOST_STATE_FILE)) return null;
    try {
        ensurePrivateFile(HAY_HOST_STATE_FILE);
        const parsed = JSON.parse(fs.readFileSync(HAY_HOST_STATE_FILE, 'utf8'));
        const pid = Number(parsed?.pid);
        const port = Number(parsed?.port);
        if (!Number.isInteger(pid) || pid <= 0) return null;
        if (!Number.isInteger(port) || port < 1 || port > 65535) return null;
        return {
            pid,
            port,
            startedAt: Number(parsed?.startedAt) || Date.now(),
            // The state file itself lives under this HOP_HOME, so legacy files
            // without the hash are still unambiguously owned by this instance.
            homeHash: typeof parsed?.homeHash === 'string' ? parsed.homeHash : HAY_HOST_HOME_HASH
        };
    } catch (e) {
        return null;
    }
}

function writeHayHostStateFile(state) {
    if (!state) return;
    // Only invalidate + persist when the host actually changed. This runs on
    // every session-list request (ensure + fetch both call it); unconditionally
    // zeroing the discovery cache here forced a full synchronous ps+lsof
    // rebuild (~500ms, event-loop-blocking) for EACH of the three stages of
    // every /api/sessions call — the whole reason listing sessions took ~1.6s.
    const changed = !hayHostState
        || hayHostState.pid !== state.pid
        || hayHostState.port !== state.port;
    if (!changed) return;
    hayHostState = {
        pid: state.pid,
        port: state.port,
        startedAt: state.startedAt || Date.now(),
        homeHash: HAY_HOST_HOME_HASH
    };
    // The state was just authenticated by a health check, so it is already a
    // valid discovery result. Keeping it in the cache avoids an immediate
    // synchronous ps/lsof rediscovery on the next ensure call; lsof can block
    // indefinitely on unhealthy filesystem mounts and stall daemon startup.
    hayHostDiscoveryCache = {
        expiresAt: Date.now() + HAY_HOST_DISCOVERY_CACHE_MS,
        hosts: [{ ...hayHostState, scoped: true }]
    };
    writePrivateFile(HAY_HOST_STATE_FILE, JSON.stringify(hayHostState));
}

function clearHayHostStateFile() {
    hayHostState = null;
    hayHostDiscoveryCache = { expiresAt: 0, hosts: [] };
    try {
        if (fs.existsSync(HAY_HOST_STATE_FILE)) {
            fs.unlinkSync(HAY_HOST_STATE_FILE);
        }
    } catch (e) { }
}

function parseListeningPortForPid(pid) {
    if (!Number.isInteger(pid) || pid <= 0) return null;
    try {
        const output = execFileSync('lsof', [
            '-nP',
            '-a',
            '-p', String(pid),
            '-iTCP',
            '-sTCP:LISTEN',
            '-Fn'
        ], {
            encoding: 'utf8',
            stdio: ['ignore', 'pipe', 'ignore']
        });
        const lines = String(output || '').split(/\r?\n/);
        for (const line of lines) {
            if (!line.startsWith('n')) continue;
            const match = line.match(/:(\d+)(?:->|$)/);
            if (!match) continue;
            const port = Number.parseInt(match[1], 10);
            if (Number.isInteger(port) && port > 0 && port <= 65535) {
                return port;
            }
        }
    } catch (e) { }
    return null;
}

function parseHayHostHomeHash(command) {
    const match = String(command || '').match(/(?:^|\s)--hop-home-hash=([a-f0-9]{24})(?=\s|$)/i);
    return match ? match[1].toLowerCase() : null;
}

// Background refresh for host discovery. The sync builder below runs ps plus
// one lsof per candidate pid (~1.8s wall, and it BLOCKS the event loop — the
// daemon can't proxy websockets or serve requests while it runs). With the
// cache TTL shorter than the rebuild cost, every /api/sessions call paid it.
// Serve the stale cache immediately and rebuild off the request path instead;
// host membership only changes when a hay-host starts or stops.
let hayHostDiscoveryRefreshing = false;
function refreshHayHostDiscoveryAsync() {
    if (hayHostDiscoveryRefreshing) return;
    hayHostDiscoveryRefreshing = true;
    const hostScript = path.join(__dirname, 'scripts', 'hay-host.js');
    execFile('ps', ['-axo', 'pid=,command='], { encoding: 'utf8' }, (psErr, psOut) => {
        if (psErr) { hayHostDiscoveryRefreshing = false; return; }
        const recorded = hayHostState || readHayHostStateFile();
        const pids = [];
        const scopedByPid = new Map();
        for (const line of String(psOut || '').split(/\r?\n/)) {
            const match = line.trim().match(/^(\d+)\s+(.+)$/);
            if (!match) continue;
            const pid = Number.parseInt(match[1], 10);
            const command = match[2] || '';
            if (!Number.isInteger(pid) || pid <= 0 || !command.includes(hostScript)) continue;
            const homeHash = parseHayHostHomeHash(command);
            const recordedMatch = recorded && recorded.pid === pid;
            if (homeHash !== HAY_HOST_HOME_HASH && !recordedMatch) continue;
            pids.push(pid);
            scopedByPid.set(pid, homeHash);
        }
        if (pids.length === 0) {
            hayHostDiscoveryCache = { expiresAt: Date.now() + HAY_HOST_DISCOVERY_CACHE_MS, hosts: [] };
            hayHostDiscoveryRefreshing = false;
            return;
        }
        // One lsof for every candidate pid instead of one per pid.
        execFile('lsof', ['-nP', '-a', '-p', pids.join(','), '-iTCP', '-sTCP:LISTEN'], { encoding: 'utf8' }, (lsofErr, lsofOut) => {
            const candidates = [];
            const seen = new Set();
            if (!lsofErr || lsofOut) {
                for (const line of String(lsofOut || '').split(/\r?\n/)) {
                    const cols = line.trim().split(/\s+/);
                    const pid = Number.parseInt(cols[1], 10);
                    if (!pids.includes(pid)) continue;
                    const portMatch = (cols[cols.length - 2] || '').match(/:(\d+)$/) || line.match(/:(\d+)\s+\(LISTEN\)/);
                    if (!portMatch) continue;
                    const port = Number.parseInt(portMatch[1], 10);
                    if (!Number.isInteger(port) || port <= 0 || port > 65535) continue;
                    const key = `${pid}:${port}`;
                    if (seen.has(key)) continue;
                    seen.add(key);
                    candidates.push({
                        pid,
                        port,
                        startedAt: recorded && recorded.pid === pid && recorded.port === port ? recorded.startedAt : 0,
                        scoped: typeof scopedByPid.get(pid) === 'string',
                        homeHash: scopedByPid.get(pid) || null
                    });
                }
            }
            if (candidates.length > 0 || !lsofErr) {
                hayHostDiscoveryCache = { expiresAt: Date.now() + HAY_HOST_DISCOVERY_CACHE_MS, hosts: candidates };
            }
            hayHostDiscoveryRefreshing = false;
        });
    });
}

function listDiscoveredHayHostCandidates(force = false) {
    if (!isExternalTerminalBackend()) return [];
    const now = Date.now();
    if (!force && hayHostDiscoveryCache.expiresAt > now) {
        return hayHostDiscoveryCache.hosts.map((host) => ({ ...host }));
    }
    // Stale-while-revalidate: never make a request wait on process discovery
    // once we have any prior answer.
    if (!force && hayHostDiscoveryCache.hosts.length > 0) {
        refreshHayHostDiscoveryAsync();
        return hayHostDiscoveryCache.hosts.map((host) => ({ ...host }));
    }

    const candidates = [];
    const seen = new Set();
    const recorded = hayHostState || readHayHostStateFile();
    const hostScript = path.join(__dirname, 'scripts', 'hay-host.js');

    const remember = (candidate) => {
        if (!candidate) return;
        const pid = Number(candidate.pid);
        const port = Number(candidate.port);
        if (!Number.isInteger(pid) || pid <= 0) return;
        if (!Number.isInteger(port) || port <= 0 || port > 65535) return;
        const key = `${pid}:${port}`;
        if (seen.has(key)) return;
        seen.add(key);
        candidates.push({
            pid,
            port,
            startedAt: Number(candidate.startedAt) || 0,
            scoped: candidate.scoped === true,
            homeHash: typeof candidate.homeHash === 'string' ? candidate.homeHash.toLowerCase() : null
        });
    };

    if (recorded && isProcessAlive(recorded.pid)) {
        remember({ ...recorded, scoped: true, homeHash: HAY_HOST_HOME_HASH });
        // A live state-file record is already scoped to this HOP_HOME and its
        // health is checked by inspectExternalHayHosts. Adopt it directly;
        // rediscovering its listening port with lsof is redundant and can
        // block daemon restart on machines with stalled filesystem mounts.
        hayHostDiscoveryCache = {
            expiresAt: now + HAY_HOST_DISCOVERY_CACHE_MS,
            hosts: candidates
        };
        return candidates.map((host) => ({ ...host }));
    }

    try {
        const output = execFileSync('ps', ['-axo', 'pid=,command='], {
            encoding: 'utf8',
            stdio: ['ignore', 'pipe', 'ignore']
        });
        const lines = String(output || '').split(/\r?\n/);
        for (const line of lines) {
            const trimmed = line.trim();
            if (!trimmed) continue;
            const match = trimmed.match(/^(\d+)\s+(.+)$/);
            if (!match) continue;
            const pid = Number.parseInt(match[1], 10);
            const command = match[2] || '';
            if (!Number.isInteger(pid) || pid <= 0) continue;
            if (!command.includes(hostScript)) continue;
            if (!isProcessAlive(pid)) continue;
            const homeHash = parseHayHostHomeHash(command);
            const recordedMatch = recorded && recorded.pid === pid;
            if (homeHash !== HAY_HOST_HOME_HASH && !recordedMatch) continue;
            const port = parseListeningPortForPid(pid);
            if (!port) continue;
            const startedAt = recorded && recorded.pid === pid && recorded.port === port
                ? recorded.startedAt
                : 0;
            remember({ pid, port, startedAt, scoped: !!homeHash, homeHash });
        }
    } catch (e) { }

    hayHostDiscoveryCache = {
        expiresAt: now + HAY_HOST_DISCOVERY_CACHE_MS,
        hosts: candidates
    };
    return candidates.map((host) => ({ ...host }));
}

// ---- On-demand session screen preview (session manager) --------------------
// Rendered only when a manager card is expanded and the tab is visible, so idle
// or unwatched sessions cost nothing. The hay-host returns a bounded output
// tail; we render it through a headless terminal here, on demand.
let headlessTermCtor;
let headlessTermLoadTried = false;
function loadHeadlessTerminal() {
    if (headlessTermLoadTried) return headlessTermCtor || null;
    headlessTermLoadTried = true;
    // xterm-headless references browser globals at load time; shim them.
    if (!global.window) global.window = global;
    if (!global.requestIdleCallback) {
        global.requestIdleCallback = (cb) => setTimeout(() => cb({ timeRemaining: () => 0, didTimeout: false }), 0);
    }
    if (!global.cancelIdleCallback) {
        global.cancelIdleCallback = (handle) => clearTimeout(handle);
    }
    const candidates = [
        path.join(__dirname, 'hay', 'node_modules', 'xterm-headless'),
        'xterm-headless'
    ];
    for (const candidate of candidates) {
        try {
            const mod = require(candidate);
            if (mod && typeof mod.Terminal === 'function') {
                headlessTermCtor = mod.Terminal;
                return headlessTermCtor;
            }
        } catch (e) { /* try next candidate */ }
    }
    headlessTermCtor = null;
    return null;
}

// Last non-empty rendered preview per room. A live TUI mid-repaint (or a
// briefly unreachable host) can render an empty frame; a blank tile that was
// showing content a second ago reads as a dead session, so serve the previous
// good frame instead and let the next poll catch up. Persisted to disk —
// daemon restarts are routine and wiping the cache re-blanked every tile
// whose session was mid-churn at that moment.
const lastGoodPreviewByRoom = new Map();
const PREVIEW_CACHE_FILE = path.join(HOME_DIR, 'preview-cache.json');
try {
    for (const [k, v] of JSON.parse(fs.readFileSync(PREVIEW_CACHE_FILE, 'utf8'))) {
        if (v && typeof v.text === 'string') lastGoodPreviewByRoom.set(k, v);
    }
} catch (e) { /* absent or corrupt — start empty */ }
let previewCacheSaveTimer = null;
function schedulePreviewCacheSave() {
    if (previewCacheSaveTimer) return;
    previewCacheSaveTimer = setTimeout(() => {
        previewCacheSaveTimer = null;
        try {
            // Persist TEXT only: colour runs are regenerated from the live
            // grid on every serve, and writing them would bloat this file by
            // an order of magnitude for a fallback that only has to say what
            // the screen said.
            const slim = [...lastGoodPreviewByRoom].map(([k, v]) => [k, { ...v, color: undefined }]);
            fs.writeFileSync(PREVIEW_CACHE_FILE, JSON.stringify(slim), { mode: 0o600 });
        } catch (e) { /* best-effort */ }
    }, 5000);
    previewCacheSaveTimer.unref?.();
}

function fetchHayRoomPreviewSource(internalName, bytes) {
    const host = hayHostState || readHayHostStateFile();
    if (!host || !Number.isInteger(host.port) || host.port <= 0) return Promise.resolve(null);
    return new Promise((resolve) => {
        let settled = false;
        const done = (v) => { if (!settled) { settled = true; resolve(v); } };
        const req = http.request({
            hostname: '127.0.0.1',
            port: host.port,
            path: `/rooms/${encodeURIComponent(internalName)}/preview${bytes ? `?bytes=${bytes}` : ''}`,
            method: 'GET'
        }, (res) => {
            if ((res.statusCode || 0) !== 200) { res.resume(); done(null); return; }
            let data = '';
            res.on('data', (chunk) => { data += chunk; });
            res.on('end', () => { try { done(JSON.parse(data || 'null')); } catch (e) { done(null); } });
        });
        req.on('error', () => done(null));
        req.setTimeout(1500, () => { req.destroy(); done(null); });
        req.end();
    });
}

// ── Grid previews: a persistent headless terminal per recently-previewed
// room, fed INCREMENTALLY via the host's /rooms/:id/output?since= endpoint.
// Parser state carries forward, so there is never an arbitrary cut point in
// a differential-repaint stream — the grid IS the screen, and "render a
// preview" becomes "read ~50 lines out of an existing grid". The
// guess-the-frame heuristics below (trim markers, density gate, deep
// refetch) survive only as the fallback path for hosts predating /output.
// Grids are lazy (created on first preview request) and reaped when idle,
// preserving the idle-rooms-cost-nothing property. ──
const roomGrids = new Map(); // internalName -> { term, serialize, offset, cols, rows, lastUsedAt }
// Serialize addon (same 5.x line as xterm-headless): turns a grid into the
// compact ANSI string that repaints the CURRENT screen — the fast-attach
// first paint. Best-effort: without it, grids still serve text previews.
let serializeAddonTried = false;
let serializeAddonCtor = null;
function loadSerializeAddon() {
    if (serializeAddonTried) return serializeAddonCtor;
    serializeAddonTried = true;
    // The addon's color helpers touch `document` at module load; a stub
    // canvas-less element is enough (hex parsing has a non-canvas path).
    if (!global.document) {
        global.document = { createElement: () => ({ getContext: () => null, style: {} }) };
    }
    const candidates = [
        path.join(__dirname, 'hay', 'node_modules', 'xterm-addon-serialize'),
        'xterm-addon-serialize'
    ];
    for (const candidate of candidates) {
        try {
            const mod = require(candidate);
            if (mod && typeof mod.SerializeAddon === 'function') {
                serializeAddonCtor = mod.SerializeAddon;
                return serializeAddonCtor;
            }
        } catch (e) { /* try next candidate */ }
    }
    return null;
}
const ROOM_GRID_MAX = 80; // LRU cap — a scrollback-0 grid is ~0.5-2MB
const ROOM_GRID_IDLE_MS = 5 * 60_000;
// Whether the CURRENT host incarnation serves /output — probed lazily, and
// scoped to that incarnation: a restarted host may have gained the endpoint,
// and grid cursors from a previous incarnation are meaningless against the
// new one's offsets (same room ids, different streams), so a host change
// resets the probe AND disposes every grid.
let outputSinceProbe = { hostKey: '', supported: null };

function disposeRoomGrid(internalName) {
    const grid = roomGrids.get(internalName);
    if (grid) {
        try { grid.term.dispose(); } catch (e) { /* already dead */ }
        roomGrids.delete(internalName);
    }
}
setInterval(() => {
    const cutoff = Date.now() - ROOM_GRID_IDLE_MS;
    for (const [key, grid] of roomGrids) {
        if (grid.lastUsedAt < cutoff) disposeRoomGrid(key);
    }
}, 60_000).unref();

function fetchHayRoomOutputSince(internalName, since) {
    const host = hayHostState || readHayHostStateFile();
    if (!host || !Number.isInteger(host.port) || host.port <= 0) return Promise.resolve(null);
    return new Promise((resolve) => {
        let settled = false;
        const done = (v) => { if (!settled) { settled = true; resolve(v); } };
        const req = http.request({
            hostname: '127.0.0.1',
            port: host.port,
            path: `/rooms/${encodeURIComponent(internalName)}/output${since === undefined ? '' : `?since=${since}`}`,
            method: 'GET'
        }, (res) => {
            let data = '';
            res.on('data', (chunk) => { data += chunk; });
            res.on('end', () => {
                if ((res.statusCode || 0) === 404) {
                    // Distinguish "room gone" (new host, endpoint exists) from
                    // "endpoint missing" (old host catch-all): the endpoint's
                    // own 404 says 'Room not found'.
                    let endpointMissing = true;
                    try { endpointMissing = JSON.parse(data || '{}').error !== 'Room not found'; } catch (e) { /* opaque 404 */ }
                    done({ notFound: true, endpointMissing });
                    return;
                }
                if ((res.statusCode || 0) !== 200) { done(null); return; }
                try { done(JSON.parse(data || 'null')); } catch (e) { done(null); }
            });
        });
        req.on('error', () => done(null));
        req.setTimeout(2000, () => { req.destroy(); done(null); });
        req.end();
    });
}

// xterm's 256-colour cube, for palette-indexed cells. Indices 0-15 are left
// to the VIEWER's theme (sent as null) so basic colours follow the user's
// terminal palette exactly as they do in the real terminal.
const ANSI_256 = (() => {
    const out = new Array(256).fill(null);
    const steps = [0, 95, 135, 175, 215, 255];
    const hx = (n) => n.toString(16).padStart(2, '0');
    for (let i = 0; i < 216; i++) {
        const r = steps[Math.floor(i / 36) % 6], g = steps[Math.floor(i / 6) % 6], b = steps[i % 6];
        out[16 + i] = `#${hx(r)}${hx(g)}${hx(b)}`;
    }
    for (let i = 0; i < 24; i++) {
        const v = 8 + i * 10;
        out[232 + i] = `#${hx(v)}${hx(v)}${hx(v)}`;
    }
    return out;
})();

// Colour-preserving read of the grid: consecutive cells sharing attributes
// collapse into one run. Previews were plain translateToString() text — the
// grid is a REAL terminal, but flattening it to a string threw every colour
// away, which is why tiles stayed monochrome after the sessions themselves
// regained colour. Runs carry only what differs from default, so an ordinary
// screen costs little more than its text.
function readGridColorLines(grid) {
    const buffer = grid.term.buffer.active;
    const cell = buffer.getNullCell();
    const lines = [];
    for (let y = 0; y < grid.rows; y++) {
        const line = buffer.getLine(buffer.baseY + y);
        if (!line) { lines.push([]); continue; }
        const runs = [];
        let cur = null;
        for (let x = 0; x < grid.cols; x++) {
            line.getCell(x, cell);
            if (cell.getWidth() === 0) continue; // trailing half of a wide glyph
            const ch = cell.getChars() || ' ';
            const fg = cell.isFgRGB() ? `#${cell.getFgColor().toString(16).padStart(6, '0')}`
                : cell.isFgPalette() ? ANSI_256[cell.getFgColor()] : null;
            const bg = cell.isBgRGB() ? `#${cell.getBgColor().toString(16).padStart(6, '0')}`
                : cell.isBgPalette() ? ANSI_256[cell.getBgColor()] : null;
            const dim = cell.isDim() ? 1 : 0;
            const bold = cell.isBold() ? 1 : 0;
            const inv = cell.isInverse() ? 1 : 0;
            if (cur && cur.f === fg && cur.b === bg && cur.d === dim && cur.o === bold && cur.i === inv) {
                cur.t += ch;
            } else {
                cur = { t: ch, f: fg, b: bg, d: dim, o: bold, i: inv };
                runs.push(cur);
            }
        }
        // Drop trailing blank, unstyled run — pure padding.
        while (runs.length) {
            const last = runs[runs.length - 1];
            if (!last.f && !last.b && !last.i && !last.t.trim()) runs.pop();
            else break;
        }
        // Strip the defaults so the payload only carries what matters.
        for (const r of runs) {
            if (!r.f) delete r.f;
            if (!r.b) delete r.b;
            if (!r.d) delete r.d;
            if (!r.o) delete r.o;
            if (!r.i) delete r.i;
        }
        lines.push(runs);
    }
    while (lines.length && lines[lines.length - 1].length === 0) lines.pop();
    return lines;
}

function readGridScreen(grid) {
    try {
        const buffer = grid.term.buffer.active;
        const lines = [];
        for (let i = 0; i < grid.rows; i++) {
            const line = buffer.getLine(buffer.baseY + i);
            lines.push(line ? line.translateToString(true) : '');
        }
        while (lines.length && !lines[lines.length - 1].trim()) lines.pop();
        let color = null;
        try { color = readGridColorLines(grid); } catch (e) { /* text still fine */ }
        return { text: lines.join('\n'), color, cols: grid.cols, rows: grid.rows };
    } catch (e) {
        return null;
    }
}

// Concurrent tile fetches for the SAME room must not interleave: two calls
// sharing one grid would each fetch the same delta and write it twice
// (duplicated scroll lines), or race create/dispose. Coalesce — concurrent
// callers want the same screen anyway.
const roomGridInflight = new Map(); // internalName -> Promise
function getRoomGridPreviewShared(internalName) {
    const inflight = roomGridInflight.get(internalName);
    if (inflight) return inflight;
    const p = getRoomGridPreview(internalName)
        .finally(() => roomGridInflight.delete(internalName));
    roomGridInflight.set(internalName, p);
    return p;
}

// The grid path's whole contract: returns the room's ACTUAL current screen,
// or null when this path can't serve (old host, no live room, no headless
// terminal) and the legacy pipeline should take over.
async function getRoomGridPreview(internalName) {
    const host = hayHostState || readHayHostStateFile();
    if (host && Number.isInteger(host.port) && host.port > 0) {
        const hostKey = `${host.pid}:${host.startedAt}`;
        if (outputSinceProbe.hostKey !== hostKey) {
            outputSinceProbe = { hostKey, supported: null };
            for (const key of [...roomGrids.keys()]) disposeRoomGrid(key);
        }
    }
    if (outputSinceProbe.supported === false) return null;
    const Term = loadHeadlessTerminal();
    if (!Term) return null;
    let grid = roomGrids.get(internalName);
    const res = await fetchHayRoomOutputSince(internalName, grid ? grid.offset : undefined);
    if (!res) {
        // Host unreachable: an existing grid still holds the last true
        // screen — serve that rather than nothing.
        return grid ? readGridScreen(grid) : null;
    }
    if (res.notFound) {
        if (res.endpointMissing) outputSinceProbe.supported = false;
        disposeRoomGrid(internalName);
        return null;
    }
    outputSinceProbe.supported = true;
    // Generous clamps: rendering NARROWER than the PTY re-wraps every long
    // line into garbage (the old 400 clamp mangled a real 476-col session).
    const cols = Math.max(2, Math.min(1000, Math.floor(Number(res.cols) || 80)));
    const rows = Math.max(2, Math.min(200, Math.floor(Number(res.rows) || 24)));
    if (!grid || res.reset) {
        disposeRoomGrid(internalName);
        let term;
        try {
            term = new Term({ cols, rows, scrollback: 0, allowProposedApi: true });
        } catch (e) {
            return null;
        }
        let serialize = null;
        const SerializeCtor = loadSerializeAddon();
        if (SerializeCtor) {
            try {
                serialize = new SerializeCtor();
                term.loadAddon(serialize);
            } catch (e) {
                serialize = null;
            }
        }
        grid = { term, serialize, offset: res.offset, cols, rows, lastUsedAt: Date.now() };
        roomGrids.set(internalName, grid);
        if (roomGrids.size > ROOM_GRID_MAX) {
            let oldestKey = null;
            let oldestAt = Infinity;
            for (const [key, g] of roomGrids) {
                if (g.lastUsedAt < oldestAt) { oldestAt = g.lastUsedAt; oldestKey = key; }
            }
            if (oldestKey && oldestKey !== internalName) disposeRoomGrid(oldestKey);
        }
    } else if (grid.cols !== cols || grid.rows !== rows) {
        // Session resized: resize the grid BEFORE writing the delta — the
        // delta was emitted for the new size (and TUIs repaint on resize).
        try { grid.term.resize(cols, rows); } catch (e) { /* keep old dims */ }
        grid.cols = cols;
        grid.rows = rows;
    }
    grid.offset = res.offset;
    grid.lastUsedAt = Date.now();
    if (res.data) {
        await new Promise((resolve) => {
            try { grid.term.write(res.data, () => resolve()); } catch (e) { resolve(); }
        });
    }
    return readGridScreen(grid);
}

// ── Session taglines ──────────────────────────────────────────────────────
// A short human line describing what a session is FOR, shown under its name.
// Generated by a local agent CLI (Claude Code / Codex) that is already
// installed and logged in. Core hop never requires one: with no CLI present
// every path here silently no-ops and sessions simply have no tagline.
// Shared by the daemon's automatic loop and the `hop ai tagline` command.
const TAGLINE_MIN_AGE_MS = 6 * 60 * 60 * 1000;
const TAGLINE_DISABLED = /^(0|false|off|no)$/i.test(String(process.env.HOP_AI_TAGLINES || ''));

// Env scrub: hop is often launched from inside a Claude Code session, and
// inherited CLAUDE* markers make the child think it is a nested session
// (which silently disables its transcript saving). Auth tokens are kept.
function aiChildEnv() {
    const env = { ...process.env };
    // HOP_SESSION must NOT leak into a helper claude: the SessionStart hook
    // keys its record on it, so a tagline helper running in os.tmpdir()
    // recorded ITSELF as that session's conversation — and restore then had
    // to refuse it (correctly) and open a plain shell. Observed live:
    // Solstice's record became `claude -p --model haiku` in a tmpdir.
    delete env.HOP_SESSION;
    delete env.HOP_SESSION_INTERNAL;
    for (const k of Object.keys(env)) {
        if (k === 'CLAUDECODE' || k === 'CLAUDE_EFFORT' || k === 'CLAUDE_CONFIG_DIR' || k === 'CLAUDE_PID'
            || (k.startsWith('CLAUDE_CODE_') && !k.startsWith('CLAUDE_CODE_OAUTH_TOKEN'))) {
            delete env[k];
        }
    }
    return env;
}

let aiProviderCache = { at: 0, id: null };
function detectAiProvider() {
    // Cached: probing spawns processes, and the daemon asks on every tick.
    if (Date.now() - aiProviderCache.at < 300000) return aiProviderCache.id;
    let found = null;
    for (const bin of ['claude', 'codex']) {
        try {
            execSync(`command -v ${bin} >/dev/null 2>&1`, { shell: '/bin/sh', timeout: 5000, stdio: 'ignore' });
            found = bin;
            break;
        } catch (e) { /* next */ }
    }
    aiProviderCache = { at: Date.now(), id: found };
    return found;
}

// Async so the daemon's event loop keeps serving while a model thinks — a
// synchronous exec here would freeze every session for the duration.
function askAiProvider(provider, prompt, timeoutMs = 120000) {
    return new Promise((resolve) => {
        if (provider === 'codex') {
            const tmpOut = path.join(os.tmpdir(), `hop-ai-${crypto.randomBytes(6).toString('hex')}.txt`);
            const child = execFile('codex', ['exec', '--skip-git-repo-check', '-o', tmpOut], {
                timeout: timeoutMs, env: aiChildEnv(), cwd: os.tmpdir(), maxBuffer: 8 * 1024 * 1024
            }, () => {
                let text = '';
                try { text = fs.readFileSync(tmpOut, 'utf8'); } catch (e) { /* nothing produced */ }
                try { fs.unlinkSync(tmpOut); } catch (e) { /* best effort */ }
                resolve(text);
            });
            try { child.stdin.end(prompt); } catch (e) { resolve(''); }
            return;
        }
        const child = execFile('claude', ['-p', '--model', 'haiku'], {
            timeout: timeoutMs, env: aiChildEnv(), cwd: os.tmpdir(), maxBuffer: 4 * 1024 * 1024
        }, (err, stdout) => resolve(err ? '' : String(stdout || '')));
        try { child.stdin.end(prompt); } catch (e) { resolve(''); }
    });
}

// The model is asked for a bare phrase; any CLI can still prepend chatter.
// Take the last non-empty line and reject anything that reads like prose,
// an error, or a refusal rather than a tagline.
function cleanTaglineText(raw) {
    const lines = String(raw || '').split('\n').map((l) => l.trim()).filter(Boolean);
    if (lines.length === 0) return '';
    let t = lines[lines.length - 1];
    t = t.replace(/^[-*>#\s]+/, '').replace(/^["'`]+|["'`.]+$/g, '').replace(/\s+/g, ' ').trim();
    if (!t) return '';
    if (/^(ERROR|I |I'm |Sorry|As an|Unable|Cannot)\b/i.test(t)) return '';
    if (t.length > 64 || t.split(' ').length > 9) return '';
    return t;
}

function taglineGitBranch(cwd) {
    if (!cwd) return '';
    try {
        return execSync('git rev-parse --abbrev-ref HEAD 2>/dev/null', {
            cwd, encoding: 'utf8', timeout: 5000, stdio: ['ignore', 'pipe', 'ignore']
        }).trim();
    } catch (e) { return ''; }
}

// The visible screen is a keyhole — it shows the last minute, so a
// screen-only tagline describes a moment and goes stale as soon as the
// screen scrolls. The user's OWN prompts state intent directly and change
// far more slowly, which is what makes a tagline durable.
function taglineUserPrompts(internalName) {
    try {
        const tPath = resolveClaudeTranscriptPath(readClaudeSessionRecord(internalName));
        if (!tPath) return [];
        const stat = fs.statSync(tPath);
        const readLen = Math.min(stat.size, 2 * 1024 * 1024);
        const fd = fs.openSync(tPath, 'r');
        const buf = Buffer.alloc(readLen);
        fs.readSync(fd, buf, 0, readLen, Math.max(0, stat.size - readLen));
        fs.closeSync(fd);
        const out = [];
        for (const line of buf.toString('utf8').split('\n')) {
            if (!line.includes('"type":"user"')) continue;
            let j;
            try { j = JSON.parse(line); } catch (e) { continue; }
            const c = j?.message?.content;
            const text = typeof c === 'string'
                ? c
                : Array.isArray(c) ? c.filter((p) => p?.type === 'text').map((p) => p.text).join(' ') : '';
            const clean = String(text || '').replace(/\s+/g, ' ').trim();
            if (!clean || clean.length < 12 || clean.length > 400) continue;
            if (/^(<|\[Request interrupted|caveat:)/i.test(clean)) continue;
            out.push(clean.slice(0, 240));
        }
        return out.length > 8 ? [...out.slice(0, 4), ...out.slice(-4)] : out;
    } catch (e) {
        return [];
    }
}

function buildTaglinePrompt({ cwd, foregroundProcess }, screen, prompts, branch) {
    return [
        'Write a short tagline for a terminal session, shown under its name in a session switcher.',
        '',
        'Rules:',
        '- 3 to 6 words, sentence case, no trailing period.',
        '- Name the ONGOING PROJECT OR GOAL — what this session is FOR across its whole life.',
        '- Do NOT describe momentary status (waiting, blocked, debugging one error) or the last command.',
        '- It should still read correctly hours from now, after the current task finishes.',
        '- Natural readable words. No kebab-case, snake_case, file paths, or quotes.',
        '- Do not repeat the working directory (already shown next to it).',
        '- Output ONLY the tagline, nothing else.',
        '',
        `Working directory: ${cwd || 'unknown'}`,
        branch ? `Git branch: ${branch}` : '',
        `Foreground app: ${foregroundProcess || 'shell'}`,
        '',
        prompts.length ? "What the user has asked for in this session (earliest first — the best signal of the durable goal):" : '',
        prompts.length ? '---' : '',
        ...prompts,
        prompts.length ? '---' : '',
        '',
        'Recent screen (supporting detail only — do not tag the moment):',
        '---',
        screen,
        '---'
    ].filter((l) => l !== '').join('\n');
}

function taglineNeedsRefresh(cfg, lastActivityAt, now = Date.now()) {
    if (!cfg?.tagline) return true;
    const at = Number(cfg.taglineAt || 0);
    if (!at) return true;
    // Durable by design: only re-tag when the tagline has aged out AND the
    // session has done something since. Keeps this a cheap no-op.
    return now - at > TAGLINE_MIN_AGE_MS && Number(lastActivityAt || 0) > at;
}

function persistTagline(internalName, tagline) {
    const savedConfig = getSessionConfig(internalName);
    const config = getEffectiveSessionConfig(internalName);
    if (!config) return false;
    const next = { ...config, tagline, taglineAt: Date.now() };
    if (savedConfig) setSessionConfig(internalName, next);
    else rememberRuntimeSessionMetadata(internalName, next);
    const durable = readClaudeSessionMeta(internalName) || {};
    writeClaudeSessionMeta(internalName, { ...durable, internalName, tagline, taglineAt: next.taglineAt });
    return true;
}

// Daemon-side automatic tagging: the feature has to "just work" — a user
// should never run a command to get names that mean something. One session
// per tick keeps it invisible (no CPU spike, no burst of model calls); the
// refresh rule above means a settled fleet costs nothing at all.
let taglineSweepBusy = false;
async function sweepTaglines() {
    if (TAGLINE_DISABLED || taglineSweepBusy || shuttingDown) return;
    const provider = detectAiProvider();
    if (!provider) return;
    taglineSweepBusy = true;
    try {
        log(`[tagline] sweep tick (provider=${provider})`, CYAN);
        const snapshot = await listAllSessionEntriesRuntimeFirst();
        const now = Date.now();
        const candidates = (snapshot.entries || []).filter((s) => {
            if (s.type === 'port' || !s.internalName) return false;
            if (s.live !== true) return false;
            return taglineNeedsRefresh(getEffectiveSessionConfig(s.internalName), s.lastActivityAt, now);
        });
        if (candidates.length === 0) return;
        // Oldest tagline first so attention rotates rather than starving one.
        candidates.sort((a, b) => {
            const at = Number(getEffectiveSessionConfig(a.internalName)?.taglineAt || 0);
            const bt = Number(getEffectiveSessionConfig(b.internalName)?.taglineAt || 0);
            return at - bt;
        });
        const target = candidates[0];
        const key = target.internalName;
        let screen = '';
        try {
            const grid = await getRoomGridPreviewShared(key);
            screen = String(grid?.text || '');
            if (!screen.trim()) {
                const src = await fetchHayRoomPreviewSource(key);
                if (src) screen = String(await renderSessionPreviewText(src) || '');
            }
        } catch (e) { /* no screen — skip this tick */ }
        screen = screen.split('\n').filter((l) => l.trim()).slice(-40).join('\n').slice(-3500);
        if (!screen.trim()) return;
        const cfg = getEffectiveSessionConfig(key) || {};
        const prompt = buildTaglinePrompt(
            { cwd: target.cwd || cfg.cwd, foregroundProcess: target.foregroundProcess },
            screen, taglineUserPrompts(key), taglineGitBranch(target.cwd || cfg.cwd)
        );
        const tagline = cleanTaglineText(await askAiProvider(provider, prompt));
        if (tagline && persistTagline(key, tagline)) {
            log(`[tagline] ${getSessionDisplayName(key) || key}: ${tagline}`, CYAN);
        }
    } catch (e) {
        log(`[tagline] sweep failed: ${e.message}`, YELLOW);
    } finally {
        taglineSweepBusy = false;
    }
}

// The preview source is a raw tail cut at an arbitrary byte: it can begin
// mid-escape-sequence (renders as garbage text) or mid-redraw (renders a
// half-painted frame until the next poll's cut happens to land clean). Start
// at the most recent full-repaint marker (clear-screen / cursor-home, which
// alt-screen TUIs emit every frame) when one exists; otherwise skip to the
// first line boundary so we never start inside a sequence.
function trimPreviewSource(output) {
    const CLEAR_RE = /\x1b\[[0-3]?J|\x1b\[H(?!\d)/g;
    // A marker with almost nothing after it is a mid-repaint cursor-home, not
    // a frame start — inline TUIs (claude) emit these constantly, and cutting
    // there rendered EMPTY previews. Use the latest marker that still has a
    // frame's worth of content following it. 6KB, not 1.5KB: a 250-col frame
    // easily exceeds 1.5KB while still being a sliver — TUIs overdraw from
    // cursor-home, so anchoring a frame earlier keeps the previous frame's
    // pixels beneath the partial repaint instead of a near-blank screen.
    const MIN_FRAME_TAIL = 6000;
    let frameStart = -1;
    let m;
    while ((m = CLEAR_RE.exec(output)) !== null) {
        if (output.length - m.index >= MIN_FRAME_TAIL) frameStart = m.index;
    }
    if (frameStart > 0) return output.slice(frameStart);
    const nl = output.indexOf('\n');
    return nl > 0 && nl < 8192 ? output.slice(nl + 1) : output;
}

// Density = count of lines with real content. A coherent screen has several;
// a differential-repaint miss has 1-4 scattered live cells.
function previewFrameDensity(text) {
    if (typeof text !== 'string') return 0;
    return text.split('\n').filter((l) => l.trim().length >= 2).length;
}

// Sparse = too few non-blank lines to be a real screen (a spinner/counter
// frame, or a mid-repaint capture). Tuned so a bare shell prompt or a short
// command's output (1-2 dense lines) still counts as real, while 3-4
// scattered fragments (a differential-repaint miss) do not.
function previewFrameIsSparse(text) {
    if (typeof text !== 'string') return true;
    const len = text.trim().length;
    if (len < 8) return true;
    const dense = previewFrameDensity(text);
    if (dense >= 5) return false;         // real screen
    if (dense <= 2) return len < 12;      // shell prompt / tiny output
    return len < 60;                      // 3-4 fragments → sparse unless substantial
}

async function renderSessionPreviewText(source, { noTrim = false } = {}) {
    if (!source || typeof source.output !== 'string') return null;
    const Term = loadHeadlessTerminal();
    if (!Term) return null;
    if (!noTrim) source = { ...source, output: trimPreviewSource(source.output) };
    // Clamp must exceed real-world PTY widths: rendering NARROWER than the
    // content was written re-wraps every long line into garbage (a 253-col
    // session clamped to 220 blanked its tiles; a real 476-col session blew
    // past the old 400 cap).
    const cols = Math.max(2, Math.min(1000, Math.floor(Number(source.cols) || 80)));
    const rows = Math.max(2, Math.min(200, Math.floor(Number(source.rows) || 24)));
    let term;
    try {
        term = new Term({ cols, rows, scrollback: 0, allowProposedApi: true });
    } catch (e) {
        return null;
    }
    await new Promise((resolve) => {
        try { term.write(source.output, () => resolve()); }
        catch (e) { resolve(); }
    });
    const buffer = term.buffer.active;
    const lines = [];
    for (let i = 0; i < rows; i++) {
        const line = buffer.getLine(buffer.baseY + i);
        if (!line) { lines.push(''); continue; }
        const text = line.translateToString(true);
        // Crop, don't cascade: SHORT wrap-continuation rows are the orphan
        // tails of re-wrapped lines ("itance", "ies.") — garbage in a tile.
        // FULL continuation rows are real text (a streaming paragraph fills
        // the screen with them; dropping those blanked busy sessions).
        if (line.isWrapped && text.trim().length < Math.min(40, cols * 0.3)) continue;
        lines.push(text);
    }
    try { term.dispose(); } catch (e) { /* ignore */ }
    while (lines.length && !lines[lines.length - 1].trim()) lines.pop();
    return lines.join('\n');
}

async function fetchExternalHayRuntimeRoomsFromHost(hostState) {
    if (!isExternalTerminalBackend()) return null;
    if (!hostState || !Number.isInteger(hostState.port) || hostState.port <= 0) return null;
    return await new Promise((resolve) => {
        let settled = false;
        const finish = (value) => {
            if (settled) return;
            settled = true;
            resolve(value);
        };
        const opts = {
            hostname: '127.0.0.1',
            port: hostState.port,
            path: '/rooms',
            method: 'GET'
        };
        const req = http.request(opts, (res) => {
            let data = '';
            res.on('data', (chunk) => { data += chunk; });
            res.on('end', () => {
                if ((res.statusCode || 0) < 200 || (res.statusCode || 0) >= 300) {
                    finish(null);
                    return;
                }
                try {
                    const parsed = JSON.parse(data || '{}');
                    const rawRooms = Array.isArray(parsed?.rooms) ? parsed.rooms : [];
                    const rooms = rawRooms
                        .map((room) => {
                            const id = String(room?.id || '').trim();
                            if (!id || !SESSION_NAME_RE.test(id)) return null;
                            const liveCwd = typeof room?.liveCwd === 'string' && room.liveCwd.trim() ? room.liveCwd : undefined;
                            const cwd = liveCwd || (typeof room?.cwd === 'string' && room.cwd.trim() ? room.cwd : undefined);
                            const foregroundProcess = typeof room?.foregroundProcess === 'string' && room.foregroundProcess.trim()
                                ? room.foregroundProcess.trim()
                                : undefined;
                            const lastActivityAt = Number.isFinite(Number(room?.lastActivityAt)) && Number(room.lastActivityAt) > 0
                                ? Number(room.lastActivityAt)
                                : undefined;
                            const bellSeqRaw = Number(room?.bellSeq);
                            const bellSeq = Number.isFinite(bellSeqRaw) && bellSeqRaw >= 0
                                ? Math.floor(bellSeqRaw)
                                : 0;
                            const lastBellAtRaw = Number(room?.lastBellAt);
                            const lastBellAt = Number.isFinite(lastBellAtRaw) && lastBellAtRaw >= 0
                                ? Math.floor(lastBellAtRaw)
                                : 0;
                            const clientCountRaw = Number(room?.clientCount);
                            const clientCount = Number.isFinite(clientCountRaw) && clientCountRaw >= 0
                                ? Math.floor(clientCountRaw)
                                : 0;
                            const localCliCountRaw = Number(room?.localCliCount);
                            const localCliCount = Number.isFinite(localCliCountRaw) && localCliCountRaw >= 0
                                ? Math.floor(localCliCountRaw)
                                : 0;
                            return {
                                id,
                                cwd,
                                foregroundProcess,
                                lastActivityAt,
                                bellSeq,
                                lastBellAt,
                                clientCount,
                                localCliCount,
                                hasLocalCli: localCliCount > 0,
                                hostPid: hostState.pid,
                                hostPort: hostState.port,
                                scoped: hostState.scoped === true
                            };
                        })
                        .filter(Boolean);
                    try { syncSessionMetaFromRooms(rooms); } catch (e) { /* best effort */ }
                    finish(rooms);
                } catch (e) {
                    finish(null);
                }
            });
        });
        req.on('error', () => finish(null));
        req.setTimeout(1200, () => {
            req.destroy();
            finish(null);
        });
        req.end();
    });
}

// Keep a durable {cwd, createdBy} meta per LIVE session, refreshed on every
// rooms fetch (write only on change). This is what lets `hop restore` reopen
// plain-shell sessions (which have no SessionStart-hook record) in their last
// working directory even after a hard crash, where the graceful-shutdown
// buffer path never ran. Room-end/delete cleanup removes these with the rest.
function syncSessionMetaFromRooms(rooms) {
    for (const room of rooms) {
        if (!room || typeof room.id !== 'string' || !SESSION_NAME_RE.test(room.id)) continue;
        const cwd = typeof room.cwd === 'string' ? room.cwd : '';
        if (!cwd) continue;
        const existing = readClaudeSessionMeta(room.id);
        if (existing && existing.cwd === cwd) continue;
        writeClaudeSessionMeta(room.id, {
            ...(existing || {}),
            createdBy: existing?.createdBy === 'agent' ? 'agent' : 'user',
            cwd,
            updatedAt: new Date().toISOString()
        });
    }
}

async function probeExternalHayHostFromHost(hostState, timeoutMs = 1200) {
    if (!isExternalTerminalBackend()) return false;
    if (!hostState || !Number.isInteger(hostState.port) || hostState.port <= 0) return false;
    return await new Promise((resolve) => {
        let settled = false;
        const finish = (value) => {
            if (settled) return;
            settled = true;
            resolve(value);
        };
        const req = http.request({
            hostname: '127.0.0.1',
            port: hostState.port,
            path: '/health',
            method: 'GET'
        }, (res) => {
            let data = '';
            res.on('data', (chunk) => { data += chunk; });
            res.on('end', () => {
                if ((res.statusCode || 0) < 200 || (res.statusCode || 0) >= 300) {
                    finish(false);
                    return;
                }
                try {
                    const parsed = JSON.parse(data || '{}');
                    finish(parsed?.ok === true && parsed?.capabilities?.localCliCount === true);
                } catch (e) {
                    finish(false);
                }
            });
        });
        req.on('error', () => finish(false));
        req.setTimeout(timeoutMs, () => {
            req.destroy();
            finish(false);
        });
        req.end();
    });
}

function choosePreferredHayHost(inspectedHosts, preferredHost = null) {
    if (!Array.isArray(inspectedHosts) || inspectedHosts.length === 0) return null;
    const preferredPid = Number(preferredHost?.pid);
    const preferredPort = Number(preferredHost?.port);
    const ranked = [...inspectedHosts].sort((a, b) => {
        const aRooms = Array.isArray(a.rooms) ? a.rooms.length : 0;
        const bRooms = Array.isArray(b.rooms) ? b.rooms.length : 0;
        if (aRooms !== bRooms) return bRooms - aRooms;
        const aPreferred = a.host.pid === preferredPid && a.host.port === preferredPort ? 1 : 0;
        const bPreferred = b.host.pid === preferredPid && b.host.port === preferredPort ? 1 : 0;
        if (aPreferred !== bPreferred) return bPreferred - aPreferred;
        const aStarted = Number(a.host.startedAt) || 0;
        const bStarted = Number(b.host.startedAt) || 0;
        return bStarted - aStarted;
    });
    return ranked[0]?.host || null;
}

async function inspectExternalHayHosts(force = false) {
    if (!isExternalTerminalBackend()) return [];
    const candidates = listDiscoveredHayHostCandidates(force);
    if (candidates.length === 0) return [];
    const inspected = await Promise.all(candidates.map(async (host) => {
        const __h0 = Date.now();
        const healthy = await probeExternalHayHostFromHost(host);
        const __h1 = Date.now();
        const rooms = await fetchExternalHayRuntimeRoomsFromHost(host);
        const __h2 = Date.now();
        if (__h2 - __h0 > 150) log(`[perf] inspect host pid=${host.pid} port=${host.port}: probe=${__h1-__h0}ms rooms=${__h2-__h1}ms`, YELLOW);
        return { host, healthy, rooms };
    }));
    return inspected.filter((entry) => entry.healthy === true && Array.isArray(entry.rooms));
}

function hostBelongsToCurrentHome(entry, preferredHost = null) {
    if (!entry || !entry.host) return false;
    if (typeof entry.host.homeHash === 'string') {
        return entry.host.homeHash.toLowerCase() === HAY_HOST_HOME_HASH;
    }
    const preferredPid = Number(preferredHost?.pid);
    const preferredPort = Number(preferredHost?.port);
    if (entry.host.pid === preferredPid && entry.host.port === preferredPort) {
        return true;
    }
    return false;
}

function getExternalHayHostStateOrThrow() {
    if (!isExternalTerminalBackend()) return null;
    if (!hayHostState) {
        hayHostState = readHayHostStateFile();
    }
    if (!hayHostState || !isProcessAlive(hayHostState.pid)) {
        clearHayHostStateFile();
        throw new Error('External hay host is not running');
    }
    return hayHostState;
}

async function stopExternalHayHostProcess(hostState, timeoutMs = 1500) {
    const pid = Number(hostState?.pid);
    if (!Number.isInteger(pid) || pid <= 0) return true;
    if (!isProcessAlive(pid)) return true;
    try {
        process.kill(pid, 'SIGTERM');
    } catch (e) {
        return !isProcessAlive(pid);
    }
    const deadline = Date.now() + timeoutMs;
    while (Date.now() < deadline) {
        if (!isProcessAlive(pid)) return true;
        await new Promise((resolve) => setTimeout(resolve, 100));
    }
    if (!isProcessAlive(pid)) return true;
    try {
        process.kill(pid, 'SIGKILL');
    } catch (e) { }
    const forceDeadline = Date.now() + 500;
    while (Date.now() < forceDeadline) {
        if (!isProcessAlive(pid)) return true;
        await new Promise((resolve) => setTimeout(resolve, 100));
    }
    return !isProcessAlive(pid);
}

async function ensureExternalHayHostReady() {
    if (!isExternalTerminalBackend()) return null;

    const existing = hayHostState || readHayHostStateFile();
    const inspectedExisting = await inspectExternalHayHosts();
    const relevantExisting = inspectedExisting.filter((entry) => hostBelongsToCurrentHome(entry, existing));
    const preferredExisting = choosePreferredHayHost(relevantExisting, existing);
    if (preferredExisting) {
        writeHayHostStateFile(preferredExisting);
        return preferredExisting;
    }

    if (existing && isProcessAlive(existing.pid)) {
        // Generous timeout: a host mid-GC or briefly saturated is SLOW, not
        // dead — and "restarting" it kills every live PTY. Only a host that
        // stays unresponsive across repeated probes over a real time window
        // gets restarted; a merely-slow host is returned as-is (degraded but
        // alive beats dead).
        const healthy = await probeExternalHayHostFromHost(existing, 5000);
        if (healthy) {
            if (hayHostProbeFailures.pid === existing.pid && hayHostProbeFailures.count > 0) {
                log(`[Hay] Host ${existing.pid} responsive again after ${hayHostProbeFailures.count} failed probe(s).`, DIM);
            }
            hayHostProbeFailures = { pid: 0, count: 0, firstAt: 0 };
            writeHayHostStateFile(existing);
            return existing;
        }
        if (hayHostProbeFailures.pid !== existing.pid) {
            hayHostProbeFailures = { pid: existing.pid, count: 0, firstAt: Date.now() };
        }
        hayHostProbeFailures.count += 1;
        const failingForMs = Date.now() - hayHostProbeFailures.firstAt;
        if (hayHostProbeFailures.count < HAY_HOST_UNRESPONSIVE_PROBES || failingForMs < HAY_HOST_UNRESPONSIVE_WINDOW_MS) {
            log(`[Hay] Host ${existing.pid} (port ${existing.port}) slow: probe timed out (${hayHostProbeFailures.count}/${HAY_HOST_UNRESPONSIVE_PROBES} over ${Math.round(failingForMs / 1000)}s). Keeping it alive.`, YELLOW);
            writeHayHostStateFile(existing);
            return existing;
        }
        log(`[Hay] Host ${existing.pid} (port ${existing.port}) unresponsive for ${Math.round(failingForMs / 1000)}s (${hayHostProbeFailures.count} failed probes). Restarting it.`, YELLOW);
        hayHostProbeFailures = { pid: 0, count: 0, firstAt: 0 };
        await stopExternalHayHostProcess(existing);
    }

    clearHayHostStateFile();

    // Spawn lock: concurrent ensure calls (other hop processes, racing web
    // requests) must not each spawn a host. Loser waits for the winner's
    // state file and adopts that host.
    let spawnLockFd = null;
    try {
        spawnLockFd = fs.openSync(HAY_HOST_SPAWN_LOCK, 'wx');
        fs.writeSync(spawnLockFd, String(process.pid));
    } catch (e) {
        let stale = true;
        try {
            const holder = Number(fs.readFileSync(HAY_HOST_SPAWN_LOCK, 'utf8'));
            const age = Date.now() - fs.statSync(HAY_HOST_SPAWN_LOCK).mtimeMs;
            stale = !(Number.isInteger(holder) && holder > 0 && isProcessAlive(holder) && age < 30_000);
        } catch (e2) { /* unreadable -> treat as stale */ }
        if (stale) {
            try { fs.unlinkSync(HAY_HOST_SPAWN_LOCK); } catch (e2) { }
        } else {
            // Someone else is spawning: wait for their host to register.
            const waitDeadline = Date.now() + HAY_HOST_READY_TIMEOUT_MS + 3000;
            while (Date.now() < waitDeadline) {
                await new Promise((resolve) => setTimeout(resolve, 200));
                const spawned = readHayHostStateFile();
                if (spawned && isProcessAlive(spawned.pid) && await probeExternalHayHostFromHost(spawned, 1500)) {
                    hayHostState = spawned;
                    return spawned;
                }
            }
            // Winner never delivered — fall through and spawn ourselves.
        }
        try {
            spawnLockFd = fs.openSync(HAY_HOST_SPAWN_LOCK, 'wx');
            fs.writeSync(spawnLockFd, String(process.pid));
        } catch (e2) { spawnLockFd = null; /* proceed unlocked rather than fail */ }
    }
    try {

    const hostScript = path.join(__dirname, 'scripts', 'hay-host.js');
    if (!fs.existsSync(hostScript)) {
        throw new Error('Hay host script missing');
    }

    const requestedPort = Number.parseInt(process.env.HOP_HAY_HOST_PORT || '', 10);
    const hostPort = Number.isInteger(requestedPort) && requestedPort > 0
        ? requestedPort
        : await allocateLocalPort('127.0.0.1');
    const hayHostLogFile = path.join(LOG_DIR, 'hay-host.log');
    const hayHostLogFd = rotateAndOpenLogFd(hayHostLogFile);
    let child;
    try {
        // The host must not inherit the parent claude session's identity: the
        // daemon is routinely (re)started from inside a claude session, and a
        // leaked CLAUDE_CONFIG_DIR reaches every PTY the host spawns (sent
        // restored resumes to the wrong config root, 2026-07-23). The host
        // scrubs its own env too; this covers hosts spawned before that ships.
        const hostEnv = {
            ...process.env,
            HAY_HOST_PORT: String(hostPort),
            HAY_HOST_CWD: process.cwd(),
            // Pin the host's HOP_HOME to the daemon's so it persists session
            // buffers (for `hop restore`) under the same dir we read from.
            HOP_HOME: HOME_DIR
        };
        delete hostEnv.CLAUDE_CONFIG_DIR;
        delete hostEnv.CLAUDE_PID;
        child = spawn(process.execPath, [hostScript, HAY_HOST_HOME_FLAG], {
            detached: true,
            stdio: ['ignore', hayHostLogFd, hayHostLogFd],
            env: hostEnv
        });
    } finally {
        try { fs.closeSync(hayHostLogFd); } catch (e) { }
    }

    const started = {
        pid: Number(child?.pid) || 0,
        port: hostPort,
        startedAt: Date.now(),
        homeHash: HAY_HOST_HOME_HASH
    };
    if (!Number.isInteger(started.pid) || started.pid <= 0) {
        throw new Error(`Hay host failed to start; see ${hayHostLogFile}`);
    }

    const ready = await waitForPort(started.port, '127.0.0.1', HAY_HOST_READY_TIMEOUT_MS, 120);
    if (!ready) {
        await stopExternalHayHostProcess(started);
        throw new Error(`Hay host did not open its port in time; see ${hayHostLogFile}`);
    }
    const healthy = await probeExternalHayHostFromHost(started, 1500);
    if (!healthy) {
        await stopExternalHayHostProcess(started);
        throw new Error(`Hay host failed health check after startup; see ${hayHostLogFile}`);
    }

    writeHayHostStateFile(started);
    child.unref();
    return started;

    } finally {
        if (spawnLockFd !== null) {
            try { fs.closeSync(spawnLockFd); } catch (e) { }
            try { fs.unlinkSync(HAY_HOST_SPAWN_LOCK); } catch (e) { }
        }
    }
}

async function callExternalHayHostApi(apiPath, method = 'GET', body = null, timeoutMs = 2000) {
    if (!isExternalTerminalBackend()) return null;
    const state = await ensureExternalHayHostReady();
    return await new Promise((resolve, reject) => {
        const headers = {};
        let payload = null;
        if (body !== null && body !== undefined) {
            payload = JSON.stringify(body);
            headers['Content-Type'] = 'application/json';
            headers['Content-Length'] = Buffer.byteLength(payload);
        }
        const req = http.request({
            hostname: '127.0.0.1',
            port: state.port,
            path: apiPath,
            method,
            headers
        }, (res) => {
            let data = '';
            res.on('data', (chunk) => { data += chunk; });
            res.on('end', () => {
                let parsed = null;
                try {
                    parsed = data ? JSON.parse(data) : {};
                } catch (e) {
                    parsed = null;
                }
                resolve({
                    status: res.statusCode || 500,
                    data: parsed
                });
            });
        });
        req.on('error', reject);
        req.setTimeout(timeoutMs, () => {
            req.destroy(new Error('Hay host request timeout'));
        });
        if (payload) {
            req.write(payload);
        }
        req.end();
    });
}

function rememberExternalRuntimeSession(sessionName, hostPort = null) {
    if (!sessionName) return null;
    let resolvedHostPort = Number(hostPort);
    if (!Number.isInteger(resolvedHostPort) || resolvedHostPort <= 0 || resolvedHostPort > 65535) {
        const fallbackState = getExternalHayHostStateOrThrow();
        resolvedHostPort = fallbackState.port;
    }
    activeSessions[sessionName] = {
        backend: 'external',
        hostPort: resolvedHostPort
    };
    return activeSessions[sessionName];
}

async function ensureExternalRuntimeSession(sessionName, cwd, displayName, opts = {}) {
    if (!isExternalTerminalBackend()) {
        return getOrCreateSession(sessionName, cwd, displayName);
    }
    if (!sessionName || typeof sessionName !== 'string' || !SESSION_NAME_RE.test(sessionName)) {
        throw new Error('Invalid session name');
    }

    const savedConfig = getSavedSessionConfig(sessionName);
    const runtimeConfig = getRuntimeSessionMetadata(sessionName);
    const existingConfig = getEffectiveSessionConfig(sessionName);
    const saveDefinition = opts.saveDefinition === true || !!savedConfig;
    const createdBy = opts.createdBy || existingConfig?.createdBy || 'user';
    const agentPermitted = typeof opts.agentPermitted === 'boolean'
        ? opts.agentPermitted
        : (typeof existingConfig?.agentPermitted === 'boolean'
            ? existingConfig.agentPermitted
            : createdBy === 'agent');
    const effectiveConfig = {
        type: 'terminal',
        cwd: cwd || existingConfig?.cwd || process.cwd(),
        shell: opts.shell || existingConfig?.shell,
        env: opts.env || existingConfig?.env,
        cols: Number.isInteger(opts.cols) ? opts.cols : existingConfig?.cols,
        rows: Number.isInteger(opts.rows) ? opts.rows : existingConfig?.rows,
        startup: opts.startup || existingConfig?.startup,
        autoStart: typeof opts.autoStart === 'boolean'
            ? opts.autoStart
            : existingConfig?.autoStart,
        createdBy,
        agentPermitted,
        displayName: displayName || existingConfig?.displayName || toDisplaySessionName(sessionName),
        folderId: opts.folderId !== undefined
            ? (opts.folderId || null)
            : (existingConfig?.folderId || null),
        workspaceName: resolveSessionWorkspaceName(savedConfig || existingConfig, { workspaceName: opts.workspaceName })
    };

    if (saveDefinition) {
        ensureTerminalSessionConfig(sessionName, effectiveConfig.cwd, effectiveConfig.displayName, effectiveConfig.folderId, {
            shell: effectiveConfig.shell,
            env: effectiveConfig.env,
            cols: effectiveConfig.cols,
            rows: effectiveConfig.rows,
            startup: effectiveConfig.startup,
            autoStart: effectiveConfig.autoStart,
            createdBy: effectiveConfig.createdBy,
            agentPermitted: effectiveConfig.agentPermitted,
            workspaceName: effectiveConfig.workspaceName
        });
    }

    rememberRuntimeSessionMetadata(sessionName, effectiveConfig);

    const ptyRuntime = buildSessionPtyEnv(sessionName, effectiveConfig, effectiveConfig.workspaceName);
    const roomBody = {
        id: sessionName,
        cwd: effectiveConfig.cwd,
        cols: Number.isInteger(effectiveConfig.cols) ? effectiveConfig.cols : 80,
        rows: Number.isInteger(effectiveConfig.rows) ? effectiveConfig.rows : 24,
        shell: effectiveConfig.shell,
        env: ptyRuntime.env
    };
    // Restore replay (plain-shell sessions only): seed the new room with the
    // previous session's tail buffer so it reopens on its last screen.
    if (typeof opts.seedOutput === 'string' && opts.seedOutput) {
        roomBody.seedOutput = opts.seedOutput;
    }
    // Launch the room ON the relaunch command instead of typing it after the
    // shell is up: no prompt to race, nothing half-typed, no command echo.
    if (typeof opts.command === 'string' && opts.command) {
        roomBody.command = opts.command;
    }
    const response = await callExternalHayHostApi('/rooms', 'POST', roomBody, 2500);
    if (!response || response.status < 200 || response.status >= 300 || !response.data?.ok) {
        const reason = response?.data?.error || `status ${response?.status || 'unknown'}`;
        throw new Error(`Failed to start external session "${displayName || sessionName}": ${reason}`);
    }

    const room = response.data.room || {};
    const resolvedCwd = typeof room.cwd === 'string' && room.cwd ? room.cwd : effectiveConfig.cwd;
    rememberRuntimeSessionMetadata(sessionName, { ...effectiveConfig, cwd: resolvedCwd });
    if (saveDefinition) {
        ensureTerminalSessionConfig(
            sessionName,
            resolvedCwd,
            effectiveConfig.displayName,
            effectiveConfig.folderId,
            {
                shell: effectiveConfig.shell,
                env: effectiveConfig.env,
                cols: Number.isInteger(effectiveConfig.cols) ? effectiveConfig.cols : undefined,
                rows: Number.isInteger(effectiveConfig.rows) ? effectiveConfig.rows : undefined,
                startup: effectiveConfig.startup,
                autoStart: effectiveConfig.autoStart,
                createdBy: effectiveConfig.createdBy,
                agentPermitted: effectiveConfig.agentPermitted,
                workspaceName: effectiveConfig.workspaceName
            }
        );
    }

    return rememberExternalRuntimeSession(sessionName, getExternalHayHostStateOrThrow().port);
}

async function reconcileExternalRuntimeSessions() {
    if (!isExternalTerminalBackend()) return { rooms: [], runtimeAvailable: false };
    const __r0 = Date.now();
    await ensureExternalHayHostReady();
    const __r1 = Date.now();
    const rooms = await fetchExternalHayRuntimeRooms();
    const __r2 = Date.now();
    if (__r2 - __r0 > 200) log(`[perf] reconcile: ensure=${__r1-__r0}ms fetchRooms=${__r2-__r1}ms`, YELLOW);
    if (!Array.isArray(rooms)) {
        return { rooms: [], runtimeAvailable: false };
    }

    const runtimeIds = new Set();
    for (const room of rooms) {
        if (!room || !room.id) continue;
        runtimeIds.add(room.id);
        const savedConfig = getSessionConfig(room.id);
        const runtimeConfig = getRuntimeSessionMetadata(room.id);
        const durableMeta = readClaudeSessionMeta(room.id);
        const createdBy = savedConfig?.createdBy || runtimeConfig?.createdBy || durableMeta?.createdBy || 'user';
        rememberRuntimeSessionMetadata(room.id, {
            type: 'terminal',
            cwd: room.cwd || savedConfig?.cwd || runtimeConfig?.cwd,
            // The durable meta carries the rename: the workspace store only
            // persists when a workspace exists, so without this a renamed
            // session reverted to its internal name on every daemon restart.
            // Collision guard: a rename can leave a session displaying a name
            // that a LATER session owns as its internal name (rename Altair →
            // "Accessibility", then a real Accessibility room appears). Two
            // identically-named sessions are indistinguishable in the UI and
            // ambiguous to address, so the room that OWNS the name keeps it
            // and the borrower falls back to its own — self-healing, and it
            // never touches a running process.
            displayName: (() => {
                // Durable meta first: every rename writes it, and it is the
                // only layer that survives a daemon restart. Preferring a
                // store/runtime entry here let a stale in-memory name undo a
                // rename on the very next tick.
                const claimed = durableMeta?.displayName || savedConfig?.displayName || runtimeConfig?.displayName;
                if (claimed && claimed !== room.id && runtimeIds.has(toInternalSessionName(claimed) || claimed)) {
                    log(`[rename] "${claimed}" is another live session's name — ${room.id} keeps its own`, YELLOW);
                    return toDisplaySessionName(room.id) || room.id;
                }
                return claimed || toDisplaySessionName(room.id) || room.id;
            })(),
            // Same for the AI tagline — written by `hop ai tagline`, it must
            // outlive the daemon that generated it.
            tagline: savedConfig?.tagline || runtimeConfig?.tagline || durableMeta?.tagline,
            taglineAt: savedConfig?.taglineAt || runtimeConfig?.taglineAt || durableMeta?.taglineAt,
            parked: savedConfig?.parked ?? runtimeConfig?.parked ?? durableMeta?.parked,
            archived: savedConfig?.archived ?? runtimeConfig?.archived ?? durableMeta?.archived,
            folderId: savedConfig?.folderId || runtimeConfig?.folderId || null,
            shell: savedConfig?.shell || runtimeConfig?.shell,
            env: savedConfig?.env || runtimeConfig?.env,
            cols: Number.isInteger(savedConfig?.cols) ? savedConfig.cols : runtimeConfig?.cols,
            rows: Number.isInteger(savedConfig?.rows) ? savedConfig.rows : runtimeConfig?.rows,
            startup: savedConfig?.startup || runtimeConfig?.startup,
            autoStart: typeof savedConfig?.autoStart === 'boolean' ? savedConfig.autoStart : runtimeConfig?.autoStart,
            createdBy,
            agentPermitted: typeof savedConfig?.agentPermitted === 'boolean'
                ? savedConfig.agentPermitted
                : (typeof runtimeConfig?.agentPermitted === 'boolean'
                    ? runtimeConfig.agentPermitted
                    : createdBy === 'agent'),
            workspaceName: resolveSessionWorkspaceName(savedConfig || runtimeConfig, {
                workspaceName: savedConfig?.workspaceName || runtimeConfig?.workspaceName
            })
        });
        // Keep the durable meta's cwd on the room's LIVE directory. Restore
        // otherwise falls back to the claude record's cwd — the directory
        // claude reported for its own conversation, which for agent/MCP
        // workspaces is a different tree entirely. That is how a session
        // working in ~/Code/nebula-slides came back in the slides tool's
        // agent-home workspace and read as "my session died".
        if (room.cwd && typeof room.cwd === 'string' && durableMeta && durableMeta.cwd !== room.cwd) {
            writeClaudeSessionMeta(room.id, { ...durableMeta, internalName: room.id, cwd: room.cwd });
        }
        rememberExternalRuntimeSession(room.id, room.hostPort);
    }

    for (const [name, session] of Object.entries(activeSessions)) {
        if (session?.backend === 'external' && !runtimeIds.has(name)) {
            delete activeSessions[name];
            clearRuntimeSessionMetadata(name);
        }
    }
    for (const name of Array.from(runtimeSessionMetadata.keys())) {
        if (!runtimeIds.has(name)) {
            clearRuntimeSessionMetadata(name);
        }
    }

    return { rooms, runtimeAvailable: true };
}

function buildExternalHayWsPath(parsedUrl, sessionName) {
    const params = new URLSearchParams();
    const query = parsedUrl?.query || {};
    for (const [key, value] of Object.entries(query)) {
        if (key === 'room' || key === 'token') continue;
        if (Array.isArray(value)) {
            for (const part of value) {
                if (part !== undefined && part !== null) {
                    params.append(key, String(part));
                }
            }
        } else if (value !== undefined && value !== null) {
            params.append(key, String(value));
        }
    }
    params.set('room', sessionName);
    if (!params.has('cwd')) {
        const sessionCwd = (getEffectiveSessionConfig(sessionName) || {}).cwd;
        if (sessionCwd) params.set('cwd', sessionCwd);
    }
    return `/ws?${params.toString()}`;
}

function getExternalHayHostPortForSession(sessionName, options = {}) {
    const requestedPort = Number(options.hostPort);
    if (Number.isInteger(requestedPort) && requestedPort > 0 && requestedPort <= 65535) {
        return requestedPort;
    }
    const sessionPort = Number(activeSessions[sessionName]?.hostPort);
    if (Number.isInteger(sessionPort) && sessionPort > 0 && sessionPort <= 65535) {
        return sessionPort;
    }
    const state = getExternalHayHostStateOrThrow();
    return state.port;
}

function buildExternalHayWsUrl(sessionName, options = {}) {
    const port = getExternalHayHostPortForSession(sessionName, options);
    const params = new URLSearchParams();
    params.set('room', sessionName);
    if (options.name) params.set('name', String(options.name));
    if (Number.isFinite(options.cols)) params.set('cols', String(Math.floor(Number(options.cols))));
    if (Number.isFinite(options.rows)) params.set('rows', String(Math.floor(Number(options.rows))));
    if (options.source) params.set('source', String(options.source));
    if (options.claim) params.set('claim', String(options.claim));
    if (options.cwd) params.set('cwd', String(options.cwd));
    return `ws://127.0.0.1:${port}/ws?${params.toString()}`;
}

async function waitForExternalHaySessionClosed(sessionName, hostPort = null, timeoutMs = 1500, intervalMs = 120) {
    if (!isExternalTerminalBackend() || !sessionName) return true;
    const targetPort = Number(hostPort) || getExternalHayHostPortForSession(sessionName, { hostPort });
    const deadline = Date.now() + timeoutMs;
    while (Date.now() <= deadline) {
        const rooms = await fetchExternalHayRuntimeRoomsFromHost({ port: targetPort, scoped: true });
        if (Array.isArray(rooms) && !rooms.some((room) => room && room.id === sessionName)) {
            return true;
        }
        await new Promise((resolve) => setTimeout(resolve, intervalMs));
    }
    const finalRooms = await fetchExternalHayRuntimeRoomsFromHost({ port: targetPort, scoped: true });
    return Array.isArray(finalRooms) && !finalRooms.some((room) => room && room.id === sessionName);
}

async function terminateExternalHaySession(sessionName) {
    if (!isExternalTerminalBackend() || !sessionName) return true;
    const hostPort = getExternalHayHostPortForSession(sessionName);
    try {
        const response = await callExternalHayHostApi(`/rooms/${encodeURIComponent(sessionName)}`, 'DELETE', null, 1500);
        if (response && response.status >= 200 && response.status < 300) {
            const closed = await waitForExternalHaySessionClosed(sessionName, hostPort);
            if (closed && activeSessions[sessionName]) {
                delete activeSessions[sessionName];
            }
            return closed;
        }
    } catch (e) { }

    let ws;
    try {
        ws = new WebSocket(buildExternalHayWsUrl(sessionName, {
            name: 'hop-control',
            cols: 80,
            rows: 24,
            source: 'hop-kill'
        }));
    } catch (e) {
        return false;
    }

    await new Promise((resolve) => {
        let finished = false;
        const finish = () => {
            if (finished) return;
            finished = true;
            try { ws.close(); } catch (e) { }
            resolve();
        };

        ws.once('open', () => {
            try {
                ws.send(JSON.stringify({ type: 'kill_session' }));
            } catch (e) { }
            setTimeout(finish, 120);
        });
        ws.once('error', finish);
        ws.once('close', finish);
        setTimeout(finish, 800);
    });

    const closed = await waitForExternalHaySessionClosed(sessionName, hostPort);
    if (closed && activeSessions[sessionName]) {
        delete activeSessions[sessionName];
    }
    return closed;
}

