function ensureHayBuilt() {
    if (didBuildHay) return;
    if (!fs.existsSync(HAY_ROOT)) return;
    const webDistDir = path.join(HAY_ROOT, 'apps/web/dist');
    const serverDistFile = path.join(HAY_ROOT, 'apps/server/dist/lib.js');
    const cliDistFile = path.join(HAY_ROOT, 'apps/cli/dist/index.js');
    const sharedDep = path.join(HAY_ROOT, 'node_modules/hay-shared/package.json');
    const needsInstall = !fs.existsSync(sharedDep);
    const needsBuild = !fs.existsSync(webDistDir) || !fs.existsSync(cliDistFile) || !fs.existsSync(serverDistFile);
    if (!needsInstall && !needsBuild) return;
    try {
        console.log(`[Dev] Building Hay from: ${HAY_ROOT}`);
        if (needsInstall) {
            execFileSync('npm', ['--prefix', HAY_ROOT, 'install'], { stdio: 'inherit' });
