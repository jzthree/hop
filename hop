// ── Canonical hostname + session handoff ──────────────────────────────────
// An instance can move: the hostname a client was set up against stops being
// the one it should use (most often because the old host became a public
// landing page). Clients ask /api/instance where home is now, and carry their
// existing session across with a one-time handoff rather than making the user
// re-enter a password and a TOTP code on every device.
//
// The cookie itself CANNOT be shared across the move: it is host-scoped, and
// widening it to Domain=<landing host> would broadcast this instance's
// session secret to every registered user's subdomain. Hence a token.
function getCanonicalHost() {
    const configured = getHopConfig().canonicalHost;
    return configured ? String(configured).toLowerCase() : null;
}

function requestHostname(req) {
    return String(req?.headers?.['x-forwarded-host'] || req?.headers?.host || '')
        .split(',')[0].split(':')[0].trim().toLowerCase();
}

// Single-use, short-lived. A handoff grants exactly the access the requester
// already had, on one specific hostname, once.
const handoffTokens = new Map(); // token -> expiresAt
const HANDOFF_TTL_MS = 60 * 1000;

function mintHandoffToken() {
    const nowMs = Date.now();
    for (const [token, expiresAt] of handoffTokens) {
        if (expiresAt < nowMs) handoffTokens.delete(token);
    }
    const token = crypto.randomBytes(32).toString('base64url');
    handoffTokens.set(token, nowMs + HANDOFF_TTL_MS);
    return token;
}

function redeemHandoffToken(token) {
    const key = String(token || '');
    const expiresAt = handoffTokens.get(key);
    if (!expiresAt) return false;
    handoffTokens.delete(key);           // single use, even if expired
    return expiresAt >= Date.now();
}

// The hostname that serves the public landing page: the custom domain itself.
let landingHostCache = { at: 0, value: null };
function getLandingHostname() {
    if (Date.now() - landingHostCache.at < REGISTRATION_CACHE_MS) return landingHostCache.value;
    // A configured landingHost wins — it lets signup live on a SEPARATE host
    // (hop-setup.zhoulab.io) so the bare domain stays the admin's instance.
    // Falls back to the bare custom domain when unset (the front-door model).
    let value = null;
    try {
        const stored = JSON.parse(fs.readFileSync(REGISTRATION_FILE, 'utf8')) || {};
        if (typeof stored.landingHost === 'string' && stored.landingHost.trim()) {
            value = stored.landingHost.trim().toLowerCase();
        }
    } catch (e) { /* fall through to the domain default */ }
    if (!value) {
        const domain = getDomainConfig();
        value = domain && domain.hostname ? String(domain.hostname).toLowerCase() : null;
    }
    landingHostCache = { at: Date.now(), value };
    return value;
}

function getRegistrationStore() {
    const config = getRegistrationConfig();
    return new RegistrationStore(REGISTRATIONS_FILE, {
        allowedDomain: config.allowedEmailDomain,
        // A name already provisioned — or reserved for the admin — can never
        // be handed out by the public form.
        takenSubdomains: () => {
            const taken = Object.keys(getUsers());
            if (config.adminSubdomain) taken.push(config.adminSubdomain);
            return taken;
        }
    });
}

// Does this request belong to the public landing surface? Only when
// registration is switched on AND the request arrived on the bare custom
// domain — a user's own subdomain, localhost and the CLI are untouched.
function isLandingRequest(req) {
    const config = getRegistrationConfig();
    if (!config.enabled) return false;
    const landing = getLandingHostname();
    if (!landing) return false;
    const host = String(req?.headers?.host || '').split(':')[0].trim().toLowerCase();
    return host === landing;
}

async function sendRegistrationMail(to, subject, text) {
    const config = getMailConfig();
    if (!config) throw new Error('Mail is not configured. Run: hop mail setup');
    return smtpSendMail(config, { to, subject, text });
}

// Anything interpolated into the landing HTML that a stranger can influence
// goes through this first.
function escapeHtml(value) {
    return String(value == null ? '' : value)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

