const NO_TUNNEL = process.env.HOP_NO_TUNNEL === '1';
const PRIVATE_DIR_MODE = 0o700;
const PRIVATE_FILE_MODE = 0o600;

function ensurePrivateDir(dirPath) {
    try {
        if (!fs.existsSync(dirPath)) {
            fs.mkdirSync(dirPath, { recursive: true, mode: PRIVATE_DIR_MODE });
        } else {
            fs.chmodSync(dirPath, PRIVATE_DIR_MODE);
        }
    } catch (e) { }
}

function ensurePrivateFile(filePath, mode = PRIVATE_FILE_MODE) {
    try {
        if (fs.existsSync(filePath)) {
            fs.chmodSync(filePath, mode);
        }
    } catch (e) { }
}

let __atomicWriteCounter = 0;
function writePrivateFile(filePath, data, mode = PRIVATE_FILE_MODE) {
    // Atomic write: write to a sibling temp file, fsync, then rename over the
    // target. A crash or concurrent writer can then never leave a half-written
    // or truncated file — which would make a state file unparseable and, e.g.,
    // make a live daemon look dead (isServerRunning swallows the parse error)
    // and let a second daemon spawn. Falls back to a direct write on odd FSes.
    const tmpPath = `${filePath}.tmp-${process.pid}-${++__atomicWriteCounter}`;
    let fd;
    try {
        fd = fs.openSync(tmpPath, 'wx', mode);
        fs.writeFileSync(fd, data);
        try { fs.fsyncSync(fd); } catch (e) { /* best-effort durability */ }
        fs.closeSync(fd);
        fd = undefined;
        fs.renameSync(tmpPath, filePath);
    } catch (err) {
        if (fd !== undefined) { try { fs.closeSync(fd); } catch (e) { } }
        try { fs.unlinkSync(tmpPath); } catch (e) { }
        fs.writeFileSync(filePath, data, { mode });
    }
    ensurePrivateFile(filePath, mode);
}

ensurePrivateDir(HOME_DIR);

// Sanity check: detect nested config directories (common after manual moves)
function validateConfigDir() {
    const suspiciousDirs = ['.hop-shell', '.hop-shell2', '.hop2'];
    for (const dir of suspiciousDirs) {
        const nested = path.join(HOME_DIR, dir);
        if (fs.existsSync(nested) && fs.statSync(nested).isDirectory()) {
            // Check if it contains config files that should be in HOME_DIR
            const nestedFiles = ['.auth_secret', '.password_hash', '.domain-config.json'];
            for (const f of nestedFiles) {
                if (fs.existsSync(path.join(nested, f))) {
                    console.error(`\n${RED}ERROR: Config files found in nested directory: ${nested}${RESET}`);
                    console.error(`Expected config files directly in: ${HOME_DIR}`);
                    console.error(`\nFix with: mv "${nested}"/* "${nested}"/.[!.]* "${HOME_DIR}/" && rmdir "${nested}"\n`);
                    process.exit(1);
                }
            }
        }
    }
}
validateConfigDir();

const STATE_FILE = path.join(HOME_DIR, '.tunnel-state');
// Where `hop view` and `hop port` publish. Deliberately under HOME_DIR and
// NOT under HAY_WEB_DIR, which resolves to hay/apps/web/dist — vite's own
// outDir. That directory is gitignored AND emptied on every `npm run build`,
// so every published deliverable silently vanished the next time anyone
// rebuilt the web bundle. A view is the thing the human was waiting on; it
// outlives a build.
const VIEWS_DIR = path.join(HOME_DIR, 'views');
// One-time move of anything published before that was understood. Best
// effort: a failure here just means the old copies stay unreachable, which
// is where they were headed anyway.
function migrateLegacyViews() {
    try {
        const legacy = path.join(HAY_WEB_DIR, 'assets', 'view');
        if (!fs.existsSync(legacy)) return;
        for (const sess of fs.readdirSync(legacy)) {
            const src = path.join(legacy, sess);
            if (sess === 'manifest.json' || !fs.statSync(src).isDirectory()) continue;
            const dst = path.join(VIEWS_DIR, sess);
            fs.mkdirSync(dst, { recursive: true });
            for (const f of fs.readdirSync(src)) {
                const to = path.join(dst, f);
                if (!fs.existsSync(to)) fs.copyFileSync(path.join(src, f), to);
            }
        }
        fs.rmSync(legacy, { recursive: true, force: true });
    } catch (e) { /* the new root still works */ }
}

// A view's TITLE, kept beside the files rather than in their names. An agent
// hands over "ROC curve, new model vs baseline", not "roc_curve.png", and a
// filename cannot carry that without becoming a filename nobody can type.
// One sidecar per session dir so deleting a session's folder takes its
// captions with it; dotfile so the manifest scan skips it.
function viewMetaPath(session) { return path.join(VIEWS_DIR, session, '.meta.json'); }
function readViewMeta(session) {
    try { return JSON.parse(fs.readFileSync(viewMetaPath(session), 'utf8')) || {}; }
    catch (e) { return {}; }
}
function writeViewMeta(session, meta) {
    try { fs.writeFileSync(viewMetaPath(session), JSON.stringify(meta, null, 1)); }
    catch (e) { /* a missing caption is not worth failing a publish over */ }
}

// Markdown, rendered at SERVE time rather than converted at publish time: the
// stored file stays the file the agent wrote (re-publishable, diffable), and
// the URL still reads like it. Deliberately small and dependency-free — hop
// ships as one script and a markdown dependency is not worth a node_modules
// entry. Covers what an agent actually emits in a result: headings, fenced
// code, lists, tables, quotes, links, emphasis.
function renderMarkdown(src, title, theme) {
    const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const blocks = [];
    // Fenced code first, so nothing below rewrites its insides.
    let text = src.replace(/```([\w-]*)\n([\s\S]*?)```/g, (m, lang, body) => {
        blocks.push(`<pre class="code"><code>${esc(body.replace(/\n$/, ''))}</code></pre>`);
        return `\u0000BLOCK${blocks.length - 1}\u0000`;
    });
    text = esc(text);
    const inline = (s) => s
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/!\[([^\]]*)\]\(([^)\s]+)\)/g, '<img alt="$1" src="$2">')
        .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>');
    const out = [];
    const lines = text.split('\n');
    let para = [], list = null, table = null;
    const flushPara = () => { if (para.length) { out.push(`<p>${inline(para.join(' '))}</p>`); para = []; } };
    const flushList = () => { if (list) { out.push(`<${list.tag}>${list.items.map((i) => `<li>${inline(i)}</li>`).join('')}</${list.tag}>`); list = null; } };
    const flushTable = () => {
        if (!table) return;
        const cells = (row, tag) => row.map((c) => `<${tag}>${inline(c.trim())}</${tag}>`).join('');
        out.push(`<table><thead><tr>${cells(table.head, 'th')}</tr></thead><tbody>`
            + table.rows.map((r) => `<tr>${cells(r, 'td')}</tr>`).join('') + '</tbody></table>');
        table = null;
    };
    const flushAll = () => { flushPara(); flushList(); flushTable(); };
    const splitRow = (l) => l.replace(/^\||\|$/g, '').split('|');
    for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if (/^\u0000BLOCK\d+\u0000$/.test(line.trim())) { flushAll(); out.push(line.trim()); continue; }
        if (!line.trim()) { flushAll(); continue; }
        // A table needs its separator row to be a table at all.
        if (!table && line.includes('|') && /^\s*\|?[\s:-]*-[\s:|-]*\|?\s*$/.test(lines[i + 1] || '')) {
            flushPara(); flushList();
            table = { head: splitRow(line), rows: [] };
            i++;
            continue;
        }
        if (table) {
            if (line.includes('|')) { table.rows.push(splitRow(line)); continue; }
            flushTable();
        }
        let m;
        if ((m = line.match(/^(#{1,6})\s+(.*)$/))) {
            flushAll();
            out.push(`<h${m[1].length}>${inline(m[2])}</h${m[1].length}>`);
        } else if (/^\s*([-*_])\s*\1\s*\1[\s\S]*$/.test(line) && line.trim().length >= 3
                   && /^[-*_\s]+$/.test(line)) {
            flushAll(); out.push('<hr>');
        } else if ((m = line.match(/^\s*[-*+]\s+(.*)$/))) {
            flushPara(); flushTable();
            if (list?.tag !== 'ul') { flushList(); list = { tag: 'ul', items: [] }; }
            list.items.push(m[1]);
        } else if ((m = line.match(/^\s*\d+[.)]\s+(.*)$/))) {
            flushPara(); flushTable();
            if (list?.tag !== 'ol') { flushList(); list = { tag: 'ol', items: [] }; }
            list.items.push(m[1]);
        } else if ((m = line.match(/^&gt;\s?(.*)$/))) {
            flushPara(); flushList(); flushTable();
            out.push(`<blockquote>${inline(m[1])}</blockquote>`);
        } else if (list && !para.length) {
            // Lazy continuation: a wrapped bullet is still that bullet.
            // Agents hard-wrap long list items constantly, and treating each
            // wrap as a new block rendered a clean summary as a pile of
            // one-item lists with orphaned paragraphs between them.
            list.items[list.items.length - 1] += ' ' + line.trim();
        } else {
            flushList(); flushTable();
            para.push(line.trim());
        }
    }
    flushAll();
    const body = out.join('\n').replace(/\u0000BLOCK(\d+)\u0000/g, (m, i) => blocks[Number(i)]);
    return viewPageShell(title, body, theme);
}

// The page every rendered view lives in. Tokened light AND dark palettes:
// this page is read INSIDE the wall (an iframe) and the wall has a theme the
// OS knows nothing about, so the client passes ?theme= and wins outright;
// with no opinion given, prefers-color-scheme decides. It shipped dark-only
// first, and a dark page framed by a light wall read as someone else's app.
function viewPageShell(title, body, theme) {
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const light = '--bg:#fdfdfc;--ink:#22212a;--muted:#6b6878;--accent:#6d4fd0;--panel:#f4f3f8;--line:#e4e2ec;--codebg:#efedf5;';
    const dark = '--bg:#0b0b12;--ink:#e8e6f0;--muted:#9a93b8;--accent:#a78bfa;--panel:#16151f;--line:#2a2740;--codebg:#201e2e;';
    const palette = theme === 'light' ? `:root{${light}color-scheme:light}`
        : theme === 'dark' ? `:root{${dark}color-scheme:dark}`
        : `:root{${light}color-scheme:light dark}@media (prefers-color-scheme: dark){:root{${dark}}}`;
    return `<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${esc(title)}</title><style>
${palette}
body { margin:0 auto; padding:24px 18px 64px; max-width:46rem; background:var(--bg); color:var(--ink);
  font:16px/1.65 -apple-system,"SF Pro Text",Helvetica,sans-serif; overflow-wrap:break-word; }
h1,h2,h3,h4 { line-height:1.25; margin:1.6em 0 .5em; }
h1 { font-size:1.7rem; } h2 { font-size:1.35rem; } h3 { font-size:1.12rem; }
a { color:var(--accent); }
code { font-family:ui-monospace,"SF Mono",monospace; font-size:.87em; background:var(--codebg);
  padding:.12em .38em; border-radius:6px; }
pre.code { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:12px 14px;
  overflow-x:auto; } pre.code code { background:none; padding:0; font-size:.85rem; }
blockquote { margin:1em 0; padding:.2em 0 .2em 1em; border-left:3px solid var(--line); color:var(--muted); }
table { border-collapse:collapse; width:100%; margin:1.2em 0; font-size:.93rem; display:block; overflow-x:auto; }
th,td { border:1px solid var(--line); padding:7px 10px; text-align:left; }
th { background:var(--panel); position:sticky; top:0; }
th.num,td.num { text-align:right; font-variant-numeric:tabular-nums;
  font-family:ui-monospace,"SF Mono",monospace; font-size:.88em; }
tbody tr:nth-child(even) td { background:color-mix(in srgb, var(--panel) 45%, transparent); }
hr { border:0; border-top:1px solid var(--line); margin:2em 0; }
img { max-width:100%; border-radius:10px; }
.foot { color:var(--muted); font-size:.8rem; margin-top:1.1em; }
</style></head><body>\n${body}\n</body></html>`;
}

// Names `--session` will accept, for the error that asks for one. Reading the
// daemon's own list rather than the views folder: the answer to "where can
// this go" is every live session, not just the ones that already published.
function listPublishTargets(state) {
    try {
        const out = execFileSync(process.execPath, ['-e', `
            const http = require('http');
            http.get({ host: '127.0.0.1', port: ${Number(state.port)}, path: '/api/sessions',
                       headers: { Cookie: 'tunnel_session=' + process.argv[1] } }, (r) => {
                let b = ''; r.on('data', (c) => b += c);
                r.on('end', () => {
                    try {
                        const d = JSON.parse(b);
                        console.log((d.sessions || []).map((s) => s.internalName).join('\\n'));
                    } catch (e) { }
                });
            }).on('error', () => {});
        `, String(state.sessionSecret)], { encoding: 'utf8', timeout: 4000 });
        return out.split('\n').map((s) => s.trim()).filter(Boolean).slice(0, 12);
    } catch (e) {
        return [];
    }
}

// Runtime data written into the served assets dir — the briefing's
// digest.json is the live example — is deleted by every web bundle rebuild,
// because HAY_WEB_DIR resolves to vite's outDir when a dev build exists.
// hop-ios's digest tool already mitigates half of this by writing to BOTH
// candidate roots; the daemon only ever READ the first, so after a rebuild
// the surviving copy sat unreachable and the wall's briefing 404'd. This
// completes the other half: fall back to the packaged bundle for anything
// the dev build doesn't have.
function packagedAssetFallback(relPath) {
    try {
        const packagedRoot = path.resolve(path.join(__dirname, 'hay-web'));
        if (path.resolve(HAY_WEB_DIR) === packagedRoot) return null;   // same dir already
        const candidate = path.resolve(path.join(packagedRoot, relPath));
        if (!candidate.startsWith(packagedRoot + path.sep)) return null;
        return fs.existsSync(candidate) && fs.statSync(candidate).isFile() ? candidate : null;
    } catch (e) {
        return null;
    }
}

// Clear the published COPIES — `hop view` copies files into VIEWS_DIR, so
// "clear" releases exactly the space this feature consumes and can never
// touch the agent's originals, which live wherever they were created
// (Jian: "release any space hop consumes but do not delete the source
// files"). Live-server rows survive: they weigh nothing and their real
// resource is the running session, which is not a Views-panel decision.
function clearViewFiles(onlySession) {
    let removed = 0, bytes = 0;
    try {
        const sessions = onlySession ? [onlySession]
            : fs.readdirSync(VIEWS_DIR).filter((d) => !d.startsWith('.') && d !== 'manifest.json');
        for (const sess of sessions) {
            const dir = path.join(VIEWS_DIR, sess);
            if (!fs.existsSync(dir) || !fs.statSync(dir).isDirectory()) continue;
            const meta = readViewMeta(sess);
            for (const f of fs.readdirSync(dir)) {
                if (f.startsWith('.')) continue;
                if (meta[f]?.kind === 'server') continue;
                try {
                    bytes += fs.statSync(path.join(dir, f)).size;
                    fs.rmSync(path.join(dir, f));
                    delete meta[f];
                    removed += 1;
                } catch (e) { /* the next file still clears */ }
            }
            if (Object.keys(meta).length) writeViewMeta(sess, meta);
            else {
                // Nothing left worth a folder: take the sidecar and dir too.
                try { fs.rmSync(viewMetaPath(sess), { force: true }); } catch (e) { }
                try { if (!fs.readdirSync(dir).length) fs.rmSync(dir, { recursive: true }); } catch (e) { }
            }
        }
    } catch (e) { /* partial clears still rebuild an honest index */ }
    rebuildViewManifest();
    return { removed, bytes };
}

// Per-session view facts for the sessions list: how many, how recent, and
// what the newest one is called. Read from the manifest (already a cheap
// single file) rather than re-scanning, and re-read only when it changes —
// the sessions list is polled by every client, several times a minute.
let viewSummaryCache = { mtimeMs: -1, bySession: {} };
function viewSummaryBySession() {
    try {
        const mf = path.join(VIEWS_DIR, 'manifest.json');
        const st = fs.statSync(mf);
        if (st.mtimeMs !== viewSummaryCache.mtimeMs) {
            const items = JSON.parse(fs.readFileSync(mf, 'utf8')).items || [];
            const by = {};
            for (const it of items) {
                const cur = by[it.session];
                // The manifest is newest-first, so the first one wins.
                if (!cur) {
                    by[it.session] = {
                        count: 1, latestAt: it.mtime, latestName: it.name,
                        latestTitle: it.title || '', latestPath: it.path
                    };
                } else cur.count += 1;
            }
            viewSummaryCache = { mtimeMs: st.mtimeMs, bySession: by };
        }
    } catch (e) {
        viewSummaryCache = { mtimeMs: -1, bySession: {} };
    }
    return viewSummaryCache.bySession;
}

// The log's budget. Jian's design: views are "a size-capped recent log" —
// one kind of entry, one removal gesture, and the cap does the housekeeping
// nobody wants to do by hand. Oldest FILE views evict first once the fleet's
// published bytes exceed the budget; live-server rows weigh nothing and are
// never evicted. Copies only, as always — sources are not hop's to touch.
const VIEWS_BUDGET_BYTES = (Number(process.env.HOP_VIEWS_BUDGET_MB) > 0
