// Claude asks how to resume a large conversation ("1. Resume from summary
// (recommended) / 2. Resume full session as-is / 3. Don't ask me again"), so a
// restored session comes back alive but frozen on a question. There is no CLI
// flag for it, so hop answers on the user's behalf. Default: FULL — a restored
// session should be the session you left, not a summary of it. Set
// resume_mode to "summary" (cheaper) or "ask" (leave the prompt alone).
const RESUME_PROMPT_RE = /Resuming the full session|Resume from summary|Resume full session as-is/i;
// Claude Code's own chrome — proof the app is up even when the room reports
// the wrapper shell as its foreground process (argv launch).
const CLAUDE_UI_RE = /bypass permissions on|shift\+tab to cycle|Welcome back|esc to interrupt|\? for shortcuts/i;
// Claude Code's workspace-trust dialog ("Quick safety check: is this a
// project you created or one you trust?"). It precedes everything else -
// the resume prompt included - whenever the config root holds no
// acceptance for the directory (an explicit false, even one an older
// claude wrote, beats a trusted ancestor). Restore could not see it: not
// chrome, not a resume prompt, so the session read as "never started" and
// sat at the dialog for two weeks (lightscope, Neptune). Whitespace-
// tolerant because the grid text can run words together across wraps.
const TRUST_PROMPT_RE = /Quick\s*safety\s*check|Yes,?\s*I\s*trust\s*this\s*folder|Is\s*this\s*a\s*project\s*you\s*created\s*or\s*one\s*you\s*trust/i;
// The directory the dialog is asking about, so an answer is only ever given
// for the workspace the session was launched in - never for wherever a
// shell happened to wander.
function trustDialogWorkspace(screenText) {
    const m = /Accessing\s*workspace:?\s*(\/[^\s\u2502\u2500]+)/i.exec(String(screenText || ''));
    return m ? m[1].replace(/\/+$/, '') : null;
}
function samePath(a, b) {
    const norm = (p) => {
        let v = String(p || '').replace(/\/+$/, '');
        try { v = fs.realpathSync(v); } catch (e) { /* keep as-is */ }
        return v;
    };
    return !!a && !!b && norm(a) === norm(b);
}
function getResumeMode() {
    const mode = String(getHopConfig().resume_mode || '').toLowerCase();
    return mode === 'summary' || mode === 'ask' ? mode : 'full';
}
function resumeChoiceKey(mode) {
