// ---- Claude hook install/remove (in ~/.claude/settings.json) ---------------
// The same script is registered for two events: SessionStart (records the
// conversation id for `hop restore`) and Stop (bumps a per-turn counter a driver
// can wait on). See scripts/claude-session-hook.js.
const CLAUDE_HOOK_EVENTS = ['SessionStart', 'Stop'];

function getClaudeSettingsPath() {
    const dir = process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude');
    return path.join(dir, 'settings.json');
}

// Every Claude config root on this machine: CLAUDE_CONFIG_DIR, ~/.claude, and
// alternate installs like ~/.claude_fable (their agents read their own root's
// skills/settings, so hop assets must land in each).
function getClaudeConfigRoots() {
    const roots = [];
    const push = (p) => { if (p && !roots.includes(p)) roots.push(p); };
    push(process.env.CLAUDE_CONFIG_DIR);
    push(path.join(os.homedir(), '.claude'));
    try {
        for (const entry of fs.readdirSync(os.homedir())) {
            if (/^\.claude[_-][A-Za-z0-9_-]+$/.test(entry)) push(path.join(os.homedir(), entry));
        }
    } catch (e) { /* home unreadable — defaults stand */ }
    return roots.filter((p) => { try { return fs.statSync(p).isDirectory(); } catch (e) { return false; } });
}

function getCodexConfigRoots() {
    const root = process.env.CODEX_HOME || path.join(os.homedir(), '.codex');
    try {
        return fs.statSync(root).isDirectory() ? [root] : [];
    } catch (e) {
        return [];
    }
}

function getAgentSkillRoots() {
    return Array.from(new Set([...getClaudeConfigRoots(), ...getCodexConfigRoots()]));
}

// ---- hop-session skill install/remove (<config-root>/skills/hop-session/) --
// Teaches agents running INSIDE hop terminals the house conventions (render
// math via `hop math`, ring the bell when blocked, phone-friendly output).
// Source of truth: skills/hop-session/SKILL.md in the hop install.
const HOP_SKILLS_DIR = path.join(__dirname, 'skills');

function installAgentSkills(roots) {
    let names = [];
    try {
        names = fs.readdirSync(HOP_SKILLS_DIR).filter((n) => fs.existsSync(path.join(HOP_SKILLS_DIR, n, 'SKILL.md')));
    } catch (e) {
        return { ok: false, error: `skills dir missing: ${HOP_SKILLS_DIR}` };
    }
    if (!names.length) return { ok: false, error: `no skills found in ${HOP_SKILLS_DIR}` };
    const installed = [];
    const already = [];
    for (const name of names) {
        const content = fs.readFileSync(path.join(HOP_SKILLS_DIR, name, 'SKILL.md'), 'utf8');
        for (const root of roots) {
            const dest = path.join(root, 'skills', name, 'SKILL.md');
            try {
                if (fs.existsSync(dest) && fs.readFileSync(dest, 'utf8') === content) {
                    already.push(dest);
                    continue;
                }
                fs.mkdirSync(path.dirname(dest), { recursive: true });
                fs.writeFileSync(dest, content);
                installed.push(dest);
            } catch (e) {
                return { ok: false, error: `${dest}: ${e.message}` };
            }
        }
    }
    return { ok: true, installed, already };
}

