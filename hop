// ── Self-service registration ─────────────────────────────────────────────
// The landing host (the bare custom domain, e.g. hop.zhoulab.io) can serve a
// PUBLIC signup page instead of the login gate: visitors ask for
// <name>.<landing-host>, prove an eligible email address, and wait for the
// admin to approve. Approval runs the existing addUser provisioning, so a
// registrant ends up exactly where a hand-added user does — running their own
// hop on their own machine, behind their own tunnel.
//
// OFF by default, and deliberately so: turning it on repurposes the hostname
// the admin's own browser and phone are pointed at, so it must be a decision,
// never a side effect of upgrading.
const REGISTRATION_FILE = path.join(HOME_DIR, '.registration.json');
const REGISTRATIONS_FILE = path.join(HOME_DIR, '.registrations.json');
const MAIL_CONFIG_FILE = path.join(HOME_DIR, '.mail-config.json');
const { RegistrationStore } = require('./lib/registration');
const { sendMail: smtpSendMail } = require('./lib/mailer');

// isLandingRequest() runs on EVERY http request, including the terminal's own
// traffic, so the two config reads behind it are cached briefly. A CLI toggle
// takes effect within a few seconds; a disk read per keystroke would not be
// worth that immediacy.
let registrationConfigCache = { at: 0, value: null };
const REGISTRATION_CACHE_MS = 1000;

function getRegistrationConfig() {
    if (registrationConfigCache.value && Date.now() - registrationConfigCache.at < REGISTRATION_CACHE_MS) {
        return registrationConfigCache.value;
    }
    let stored = {};
    try {
        stored = JSON.parse(fs.readFileSync(REGISTRATION_FILE, 'utf8')) || {};
    } catch (e) { /* absent or corrupt: defaults below */ }
    // How identity is proven. 'smtp' (default) mails a confirmation link;
    // 'cloudflare-access' trusts a verified Access JWT at CLAIM time instead,
    // so no mail is ever sent and signup stays open (no Access seat is spent
    // until an approved user actually claims). accessTeam/accessAudience feed
    // the JWT verifier; preapprovedEmails auto-advance a signup past the
    // admin queue (the admin's own lab).
    const gate = stored.emailGate === 'cloudflare-access' ? 'cloudflare-access' : 'smtp';
    const value = {
        enabled: stored.enabled === true,
        allowedEmailDomain: stored.allowedEmailDomain || 'uchicago.edu',
        // Where the admin's own hop lives once the bare host becomes the
        // landing page. Purely for the "sign in" link and the approval mail.
        adminSubdomain: stored.adminSubdomain || null,
        emailGate: gate,
        // Where the signup page is served. Default: the bare custom domain
        // (turning hop.zhoulab.io itself into the front door, which forces the
        // admin to move their own clients to a subdomain). Set to a SEPARATE
        // hostname (hop-setup.zhoulab.io) to keep the bare domain as the
        // admin's untouched instance — signup lives on its own host, no
        // client migration. The host must route to this daemon either way.
        landingHost: typeof stored.landingHost === 'string' && stored.landingHost.trim()
            ? stored.landingHost.trim().toLowerCase() : null,
        accessTeam: typeof stored.accessTeam === 'string' ? stored.accessTeam.trim() : null,
        accessAudience: typeof stored.accessAudience === 'string' ? stored.accessAudience.trim() : null,
        preapprovedEmails: Array.isArray(stored.preapprovedEmails)
            ? stored.preapprovedEmails.map((e) => String(e || '').trim().toLowerCase()).filter(Boolean)
            : []
    };
    registrationConfigCache = { at: Date.now(), value };
    return value;
}

function saveRegistrationConfig(config) {
    writePrivateFile(REGISTRATION_FILE, JSON.stringify(config, null, 2));
    registrationConfigCache = { at: 0, value: null }; // a deliberate change lands now
}
// The whole registration surface asks this instead of re-deriving the mode.
function registrationUsesAccessGate() {
    return getRegistrationConfig().emailGate === 'cloudflare-access';
}
function isPreapprovedEmail(email) {
    const addr = String(email || '').trim().toLowerCase();
    return !!addr && getRegistrationConfig().preapprovedEmails.includes(addr);
}
const { verifyAccessJwt } = require('./lib/cf-access');
// Pull and verify the Access identity off an inbound request. The token
// rides in the Cf-Access-Jwt-Assertion header (or the CF_Authorization
// cookie). Returns { ok, email } — the email is BELIEVED only after the
// signature/issuer/expiry/audience all check out.
async function verifiedAccessEmail(req) {
    const cfg = getRegistrationConfig();
    if (!cfg.accessTeam) return { ok: false, error: 'Access team is not configured (hop registration access-team <name>)' };
    let token = req.headers['cf-access-jwt-assertion'];
    if (!token) {
        const cookie = req.headers['cookie'] || '';
        const m = /(?:^|;\s*)CF_Authorization=([^;]+)/.exec(cookie);
        if (m) token = decodeURIComponent(m[1]);
    }
    return verifyAccessJwt(token, { teamDomain: cfg.accessTeam, audience: cfg.accessAudience || null });
}

