        path.join(__dirname, 'hay/apps/web/dist'),
        path.join(__dirname, '../hay/apps/web/dist'),
        path.join(__dirname, '../../hay/apps/web/dist'),
        path.resolve(__dirname, '../hay/apps/web/dist'),
