function setNoCache(res) {
    res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
    res.setHeader('Pragma', 'no-cache');
    res.setHeader('Expires', '0');
}

function appendSetCookie(res, cookies) {
    const existing = res.getHeader('Set-Cookie');
    if (!existing) {
        res.setHeader('Set-Cookie', cookies);
        return;
    }
    const merged = Array.isArray(existing) ? existing.concat(cookies) : [existing].concat(cookies);
    res.setHeader('Set-Cookie', merged);
}

function clearAuthCookies(res) {
    const expires = new Date(0);
    appendSetCookie(res, [
        cookie.serialize(SESSION_COOKIE_NAME, '', {
            httpOnly: true,
            secure: true,
            sameSite: 'lax',
            path: '/',
            expires,
            maxAge: 0
        }),
        cookie.serialize(SESSION_COOKIE_NAME, '', {
            httpOnly: true,
            secure: true,
            sameSite: 'lax',
            path: '/api',
            expires,
            maxAge: 0
        })
    ]);
}

function escapeHtml(value) {
    return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

// ---- Passkey (WebAuthn) login — biometric auth via Touch ID / Face ID ----
// Passkeys AUGMENT TOTP (which stays as the fallback): a verified assertion
// mints the same tunnel_session cookie the TOTP path mints. Credentials are
// per-rpID (per hostname), so a passkey enrolled at the tunnel domain works
// there and one enrolled at localhost works locally.
const PASSKEYS_FILE = path.join(HOME_DIR, '.passkeys.json');
let webauthnLibPromise = null;
function loadWebauthn() {
    // The library is ESM-only; hop is CJS — load lazily via dynamic import.
    if (!webauthnLibPromise) webauthnLibPromise = import('@simplewebauthn/server');
    return webauthnLibPromise;
}

function loadPasskeys() {
    try {
        const parsed = JSON.parse(fs.readFileSync(PASSKEYS_FILE, 'utf8'));
        return {
            userId: typeof parsed?.userId === 'string' ? parsed.userId : null,
            credentials: Array.isArray(parsed?.credentials) ? parsed.credentials : []
        };
    } catch (e) {
        return { userId: null, credentials: [] };
    }
}

function savePasskeys(store) {
    writePrivateFile(PASSKEYS_FILE, JSON.stringify(store, null, 2));
}

// Outstanding WebAuthn challenges, single-use with a short TTL.
const passkeyChallenges = new Map();
function putPasskeyChallenge(type, rpID, challenge) {
    const now = Date.now();
    for (const [k, v] of passkeyChallenges) {
        if (v.expiresAt < now) passkeyChallenges.delete(k);
    }
    const token = crypto.randomBytes(16).toString('hex');
    passkeyChallenges.set(token, { challenge, type, rpID, expiresAt: now + 120000 });
    return token;
}

function takePasskeyChallenge(token, type) {
    const entry = passkeyChallenges.get(String(token || ''));
    passkeyChallenges.delete(String(token || ''));
    if (!entry || entry.type !== type || entry.expiresAt < Date.now()) return null;
    return entry;
}

// rpID/origin from the request's own Host: the tunnel domain for remote
// logins, localhost for local ones. (WebAuthn forbids bare IPs as rpIDs —
// use http://localhost:<port> rather than 127.0.0.1 for local passkeys.)
function passkeyRpInfo(req) {
    const hostHeader = String(req.headers['x-forwarded-host'] || req.headers.host || '').split(',')[0].trim();
    const hostname = hostHeader.replace(/:\d+$/, '') || 'localhost';
    const isLocal = hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1';
    const proto = String(req.headers['x-forwarded-proto'] || '').split(',')[0].trim() || (isLocal ? 'http' : 'https');
    return { rpID: hostname, origin: `${proto}://${hostHeader}` };
}

function readRequestJson(req, limit = 262144) {
    return new Promise((resolve) => {
        let body = '';
        let dead = false;
        req.on('data', (chunk) => {
            if (dead) return;
            body += chunk;
            if (body.length > limit) { dead = true; resolve(null); }
        });
        req.on('end', () => {
            if (dead) return;
            try { resolve(JSON.parse(body || '{}')); } catch (e) { resolve(null); }
        });
        req.on('error', () => resolve(null));
    });
}

let lastAuthAt = 0;
function recordAuth(authEmitter) {
    lastAuthAt = Date.now();
    if (authEmitter) authEmitter.emit('authenticated');
}

function startAuthProxy(authEmitter) {
    log(`[2/4] Starting Session Manager on port ${PROXY_PORT}...`, BOLD);

    const server = http.createServer(async (req, res) => {
        const parsedUrl = url.parse(req.url, true);
        const cookies = cookie.parse(req.headers.cookie || '');
        const ip = getClientIp(req);
        const sessionInfo = parseSessionFromRequest(req, parsedUrl);

        // Check auth via cookie OR Authorization header (internal hop-to-hop only)
        // Bearer token is read from state file by other hop processes on same machine
        const authHeader = req.headers.authorization;
        const tokenFromHeader = authHeader && authHeader.startsWith('Bearer ')
            ? authHeader.substring(7)
            : null;
        const isAuthenticated = cookies[SESSION_COOKIE_NAME] === SESSION_SECRET
            || tokenFromHeader === SESSION_SECRET;

        // API: Auth status (used by local CLI to wait for remote login)
        if (parsedUrl.pathname === '/api/auth' && req.method === 'GET') {
            if (!isAuthenticated) {
                res.writeHead(401, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Unauthorized' }));
                return;
            }
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({ lastAuthAt }));
            return;
        }

        // --- PASSKEYS (WebAuthn) ---
        if (parsedUrl.pathname.startsWith('/api/passkeys/') && req.method === 'POST') {
            const respond = (status, payload) => {
                res.writeHead(status, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify(payload));
            };
            const rp = passkeyRpInfo(req);
            try {
                // Unauthenticated: obtain a login challenge.
                if (parsedUrl.pathname === '/api/passkeys/login-options') {
                    const store = loadPasskeys();
                    const creds = store.credentials.filter((c) => c.rpID === rp.rpID);
                    if (creds.length === 0) {
                        respond(200, { ok: false, error: `No passkeys enrolled for ${rp.rpID}` });
                        return;
                    }
                    const { generateAuthenticationOptions } = await loadWebauthn();
                    const options = await generateAuthenticationOptions({
                        rpID: rp.rpID,
                        userVerification: 'preferred',
                        allowCredentials: creds.map((c) => ({
                            id: c.id,
                            transports: Array.isArray(c.transports) && c.transports.length ? c.transports : undefined
                        }))
                    });
                    respond(200, { ok: true, token: putPasskeyChallenge('login', rp.rpID, options.challenge), options });
                    return;
                }
                // Unauthenticated: verify assertion → mint the session cookie.
                if (parsedUrl.pathname === '/api/passkeys/login') {
                    const limit = checkRateLimit(ip);
                    if (!limit.allowed) {
                        respond(429, { ok: false, error: `Too many attempts. Try again in ${limit.remaining}s.` });
                        return;
                    }
                    const body = await readRequestJson(req);
                    const challenge = body ? takePasskeyChallenge(body.token, 'login') : null;
                    const store = loadPasskeys();
                    const cred = body?.response?.id
                        ? store.credentials.find((c) => c.id === body.response.id && c.rpID === rp.rpID)
                        : null;
                    if (!challenge || !cred) {
                        recordFailure(ip);
                        respond(401, { ok: false, error: 'Passkey not recognized' });
                        return;
                    }
                    const { verifyAuthenticationResponse } = await loadWebauthn();
                    let verification;
                    try {
                        verification = await verifyAuthenticationResponse({
                            response: body.response,
                            expectedChallenge: challenge.challenge,
                            expectedOrigin: rp.origin,
                            expectedRPID: rp.rpID,
                            credential: {
                                id: cred.id,
                                publicKey: Buffer.from(cred.publicKey, 'base64url'),
                                counter: Number(cred.counter) || 0,
                                transports: cred.transports
                            },
                            requireUserVerification: false
                        });
                    } catch (e) {
                        verification = null;
                    }
                    if (!verification?.verified) {
                        recordFailure(ip);
                        respond(401, { ok: false, error: 'Passkey verification failed' });
                        return;
                    }
                    cred.counter = verification.authenticationInfo?.newCounter ?? cred.counter;
                    cred.lastUsedAt = new Date().toISOString();
                    savePasskeys(store);
                    resetFailure(ip);
                    appendSetCookie(res, [
                        cookie.serialize(SESSION_COOKIE_NAME, SESSION_SECRET, {
                            httpOnly: true,
                            secure: true,
                            sameSite: 'lax',
                            path: '/',
                            maxAge: 60 * 60 * 24 * 7
                        })
                    ]);
                    recordAuth(authEmitter);
                    respond(200, { ok: true });
                    return;
                }
                // Everything below requires an authenticated session.
                if (!isAuthenticated) {
                    respond(401, { ok: false, error: 'Unauthorized' });
                    return;
                }
                if (parsedUrl.pathname === '/api/passkeys/register-options') {
                    const store = loadPasskeys();
                    if (!store.userId) store.userId = crypto.randomBytes(16).toString('base64url');
                    const { generateRegistrationOptions } = await loadWebauthn();
                    const options = await generateRegistrationOptions({
                        rpName: 'hop',
                        rpID: rp.rpID,
                        userID: Buffer.from(store.userId, 'base64url'),
                        userName: 'hop',
                        userDisplayName: `hop @ ${rp.rpID}`,
                        attestationType: 'none',
                        excludeCredentials: store.credentials
                            .filter((c) => c.rpID === rp.rpID)
                            .map((c) => ({ id: c.id, transports: c.transports })),
                        authenticatorSelection: { residentKey: 'preferred', userVerification: 'preferred' }
                    });
                    savePasskeys(store); // persist userId
                    respond(200, { ok: true, token: putPasskeyChallenge('register', rp.rpID, options.challenge), options });
                    return;
                }
                if (parsedUrl.pathname === '/api/passkeys/register') {
                    const body = await readRequestJson(req);
                    const challenge = body ? takePasskeyChallenge(body.token, 'register') : null;
                    if (!challenge) {
                        respond(400, { ok: false, error: 'Challenge expired — try again' });
                        return;
                    }
                    const { verifyRegistrationResponse } = await loadWebauthn();
                    let verification;
                    try {
                        verification = await verifyRegistrationResponse({
                            response: body.response,
                            expectedChallenge: challenge.challenge,
                            expectedOrigin: rp.origin,
                            expectedRPID: rp.rpID,
                            requireUserVerification: false
                        });
                    } catch (e) {
                        verification = null;
                    }
                    const registered = verification?.verified ? verification.registrationInfo?.credential : null;
                    if (!registered) {
                        respond(400, { ok: false, error: 'Attestation verification failed' });
                        return;
                    }
                    const store = loadPasskeys();
                    if (!store.credentials.some((c) => c.id === registered.id)) {
                        store.credentials.push({
                            id: registered.id,
                            publicKey: Buffer.from(registered.publicKey).toString('base64url'),
                            counter: Number(registered.counter) || 0,
                            transports: registered.transports || body?.response?.response?.transports || [],
                            rpID: rp.rpID,
                            label: String(body?.label || '').slice(0, 60) || `passkey · ${rp.rpID}`,
                            createdAt: new Date().toISOString()
                        });
                        savePasskeys(store);
                    }
                    log(`[passkey] enrolled for ${rp.rpID} (${store.credentials.length} total)`, GREEN);
                    respond(200, { ok: true, count: store.credentials.length });
                    return;
                }
                if (parsedUrl.pathname === '/api/passkeys/list') {
                    const store = loadPasskeys();
                    respond(200, {
                        ok: true,
                        passkeys: store.credentials.map((c) => ({
                            id: c.id, rpID: c.rpID, label: c.label, createdAt: c.createdAt, lastUsedAt: c.lastUsedAt || null
                        }))
                    });
                    return;
                }
                if (parsedUrl.pathname === '/api/passkeys/delete') {
                    const body = await readRequestJson(req);
                    const store = loadPasskeys();
                    const before = store.credentials.length;
                    store.credentials = store.credentials.filter((c) => c.id !== String(body?.id || ''));
                    savePasskeys(store);
                    respond(200, { ok: true, removed: before - store.credentials.length });
                    return;
                }
                respond(404, { ok: false, error: 'Unknown passkey endpoint' });
            } catch (e) {
                log(`[passkey] error: ${e.message}`, RED);
                respond(500, { ok: false, error: 'Passkey internal error' });
            }
            return;
        }

        // --- LOGIN PAGE ---
        if (!isAuthenticated) {
            const passwordRequired = isPasswordEnabled();
            const storedPasswordHash = getStoredPassword();

            // API Login endpoint - authenticates via password (if enabled) + TOTP
            if (req.method === 'POST' && parsedUrl.pathname === '/api/login') {
                const limit = checkRateLimit(ip);
                if (!limit.allowed) {
                    res.writeHead(429, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ success: false, error: `Too many attempts. Try again in ${limit.remaining}s.` }));
                    return;
                }

                let body = '';
                req.on('data', chunk => body += chunk);
                req.on('end', () => {
                    try {
                        const { totp, password } = JSON.parse(body);

                        // Check password if enabled
                        if (passwordRequired && !verifyPassword(password || '', storedPasswordHash)) {
                            recordFailure(ip);
                            res.writeHead(401, { 'Content-Type': 'application/json' });
                            res.end(JSON.stringify({ success: false, error: 'Invalid password' }));
                            return;
                        }

                        // Check TOTP
                        if (authenticator.check(totp, AUTH_SECRET)) {
                            resetFailure(ip);
                            appendSetCookie(res, [
                                cookie.serialize(SESSION_COOKIE_NAME, SESSION_SECRET, {
                                    httpOnly: true,
                                    secure: true,
                                    sameSite: 'lax',
                                    path: '/',
                                    maxAge: 60 * 60 * 24 * 7
                                })
                            ]);
                            res.writeHead(200, { 'Content-Type': 'application/json' });
                            res.end(JSON.stringify({ success: true }));
                            recordAuth(authEmitter);
                        } else {
                            recordFailure(ip);
                            res.writeHead(401, { 'Content-Type': 'application/json' });
                            res.end(JSON.stringify({ success: false, error: 'Invalid code' }));
                        }
                    } catch (e) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ success: false, error: 'Invalid request' }));
                    }
                });
                return;
            }

            // Web form login (support / and /s/<name>/)
            if (req.method === 'POST' && (parsedUrl.pathname === '/' || parsedUrl.pathname.startsWith('/s/'))) {
                const limit = checkRateLimit(ip);
                if (!limit.allowed) {
                    res.writeHead(429, { 'Content-Type': 'text/html; charset=utf-8' });
                    res.end(`Too many attempts. Try again in ${limit.remaining}s. <a href="/">Back</a>`);
                    return;
                }

                let body = '';
                req.on('data', chunk => body += chunk);
                req.on('end', () => {
                    const params = new URLSearchParams(body);
                    const token = params.get('token');
                    const password = params.get('password');
                    const requestedDisplayName = params.get('session') || sessionInfo?.displayName;
                    const requestedInternalName = requestedDisplayName
                        ? toInternalSessionName(requestedDisplayName)
                        : null;

                    try {
                        // Check password if enabled
                        if (passwordRequired && !verifyPassword(password || '', storedPasswordHash)) {
                            recordFailure(ip);
                            res.writeHead(401, { 'Content-Type': 'text/html; charset=utf-8' });
                            res.end('Invalid password. <a href="/">Try Again</a>');
                            return;
                        }

                        // Check TOTP
                        if (authenticator.check(token, AUTH_SECRET)) {
                            resetFailure(ip);
                            appendSetCookie(res, [
                                cookie.serialize(SESSION_COOKIE_NAME, SESSION_SECRET, {
                                    httpOnly: true,
                                    secure: true,
                                    sameSite: 'lax',
                                    path: '/',
                                    maxAge: 60 * 60 * 24 * 7
                                })
                            ]);
                            const redirectTarget = requestedInternalName
                                ? buildSessionPath(requestedDisplayName)
                                : '/sessions';
                            res.writeHead(302, { 'Location': redirectTarget });
                            res.end();
                            recordAuth(authEmitter);
                        } else {
                            recordFailure(ip);
                            res.writeHead(401, { 'Content-Type': 'text/html; charset=utf-8' });
                            res.end('Invalid Code. <a href="/">Try Again</a>');
                        }
                    } catch (e) {
                        res.writeHead(401);
                        res.end('Error verifying code');
                    }
                });
                return;
            }

            // Show login page - with password field if enabled
            const passwordFieldHtml = passwordRequired ? `
                <div style="margin-bottom: 1.5rem;">
                    <input type="password" name="password" id="passwordField" placeholder="Password"
                        style="width: 100%; padding: 0.8rem 1rem; font-size: 1rem; border: 1px solid #e4e4e7; border-radius: 8px; background: #fff; color: #18181b; box-sizing: border-box;"
                        required>
                </div>
                <p style="color: #71717a; margin-bottom: 1rem; font-size: 0.9rem;">Then enter your authenticator code:</p>
            ` : '';

            const passwordCheckJs = passwordRequired ? `
                const passwordField = document.getElementById('passwordField');
                if (!passwordField.value) {
                    passwordField.focus();
                    return;
                }
            ` : '';

            const requestedDisplayName = sessionInfo?.displayName;
            const requestedInternalName = requestedDisplayName
                ? (resolveSessionDisplayName(requestedDisplayName).internalName || toInternalSessionName(requestedDisplayName))
                : null;
            const sessionFieldHtml = requestedInternalName
                ? `<input type="hidden" name="session" value="${escapeHtml(requestedDisplayName)}">`
                : '';

            clearAuthCookies(res);
            setNoCache(res);
            res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
            res.end(`
                <html>
                    <head>
                        <meta charset="UTF-8">
                        <meta name="viewport" content="width=device-width, initial-scale=1">
                        <title>Verify Identity</title>
                        <style>
                            body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #fafafa; color: #18181b; display: flex; justify-content: center; align-items: center; height: 100vh; margin:0; }
                            .box { text-align: center; max-width: 400px; padding: 2rem; }
                            h2 { margin-bottom: 1.5rem; font-weight: 600; font-size: 1.5rem; }
                            .code-inputs { display: flex; gap: 8px; justify-content: center; margin-bottom: 2rem; }
                            .code-inputs input {
                                width: 44px; height: 56px;
                                font-size: 24px; text-align: center;
                                border: 1px solid #e4e4e7; border-radius: 8px;
                                background: #fff; color: #18181b;
                                -moz-appearance: textfield;
                            }
                            .code-inputs input:focus { outline: none; border-color: #7c3aed; box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.1); }
                            .code-inputs input::-webkit-outer-spin-button,
                            .code-inputs input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
                            input[type="password"]:focus { outline: none; border-color: #7c3aed; box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.1); }

                            button { font-size: 1rem; padding: 0.8rem 2.5rem; background: #18181b; color: #fff; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; width: 100%; transition: opacity 0.2s; }
                            button:hover { opacity: 0.9; }
                            .hidden-submit { position: absolute; left: -9999px; }
                        </style>
                    </head>
                    <body>
                        <div class="box">
                            <h2>Security Check</h2>
                            ${passwordRequired ? '<p style="color: #71717a; margin-bottom: 1rem; font-size: 0.9rem;">Enter your password:</p>' : '<p style="color: #71717a; margin-bottom: 2rem; font-size: 0.9rem;">Please enter the verification code from your authenticator app to continue.</p>'}
                            <form method="POST" id="authForm">
                                ${passwordFieldHtml}
                                ${sessionFieldHtml}
                                <div class="code-inputs" id="inputs">
                                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                                </div>
                                <input type="hidden" name="token" id="fullToken">
                                <button type="submit">Verify</button>
                            </form>
                            <div id="passkeyRow" style="display:none; margin-top: 1.2rem;">
                                <div style="display:flex; align-items:center; gap:10px; margin-bottom:1rem; color:#a1a1aa; font-size:0.8rem;">
                                    <span style="flex:1; height:1px; background:#e4e4e7;"></span>or<span style="flex:1; height:1px; background:#e4e4e7;"></span>
                                </div>
                                <button type="button" id="passkeyBtn" style="background:#7c3aed;">Sign in with Touch&nbsp;ID / passkey</button>
                                <p id="passkeyErr" style="display:none; color:#cf222e; font-size:0.85rem; margin-top:0.6rem;"></p>
                            </div>
                        </div>
                        <script>
                            const inputs = document.querySelectorAll('.code-inputs input');
                            const form = document.getElementById('authForm');
                            const hidden = document.getElementById('fullToken');

                            // ---- Passkey (WebAuthn) sign-in ----
                            const pkRow = document.getElementById('passkeyRow');
                            const pkBtn = document.getElementById('passkeyBtn');
                            const pkErr = document.getElementById('passkeyErr');
                            const b64uToBuf = (s) => Uint8Array.from(
                                atob(s.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(s.length / 4) * 4, '=')),
                                (c) => c.charCodeAt(0)
                            );
                            const bufToB64u = (b) => btoa(String.fromCharCode(...new Uint8Array(b)))
                                .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');
                            async function passkeyLogin() {
                                pkErr.style.display = 'none';
                                try {
                                    const optRes = await fetch('/api/passkeys/login-options', { method: 'POST' });
                                    const opt = await optRes.json();
                                    if (!opt.ok) throw new Error(opt.error || 'No passkeys enrolled');
                                    const pub = opt.options;
                                    pub.challenge = b64uToBuf(pub.challenge);
                                    pub.allowCredentials = (pub.allowCredentials || []).map((c) => ({ ...c, id: b64uToBuf(c.id) }));
                                    const cred = await navigator.credentials.get({ publicKey: pub });
                                    const r = cred.response;
                                    const payload = {
                                        token: opt.token,
                                        response: {
                                            id: cred.id,
                                            rawId: bufToB64u(cred.rawId),
                                            type: cred.type,
                                            authenticatorAttachment: cred.authenticatorAttachment || undefined,
                                            clientExtensionResults: cred.getClientExtensionResults(),
                                            response: {
                                                clientDataJSON: bufToB64u(r.clientDataJSON),
                                                authenticatorData: bufToB64u(r.authenticatorData),
                                                signature: bufToB64u(r.signature),
                                                userHandle: r.userHandle ? bufToB64u(r.userHandle) : undefined
                                            }
                                        }
                                    };
                                    const vr = await fetch('/api/passkeys/login', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(payload)
                                    });
                                    const out = await vr.json();
                                    if (!out.ok) throw new Error(out.error || 'Verification failed');
                                    window.location.reload();
                                } catch (e) {
                                    if (e && e.name === 'NotAllowedError') return; // user dismissed the prompt
                                    pkErr.textContent = e.message || String(e);
                                    pkErr.style.display = 'block';
                                }
                            }
                            if (window.PublicKeyCredential) {
                                // Show the button only when passkeys exist for this hostname.
                                fetch('/api/passkeys/login-options', { method: 'POST' })
                                    .then((r) => r.json())
                                    .then((opt) => { if (opt.ok) pkRow.style.display = 'block'; })
                                    .catch(() => {});
                                pkBtn.addEventListener('click', passkeyLogin);
                            }

                            inputs.forEach((input, i) => {
                                input.addEventListener('input', e => {
                                    if (e.target.value.length === 1) {
                                        if (i < inputs.length - 1) inputs[i + 1].focus();
                                        else submit();
                                    }
                                });
                                input.addEventListener('keydown', e => {
                                    if (e.key === 'Backspace' && !e.target.value && i > 0) {
                                        inputs[i - 1].focus();
                                    }
                                });
                                input.addEventListener('paste', e => {
                                    e.preventDefault();
                                    const text = (e.clipboardData || window.clipboardData).getData('text');
                                    const digits = text.replace(/[^0-9]/g, '').slice(0, 6);
                                    if (digits.length === 0) return;
                                    digits.split('').forEach((char, index) => {
                                        if (inputs[index]) inputs[index].value = char;
                                    });
                                    if (digits.length === 6) submit();
                                    else inputs[Math.min(digits.length, 5)].focus();
                                });
                            });

                            function submit() {
                                ${passwordCheckJs}
                                const code = Array.from(inputs).map(i => i.value).join('');
                                if (code.length === 6) {
                                    hidden.value = code;
                                    form.submit();
                                }
                            }

                            form.addEventListener('submit', e => {
                                const code = Array.from(inputs).map(i => i.value).join('');
                                hidden.value = code;
                            });
                        </script>
                    </body>
                </html>
            `);
            return;
        }

        // --- AUTHENTICATED ROUTES ---
        const sessionInfoAuth = parseSessionFromRequest(req, parsedUrl);
        const sessionName = sessionInfoAuth ? sessionInfoAuth.internalName : null;
        const displayName = sessionInfoAuth ? sessionInfoAuth.displayName : null;
        const strippedUrl = sessionInfoAuth ? sessionInfoAuth.strippedUrl : req.url;
        const strippedPathname = sessionInfoAuth ? sessionInfoAuth.strippedPathname : (parsedUrl.pathname || '/');

        if (sessionInfoAuth && sessionInfoAuth.source === 'path' && sessionInfoAuth.aliasRedirect && shouldRedirectToSessionPath(req)) {
            const target = buildSessionPath(displayName) + (parsedUrl.search || '');
            res.writeHead(302, { 'Location': target });
            res.end();
            return;
        }

        if (sessionInfoAuth && sessionInfoAuth.source === 'query' && shouldRedirectToSessionPath(req)) {
            res.writeHead(302, { 'Location': buildSessionPath(displayName) });
            res.end();
            return;
        }
        if (sessionInfoAuth && sessionInfoAuth.source === 'path' && sessionInfoAuth.needsSlash && shouldRedirectToSessionPath(req)) {
            const target = buildSessionPath(displayName) + (parsedUrl.search || '');
            res.writeHead(302, { 'Location': target });
            res.end();
            return;
        }

        // API: Ping (triggers auth event for mobile login)
        if (parsedUrl.pathname === '/api/ping' && req.method === 'POST') {
            recordAuth(authEmitter);
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({ ok: true, message: 'Mobile login' }));
            return;
        }

        // API: Tunnel status (local diagnostics for hop health)
        if (parsedUrl.pathname === '/api/tunnel/status' && req.method === 'GET') {
            let tunnelPid = currentTunnelProc && !currentTunnelProc.killed ? currentTunnelProc.pid : null;
            let tunnelRunning = false;
            if (tunnelPid) {
                try {
                    process.kill(tunnelPid, 0);
                    tunnelRunning = true;
                } catch (e) {
                    tunnelPid = null;
                }
            }
            if (!tunnelRunning && tunnelStatus.connected) {
                updateTunnelStatus({
                    connected: false,
                    lastEvent: 'stale',
                    lastError: 'cloudflared process not running'
                });
            }
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({
                url: currentPublicUrl,
                connected: tunnelStatus.connected,
                lastEvent: tunnelStatus.lastEvent,
                lastError: tunnelStatus.lastError,
                lastUpdateAt: tunnelStatus.lastUpdateAt,
                lastConnectedAt: tunnelStatus.lastConnectedAt,
                lastRestartAt: tunnelStatus.lastRestartAt,
                consecutiveFailures: tunnelStatus.consecutiveFailures,
                tunnelPid,
                tunnelRunning
            }));
            return;
        }

        // API: Tunnel restart (local diagnostics for hop health)
        if (parsedUrl.pathname === '/api/tunnel/restart' && req.method === 'POST') {
            if (tunnelRestartInProgress) {
                res.writeHead(202, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ ok: true, inProgress: true }));
                return;
            }
            updateTunnelStatus({ lastRestartAt: Date.now(), lastEvent: 'restarting' });
            if (currentTunnelProc && !currentTunnelProc.killed) {
                try { currentTunnelProc.kill('SIGTERM'); } catch (e) { }
            } else {
                startTunnelWithRestart();
            }
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({ ok: true }));
            return;
        }

        // API: keyboard input-loss diagnostics beacon — the mobile client posts
        // its tap/dispatch/send counters here so a typing-burst result can be
        // read from the daemon log without a device screenshot.
        if (parsedUrl.pathname === '/api/diag' && req.method === 'POST') {
            let diagBody = '';
            req.on('data', (chunk) => { diagBody += chunk; if (diagBody.length > 2048) req.destroy(); });
            req.on('end', () => {
                log(`[kbdiag] ${String(diagBody).slice(0, 500)}`, CYAN);
                res.writeHead(204);
                res.end();
            });
            return;
        }

        // API: Content-aware session search — grep the tail of each live room's
        // ALREADY-RETAINED output (no index, no background work, no new state
        // beyond a 3s strip cache). Called debounced from the switcher filter.
        if (parsedUrl.pathname === '/api/sessions/search' && req.method === 'GET') {
            const q = String(parsedUrl.query?.q || '').trim().toLowerCase();
            if (q.length < 2 || q.length > 200) {
                res.writeHead(200, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ matches: [] }));
                return;
            }
            // Multi-word queries are AND-terms anywhere in the corpus, not an
            // exact phrase — "restore failed" should find a session where both
            // words appear on different lines.
            const terms = q.split(/\s+/).filter(Boolean);
            const snippetAround = (text, idx, len) => {
                const lineStart = text.lastIndexOf('\n', idx) + 1;
                const lineEnd = text.indexOf('\n', idx + len);
                const line = text.slice(lineStart, lineEnd === -1 ? undefined : lineEnd).trim();
                return line.length > 140 ? `…${line.slice(Math.max(0, idx - lineStart - 40), idx - lineStart + 100)}…` : line;
            };
            // `hay` is pre-lowercased at cache-build time — lowercasing the
            // corpora per keystroke was the search's real cost once the tails
            // grew past a few hundred KB per room.
            const matchAll = (hay) => {
                let anchor = -1;
                for (const t of terms) {
                    const idx = hay.lastIndexOf(t);
                    if (idx === -1) return null;
                    if (anchor === -1) anchor = idx;
                }
                return { idx: anchor, len: terms[0].length };
            };
            let matches = [];
            try {
                const listed = await callExternalHayHostApi('/rooms');
                const rooms = Array.isArray(listed?.data?.rooms) ? listed.data.rooms : [];
                const now = Date.now();
                const lookups = rooms.slice(0, 80).map(async (room) => {
                    const id = String(room?.id || '');
                    if (!id || !SESSION_NAME_RE.test(id)) return null;
                    let entry = sessionSearchTextCache.get(id);
                    if (!entry || now - entry.at > 3000) {
                        // Deeper-than-screen tail (?bytes honored by newer hosts).
                        const prev = await callExternalHayHostApi(`/rooms/${encodeURIComponent(id)}/preview?bytes=524288`);
                        const raw = typeof prev?.data?.output === 'string' ? prev.data.output : '';
                        // The CONVERSATION transcript reaches back much further
                        // than any screen tail — grep its recent text too, so
                        // "the session where we discussed X" is findable even
                        // when X scrolled away an hour ago. The 1MB read+parse
                        // is skipped when the file hasn't changed since the
                        // last search (stat signature match) — steady-state
                        // searches re-read nothing.
                        let transcriptText = entry ? entry.transcript : '';
                        let transcriptLower = entry ? entry.transcriptLower : '';
                        let transcriptSig = entry ? entry.transcriptSig : '';
                        try {
                            const tPath = resolveClaudeTranscriptPath(readClaudeSessionRecord(id));
                            if (tPath) {
                                const stat = fs.statSync(tPath);
                                const sig = `${tPath}:${stat.size}:${stat.mtimeMs}`;
                                if (sig !== transcriptSig) {
                                    const fd = fs.openSync(tPath, 'r');
                                    const readLen = Math.min(stat.size, 1048576);
                                    const buf = Buffer.alloc(readLen);
                                    fs.readSync(fd, buf, 0, readLen, Math.max(0, stat.size - readLen));
                                    fs.closeSync(fd);
                                    transcriptText = (buf.toString('utf8').match(/"text":"((?:[^"\\]|\\.){4,2000})"/g) || [])
                                        .map((m) => m.slice(8, -1).replace(/\\n/g, '\n').replace(/\\"/g, '"').replace(/\\\\/g, '\\'))
                                        .join('\n');
                                    transcriptLower = transcriptText.toLowerCase();
                                    transcriptSig = sig;
                                }
                            } else {
                                transcriptText = '';
                                transcriptLower = '';
                                transcriptSig = '';
                            }
                        } catch (e) { /* no transcript — screen only */ }
                        const screenText = stripAnsiForSearch(raw);
                        entry = {
                            at: now,
                            text: screenText,
                            textLower: screenText.toLowerCase(),
                            transcript: transcriptText || '',
                            transcriptLower: transcriptLower || '',
                            transcriptSig: transcriptSig || ''
                        };
                        sessionSearchTextCache.set(id, entry);
                        if (sessionSearchTextCache.size > 150) {
                            // Bounded: drop the oldest entries.
                            for (const key of [...sessionSearchTextCache.keys()].slice(0, 50)) sessionSearchTextCache.delete(key);
                        }
                    }
                    const onScreen = matchAll(entry.textLower);
                    if (onScreen) {
                        return {
                            internalName: id,
                            name: getSessionDisplayName(id) || id,
                            snippet: snippetAround(entry.text, onScreen.idx, onScreen.len)
                        };
                    }
                    const inTranscript = entry.transcriptLower ? matchAll(entry.transcriptLower) : null;
                    if (inTranscript) {
                        return {
                            internalName: id,
                            name: getSessionDisplayName(id) || id,
                            snippet: `≡ ${snippetAround(entry.transcript, inTranscript.idx, inTranscript.len)}`
                        };
                    }
                    return null;
                });
                matches = (await Promise.all(lookups)).filter(Boolean);
            } catch (e) { /* host unreachable — return what we have */ }
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({ matches }));
            return;
        }

        // API: List sessions
        if (parsedUrl.pathname === '/api/sessions' && req.method === 'GET') {
            const snapshot = await listAllSessionEntriesRuntimeFirst();
            const sessions = snapshot.entries.map(s => ({
                name: s.displayName,
                displayName: s.displayName,
                internalName: s.internalName,
                windows: s.windows,
                attached: s.attached,
                live: s.live === true,
                type: s.type,
                port: s.port,
                hostPort: s.hostPort,
                folderId: s.folderId || null,
                cwd: s.cwd,
                foregroundProcess: s.foregroundProcess,
                lastActivityAt: s.lastActivityAt,
                bellSeq: s.bellSeq,
                lastBellAt: s.lastBellAt,
                shell: s.shell,
                env: s.env,
                cols: s.cols,
                rows: s.rows,
                startup: s.startup,
                autoStart: s.autoStart,
                createdAt: s.createdAt,
                createdBy: s.createdBy || 'user',
                // Display tagline (hop ai tagline); absent for most sessions.
                // taglineAt drives the freshness check that skips re-tagging
                // sessions nothing has happened to.
                tagline: getEffectiveSessionConfig(s.internalName)?.tagline || undefined,
                taglineAt: getEffectiveSessionConfig(s.internalName)?.taglineAt || undefined,
                parked: getEffectiveSessionConfig(s.internalName)?.parked === true || undefined,
                archived: getEffectiveSessionConfig(s.internalName)?.archived === true || undefined,
                agentPermitted: s.agentPermitted === true,
                hasLocalCli: !!s.hasLocalCli,
                localCliCount: s.localCliCount || 0
            }));
            const activeSessionNames = snapshot.activeDisplayNames;
            const startingSessionNames = Array.from(startingSessions).map(getSessionDisplayName);
            const folders = sessionStore.order.folders
                .map((id) => sessionStore.folders[id])
                .filter(Boolean);
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({
                sessions,
                active: activeSessionNames,
                starting: startingSessionNames,
                folders,
                order: sessionStore.order,
                aliases: sessionAliases,
                runtimeAvailable: snapshot.runtimeAvailable
            }));
            return;
        }

        // API: Park / unpark. Parked sessions leave the wall but keep
        // running; unparking also clears the archived flag (the session is
        // being brought back deliberately).
        if (parsedUrl.pathname === '/api/sessions/park' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => { body += chunk; if (body.length > 4096) req.destroy(); });
            req.on('end', () => {
                try {
                    const { name, internalName, parked } = JSON.parse(body);
                    const resolved = resolveSessionInternalName(name, internalName);
                    if (!resolved) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }
                    const savedConfig = getSessionConfig(resolved);
                    const config = getEffectiveSessionConfig(resolved);
                    if (!config || config.type === 'port') {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not a terminal' }));
                        return;
                    }
                    const on = parked === true;
                    const next = { ...config, parked: on || undefined, archived: on ? config.archived : undefined, updatedAt: new Date().toISOString() };
                    if (savedConfig) setSessionConfig(resolved, next);
                    else rememberRuntimeSessionMetadata(resolved, next);
                    const durable = readClaudeSessionMeta(resolved) || {};
                    writeClaudeSessionMeta(resolved, { ...durable, internalName: resolved, parked: on || undefined, archived: on ? durable.archived : undefined });
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, parked: on }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Archive — stop the process but stay RESUMABLE. The restore
        // plan (resume command + config root + cwd) is pre-written into the
        // session's startup, so the next open recreates the room and picks
        // the conversation back up; every record/meta/buffer survives.
        if (parsedUrl.pathname === '/api/sessions/archive' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => { body += chunk; if (body.length > 4096) req.destroy(); });
            req.on('end', async () => {
                try {
                    const { name, internalName } = JSON.parse(body);
                    const resolved = resolveSessionInternalName(name, internalName);
                    if (!resolved) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }
                    const savedConfig = getSessionConfig(resolved);
                    const config = getEffectiveSessionConfig(resolved);
                    if (!config || config.type === 'port') {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not a terminal' }));
                        return;
                    }
                    const plan = restorePlanForSession({
                        internalName: resolved,
                        cwd: config.cwd,
                        startup: config.startup,
                        autoStart: config.autoStart
                    });
                    const next = {
                        ...config,
                        parked: true,
                        archived: true,
                        startup: plan?.command || config.startup,
                        cwd: plan?.cwd || config.cwd,
                        updatedAt: new Date().toISOString()
                    };
                    if (savedConfig) setSessionConfig(resolved, next);
                    else rememberRuntimeSessionMetadata(resolved, next);
                    const durable = readClaudeSessionMeta(resolved) || {};
                    writeClaudeSessionMeta(resolved, { ...durable, internalName: resolved, parked: true, archived: true, cwd: next.cwd });
                    // Stop the process — records, metas, and buffers all stay.
                    if (isExternalTerminalBackend()) {
                        await terminateExternalHaySession(resolved);
                    } else if (hayRooms.hasRoom(resolved)) {
                        hayRooms.closeRoom(resolved);
                    }
                    if (activeSessions[resolved]) delete activeSessions[resolved];
                    sessionClientSummary.delete(resolved);
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, resumable: !!plan?.command }));
                } catch (e) {
                    res.writeHead(500, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Archive failed' }));
                }
            });
            return;
        }

        // API: Serialized CURRENT screen (ANSI, colors included) from the
        // room grid — the switch-time fast first paint. The client writes it
        // into a fresh terminal immediately; the WS snapshot supersedes it.
        if (parsedUrl.pathname === '/api/sessions/screen' && req.method === 'GET') {
            const internalName = typeof parsedUrl.query.name === 'string' ? parsedUrl.query.name : '';
            if (!internalName || !SESSION_NAME_RE.test(internalName)) {
                res.writeHead(400, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Invalid session name' }));
                return;
            }
            try {
                await getRoomGridPreviewShared(internalName); // freshen (or create) the grid
                const grid = roomGrids.get(internalName);
                let data = null;
                if (grid && grid.serialize) {
                    try { data = grid.serialize.serialize(); } catch (e) { data = null; }
                }
                if (typeof data === 'string' && data.length > 0) {
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ data, cols: grid.cols, rows: grid.rows }));
                    return;
                }
                res.writeHead(404, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'No screen available' }));
            } catch (e) {
                res.writeHead(500, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Screen failed' }));
            }
            return;
        }

        // API: Session tagline — a short human-readable line describing what
        // the session is working on. Written by `hop ai tagline` (the only
        // AI-dependent surface; core hop never calls a model). Stored on the
        // session config AND the durable meta so it survives restarts.
        if (parsedUrl.pathname === '/api/sessions/tagline' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => { body += chunk; if (body.length > 8192) req.destroy(); });
            req.on('end', () => {
                try {
                    const { name, internalName, tagline } = JSON.parse(body);
                    const resolved = resolveSessionInternalName(name, internalName);
                    if (!resolved) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }
                    // Empty string clears it.
                    const clean = typeof tagline === 'string' ? tagline.replace(/\s+/g, ' ').trim().slice(0, 64) : '';
                    const savedConfig = getSessionConfig(resolved);
                    const config = getEffectiveSessionConfig(resolved);
                    if (!config) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }
                    const next = { ...config, tagline: clean || undefined, taglineAt: clean ? Date.now() : undefined };
                    if (savedConfig) setSessionConfig(resolved, next);
                    else rememberRuntimeSessionMetadata(resolved, next);
                    const durable = readClaudeSessionMeta(resolved) || {};
                    writeClaudeSessionMeta(resolved, { ...durable, internalName: resolved, tagline: clean || undefined, taglineAt: next.taglineAt });
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, tagline: clean }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: On-demand text preview of a live session's screen (session manager).
        if (parsedUrl.pathname === '/api/sessions/preview' && req.method === 'GET') {
            const internalName = typeof parsedUrl.query.name === 'string' ? parsedUrl.query.name : '';
            if (!internalName || !SESSION_NAME_RE.test(internalName)) {
                res.writeHead(400, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Invalid session name' }));
                return;
            }
            try {
                // Grid path first: the persistent parser's screen is exact —
                // no trim/density/deep-refetch guesswork. Cache non-empty
                // frames only as the host-unreachable fallback.
                const gridScreen = await getRoomGridPreviewShared(internalName);
                if (gridScreen && typeof gridScreen.text === 'string') {
                    if (gridScreen.text.trim()) {
                        lastGoodPreviewByRoom.set(internalName, gridScreen);
                        if (lastGoodPreviewByRoom.size > 500) {
                            lastGoodPreviewByRoom.delete(lastGoodPreviewByRoom.keys().next().value);
                        }
                        schedulePreviewCacheSave();
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify(gridScreen));
                    return;
                }
                const source = await fetchHayRoomPreviewSource(internalName);
                const cached = lastGoodPreviewByRoom.get(internalName);
                if (!source) {
                    if (cached) {
                        res.writeHead(200, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ ...cached, stale: true }));
                        return;
                    }
                    // No live room (dead / not-yet-restored session): serve its
                    // retained shutdown buffer so every tile shows a last
                    // screen, not a blank box. Render at the session's STORED
                    // dims — a wide session's buffer re-wrapped at 100 cols
                    // came out as a mangled sliver, not its last screen.
                    const bufPath = shellSessionBufferPath(internalName);
                    let buf = null;
                    if (bufPath) { try { buf = fs.readFileSync(bufPath, 'utf8'); } catch (e) { /* none */ } }
                    if (buf && buf.trim()) {
                        const cfg = getSessionConfig(internalName);
                        const deadCols = Number.isInteger(cfg?.cols) && cfg.cols > 10 ? cfg.cols : 100;
                        const deadRows = Number.isInteger(cfg?.rows) && cfg.rows > 5 ? cfg.rows : 30;
                        const text = await renderSessionPreviewText({ output: buf, cols: deadCols, rows: deadRows });
                        if (typeof text === 'string' && text.trim()) {
                            res.writeHead(200, { 'Content-Type': 'application/json' });
                            res.end(JSON.stringify({ text, cols: deadCols, rows: deadRows, stale: true }));
                            return;
                        }
                    }
                    res.writeHead(404, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'No live preview available' }));
                    return;
                }
                const rendered = await renderSessionPreviewText(source);
                let payload = { text: typeof rendered === 'string' ? rendered : '', cols: source.cols, rows: source.rows };
                // A DIFFERENTIAL-repaint TUI (claude inline) writes only the
                // cells that changed; a bounded tail that misses the last full
                // repaint renders as a near-empty screen with a few scattered
                // live cells (a spinner, a counter — "1m 23s", "58"). That is
                // NOT a good frame even though it has >8 chars. Measure density
                // by non-blank lines, not raw length.
                if (previewFrameIsSparse(payload.text)) {
                    // Deeper untrimmed replay: overdraw from an earlier full
                    // repaint reconstructs the screen (host honors ?bytes).
                    const deep = await fetchHayRoomPreviewSource(internalName, 524288);
                    if (deep && typeof deep.output === 'string' && deep.output.length > (source.output || '').length) {
                        const deepText = await renderSessionPreviewText(deep, { noTrim: true });
                        if (typeof deepText === 'string' && previewFrameDensity(deepText) > previewFrameDensity(payload.text)) {
                            payload = { text: deepText, cols: deep.cols, rows: deep.rows };
                        }
                    }
                }
                // A dense frame becomes the cached "last good"; a sparse one is
                // never cached (it would overwrite a real screen) and, when a
                // cached frame exists, is not even served — the tile keeps its
                // last real screen until a dense frame arrives.
                if (!previewFrameIsSparse(payload.text)) {
                    lastGoodPreviewByRoom.set(internalName, payload);
                    if (lastGoodPreviewByRoom.size > 500) {
                        lastGoodPreviewByRoom.delete(lastGoodPreviewByRoom.keys().next().value);
                    }
                    schedulePreviewCacheSave();
                } else if (cached) {
                    payload = { ...cached, stale: true };
                }
                res.writeHead(200, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify(payload));
            } catch (e) {
                res.writeHead(500, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Preview failed' }));
            }
            return;
        }

        // API: Atomically choose and reserve a session for a local CLI attach.
        if (parsedUrl.pathname === '/api/sessions/claim-local-cli' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const parsed = body ? JSON.parse(body) : {};
                    const cwdPath = typeof parsed.cwd === 'string' && parsed.cwd.trim()
                        ? parsed.cwd
                        : process.cwd();
                    const cwdName = typeof parsed.cwdName === 'string' && parsed.cwdName.trim()
                        ? parsed.cwdName
                        : path.basename(cwdPath).replace(/[^a-zA-Z0-9_-]/g, '-');
                    const claimed = await withLocalCliClaimLock(() => (
                        claimUnnamedLocalCliSession({ cwdPath, cwdName, createdBy: resolveActor(req) === 'agent' ? 'agent' : 'user' })
                    ));
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({
                        ok: true,
                        createdNew: claimed.createdNew,
                        target: claimed.target
                    }));
                } catch (e) {
                    const status = Number.isInteger(e?.status) ? e.status : 500;
                    res.writeHead(status, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: e?.message || 'Failed to claim local session' }));
                }
            });
            return;
        }

        // API: Create session
        if (parsedUrl.pathname === '/api/sessions' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    let { name, type, port, cwd, folderId, startRuntime, workspace, workspaceName } = JSON.parse(body);
                    // Sessions created by an agent-marked request (X-Hop-Actor,
                    // set by MCP/hopa and by the CLI under a claude env) land
                    // in the agent bucket instead of impersonating the human.
                    const actorCreatedBy = resolveActor(req) === 'agent' ? 'agent' : 'user';
                    const displayName = name;
                    const internalName = toInternalSessionName(displayName);
                    if (!internalName || !displayName) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Invalid session name' }));
                        return;
                    }
                    if (isDisplayNameInUse(displayName)) {
                        res.writeHead(409, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session name already in use' }));
                        return;
                    }
                    if (hasSavedSessionConfig(internalName)) {
                        res.writeHead(409, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session internal name already in use' }));
                        return;
                    }
                    type = (type || 'terminal').toLowerCase();
                    if (type !== 'terminal' && type !== 'port') {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Invalid session type' }));
                        return;
                    }
                    const targetFolderId = folderId && sessionStore.folders[folderId] ? folderId : null;
                    const targetWorkspaceName = normalizeWorkspaceName(workspaceName || workspace);
                    if (type === 'port') {
                        const parsedPort = parseInt(port, 10);
                        if (!Number.isInteger(parsedPort) || parsedPort < 1 || parsedPort > 65535) {
                            res.writeHead(400, { 'Content-Type': 'application/json' });
                            res.end(JSON.stringify({ error: 'Invalid port' }));
                            return;
                        }
                        if (await runtimeTerminalSessionExists(internalName)) {
                            res.writeHead(409, { 'Content-Type': 'application/json' });
                            res.end(JSON.stringify({ error: 'Terminal session already exists with this name' }));
                            return;
                        }
                        const existingConfig = getEffectiveSessionConfig(internalName);
                        if (existingConfig && existingConfig.type === 'terminal') {
                            res.writeHead(409, { 'Content-Type': 'application/json' });
                            res.end(JSON.stringify({ error: 'Terminal session already exists with this name' }));
                            return;
                        }
                        if (targetWorkspaceName) {
                            const saved = upsertWorkspaceSessionDefinition(targetWorkspaceName, internalName, {
                                type: 'port',
                                port: parsedPort,
                                displayName,
                                folderId: targetFolderId,
                                createdAt: new Date().toISOString(),
                                updatedAt: new Date().toISOString(),
                                createdBy: actorCreatedBy,
                                agentPermitted: actorCreatedBy === 'agent',
                                workspaceName: targetWorkspaceName
                            });
                            if (!saved) {
                                res.writeHead(400, { 'Content-Type': 'application/json' });
                                res.end(JSON.stringify({ error: 'Invalid workspace session config' }));
                                return;
                            }
                        } else {
                            setPortSessionConfig(internalName, parsedPort, displayName, targetFolderId);
                        }
                    } else {
                        const existingConfig = getEffectiveSessionConfig(internalName);
                        if (existingConfig && existingConfig.type === 'port') {
                            res.writeHead(409, { 'Content-Type': 'application/json' });
                            res.end(JSON.stringify({ error: 'Port session already exists with this name' }));
                            return;
                        }
                        if (startRuntime === false) {
                            if (targetWorkspaceName) {
                                const saved = upsertWorkspaceSessionDefinition(targetWorkspaceName, internalName, {
                                    type: 'terminal',
                                    cwd,
                                    displayName,
                                    folderId: targetFolderId,
                                    createdAt: new Date().toISOString(),
                                    updatedAt: new Date().toISOString(),
                                    createdBy: actorCreatedBy,
                                    agentPermitted: actorCreatedBy === 'agent',
                                    workspaceName: targetWorkspaceName
                                });
                                if (!saved) {
                                    res.writeHead(400, { 'Content-Type': 'application/json' });
                                    res.end(JSON.stringify({ error: 'Invalid workspace session config' }));
                                    return;
                                }
                            } else {
                                res.writeHead(400, { 'Content-Type': 'application/json' });
                                res.end(JSON.stringify({ error: 'workspace is required when startRuntime is false' }));
                                return;
                            }
                        } else if (isExternalTerminalBackend()) {
                            await ensureExternalRuntimeSession(internalName, cwd, displayName, {
                                folderId: targetFolderId,
                                saveDefinition: false,
                                createdBy: actorCreatedBy
                            });
                        } else {
                            getOrCreateSession(internalName, cwd, displayName);
                        }
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, name: displayName, type }));
                } catch (e) {
                    const status = Number.isInteger(e?.status) ? e.status : 500;
                    const message = e?.message || 'Failed to create session';
                    res.writeHead(status, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: message }));
                }
            });
            return;
        }

        // API: Create folder
        if (parsedUrl.pathname === '/api/folders' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const { name } = JSON.parse(body);
                    const folder = createFolder(name);
                    if (!folder) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Invalid folder name' }));
                        return;
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, folder }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Rename folder
        if (parsedUrl.pathname === '/api/folders/rename' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const { id, name } = JSON.parse(body);
                    const folder = renameFolder(id, name);
                    if (!folder) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Folder not found or invalid name' }));
                        return;
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, folder }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Delete folder
        if (parsedUrl.pathname === '/api/folders/delete' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const { id } = JSON.parse(body);
                    const ok = deleteFolder(id);
                    if (!ok) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Folder not found' }));
                        return;
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Reorder folders
        if (parsedUrl.pathname === '/api/folders/order' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const { order } = JSON.parse(body);
                    const ok = setFolderOrder(order);
                    if (!ok) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Invalid folder order' }));
                        return;
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Move session (folder/order)
        if (parsedUrl.pathname === '/api/sessions/move' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const { name, internalName, folderId, index } = JSON.parse(body);
                    let targetName = internalName && sessionStore.sessions[internalName] ? internalName : null;
                    if (!targetName && name) {
                        const displayName = resolveDisplayNameAlias(name);
                        targetName = findInternalSessionName(displayName);
                    }
                    if (!targetName) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }
                    const ok = moveSessionToFolder(targetName, folderId || null, index);
                    if (!ok) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Failed to move session' }));
                        return;
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Replace a bucket's full manual order (session manager → manual sort)
        if (parsedUrl.pathname === '/api/sessions/reorder' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const { folderId, names } = JSON.parse(body);
                    const ok = setSessionBucketOrder(folderId || null, Array.isArray(names) ? names : []);
                    res.writeHead(ok ? 200 : 400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify(ok ? { ok: true } : { error: 'Failed to reorder' }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Restore saved sessions (recreate rooms + resume claude conversations)
        if (parsedUrl.pathname === '/api/sessions/restore' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const parsed = body ? JSON.parse(body) : {};
                    const result = await restoreSavedSessions({
                        dryRun: parsed.dryRun === true,
                        includeAgents: parsed.includeAgents === true
                    });
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify(result));
                } catch (e) {
                    res.writeHead(500, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Restore failed' }));
                }
            });
            return;
        }

        // API: Rename session
        if (parsedUrl.pathname === '/api/sessions/rename' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const { oldName, newName, internalName } = JSON.parse(body);
                    renameSessionDisplayName(oldName, newName, internalName);
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true }));
                } catch (e) {
                    res.writeHead(e?.status || 500, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: e?.message || 'Rename failed' }));
                }
            });
            return;
        }

        // API: Set agent permission
        if (parsedUrl.pathname === '/api/sessions/agent-permission' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const { name, internalName, allowed } = JSON.parse(body);
                    const resolved = resolveSessionInternalName(name, internalName);
                    if (!resolved) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }
                    const savedConfig = getSessionConfig(resolved);
                    const config = getEffectiveSessionConfig(resolved);
                    if (!config || config.type === 'port') {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not a terminal' }));
                        return;
                    }
                    const next = { ...config };
                    next.agentPermitted = !!allowed;
                    if (!next.createdBy) next.createdBy = 'user';
                    next.updatedAt = new Date().toISOString();
                    if (savedConfig) {
                        setSessionConfig(resolved, next);
                    } else {
                        rememberRuntimeSessionMetadata(resolved, next);
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, agentPermitted: next.agentPermitted }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Reclassify a session's origin (user <-> agent). An agent-spawned
        // session the human adopts (e.g. a forked conversation) belongs on the
        // user side of the origin filter; the flag is presentation + restore
        // policy (agent sessions skip default restore), not a permission.
        if (parsedUrl.pathname === '/api/sessions/origin' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const { name, internalName, createdBy } = JSON.parse(body);
                    if (createdBy !== 'user' && createdBy !== 'agent') {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'createdBy must be "user" or "agent"' }));
                        return;
                    }
                    const resolved = resolveSessionInternalName(name, internalName);
                    if (!resolved) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }
                    const savedConfig = getSessionConfig(resolved);
                    const config = getEffectiveSessionConfig(resolved);
                    if (!config || config.type === 'port') {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not a terminal' }));
                        return;
                    }
                    const next = { ...config, createdBy, updatedAt: new Date().toISOString() };
                    if (savedConfig) {
                        setSessionConfig(resolved, next);
                    } else {
                        rememberRuntimeSessionMetadata(resolved, next);
                    }
                    // The durable meta is what restore + reconcile consult; keep
                    // it in lockstep so the reclassification survives restarts.
                    const durable = readClaudeSessionMeta(resolved) || {};
                    writeClaudeSessionMeta(resolved, { ...durable, createdBy });
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, createdBy }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Delete session
        if (parsedUrl.pathname === '/api/sessions/delete' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    let { name, internalName } = JSON.parse(body || '{}');
                    const resolved = resolveSessionInternalName(name, internalName);
                    if (!resolved) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }
                    const savedConfig = getSessionConfig(resolved);
                    const config = getEffectiveSessionConfig(resolved);
                    if (config && config.type === 'port') {
                        deleteSessionConfig(resolved);
                        clearRuntimeSessionMetadata(resolved);
                        res.writeHead(200, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ ok: true, type: 'port' }));
                        return;
                    }

                    const exists = hopSessionExists(resolved);
                    if (!exists && !config) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }

                    // Close the terminal session if it exists
                    if (isExternalTerminalBackend()) {
                        await terminateExternalHaySession(resolved);
                    } else if (hayRooms.hasRoom(resolved)) {
                        hayRooms.closeRoom(resolved);
                    }

                    // Clean up internal tracking
                    if (activeSessions[resolved]) {
                        delete activeSessions[resolved];
                    }
                    clearRuntimeSessionMetadata(resolved);
                    sessionClientSummary.delete(resolved);

                    if (savedConfig) {
                        deleteSessionConfig(resolved);
                    } else {
                        // Runtime-only sessions skip deleteSessionConfig, so drop
                        // their rename aliases here to avoid stale resurrection...
                        pruneSessionAliasesForSession(resolved, config?.displayName);
                        // ...and their SessionStart-hook record, or `hop restore`
                        // resurrects a session the user explicitly deleted.
                        removeClaudeSessionRecord(resolved);
                    }

                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, type: 'terminal' }));
                } catch (e) {
                    res.writeHead(500, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Delete failed' }));
                }
            });
            return;
        }

        // API: List terminal API sessions
        if (parsedUrl.pathname === '/api/terminals' && req.method === 'GET') {
            const actor = resolveActor(req);
            const sessions = Array.from(terminalApiSessions.values())
                .filter((entry) => {
                    const config = getEffectiveSessionConfig(entry.sessionName);
                    return canActorAccessSession(actor, config);
                })
                .map(entry => ({
                    id: entry.id,
                    sessionName: entry.sessionName,
                    displayName: entry.displayName,
                    actor: entry.actor,
                    createdAt: entry.createdAt
                }));
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({ terminals: sessions }));
            return;
        }

        // API: Create terminal session
        if (parsedUrl.pathname === '/api/terminals' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const actor = resolveActor(req);
                    const payload = JSON.parse(body || '{}');
                    const displayName = payload.name || `${actor}-${Date.now()}`;
                    const cwd = payload.cwd;
                    const cols = payload.cols;
                    const rows = payload.rows;
                    const shell = payload.shell;
                    const env = payload.env;
                    const startup = payload.startup;
                    const autoStart = payload.autoStart;
                    const targetWorkspaceName = normalizeWorkspaceName(payload.workspaceName || payload.workspace);
                    const folderId = payload.folderId && sessionStore.folders[payload.folderId]
                        ? payload.folderId
                        : null;
                    const saveDefinition = payload.saveDefinition === true;

                    if (isExternalTerminalBackend()) {
                        await ensureExternalHayHostReady();
                    }

                    if (!SESSION_NAME_RE.test(displayName)) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Invalid session name' }));
                        return;
                    }
                    if (cwd && !path.isAbsolute(cwd)) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'cwd must be an absolute path' }));
                        return;
                    }
                    if (isDisplayNameInUse(displayName)) {
                        res.writeHead(409, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session name already in use' }));
                        return;
                    }
                    const internalName = toInternalSessionName(displayName);
                    if (!internalName) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Invalid session name' }));
                        return;
                    }
                    if (saveDefinition && !targetWorkspaceName) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'workspace is required when saveDefinition is true' }));
                        return;
                    }

                    if (saveDefinition) {
                        const saved = upsertWorkspaceSessionDefinition(targetWorkspaceName, internalName, {
                            type: 'terminal',
                            cwd,
                            shell,
                            env,
                            cols,
                            rows,
                            startup,
                            autoStart,
                            createdBy: actor,
                            agentPermitted: actor === 'agent',
                            displayName,
                            folderId,
                            workspaceName: targetWorkspaceName,
                            createdAt: new Date().toISOString(),
                            updatedAt: new Date().toISOString()
                        });
                        if (!saved) {
                            res.writeHead(400, { 'Content-Type': 'application/json' });
                            res.end(JSON.stringify({ error: 'Invalid workspace session config' }));
                            return;
                        }
                    }
                    rememberRuntimeSessionMetadata(internalName, {
                        type: 'terminal',
                        cwd,
                        displayName,
                        shell,
                        env,
                        cols,
                        rows,
                        startup,
                        autoStart,
                        createdBy: actor,
                        agentPermitted: actor === 'agent',
                        folderId,
                        workspaceName: targetWorkspaceName || null
                    });
                    // Durable origin marker so `hop restore` (which may run after a
                    // reboot, long after runtime metadata is gone) can keep
                    // agent-created workers out of the default restore set.
                    if (actor === 'agent') {
                        writeClaudeSessionMeta(internalName, { createdBy: 'agent', createdAt: new Date().toISOString() });
                    }

                    const entry = await attachTerminalApiClient(internalName, displayName, {
                        actor,
                        cols,
                        rows,
                        cwd,
                        label: actor,
                        shell,
                        env,
                        startup,
                        autoStart,
                        createdBy: actor,
                        agentPermitted: actor === 'agent',
                        folderId,
                        workspaceName: targetWorkspaceName || null,
                        saveDefinition
                    });

                    if (startup && autoStart !== false) {
                        sendTerminalInput(entry, startup.endsWith('\n') ? startup : `${startup}\n`);
                    }

                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({
                        ok: true,
                        id: entry.id,
                        sessionName: internalName,
                        displayName: entry.displayName
                    }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Attach terminal API client to existing session
        if (parsedUrl.pathname === '/api/terminals/attach' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const actor = resolveActor(req);
                    const payload = JSON.parse(body || '{}');
                    const target = resolveSessionInternalName(payload.name, payload.internalName);
                    if (!target) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Session not found' }));
                        return;
                    }
                    const config = getEffectiveSessionConfig(target);
                    if (!canActorAccessSession(actor, config)) {
                        res.writeHead(403, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Agent access not permitted' }));
                        return;
                    }
                    if (isExternalTerminalBackend()) {
                        await ensureExternalHayHostReady();
                    }
                    const entry = await attachTerminalApiClient(target, config?.displayName, {
                        actor,
                        cols: payload.cols,
                        rows: payload.rows,
                        label: actor
                    });
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({
                        ok: true,
                        id: entry.id,
                        sessionName: entry.sessionName,
                        displayName: entry.displayName
                    }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Terminal stream (SSE)
        const terminalStreamMatch = (parsedUrl.pathname || '').match(/^\/api\/terminals\/([^/]+)\/stream$/);
        if (terminalStreamMatch && req.method === 'GET') {
            const terminalId = terminalStreamMatch[1];
            const entry = terminalApiSessions.get(terminalId);
            if (!entry) {
                res.writeHead(404, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Terminal not found' }));
                return;
            }
            const actor = resolveActor(req);
            const config = getEffectiveSessionConfig(entry.sessionName);
            if (!canActorAccessSession(actor, config)) {
                res.writeHead(403, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Agent access not permitted' }));
                return;
            }
            const afterRaw = parsedUrl.query?.after;
            const after = Number.isFinite(Number(afterRaw)) ? Number(afterRaw) : 0;
            res.writeHead(200, {
                'Content-Type': 'text/event-stream',
                'Cache-Control': 'no-cache',
                'Connection': 'keep-alive'
            });
            res.write(`data: ${JSON.stringify({ type: 'ready', timestamp: Date.now() })}\n\n`);

            const replayEvents = listTerminalEvents(terminalId, after);
            for (const payload of replayEvents) {
                res.write(`data: ${JSON.stringify(payload)}\n\n`);
            }

            registerTerminalStream(terminalId, res);
            req.on('close', () => unregisterTerminalStream(terminalId, res));
            return;
        }

        // API: Terminal write
        const terminalWriteMatch = (parsedUrl.pathname || '').match(/^\/api\/terminals\/([^/]+)\/write$/);
        if (terminalWriteMatch && req.method === 'POST') {
            const terminalId = terminalWriteMatch[1];
            const entry = terminalApiSessions.get(terminalId);
            if (!entry) {
                res.writeHead(404, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Terminal not found' }));
                return;
            }
            const actor = resolveActor(req);
            const config = getEffectiveSessionConfig(entry.sessionName);
            if (!canActorAccessSession(actor, config)) {
                res.writeHead(403, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Agent access not permitted' }));
                return;
            }
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const payload = JSON.parse(body || '{}');
                    const data = payload.data;
                    if (!data) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Missing data' }));
                        return;
                    }
                    sendTerminalInput(entry, String(data));
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Terminal resize
        const terminalResizeMatch = (parsedUrl.pathname || '').match(/^\/api\/terminals\/([^/]+)\/resize$/);
        if (terminalResizeMatch && req.method === 'POST') {
            const terminalId = terminalResizeMatch[1];
            const entry = terminalApiSessions.get(terminalId);
            if (!entry) {
                res.writeHead(404, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Terminal not found' }));
                return;
            }
            const actor = resolveActor(req);
            const config = getEffectiveSessionConfig(entry.sessionName);
            if (!canActorAccessSession(actor, config)) {
                res.writeHead(403, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Agent access not permitted' }));
                return;
            }
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const payload = JSON.parse(body || '{}');
                    sendTerminalResize(entry, payload.cols, payload.rows);
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Terminal exec (convenience wrapper around write)
        const terminalExecMatch = (parsedUrl.pathname || '').match(/^\/api\/terminals\/([^/]+)\/exec$/);
        if (terminalExecMatch && req.method === 'POST') {
            const terminalId = terminalExecMatch[1];
            const entry = terminalApiSessions.get(terminalId);
            if (!entry) {
                res.writeHead(404, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Terminal not found' }));
                return;
            }
            const actor = resolveActor(req);
            const config = getEffectiveSessionConfig(entry.sessionName);
            if (!canActorAccessSession(actor, config)) {
                res.writeHead(403, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Agent access not permitted' }));
                return;
            }
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const payload = JSON.parse(body || '{}');
                    const command = payload.command;
                    if (!command) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Missing command' }));
                        return;
                    }
                    const line = String(command);
                    sendTerminalInput(entry, line.endsWith('\n') ? line : `${line}\n`);
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Terminal detach (optional kill session)
        const terminalDeleteMatch = (parsedUrl.pathname || '').match(/^\/api\/terminals\/([^/]+)$/);
        if (terminalDeleteMatch && req.method === 'DELETE') {
            const terminalId = terminalDeleteMatch[1];
            const entry = terminalApiSessions.get(terminalId);
            if (!entry) {
                res.writeHead(404, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Terminal not found' }));
                return;
            }
            const actor = resolveActor(req);
            const config = getEffectiveSessionConfig(entry.sessionName);
            if (!canActorAccessSession(actor, config)) {
                res.writeHead(403, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Agent access not permitted' }));
                return;
            }
            const killSession = parsedUrl.query?.killSession === 'true';
            entry.adapter.close();
            if (killSession) {
                if (isExternalTerminalBackend()) {
                    await terminateExternalHaySession(entry.sessionName);
                } else if (hayRooms.hasRoom(entry.sessionName)) {
                    hayRooms.closeRoom(entry.sessionName);
                }
                if (activeSessions[entry.sessionName]) {
                    delete activeSessions[entry.sessionName];
                }
                clearRuntimeSessionMetadata(entry.sessionName);
                sessionClientSummary.delete(entry.sessionName);
                const savedConfig = getSessionConfig(entry.sessionName);
                if (savedConfig) {
                    deleteSessionConfig(entry.sessionName);
                } else {
                    // Runtime-only sessions skip deleteSessionConfig, so drop
                    // their rename aliases here to avoid stale resurrection...
                    pruneSessionAliasesForSession(entry.sessionName, config?.displayName);
                    // ...and their SessionStart-hook record: an explicitly killed
                    // session must not come back via `hop restore`.
                    removeClaudeSessionRecord(entry.sessionName);
                }
            }
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({ ok: true }));
            return;
        }

        // API: List workspaces
        if (parsedUrl.pathname === '/api/workspaces' && req.method === 'GET') {
            const names = listWorkspaceNames();
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({ workspaces: names }));
            return;
        }

        // API: Show workspace definition
        if (parsedUrl.pathname === '/api/workspaces/show' && req.method === 'GET') {
            const name = typeof parsedUrl.query?.name === 'string' ? parsedUrl.query.name : '';
            const workspace = loadWorkspaceFile(name);
            if (!workspace) {
                res.writeHead(404, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify({ error: 'Workspace not found' }));
                return;
            }
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({ ok: true, workspace }));
            return;
        }

        // API: Create workspace
        if (parsedUrl.pathname === '/api/workspaces/create' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const { name } = JSON.parse(body);
                    const created = createWorkspaceFile(name);
                    if (created === null) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Invalid workspace name' }));
                        return;
                    }
                    if (created === false) {
                        res.writeHead(409, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Workspace already exists' }));
                        return;
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, workspace: created }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Save workspace snapshot from selected live sessions
        if (parsedUrl.pathname === '/api/workspaces/save' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const payload = JSON.parse(body);
                    const name = payload?.name;
                    const sessionNames = Array.isArray(payload?.sessionNames)
                        ? payload.sessionNames.filter((entry) => typeof entry === 'string' && entry)
                        : null;
                    const result = await snapshotWorkspaceFile(name, sessionNames);
                    if (!result || result.error === 'invalid-workspace') {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Invalid workspace name' }));
                        return;
                    }
                    if (result.error === 'no-live-sessions') {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'No live terminal sessions to save' }));
                        return;
                    }
                    if (result.error === 'session-not-live') {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: `Session is not live: ${result.internalName}` }));
                        return;
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, workspace: result.workspace, selected: result.selected || [] }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Load workspace (start defined sessions)
        if (parsedUrl.pathname === '/api/workspaces/load' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const { name, start } = JSON.parse(body);
                    const workspace = loadWorkspaceFile(name);
                    if (!workspace) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Workspace not found' }));
                        return;
                    }
                    const result = await applyWorkspace(workspace, {
                        startSessions: start !== false,
                        workspaceName: name
                    });
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, result }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // API: Delete workspace definition
        if (parsedUrl.pathname === '/api/workspaces/delete' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const { name } = JSON.parse(body);
                    const deleted = deleteWorkspaceFile(name);
                    if (deleted === null) {
                        res.writeHead(400, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Invalid workspace name' }));
                        return;
                    }
                    if (deleted === false) {
                        res.writeHead(404, { 'Content-Type': 'application/json' });
                        res.end(JSON.stringify({ error: 'Workspace not found' }));
                        return;
                    }
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true }));
                } catch (e) {
                    res.writeHead(400, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: 'Invalid request body' }));
                }
            });
            return;
        }

        // If no session selected, show session picker
        // Unknown /api/* must 404 as JSON — falling through to the page handler
        // returned 200 HTML, which callers (CLI, agents) misread as success
        // when talking to a daemon older than the endpoint they called.
        if (parsedUrl.pathname.startsWith('/api/')) {
            res.writeHead(404, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({ error: `Unknown API endpoint: ${parsedUrl.pathname} (daemon may need a restart to pick up new endpoints)` }));
            return;
        }

        if (parsedUrl.pathname === '/sessions') {
            // The server-rendered picker is gone; the hay app's switcher IS the
            // session manager. One canonical landing path.
            res.writeHead(302, { Location: '/' });
            res.end();
            return;
        }
        if (!sessionName) {
            // Landing (every device): the app shell in hub mode — the session
            // grid as the page, connected to NOTHING. Opening a session is the
            // user's click, not the server's guess.
            const isRootAsset = parsedUrl.pathname.startsWith('/assets/');
            // Serve the app shell + its assets at root scope (hub mode).
            let hubPath = isRootAsset
                ? path.join(HAY_WEB_DIR, parsedUrl.pathname)
                : path.join(HAY_WEB_DIR, 'index.html');
            const resolvedHub = path.resolve(hubPath);
            const hubRoot = path.resolve(HAY_WEB_DIR);
            if (resolvedHub !== hubRoot && !resolvedHub.startsWith(hubRoot + path.sep)) {
                res.writeHead(403);
                res.end('Forbidden');
                return;
            }
            if (!fs.existsSync(resolvedHub)) {
                res.writeHead(404);
                res.end('Not Found');
                return;
            }
            const hubExt = path.extname(resolvedHub).toLowerCase();
            const hubTypes = {
                '.html': 'text/html; charset=utf-8',
                '.js': 'application/javascript',
                '.css': 'text/css',
                '.json': 'application/json',
                '.png': 'image/png',
                '.jpg': 'image/jpeg',
                '.svg': 'image/svg+xml',
                '.ico': 'image/x-icon'
            };
            let hubContent = fs.readFileSync(resolvedHub);
            if (hubExt === '.html') {
                // Room-less config: marks the page as hop-served (hub mode).
                const hubConfig = { wsUrl: '/ws' };
                const hubUsername = resolveRequestUsername(req);
                if (hubUsername) hubConfig.name = hubUsername;
                hubContent = Buffer.from(
                    hubContent.toString('utf8').replace(
                        '<head>',
                        `<head><script>window.__HOP_SESSION__ = ${JSON.stringify(hubConfig)};</script>`
                    ),
                    'utf8'
                );
                setNoCache(res);
            }
            res.writeHead(200, { 'Content-Type': hubTypes[hubExt] || 'application/octet-stream' });
            res.end(hubContent);
            return;
        }
        // --- CHECK FOR iOS - Intercept and inject virtual keyboard ---
        const userAgent = req.headers['user-agent'] || '';
        const isIOS = /iPad|iPhone|iPod/.test(userAgent);
        const isMobile = isIOS || /Android/i.test(userAgent);
        const sessionConfig = getEffectiveSessionConfig(sessionName);
        if (sessionConfig && sessionConfig.type === 'port') {
            const targetPort = sessionConfig.port;
            if (!targetPort) {
                res.writeHead(500);
                res.end('Port session missing target port.');
                return;
            }
            const shouldInject = isMobile && shouldInjectSessionSwitcher(req);
            if (shouldInject) {
                waitForPort(targetPort).then((ready) => {
                    if (!ready) {
                        sendStartingPage(res, displayName);
                        return;
                    }
                    const headers = { ...req.headers };
                    delete headers['accept-encoding'];
                    const proxyReq = http.request({
                        hostname: '127.0.0.1',
                        port: targetPort,
                        method: req.method,
                        path: strippedUrl,
                        headers
                    }, (proxyRes) => {
                        const contentType = String(proxyRes.headers['content-type'] || '').toLowerCase();
                        const contentEncoding = String(proxyRes.headers['content-encoding'] || '').toLowerCase();
                        const isHtml = contentType.includes('text/html');
                        const isPlain = contentType.includes('text/plain');
                        const canModify = (isHtml || isPlain) && (!contentEncoding || contentEncoding === 'identity');
                        if (!canModify) {
                            res.writeHead(proxyRes.statusCode || 200, proxyRes.headers);
                            proxyRes.pipe(res);
                            return;
                        }
                        let chunks = [];
                        proxyRes.on('data', chunk => chunks.push(chunk));
                        proxyRes.on('end', () => {
                            let html = Buffer.concat(chunks).toString('utf8');
                            const overlay = getSessionSwitcherOverlay();
                            if (isPlain && !html.includes('<html')) {
                                const body = `<pre style="white-space:pre-wrap;font:14px/1.4 ui-monospace,Menlo,Monaco,Consolas,monospace;margin:24px;color:#18181b;">${escapeHtml(html)}</pre>`;
                                html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head><body>${body}${overlay}</body></html>`;
                            } else if (html.includes('</body>')) {
                                html = html.split('</body>').join(overlay + '</body>');
                            } else {
                                html += overlay;
                            }
                            const outHeaders = { ...proxyRes.headers };
                            delete outHeaders['content-length'];
                            delete outHeaders['content-encoding'];
                            if (isPlain) {
                                outHeaders['content-type'] = 'text/html; charset=utf-8';
                            }
                            res.writeHead(proxyRes.statusCode || 200, outHeaders);
                            res.end(html);
                        });
                    });
                    proxyReq.on('error', () => {
                        sendStartingPage(res, displayName);
                    });
                    req.pipe(proxyReq);
                });
                return;
            }

            waitForPort(targetPort).then((ready) => {
                if (!ready) {
                    sendStartingPage(res, displayName);
                    return;
                }
                const proxy = httpProxy.createProxyServer({ target: `http://127.0.0.1:${targetPort}`, ws: false });
                const originalUrl = req.url;
                req.url = strippedUrl;
                proxy.web(req, res, {}, () => {
                    sendStartingPage(res, displayName);
                });
                req.url = originalUrl;
            });
            return;
        }

        // Ensure session exists (creates hay room if needed)
        try {
            getOrCreateSession(sessionName);
        } catch (e) {
            res.writeHead(500);
            res.end('Failed to create session');
            return;
        }

        // Serve hay web client (has built-in mobile keyboard)
        const reqPath = strippedPathname || '/';

        // Map request path to file
        let filePath;
        if (reqPath === '/' || reqPath === '') {
            filePath = path.join(HAY_WEB_DIR, 'index.html');
        } else if (reqPath.startsWith('/assets/')) {
            filePath = path.join(HAY_WEB_DIR, reqPath);
        } else {
            // Fallback to index.html for SPA routing
            filePath = path.join(HAY_WEB_DIR, 'index.html');
        }

        // Containment check: prevent path traversal (e.g. /assets/../../secret)
        // from escaping the web asset directory via raw ".." segments.
        const resolvedFilePath = path.resolve(filePath);
        const webDirRoot = path.resolve(HAY_WEB_DIR);
        if (resolvedFilePath !== webDirRoot && !resolvedFilePath.startsWith(webDirRoot + path.sep)) {
            res.writeHead(403);
            res.end('Forbidden');
            return;
        }
        filePath = resolvedFilePath;

        // Check if file exists
        if (!fs.existsSync(filePath)) {
            res.writeHead(404);
            res.end('Not Found');
            return;
        }

        // Determine content type
        const ext = path.extname(filePath).toLowerCase();
        const contentTypes = {
            '.html': 'text/html; charset=utf-8',
            '.js': 'application/javascript',
            '.css': 'text/css',
            '.json': 'application/json',
            '.png': 'image/png',
            '.jpg': 'image/jpeg',
            '.svg': 'image/svg+xml',
            '.ico': 'image/x-icon'
        };
        const contentType = contentTypes[ext] || 'application/octet-stream';

        // Read and serve the file
        let content = fs.readFileSync(filePath);

        // For HTML files, inject config and fix asset paths
        if (ext === '.html') {
            let html = content.toString('utf8');
            const sessionBasePath = `/s/${displayName}/`;

            // Inject hop session configuration. Only include a name when the
            // request's user is known (multi-user hostnames); the web client
            // falls back to its own default otherwise.
            const hopSessionConfig = {
                room: displayName,
                wsUrl: '/ws'
            };
            const requestUsername = resolveRequestUsername(req);
            if (requestUsername) {
                hopSessionConfig.name = requestUsername;
            }
            const injectScript = `<script>
                // Hop session configuration - use /ws endpoint with room as query param
                window.__HOP_SESSION__ = ${JSON.stringify(hopSessionConfig)};
            </script>`;
            html = html.replace('<head>', '<head>' + injectScript);

            // Convert absolute asset paths to relative (remove leading /)
            html = html.replace(/src="\/assets\//g, 'src="assets/');
            html = html.replace(/href="\/assets\//g, 'href="assets/');

            content = Buffer.from(html, 'utf8');
        }

        // No caching in dev mode (when serving from hay)
        const isDevMode = !HAY_WEB_DIR.includes('hay-web');
        const headers = {
            'Content-Type': contentType,
            'Content-Length': content.length
        };
        if (isDevMode) {
            headers['Cache-Control'] = 'no-cache, no-store, must-revalidate';
            headers['Pragma'] = 'no-cache';
            headers['Expires'] = '0';
        }
        res.writeHead(200, headers);
        res.end(content);
    });

    // WebSocket upgrade for terminal
    server.on('upgrade', (req, socket, head) => {
        const parsedUrl = url.parse(req.url, true);
        const cookies = cookie.parse(req.headers.cookie || '');

        // Auth via cookie, Bearer token, or query param (for local CLI connections)
        const authHeader = req.headers.authorization || '';
        const bearerToken = authHeader.startsWith('Bearer ') ? authHeader.slice(7) : null;
        const tokenFromQuery = parsedUrl.query.token;
        const isAuthenticated = cookies[SESSION_COOKIE_NAME] === SESSION_SECRET ||
                               bearerToken === SESSION_SECRET ||
                               tokenFromQuery === SESSION_SECRET;

        if (!isAuthenticated) {
            socket.write('HTTP/1.1 401 Unauthorized\r\n\r\n');
            socket.destroy();
            return;
        }

        // Support both /ws?room=X (hay CLI format) and /s/{session}/ws (legacy)
        let sessionName = null;
        let sessionInfo = null;

        if (parsedUrl.pathname === '/ws') {
            // Hay CLI format: /ws?room=X
            const roomParam = parsedUrl.query.room;
            if (roomParam && typeof roomParam === 'string') {
                const resolved = resolveSessionDisplayName(roomParam);
                sessionName = resolved.internalName;
            }
        } else {
            // Legacy format: /s/{session}/ws
            sessionInfo = parseSessionFromRequest(req, parsedUrl);
            sessionName = sessionInfo ? sessionInfo.internalName : null;
        }

        if (!sessionName) {
            socket.write('HTTP/1.1 404 Session Not Found\r\n\r\n');
            socket.destroy();
            return;
        }

        const sessionConfig = getEffectiveSessionConfig(sessionName);
        if (sessionConfig && sessionConfig.type === 'port') {
            const targetPort = sessionConfig.port;
            if (!targetPort) {
                socket.write('HTTP/1.1 502 Bad Gateway\r\n\r\n');
                socket.destroy();
                return;
            }
            const proxy = httpProxy.createProxyServer({ target: `http://127.0.0.1:${targetPort}`, ws: true });
            proxy.once('error', () => {
                try { socket.destroy(); } catch (e) { }
            });
            const originalUrl = req.url;
            req.url = sessionInfo ? sessionInfo.strippedUrl : req.url;
            proxy.ws(req, socket, head);
            req.url = originalUrl;
            return;
        }

        // Get or create hay session
        if (isExternalTerminalBackend()) {
            (async () => {
                try {
                    await reconcileExternalRuntimeSessions();
                    await ensureExternalRuntimeSession(sessionName, sessionConfig?.cwd, getSessionDisplayName(sessionName), {
                        shell: sessionConfig?.shell,
                        env: sessionConfig?.env,
                        cols: sessionConfig?.cols,
                        rows: sessionConfig?.rows,
                        startup: sessionConfig?.startup,
                        autoStart: sessionConfig?.autoStart,
                        createdBy: sessionConfig?.createdBy,
                        agentPermitted: sessionConfig?.agentPermitted,
                        workspaceName: sessionConfig?.workspaceName,
                        folderId: sessionConfig?.folderId,
                        saveDefinition: hasSavedSessionConfig(sessionName)
                    });
                } catch (e) {
                    socket.write('HTTP/1.1 500 Server Error\r\n\r\n');
                    socket.destroy();
                    return;
                }

                const source = typeof parsedUrl.query.source === 'string' ? parsedUrl.query.source : '';
                const claimId = typeof parsedUrl.query.claim === 'string' ? parsedUrl.query.claim : null;
                noteClientConnected(sessionName, source, claimId);
                let disconnected = false;
                const handleDisconnect = () => {
                    if (disconnected) return;
                    disconnected = true;
                    noteClientDisconnected(sessionName, source);
                };
                socket.once('close', handleDisconnect);
                socket.once('error', handleDisconnect);

                try {
                    const targetPort = getExternalHayHostPortForSession(sessionName);
                    const proxy = httpProxy.createProxyServer({ target: `ws://127.0.0.1:${targetPort}`, ws: true });
                    proxy.once('error', () => {
                        handleDisconnect();
                        try { socket.destroy(); } catch (e) { }
                    });
                    const originalUrl = req.url;
                    req.url = buildExternalHayWsPath(parsedUrl, sessionName);
                    proxy.ws(req, socket, head);
                    req.url = originalUrl;
                } catch (e) {
                    handleDisconnect();
                    socket.write('HTTP/1.1 502 Bad Gateway\r\n\r\n');
                    socket.destroy();
                }
            })();
            return;
        }

        let session = activeSessions[sessionName];
        if (!session) {
            try {
                session = getOrCreateSession(sessionName);
            } catch (e) {
                socket.write('HTTP/1.1 500 Server Error\r\n\r\n');
                socket.destroy();
                return;
            }
        }

        // Create WebSocket server for this upgrade
        const wss = new WebSocket.Server({ noServer: true });
        wss.handleUpgrade(req, socket, head, (ws) => {
            // Parse query params for client info
            const wsUrl = new URL(req.url, 'http://localhost');
            const clientName = hay.sanitizeName(wsUrl.searchParams.get('name') || 'Anonymous');
            const cols = parseInt(wsUrl.searchParams.get('cols') || '80', 10);
            const rows = parseInt(wsUrl.searchParams.get('rows') || '24', 10);
            const source = wsUrl.searchParams.get('source') || '';
            const claimId = wsUrl.searchParams.get('claim') || null;

            const clientId = hay.generateClientId();
            const colorIndex = Math.floor(Math.random() * 1000);
            const actorLabel = source ? `web:${source}` : 'web';

            noteClientConnected(sessionName, source, claimId);
            registerSessionClientActor(sessionName, clientId, actorLabel);
            let disconnected = false;
            const handleDisconnect = () => {
                if (disconnected) return;
                disconnected = true;
                noteClientDisconnected(sessionName, source);
                unregisterSessionClientActor(sessionName, clientId);
            };
            ws.on('close', handleDisconnect);
            ws.on('error', handleDisconnect);

            // Attach client to hay room
            session.room.attachClient(
                { id: clientId, name: clientName, colorIndex, cols, rows },
                hay.createSocketAdapter(ws)
            );
        });
    });

    server.listen(PROXY_PORT, '127.0.0.1');
    return server;
}

// Tunnel manager - handles auto-restart and URL updates
let currentTunnelProc = null;
let currentPublicUrl = null;
let shuttingDown = false;  // Prevent restart during cleanup
const tunnelEmitter = new EventEmitter();
let CLIENT_TUNNEL_CONFIG = null; // { tunnelId, credentialsPath, hostname, configDir }
const plannedTunnelShutdowns = new WeakSet();
const tunnelStatus = {
    connected: false,
    lastEvent: null,
    lastError: null,
    lastUpdateAt: null,
    lastConnectedAt: null,
    lastRestartAt: null,
    consecutiveFailures: 0
};

function updateTunnelStatus(update) {
    Object.assign(tunnelStatus, update);
    tunnelStatus.lastUpdateAt = Date.now();
    // Any time the tunnel reports a live connection, clear the restart backoff
    // so the next outage starts retrying quickly again.
    if (update.connected === true) {
        tunnelRestartAttempts = 0;
        tunnelStatus.consecutiveFailures = 0;
    }
}

// Exponential backoff for tunnel restarts. Previously every close/error retried
// on a flat 3s loop forever (and could double-schedule), so a persistently
// broken tunnel (bad creds, network down) hammered `spawn('cloudflared')` and
// flooded the log at a constant rate. Back off 3s -> 60s with jitter, deduped,
// reset on a verified connection (see updateTunnelStatus).
const TUNNEL_BACKOFF_BASE_MS = 3000;
const TUNNEL_BACKOFF_MAX_MS = 60000;
let tunnelRestartAttempts = 0;
let tunnelBackoffTimer = null;

function scheduleTunnelRestart() {
    if (shuttingDown) return;
    if (tunnelBackoffTimer || tunnelRestartInProgress) return; // don't stack restarts
    const exp = Math.min(TUNNEL_BACKOFF_BASE_MS * Math.pow(2, tunnelRestartAttempts), TUNNEL_BACKOFF_MAX_MS);
    const delay = exp + Math.floor(Math.random() * 1000); // 0-1s jitter
    tunnelRestartAttempts += 1;
    updateTunnelStatus({ consecutiveFailures: tunnelRestartAttempts });
    log(`[Tunnel] Restart attempt ${tunnelRestartAttempts} in ${Math.round(delay / 1000)}s`, YELLOW);
    tunnelBackoffTimer = setTimeout(() => {
        tunnelBackoffTimer = null;
        if (!shuttingDown) startTunnelWithRestart();
    }, delay);
}

function isPlannedTunnelShutdown(tunnel) {
    return !!(tunnel && plannedTunnelShutdowns.has(tunnel));
}

function markPlannedTunnelShutdown(tunnel) {
    if (!tunnel || typeof tunnel.kill !== 'function') return false;
    plannedTunnelShutdowns.add(tunnel);
    return true;
}

function clearPlannedTunnelShutdown(tunnel) {
    if (!tunnel) return;
    plannedTunnelShutdowns.delete(tunnel);
}

function startTunnel(isRestart = false) {
    if (NO_TUNNEL) {
        log(`[test] tunnel disabled (HOP_NO_TUNNEL=1) — local stack at http://127.0.0.1:${BASE_PORT}`, YELLOW);
        return Promise.resolve({ tunnel: null, publicUrl: `http://127.0.0.1:${BASE_PORT}` });
    }
    const domainConfig = getDomainConfig();
    const useNamedTunnel = domainConfig && domainConfig.tunnelName && domainConfig.hostname;

    if (!isRestart) {
        if (useNamedTunnel) {
            log(`[3/4] Opening Cloudflare Tunnel (${domainConfig.hostname})...`, BOLD);
        } else {
            log(`[3/4] Opening Cloudflare Tunnel...`, BOLD);
        }
    } else {
        log(`[Tunnel] Reconnecting...`, YELLOW);
    }

    // Use named tunnel if configured, otherwise quick tunnel
    let tunnel;
    let publicUrl;

    const localTunnelHost = '127.0.0.1';

    if (useNamedTunnel) {
        // Named tunnel with custom domain - URL is fixed
        publicUrl = `https://${domainConfig.hostname}`;

        // Create config file for the tunnel
        const tunnelConfigPath = path.join(HOME_DIR, '.tunnel-config.yml');
        const tunnelConfig = `
url: http://${localTunnelHost}:${PROXY_PORT}
tunnel: ${domainConfig.tunnelName}
`;
        writePrivateFile(tunnelConfigPath, tunnelConfig);

        const runArgs = ['tunnel', '--config', tunnelConfigPath, 'run'];
        if (domainConfig.tunnelTokenFile && fs.existsSync(domainConfig.tunnelTokenFile)) {
            runArgs.push('--token-file', domainConfig.tunnelTokenFile);
        } else if (domainConfig.credentialsFile && fs.existsSync(domainConfig.credentialsFile)) {
            runArgs.push('--credentials-file', domainConfig.credentialsFile);
        }
        runArgs.push(domainConfig.tunnelName);
        tunnel = spawn('cloudflared', runArgs);
    } else {
        // Quick tunnel - URL is random
        tunnel = spawn('cloudflared', ['tunnel', '--url', `http://${localTunnelHost}:${PROXY_PORT}`]);
    }

    tunnel.on('close', (code) => {
        if (shuttingDown) return;  // Don't restart during cleanup
        const planned = isPlannedTunnelShutdown(tunnel);
        clearPlannedTunnelShutdown(tunnel);
        updateTunnelStatus({
            connected: false,
            lastEvent: planned ? 'planned_close' : 'closed',
            lastError: planned ? null : `cloudflared exited (code ${code})`
        });
        if (planned) return;
        log(`[Tunnel] Disconnected (code ${code}).`, YELLOW);
        scheduleTunnelRestart();
    });

    tunnel.on('error', (err) => {
        if (shuttingDown) return;  // Don't restart during cleanup
        const planned = isPlannedTunnelShutdown(tunnel);
        clearPlannedTunnelShutdown(tunnel);
        updateTunnelStatus({
            connected: false,
            lastEvent: planned ? 'planned_error' : 'error',
            lastError: planned ? null : err.message
        });
        if (planned) return;
        log(`[Tunnel] Error: ${err.message}.`, RED);
        scheduleTunnelRestart();
    });

    // For named tunnels, resolve immediately with the known URL
    updateTunnelStatus({ connected: false, lastEvent: isRestart ? 'restarting' : 'starting', lastError: null });
    if (useNamedTunnel) {
        currentTunnelProc = tunnel;
        currentPublicUrl = publicUrl;

        // Wait a moment for tunnel to establish, then resolve
        return new Promise((resolve) => {
            let resolved = false;

            // Listen for successful connection or error
            tunnel.stderr.on('data', (data) => {
                const output = data.toString();
                // Look for connection established message
                if (!resolved && (output.includes('Registered tunnel connection') || output.includes('Connection'))) {
                    resolved = true;
                    updateTunnelStatus({
                        connected: true,
                        lastEvent: 'connected',
                        lastError: null,
                        lastConnectedAt: Date.now()
                    });
                    if (isRestart) {
                        tunnelEmitter.emit('urlChanged', publicUrl);
                        log(`[Tunnel] Reconnected: ${publicUrl}`, GREEN);
                    }
                    resolve({ tunnel, publicUrl });
                }
            });

            // Timeout fallback after 5 seconds: cloudflared never confirmed the
            // connection, so verify with a quick HTTP probe instead of assuming.
            setTimeout(() => {
                if (resolved) return;
                resolved = true;
                probeTunnelHealth(publicUrl, 5000).then((health) => {
                    if (health.ok) {
                        updateTunnelStatus({
                            connected: true,
                            lastEvent: 'assumed_connected',
                            lastError: null,
                            lastConnectedAt: Date.now()
                        });
                    } else {
                        updateTunnelStatus({
                            connected: false,
                            lastEvent: 'unconfirmed',
                            lastError: health.error || (health.status ? `HTTP ${health.status}` : 'not reachable')
                        });
                        log(`[Tunnel] Tunnel process started but ${publicUrl} is not yet reachable — check ${CYAN}hop health${RESET}.`, YELLOW);
                    }
                    if (isRestart) {
                        tunnelEmitter.emit('urlChanged', publicUrl);
                    }
                    resolve({ tunnel, publicUrl });
                });
            }, 5000);
        });
    }

    // For quick tunnels, parse URL from output
    let urlFound = false;
    const recentTunnelOutput = []; // last cloudflared lines, for timeout diagnostics
    return new Promise((resolve, reject) => {
        tunnel.stderr.on('data', (data) => {
            if (urlFound) return;
            const output = data.toString();
            for (const line of output.split('\n')) {
                if (!line.trim()) continue;
                recentTunnelOutput.push(line);
                if (recentTunnelOutput.length > 10) recentTunnelOutput.shift();
            }
            const match = output.match(/https:\/\/[a-zA-Z0-9-]+\.trycloudflare\.com/);

            if (match) {
                const parsedUrl = match[0];
                if (parsedUrl.includes('api.trycloudflare.com')) return;

                urlFound = true;
                currentTunnelProc = tunnel;
                currentPublicUrl = parsedUrl;
                updateTunnelStatus({
                    connected: true,
                    lastEvent: 'connected',
                    lastError: null,
                    lastConnectedAt: Date.now()
                });

                // Emit URL change event for restarts
                if (isRestart) {
                    tunnelEmitter.emit('urlChanged', parsedUrl);
                    log(`[Tunnel] New URL: ${parsedUrl}`, GREEN);
                }

                resolve({ tunnel, publicUrl: parsedUrl });
            }
        });

        // Timeout - don't hang forever waiting for cloudflared
        setTimeout(() => {
            if (!urlFound) {
                tunnel.kill();
                log(`\n${RED}ERROR: Cloudflare tunnel failed to start (timeout after 30s)${RESET}`, RED);
                if (recentTunnelOutput.length) {
                    log(`Last ${recentTunnelOutput.length} line(s) of cloudflared output:`, YELLOW);
                    recentTunnelOutput.forEach((line) => log(`  ${line}`, RESET));
                }
                log(`Check your internet connection or try again.`, YELLOW);
                log(`See ${CYAN}hop logs${RESET} for the full daemon log, or run ${CYAN}hop health --restart${RESET}.`, RESET);
                process.exit(1);
            }
        }, 30000);
    });
}

function startClientTunnel(isRestart = false) {
    if (!CLIENT_TUNNEL_CONFIG) {
        throw new Error('Client tunnel config missing');
    }

    const { tunnelId, credentialsPath, hostname, configDir } = CLIENT_TUNNEL_CONFIG;
    const publicUrl = hostname ? `https://${hostname}` : null;

    if (!isRestart) {
        log(`[3/4] Opening Cloudflare Tunnel${hostname ? ` (${hostname})` : ''}...`, BOLD);
    } else {
        log(`[Tunnel] Reconnecting...`, YELLOW);
    }

    const tunnelConfigPath = path.join(configDir, 'tunnel-config.yml');
    const tunnelConfig = `
url: http://127.0.0.1:${PROXY_PORT}
tunnel: ${tunnelId}
credentials-file: ${path.resolve(credentialsPath)}
`;
    writePrivateFile(tunnelConfigPath, tunnelConfig);

    const tunnel = spawn('cloudflared', ['tunnel', '--config', tunnelConfigPath, 'run'], {
        stdio: ['ignore', 'pipe', 'pipe']
    });

    tunnel.on('close', (code) => {
        if (shuttingDown) return;  // Don't restart during cleanup
        const planned = isPlannedTunnelShutdown(tunnel);
        clearPlannedTunnelShutdown(tunnel);
        updateTunnelStatus({
            connected: false,
            lastEvent: planned ? 'planned_close' : 'closed',
            lastError: planned ? null : `cloudflared exited (code ${code})`
        });
        if (planned) return;
        log(`[Tunnel] Disconnected (code ${code}).`, YELLOW);
        scheduleTunnelRestart();
    });

    tunnel.on('error', (err) => {
        if (shuttingDown) return;  // Don't restart during cleanup
        const planned = isPlannedTunnelShutdown(tunnel);
        clearPlannedTunnelShutdown(tunnel);
        updateTunnelStatus({
            connected: false,
            lastEvent: planned ? 'planned_error' : 'error',
            lastError: planned ? null : err.message
        });
        if (planned) return;
        log(`[Tunnel] Error: ${err.message}.`, RED);
        scheduleTunnelRestart();
    });

    currentTunnelProc = tunnel;
    currentPublicUrl = publicUrl;
    updateTunnelStatus({ connected: false, lastEvent: isRestart ? 'restarting' : 'starting', lastError: null });

    return new Promise((resolve) => {
        let resolved = false;

        tunnel.stderr.on('data', (data) => {
            const output = data.toString();
            if (!resolved && (output.includes('Registered tunnel connection') || output.includes('Connection'))) {
                resolved = true;
                updateTunnelStatus({
                    connected: true,
                    lastEvent: 'connected',
                    lastError: null,
                    lastConnectedAt: Date.now()
                });
                if (isRestart) {
                    if (publicUrl) {
                        tunnelEmitter.emit('urlChanged', publicUrl);
                        log(`[Tunnel] Reconnected: ${publicUrl}`, GREEN);
                    } else {
                        log(`[Tunnel] Reconnected.`, GREEN);
                    }
                }
                resolve({ tunnel, publicUrl });
            }
        });

        // Timeout fallback after 5 seconds: cloudflared never confirmed the
        // connection. Verify with a quick HTTP probe when we know the URL,
        // instead of unconditionally assuming success.
        setTimeout(() => {
            if (resolved) return;
            resolved = true;
            const finish = () => {
                if (isRestart && publicUrl) {
                    tunnelEmitter.emit('urlChanged', publicUrl);
                }
                resolve({ tunnel, publicUrl });
            };
            if (!publicUrl) {
                updateTunnelStatus({
                    connected: true,
                    lastEvent: 'assumed_connected',
                    lastError: null,
                    lastConnectedAt: Date.now()
                });
                finish();
                return;
            }
            probeTunnelHealth(publicUrl, 5000).then((health) => {
                if (health.ok) {
                    updateTunnelStatus({
                        connected: true,
                        lastEvent: 'assumed_connected',
                        lastError: null,
                        lastConnectedAt: Date.now()
                    });
                } else {
                    updateTunnelStatus({
                        connected: false,
                        lastEvent: 'unconfirmed',
                        lastError: health.error || (health.status ? `HTTP ${health.status}` : 'not reachable')
                    });
                    log(`[Tunnel] Tunnel process started but ${publicUrl} is not yet reachable — check ${CYAN}hop health${RESET}.`, YELLOW);
                }
                finish();
            });
        }, 5000);
    });
}

let tunnelRestartInProgress = false;
let tunnelRestartQueued = false;

async function startTunnelWithRestart() {
    if (NO_TUNNEL) return;
    // Prevent concurrent restarts
    if (tunnelRestartInProgress) {
        tunnelRestartQueued = true;
        log(`[Tunnel] Restart already in progress, queuing.`, YELLOW);
        return;
    }
    tunnelRestartInProgress = true;
    updateTunnelStatus({ lastRestartAt: Date.now(), lastEvent: 'restarting' });

    let shouldReschedule = false;
    try {
        const { tunnel, publicUrl } = CLIENT_TUNNEL_CONFIG
            ? await startClientTunnel(true)
            : await startTunnel(true);

        const verified = await waitForTunnelHealthy(publicUrl, {
            timeoutMs: TUNNEL_RESTART_VERIFY_TIMEOUT,
            intervalMs: TUNNEL_RESTART_VERIFY_INTERVAL
        });
        if (!verified.ok) {
            const result = verified.result || {};
            const reason = result.error || (result.status ? `HTTP ${result.status}` : 'Unknown error');
            updateTunnelStatus({
                connected: false,
                lastEvent: 'restart_unhealthy',
                lastError: `Public tunnel still unhealthy after restart: ${reason}`
            });
            if (tunnel && !tunnel.killed) {
                markPlannedTunnelShutdown(tunnel);
                try { tunnel.kill('SIGTERM'); } catch (e) { }
            }
            throw new Error(`Tunnel failed verification (${reason})`);
        }

        updateTunnelStatus({
            connected: true,
            lastEvent: 'healthy',
            lastError: null,
            lastConnectedAt: Date.now()
        });
        log(`[Tunnel] Verified healthy: ${publicUrl}`, GREEN);

        // Update state file
        if (fs.existsSync(STATE_FILE)) {
            try {
                const state = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));
                state.url = publicUrl;
                writePrivateFile(STATE_FILE, JSON.stringify(state));
            } catch (e) { }
        }
    } catch (e) {
        log(`[Tunnel] Failed to restart: ${e.message}.`, RED);
        shouldReschedule = true;
    } finally {
        tunnelRestartInProgress = false;
        if (shouldReschedule) {
            scheduleTunnelRestart();
            return;
        }
        if (tunnelRestartQueued) {
            tunnelRestartQueued = false;
            setTimeout(startTunnelWithRestart, 0);
        }
    }
}

// Tunnel health monitor - detects stale connections (e.g., after VPN change)
let tunnelHealthInterval = null;
const TUNNEL_HEALTH_CHECK_INTERVAL = 30000; // Check every 30s
const TUNNEL_HEALTH_TIMEOUT = 10000; // 10s timeout for health check
const TUNNEL_RESTART_VERIFY_TIMEOUT = 25000;
const TUNNEL_RESTART_VERIFY_INTERVAL = 1500;

async function probeTunnelHealth(publicUrl, timeoutMs = TUNNEL_HEALTH_TIMEOUT) {
    if (!publicUrl) {
        return { ok: false, error: 'Missing tunnel URL', status: null, time: 0 };
    }
    const https = require('https');
    const startedAt = Date.now();
    return new Promise((resolve) => {
        const req = https.get(publicUrl, { timeout: timeoutMs }, (res) => {
            resolve({
                ok: typeof res.statusCode === 'number' && res.statusCode < 500,
                status: res.statusCode,
                error: null,
                time: Date.now() - startedAt
            });
        });
        req.on('error', (err) => {
            resolve({
                ok: false,
                status: null,
                error: err.message,
                time: Date.now() - startedAt
            });
        });
        req.on('timeout', () => {
            req.destroy();
            resolve({
                ok: false,
                status: null,
                error: `Timeout (${Math.ceil(timeoutMs / 1000)}s)`,
                time: Date.now() - startedAt
            });
        });
    });
}

async function waitForTunnelHealthy(publicUrl, options = {}) {
    const timeoutMs = Number.isFinite(options.timeoutMs)
        ? Math.max(1, Math.floor(options.timeoutMs))
        : TUNNEL_RESTART_VERIFY_TIMEOUT;
    const intervalMs = Number.isFinite(options.intervalMs)
        ? Math.max(100, Math.floor(options.intervalMs))
        : TUNNEL_RESTART_VERIFY_INTERVAL;
    const startedAt = Date.now();
    let lastResult = { ok: false, error: 'No checks performed', status: null, time: 0 };

    while ((Date.now() - startedAt) < timeoutMs) {
        lastResult = await probeTunnelHealth(publicUrl, TUNNEL_HEALTH_TIMEOUT);
        if (lastResult.ok) {
            return {
                ok: true,
                result: lastResult,
                waitedMs: Date.now() - startedAt
            };
        }
        await new Promise((resolve) => setTimeout(resolve, intervalMs));
    }

    return {
        ok: false,
        result: lastResult,
        waitedMs: Date.now() - startedAt
    };
}

function startTunnelHealthMonitor() {
    if (NO_TUNNEL) return;
    if (tunnelHealthInterval) return;

    tunnelHealthInterval = setInterval(async () => {
        if (shuttingDown || !currentPublicUrl) return;

        const result = await probeTunnelHealth(currentPublicUrl, TUNNEL_HEALTH_TIMEOUT);
        if (!result.ok) {
            const reason = result.error || (result.status ? `HTTP ${result.status}` : 'Unknown error');
            updateTunnelStatus({
                connected: false,
                lastEvent: 'unhealthy',
                lastError: reason
            });
            log(`[Tunnel] Health check failed: ${reason}. Restarting tunnel...`, YELLOW);
            if (currentTunnelProc && !currentTunnelProc.killed) {
                try { currentTunnelProc.kill('SIGTERM'); } catch (err) { }
                // The 'close' handler will trigger restart
            } else {
                // Cloudflared already dead, restart directly
                startTunnelWithRestart();
            }
        } else if (tunnelStatus.lastEvent !== 'healthy') {
            updateTunnelStatus({
                connected: true,
                lastEvent: 'healthy',
                lastError: null
            });
        }
    }, TUNNEL_HEALTH_CHECK_INTERVAL);
}

function stopTunnelHealthMonitor() {
    if (tunnelHealthInterval) {
        clearInterval(tunnelHealthInterval);
        tunnelHealthInterval = null;
    }
}

